<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{ appName }}</title>
    <style>
      :root {
        --bg: #0f1115;
        --surface: #181b21;
        --text: #e6e9ef;
        --muted: #9aa0a6;
        --accent: #f5a623;
        --danger: #e5484d;
      }
      * { box-sizing: border-box; }
      body {
        margin: 0;
        font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
        background: var(--bg);
        color: var(--text);
        line-height: 1.6;
      }
      .shell {
        min-height: 100vh;
        display: flex;
        flex-direction: column;
      }
      header {
        padding: 1rem 1.5rem;
        background: var(--surface);
        border-bottom: 1px solid #2a2e36;
      }
      .brand {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        font-weight: 700;
        font-size: 1.25rem;
      }
      .brand svg {
        width: 1.75rem;
        height: 1.75rem;
        color: var(--accent);
      }
      main {
        flex: 1;
        max-width: 720px;
        width: 100%;
        margin: 0 auto;
        padding: 2rem 1.5rem;
      }
      h1 { margin-top: 0; }
      .placeholder {
        padding: 1rem 1.25rem;
        background: var(--surface);
        border-left: 4px solid var(--accent);
        border-radius: 0 0.5rem 0.5rem 0;
        color: var(--muted);
      }
      footer {
        padding: 1rem 1.5rem;
        text-align: center;
        color: var(--muted);
        font-size: 0.875rem;
        border-top: 1px solid #2a2e36;
      }
      .error-box {
        padding: 1.5rem;
        background: var(--surface);
        border-radius: 0.5rem;
      }
      .error-box h1 { color: var(--danger); }
      .actions { display: flex; gap: 0.75rem; flex-wrap: wrap; margin: 1rem 0; }
      .page-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 1rem;
        flex-wrap: wrap;
        margin-bottom: 1rem;
      }
      .button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 0.5rem 1rem;
        border: 1px solid #2a2e36;
        border-radius: 0.375rem;
        background: var(--surface);
        color: var(--text);
        text-decoration: none;
        cursor: pointer;
        font-size: 1rem;
      }
      .button-primary { border-color: var(--accent); color: var(--accent); }
      .button-danger { border-color: var(--danger); color: var(--danger); }
      .inline-form { display: inline; margin: 0; }
      .dashboard-counts { margin: 1.5rem 0; }
      .count-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(7rem, 1fr));
        gap: 0.75rem;
      }
      .count-card {
        padding: 0.75rem 1rem;
        background: var(--surface);
        border-radius: 0.5rem;
        text-align: center;
        color: var(--muted);
      }
      .count { display: block; font-size: 1.5rem; font-weight: 700; color: var(--text); }
      .project-list { list-style: none; padding: 0; }
      .project-list li { padding: 0.75rem 0; border-bottom: 1px solid #2a2e36; }
      .project-list a { font-weight: 600; }
      .meta { display: block; font-size: 0.875rem; color: var(--muted); }
      .filters {
        display: flex;
        flex-wrap: wrap;
        gap: 1rem;
        align-items: flex-end;
        margin-bottom: 1rem;
        padding: 1rem;
        background: var(--surface);
        border-radius: 0.5rem;
      }
      .field { display: flex; flex-direction: column; gap: 0.25rem; min-width: 10rem; }
      .field-row { display: flex; gap: 1rem; flex-wrap: wrap; }
      .field label { font-size: 0.875rem; color: var(--muted); }
      .field input, .field textarea, .field select {
        padding: 0.5rem;
        background: var(--bg);
        color: var(--text);
        border: 1px solid #2a2e36;
        border-radius: 0.375rem;
        font-size: 1rem;
      }
      .field-error input, .field-error textarea, .field-error select { border-color: var(--danger); }
      .field-error-message { font-size: 0.875rem; color: var(--danger); }
      .required { color: var(--danger); }
      .error-summary {
        padding: 1rem;
        background: rgba(229, 72, 77, 0.15);
        border-left: 4px solid var(--danger);
        border-radius: 0 0.5rem 0.5rem 0;
        margin-bottom: 1rem;
      }
      .project-form { display: flex; flex-direction: column; gap: 1rem; }
      .form-actions { display: flex; gap: 0.75rem; margin-top: 0.5rem; }
      .project-table {
        width: 100%;
        border-collapse: collapse;
        margin: 1rem 0;
      }
      .project-table th, .project-table td {
        padding: 0.75rem;
        text-align: left;
        border-bottom: 1px solid #2a2e36;
      }
      .project-table th { color: var(--muted); font-size: 0.875rem; }
      .pagination {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-top: 1rem;
      }
      .results-meta { color: var(--muted); font-size: 0.875rem; }
      .detail-list {
        display: grid;
        grid-template-columns: 8rem 1fr;
        gap: 0.5rem 1rem;
        margin: 1rem 0;
      }
      .detail-list dt { color: var(--muted); }
      .detail-list dd { margin: 0; }
      .description, .notes { white-space: pre-wrap; }
      .asset-table { width: 100%; border-collapse: collapse; margin: 1rem 0; }
      .asset-table th, .asset-table td {
        padding: 0.5rem 0.75rem;
        text-align: left;
        border-bottom: 1px solid #2a2e36;
        font-size: 0.875rem;
      }
      .asset-table th { color: var(--muted); font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.05em; }
      .asset-filename { font-weight: 600; }
      .asset-path code { font-size: 0.8rem; color: var(--muted); }
      .asset-size { text-align: right; font-variant-numeric: tabular-nums; }
      .asset-date { color: var(--muted); font-size: 0.8rem; }
      .scan-error, .scan-success {
        padding: 1rem 1.25rem;
        border-radius: 0 0.5rem 0.5rem 0;
        margin-bottom: 1rem;
      }
      .scan-error {
        background: rgba(229, 72, 77, 0.15);
        border-left: 4px solid var(--danger);
      }
      .scan-success {
        background: rgba(70, 180, 100, 0.15);
        border-left: 4px solid #46b464;
      }
    </style>
  </head>
  <body>
    <div class="shell">
      <header>
        <div class="brand">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
            <circle cx="8.5" cy="8.5" r="1.5"></circle>
            <polyline points="21 15 16 10 5 21"></polyline>
          </svg>
          {{ appName }}
        </div>
      </header>
      <main>
        {% block content %}{% endblock %}
      </main>
      <footer>CreatorCrate — self-hosted Patreon project organizer</footer>
    </div>
  </body>
</html>
