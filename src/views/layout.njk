{% set currentPageHeading = page_title or shell.activeSection or shell.appName or appName %}
{% set hasPageHeading = page_title or shell.activeSection %}
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}CreatorCrate{% if hasPageHeading %} — {{ currentPageHeading }}{% endif %}{% endblock %}</title>
    {% set viteEntryAssets = {} %}
    {% if assetMode == 'production' %}
      {% set viteEntryAssets = viteAssets.entry('client/main.js') %}
      {% for stylesheetUrl in viteEntryAssets.css %}
        <link rel="stylesheet" href="{{ stylesheetUrl }}">
      {% endfor %}
      {% for preloadUrl in viteEntryAssets.preload %}
        <link rel="modulepreload" href="{{ preloadUrl }}">
      {% endfor %}
    {% elif assetMode == 'test' %}
      <link rel="stylesheet" href="/creatorcrate.css">
    {% endif %}
    {% block page_assets %}{% endblock %}
    <link rel="icon" type="image/svg+xml" href="/logo.svg">
    {% if assetMode == 'production' %}
      <script type="module" src="{{ viteEntryAssets.js }}"></script>
    {% elif assetMode == 'development' %}
      <script type="module" src="{{ viteDevAssets.client }}"></script>
      <script type="module" src="{{ viteDevAssets.entry }}"></script>
    {% else %}
      <script type="module" src="/creatorcrate.js"></script>
    {% endif %}
  </head>
  <body class="{% block body_class %}{% endblock %}">
    {% import "partials/icons.njk" as icons %}
    {% set shellVisible = auth and (not auth.enabled or auth.authenticated) %}
    <a class="skip-link" href="#main-content">Skip to content</a>
    <div class="app-shell">
      {% if shellVisible %}
      <aside class="app-sidebar">
        <div class="app-sidebar-mark">
          <img src="/logo.svg" alt="" class="app-sidebar-logo">
          <span class="app-sidebar-brand">{{ shell.appName or appName }}</span>
        </div>
        {% if shell %}
        <nav class="app-nav" aria-label="Primary">
          <ul class="app-nav-list">
            {% for item in shell.navigation %}
              <li class="app-nav-item{% if item.active %} app-nav-item--active{% endif %}{% if item.children.length %} app-nav-item--has-children{% endif %}">
                <a href="{{ item.href }}" class="app-nav-link" data-nav-key="{{ item.key }}"{% if item.active and not item.children.length %} aria-current="page"{% endif %}>
                  {{ icons.icon(item.icon) }}<span class="app-nav-label">{{ item.label }}</span>
                </a>
                {% if item.children.length %}
                  <ul class="app-nav-children">
                    {% for child in item.children %}
                      <li class="app-nav-child-item">
                        <a href="{{ child.href }}" class="app-nav-child-link" data-nav-key="{{ item.key }}-{{ child.key }}"{% if child.current %} aria-current="page"{% endif %}>{{ child.label }}</a>
                      </li>
                    {% endfor %}
                  </ul>
                {% endif %}
              </li>
            {% endfor %}
          </ul>
          {% if auth.authenticated %}
            <div class="app-sidebar-footer">
              <span class="app-identity">{{ auth.username }}</span>
              <form method="post" action="/logout" class="app-logout-form">
                <input type="hidden" name="_csrf" value="{{ _csrf }}">
                <button type="submit" class="button button-secondary button-small app-logout-button">Log out</button>
              </form>
            </div>
          {% endif %}
        </nav>
        {% endif %}
      </aside>

      <details class="mobile-nav">
        <summary class="mobile-nav-summary">
          <img src="/logo.svg" alt="" class="mobile-nav-logo">
          <span class="mobile-nav-brand">{{ shell.appName or appName }}</span>
          <span class="mobile-nav-section">{{ currentPageHeading }}</span>
          <span class="mobile-nav-toggle">Menu</span>
        </summary>
        <nav class="mobile-nav-primary" aria-label="Primary">
          <ul class="mobile-nav-list">
            {% for item in shell.navigation %}
              <li class="mobile-nav-item{% if item.active %} mobile-nav-item--active{% endif %}{% if item.children.length %} mobile-nav-item--has-children{% endif %}">
                <a href="{{ item.href }}" class="mobile-nav-link" data-nav-key="{{ item.key }}"{% if item.active and not item.children.length %} aria-current="page"{% endif %}>{{ item.label }}</a>
                {% if item.children.length %}
                  <ul class="mobile-nav-children">
                    {% for child in item.children %}
                      <li class="mobile-nav-child-item">
                        <a href="{{ child.href }}" class="mobile-nav-child-link" data-nav-key="{{ item.key }}-{{ child.key }}"{% if child.current %} aria-current="page"{% endif %}>{{ child.label }}</a>
                      </li>
                    {% endfor %}
                  </ul>
                {% endif %}
              </li>
            {% endfor %}
          </ul>
          {% if auth.authenticated %}
            <div class="mobile-nav-footer">
              <span class="app-identity">{{ auth.username }}</span>
              <form method="post" action="/logout" class="app-logout-form">
                <input type="hidden" name="_csrf" value="{{ _csrf }}">
                <button type="submit" class="button button-secondary button-small app-logout-button">Log out</button>
              </form>
            </div>
          {% endif %}
        </nav>
      </details>
      {% endif %}

      <div class="app-main{% if not shellVisible %} app-main--centered{% endif %}">
        <header class="app-header"{% if not shellVisible %} hidden{% endif %}>
          {# The compact header title is the page's sole <h1> — the
             page-heading component below no longer renders one. When the
             shell is hidden (login.njk), skip the h1 so login's own
             standalone heading stays the only one on the page. #}
          {% if shellVisible %}
            <h1 class="app-section-title">{{ currentPageHeading }}</h1>
          {% else %}
            <p class="app-section-title">{{ currentPageHeading }}</p>
          {% endif %}
        </header>

        {% if auth and auth.enabled == false and shellVisible %}
          <div class="auth-disabled-banner" role="alert">
            {{ icons.icon('warning') }}
            <p>Authentication is disabled. Anyone who can reach this server can access CreatorCrate.</p>
            <a href="/settings/security" class="button button-secondary button-small">Enable Authentication</a>
          </div>
        {% endif %}

        <main id="main-content" tabindex="-1">
          {% block content %}{% endblock %}
        </main>

        <footer>CreatorCrate — self-hosted art project organizer</footer>
      </div>
      {% block overlay %}{% endblock %}
    </div>
    {% include "partials/confirm-dialog.njk" %}
  </body>
</html>
