<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{ appName }}</title>
    <style>
      :root {
        --bg: #0f1115;
        --surface: #181b21;
        --text: #e6e9ef;
        --muted: #9aa0a6;
        --accent: #f5a623;
        --danger: #e5484d;
      }
      * { box-sizing: border-box; }
      body {
        margin: 0;
        font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
        background: var(--bg);
        color: var(--text);
        line-height: 1.6;
      }
      .shell {
        min-height: 100vh;
        display: flex;
        flex-direction: column;
      }
      header {
        padding: 1rem 1.5rem;
        background: var(--surface);
        border-bottom: 1px solid #2a2e36;
      }
      .brand {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        font-weight: 700;
        font-size: 1.25rem;
      }
      .brand svg {
        width: 1.75rem;
        height: 1.75rem;
        color: var(--accent);
      }
      main {
        flex: 1;
        max-width: 720px;
        width: 100%;
        margin: 0 auto;
        padding: 2rem 1.5rem;
      }
      h1 { margin-top: 0; }
      .placeholder {
        padding: 1rem 1.25rem;
        background: var(--surface);
        border-left: 4px solid var(--accent);
        border-radius: 0 0.5rem 0.5rem 0;
        color: var(--muted);
      }
      footer {
        padding: 1rem 1.5rem;
        text-align: center;
        color: var(--muted);
        font-size: 0.875rem;
        border-top: 1px solid #2a2e36;
      }
      .error-box {
        padding: 1.5rem;
        background: var(--surface);
        border-radius: 0.5rem;
      }
      .error-box h1 { color: var(--danger); }
    </style>
  </head>
  <body>
    <div class="shell">
      <header>
        <div class="brand">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
            <circle cx="8.5" cy="8.5" r="1.5"></circle>
            <polyline points="21 15 16 10 5 21"></polyline>
          </svg>
          {{ appName }}
        </div>
      </header>
      <main>
        {% block content %}{% endblock %}
      </main>
      <footer>CreatorCrate — self-hosted Patreon project organizer</footer>
    </div>
  </body>
</html>
