{% extends "layout.njk" %}
{% import "partials/page-heading.njk" as pageHeading %}

{% block title %}Settings – {{ appName }}{% endblock %}

{% block content %}
  {{ pageHeading.render("Settings", "Application configuration and maintenance.") }}

  <nav class="summary-cards" aria-label="Settings areas">
    <a class="summary-card" href="/settings/backups">
      <span class="summary-card-label">Backups</span>
      <span class="summary-card-context">Create and restore SQLite database backups.</span>
    </a>
    {% if auth and auth.enabled %}
      <a class="summary-card" href="/settings/security">
        <span class="summary-card-label">Security</span>
        <span class="summary-card-context">Rotate the operator password and revoke sessions.</span>
      </a>
    {% endif %}
  </nav>
{% endblock %}
