{% extends "layout.njk" %}
{% import "partials/page-heading.njk" as pageHeading %}
{% import "partials/form-switch.njk" as formSwitch %}

{% set page_title = "Settings — Social Preparation" %}

{% block content %}
  {{ pageHeading.render("Social Preparation settings.") }}
  <p class="help-text">Social Preparation is disabled unless you explicitly opt in.</p>
  <div class="settings-social-prep-content">

  {% if notice %}
    {% set noticeVariant = notice.variant %}
    {% set noticeText = notice.text %}
    {% include "partials/notice.njk" %}
  {% endif %}

  <div class="settings-layout">
    <div class="settings-content">
      <div data-settings-social-prep-region>
        <form method="post" action="/settings/social-prep" class="project-form" novalidate>
          {% if errorMessages.length > 0 %}
            <div class="error-summary" role="alert" id="social-prep-errors">
              <p>Social Preparation settings could not be saved. Fix the field below and try again.</p>
              <ul>
                {% for error in errorMessages %}<li>{{ error }}</li>{% endfor %}
              </ul>
            </div>
          {% endif %}

          <input type="hidden" name="_csrf" value="{{ _csrf }}">
          <div class="settings-section">
            <h3>Social Preparation</h3>
            <p class="help-text">Opt in only when you want CreatorCrate to retain these preferences for future Social Preparation work. This setting does not prepare, publish, or send anything.</p>

            <div class="field field--switch{% if errors.enabled %} field-error{% endif %}">
              <span class="field-label">Enabled</span>
              {{ formSwitch.control(
                "social-prep-enabled",
                "enabled",
                settings.enabled,
                "Social Preparation enabled state",
                "social-prep-enabled-help social-prep-errors" if errors.enabled else "social-prep-enabled-help",
                true if errors.enabled else false,
                false,
                "fetch",
                true,
                "Save"
              ) }}
              <p class="help-text" id="social-prep-enabled-help">Keep this disabled until you are ready to opt in.</p>
              <p class="help-text" data-settings-fetch-save-status aria-live="polite" aria-atomic="true"></p>
            </div>

            <fieldset class="field{% if errors.platforms %} field-error{% endif %}"{% if errors.platforms %} aria-describedby="social-prep-platforms-help social-prep-errors"{% endif %}>
              <legend class="field-label">Enabled platforms</legend>
              <p class="help-text" id="social-prep-platforms-help">Select the platforms you want available if Social Preparation is enabled.</p>
              {% for platform in [
                { value: "patreon", label: "Patreon" },
                { value: "x", label: "X" },
                { value: "bluesky", label: "Bluesky" }
              ] %}
                <label class="checkbox-label" for="social-prep-platform-{{ platform.value }}">
                  <input id="social-prep-platform-{{ platform.value }}" type="checkbox" name="platforms" value="{{ platform.value }}" data-autosubmit="fetch"{% if platform.value in settings.platforms %} checked{% endif %}>
                  {{ platform.label }}
                </label>
              {% endfor %}
            </fieldset>
          </div>
          <noscript><button type="submit" class="button button-small button-secondary">Save</button></noscript>
        </form>
      </div>
    </div>
  </div>
  </div>
{% endblock %}
