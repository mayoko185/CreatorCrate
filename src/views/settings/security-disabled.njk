{% extends "layout.njk" %}
{% import "partials/page-heading.njk" as pageHeading %}

{% set page_title = "Settings — Security" %}

{% block content %}
  {% call pageHeading.render("Authentication is currently disabled. Choose a username and password to require login for this server.") %}
    <button type="submit" class="button button-primary settings-security-enable-action" form="enable-authentication-form">Enable Authentication</button>
  {% endcall %}

  {% if notice %}
    {% set noticeVariant = notice.variant %}
    {% set noticeText = notice.text %}
    {% include "partials/notice.njk" %}
  {% endif %}

  <div class="settings-layout settings-security-layout">

    <div class="settings-content settings-security-content">
      <div class="panel panel--warning settings-security-disabled-warning">
        <p><strong>Anyone who can reach this server can currently access CreatorCrate</strong> — there is no login requirement. Enabling authentication requires every visitor to sign in with the credentials chosen below.</p>
      </div>

      {% if errors.length > 0 %}
        <div class="error-summary" role="alert" id="enable-errors">
          <p>Authentication was not enabled. Fix the fields below and try again.</p>
          <ul>
            {% for error in errors %}<li>{{ error }}</li>{% endfor %}
          </ul>
        </div>
      {% endif %}

      <form id="enable-authentication-form" method="post" action="/settings/security/enable" class="project-form settings-security-form" novalidate>
        <input type="hidden" name="_csrf" value="{{ _csrf }}">
        <div class="settings-section settings-security-section">
          <h3>Enable authentication</h3>
          <p class="help-text">Use at least 12 characters for the password. Passwords are never displayed or stored in plaintext.</p>

          <div class="field {% if errors.length > 0 %}field-error{% endif %}">
            <label for="username">Username <span class="required" aria-label="required">*</span></label>
            <input type="text" id="username" name="username" autocomplete="username" required value="{{ retainedUsername }}"{% if errors.length > 0 %} aria-describedby="enable-errors" aria-invalid="true"{% endif %}>
            <span class="help-text">3-64 characters: lowercase letters, digits, "_", "." or "-".</span>
          </div>

          <div class="field {% if errors.length > 0 %}field-error{% endif %}">
            <label for="password">Password <span class="required" aria-label="required">*</span></label>
            <input type="password" id="password" name="password" autocomplete="new-password" required aria-describedby="password-help{% if errors.length > 0 %} enable-errors{% endif %}"{% if errors.length > 0 %} aria-invalid="true"{% endif %}>
            <span class="help-text" id="password-help">Minimum 12 characters; do not use leading or trailing spaces.</span>
          </div>

          <div class="field {% if errors.length > 0 %}field-error{% endif %}">
            <label for="confirmPassword">Confirm password <span class="required" aria-label="required">*</span></label>
            <input type="password" id="confirmPassword" name="confirmPassword" autocomplete="new-password" required{% if errors.length > 0 %} aria-describedby="enable-errors" aria-invalid="true"{% endif %}>
          </div>

        </div>
      </form>
    </div>
  </div>
{% endblock %}
