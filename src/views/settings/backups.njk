{% extends "layout.njk" %}
{% import "partials/page-heading.njk" as pageHeading %}
{% import "partials/icons.njk" as icons %}

{% set page_title = "Settings — Backups" %}
{% block body_class %}settings-page{% endblock %}

{% block content %}
  {% call pageHeading.render() %}
    <form method="post" action="/settings/backups" class="inline-form">
      <input type="hidden" name="_csrf" value="{{ _csrf }}">
      <button type="submit" class="button button-primary dashboard-create-action"><span class="project-create-submit-icon" aria-hidden="true">{{ icons.icon('plus') }}</span>Create Backup</button>
    </form>
  {% endcall %}

  {% if notice %}
    {% set noticeVariant = notice.variant %}
    {% set noticeText = notice.text %}
    {% include "partials/notice.njk" %}
  {% endif %}

  <div class="settings-layout">

    <div class="settings-content settings-backups-content">
      <div class="panel panel--info">
        <p>Backups save CreatorCrate's database, including projects, releases, and asset records. Restoring a backup replaces the current database, so database changes made since that backup will be lost.</p>
        <p>Project files and media stored under <code>PROJECTS_ROOT</code> are not included in backups and are not changed by a restore.</p>
        <p>After a successful backup, older managed backups exceeding <code>BACKUP_RETENTION_COUNT</code> are automatically deleted. The default is 10; set it to 0 to keep all backups. See the README for configuration details.</p>
      </div>

      <section class="settings-section backups-results-section" aria-labelledby="backups-results-heading">
        <h2 id="backups-results-heading">Existing backups</h2>
        <div class="project-detail-section-body">
          {% if backups.length > 0 %}
            <div class="table-scroll backups-table-scroll" tabindex="0" aria-label="Managed backups">
              <table class="data-table backups-table">
                <thead>
                  <tr>
                    <th>Filename</th>
                    <th>Created</th>
                    <th class="num">Size</th>
                    <th>Validation</th>
                    <th></th>
                  </tr>
                </thead>
                <tbody>
                  {% for backup in backups %}
                    <tr>
                      <td><code>{{ backup.filename }}</code></td>
                      <td>{{ backup.createdAt | formatIsoTimestamp(clockFormat) }}</td>
                      <td class="num">{{ (backup.sizeBytes / 1024) | round(1) }} KB</td>
                      <td>
                        {% if backup.valid %}
                          <span class="status-badge status-badge--success">Valid</span>
                        {% else %}
                          <span class="status-badge status-badge--error">Invalid</span>
                        {% endif %}
                      </td>
                      <td class="row-actions">
                        {% if backup.valid %}
                          <a class="button button-small button-danger" href="/settings/backups/{{ backup.filename }}/restore">Restore</a>
                        {% else %}
                          <span class="button button-small" aria-disabled="true">Restore</span>
                        {% endif %}
                        <a class="button button-small button-secondary" href="/settings/backups/{{ backup.filename }}/delete">Delete</a>
                      </td>
                    </tr>
                  {% endfor %}
                </tbody>
              </table>
            </div>
          {% else %}
            {% set emptyHeading = "No backups yet" %}
            {% set emptyDescription = "Create a backup to save the current state of the application database." %}
            {% include "partials/empty-state.njk" %}
          {% endif %}
        </div>
      </section>
    </div>
  </div>
{% endblock %}
