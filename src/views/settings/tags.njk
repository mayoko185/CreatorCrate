{% extends "layout.njk" %}
{% import "partials/page-heading.njk" as pageHeading %}

{% set page_title = "Settings — Tags" %}

{% block content %}
  {{ pageHeading.render("Create reusable tags for future project and asset tagging.") }}

  {% if notice %}
    {% set noticeVariant = notice.variant %}
    {% set noticeText = notice.text %}
    {% include "partials/notice.njk" %}
  {% endif %}

  <div class="settings-layout">

    <div class="settings-content settings-tags-content">
      <div class="settings-section settings-tags-create-section">
        <h3>Create a tag</h3>
        {% if errorMessages.length > 0 %}
          <div class="error-summary" role="alert" id="tag-errors">
            <p>Could not create the tag. Fix the field below and try again.</p>
            <ul>
              {% for error in errorMessages %}<li>{{ error }}</li>{% endfor %}
            </ul>
          </div>
        {% endif %}

        <form id="create-tag-form" method="post" action="/settings/tags" class="project-form" novalidate>
          <input type="hidden" name="_csrf" value="{{ _csrf }}">
          <div class="field settings-tags-name-field{% if errors.name %} field-error{% endif %}">
            <label for="tag-name">Tag name <span class="required" aria-label="required">*</span></label>
            <div class="settings-tags-create-row">
              <input type="text" id="tag-name" name="name" value="{{ submittedName or '' }}" maxlength="{{ tagNameMax }}" required{% if errors.name %} aria-describedby="tag-name-error" aria-invalid="true"{% endif %}>
              <button type="submit" class="button button-primary">Create Tag</button>
            </div>
            {% if errors.name %}<span class="field-error-message" id="tag-name-error">{{ errors.name }}</span>{% endif %}
          </div>

        </form>
      </div>

      <div class="settings-section settings-tags-list-section">
        <h3>Tags</h3>
        {% if tags.length > 0 %}
          <ul class="settings-tag-list">
            {% for tag in tags %}
              <li class="settings-tag-row">
                <span class="settings-tag-name">{{ tag.display_name }}</span>
                <span class="settings-tag-actions">
                  <a href="/settings/tags/{{ tag.id }}/edit" class="button button-small button-secondary" aria-label="Rename tag {{ tag.display_name }}">Rename</a>
                  <a href="/settings/tags/{{ tag.id }}/delete" class="button button-small button-danger" aria-label="Delete tag {{ tag.display_name }}">Delete</a>
                </span>
              </li>
            {% endfor %}
          </ul>
        {% else %}
          {% set emptyHeading = "No tags yet" %}
          {% set emptyDescription = "Create a tag above to start building the catalog." %}
          {% include "partials/empty-state.njk" %}
        {% endif %}
      </div>
    </div>
  </div>
{% endblock %}
