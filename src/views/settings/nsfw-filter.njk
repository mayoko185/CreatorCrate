{#
  NSFW Filter section, rendered at the bottom of Settings > Defaults.
  The region stays a sibling of [data-settings-defaults-region] and outside
  the Defaults form, so each autosave replaces only its own region.
  Expects `nsfwFilter` ({ enabled, errors }) and `_csrf` in the context.
#}
{% import "partials/form-switch.njk" as formSwitch %}
<div class="settings-content settings-nsfw-filter-content" data-settings-nsfw-filter-region>
  <form method="post" action="/settings/nsfw-filter" class="project-form" novalidate>
    {% if nsfwFilter.errors.length > 0 %}
      <div class="error-summary" role="alert" id="nsfw-filter-errors">
        <p>NSFW Filter could not be saved. Fix the field below and try again.</p>
        <ul>
          {% for error in nsfwFilter.errors %}<li>{{ error }}</li>{% endfor %}
        </ul>
      </div>
    {% endif %}

    <input type="hidden" name="_csrf" value="{{ _csrf }}">
    <section id="defaults-nsfw-filter" class="settings-section" aria-labelledby="defaults-nsfw-filter-heading">
      <h3 id="defaults-nsfw-filter-heading">NSFW Filter</h3>
      <p class="help-text" id="nsfw-filter-help">Enabling the filter will add the <strong>NSFW</strong> tag as an available option if it does not already exist.</p>

      <div class="field field--switch{% if nsfwFilter.errors.length > 0 %} field-error{% endif %}">
        <span class="field-label">Enabled</span>
        {{ formSwitch.control(
          "nsfw-filter-enabled",
          "enabled",
          nsfwFilter.enabled,
          "NSFW filter enabled state",
          "nsfw-filter-help nsfw-filter-errors" if nsfwFilter.errors.length > 0 else "nsfw-filter-help",
          true if nsfwFilter.errors.length > 0 else false,
          false,
          "fetch",
          true,
          "Save"
        ) }}
        <p class="help-text" data-settings-fetch-save-status aria-live="polite" aria-atomic="true"></p>
      </div>
    </section>
  </form>
</div>
