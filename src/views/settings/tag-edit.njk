{% extends "layout.njk" %}
{% import "partials/page-heading.njk" as pageHeading %}

{% set page_title = "Settings — Rename Tag" %}

{% block content %}
  {{ pageHeading.render("Update the display name for this reusable tag.") }}

  {% if notice %}
    {% set noticeVariant = notice.variant %}
    {% set noticeText = notice.text %}
    {% include "partials/notice.njk" %}
  {% endif %}

  <div class="settings-layout">
    {% set activeSettingsSection = "tags" %}
    {% include "partials/settings-nav.njk" %}

    <div class="settings-content">
      <div class="settings-section">
        <h3>Rename tag</h3>
        <p class="help-text">Current tag: <strong>{{ tag.display_name }}</strong></p>

        {% if errorMessages.length > 0 %}
          <div class="error-summary" role="alert" id="tag-edit-errors">
            <p>Could not rename the tag. Fix the field below and try again.</p>
            <ul>
              {% for error in errorMessages %}<li>{{ error }}</li>{% endfor %}
            </ul>
          </div>
        {% endif %}

        <form method="post" action="/settings/tags/{{ tag.id }}/edit" class="project-form" novalidate>
          <input type="hidden" name="_csrf" value="{{ _csrf }}">
          <div class="field settings-tags-name-field{% if errors.name %} field-error{% endif %}">
            <label for="tag-name">Tag name <span class="required" aria-label="required">*</span></label>
            <input type="text" id="tag-name" name="name" value="{{ submittedName or '' }}" maxlength="{{ tagNameMax }}" required{% if errors.name %} aria-describedby="tag-name-error" aria-invalid="true"{% endif %}>
            {% if errors.name %}<span class="field-error-message" id="tag-name-error">{{ errors.name }}</span>{% endif %}
          </div>

          <div class="form-actions">
            <button type="submit" class="button button-primary">Rename Tag</button>
            <a href="/settings/tags" class="button button-secondary">Cancel</a>
          </div>
        </form>
      </div>
    </div>
  </div>
{% endblock %}
