{% extends "layout.njk" %}
{% import "partials/page-heading.njk" as pageHeading %}
{% import "partials/asset-browser-preference.njk" as assetBrowserPreferenceForm %}
{% import "partials/form-switch.njk" as formSwitch %}

{% set page_title = "Settings — Asset Categories" %}

{% block content %}
  {{ pageHeading.render("Global defaults copied into every new project.") }}
  <div class="settings-asset-categories-content">

  {% if notice %}
    {% set noticeVariant = notice.variant %}
    {% set noticeText = notice.text %}
    {% include "partials/notice.njk" %}
  {% endif %}

  <div class="settings-layout">

    <div class="settings-content">
      <div class="panel panel--info">
        <p>These are the global asset category defaults used only when a project is created — future projects will be seeded from whichever defaults are enabled here. Changing, disabling, or deleting a default here does <strong>not</strong> modify categories already copied into existing projects.</p>
      </div>

      {{ assetBrowserPreferenceForm.global(
        assetBrowserPreference,
        "/settings/asset-categories/browser-default",
        "global-asset-browser-default",
        _csrf
      ) }}

      {{ assetBrowserPreferenceForm.preview(
        previewCategory,
        "/settings/asset-categories/preview-category",
        "global-preview-category",
        _csrf
      ) }}

      <div class="settings-section category-management-section category-management-add settings-category-management-add">
        <h3>Add category</h3>
        {% if addErrors.displayName or addErrors.directorySlug or addErrors.enabled %}
          <div class="error-summary" role="alert" id="add-category-errors">
            <p>Could not add the category. Fix the fields below and try again.</p>
          </div>
        {% endif %}
        {% set addEnabled = true %}
        {% if addValues.enabled is defined %}{% set addEnabled = addValues.enabled %}{% endif %}
        <form method="post" action="/settings/asset-categories" class="project-form category-management-form" novalidate data-category-slug-autofill-form>
          <input type="hidden" name="_csrf" value="{{ _csrf }}">
          <div class="field-row category-management-add-row">
            <div class="field {% if addErrors.displayName %}field-error{% endif %}">
              <label for="add-displayName">Display name <span class="required" aria-label="required">*</span></label>
              <input type="text" id="add-displayName" name="displayName" value="{{ addValues.displayName or '' }}" maxlength="100" required data-category-slug-autofill-display-name aria-describedby="add-displayName-help{% if addErrors.displayName %} add-displayName-error{% endif %}"{% if addErrors.displayName %} aria-invalid="true"{% endif %}>
              <span class="help-text" id="add-displayName-help">Press Tab to fill Directory slug from Display name.</span>
              {% if addErrors.displayName %}<span class="field-error-message" id="add-displayName-error">{{ addErrors.displayName }}</span>{% endif %}
            </div>

            <div class="field {% if addErrors.directorySlug %}field-error{% endif %}">
              <label for="add-directorySlug">Directory slug <span class="required" aria-label="required">*</span></label>
              <input type="text" id="add-directorySlug" name="directorySlug" value="{{ addValues.directorySlug or '' }}" maxlength="100" required data-category-slug-autofill-directory-slug{% if addErrors.directorySlug %} aria-describedby="add-directorySlug-error" aria-invalid="true"{% endif %}>
              <span class="help-text">Lowercase letters, numbers, and single hyphens only.</span>
              {% if addErrors.directorySlug %}<span class="field-error-message" id="add-directorySlug-error">{{ addErrors.directorySlug }}</span>{% endif %}
            </div>

            <div class="form-actions category-management-add-submit">
              <button type="submit" class="button button-primary">Add</button>
            </div>

            <div class="field field--switch">
              <span class="field-label">Enabled</span>
              {{ formSwitch.control(
                "add-enabled",
                "enabled",
                addEnabled,
                "New global category enabled state",
                "add-enabled-error" if addErrors.enabled else null,
                true if addErrors.enabled else false
              ) }}
              {% if addErrors.enabled %}<span class="field-error-message" id="add-enabled-error">{{ addErrors.enabled }}</span>{% endif %}
            </div>
          </div>
        </form>
      </div>

      <div class="settings-section category-management-section category-management-list-section settings-category-management-section">
        <h3>Current defaults</h3>
        {% if categories.length > 0 %}
          <form id="settings-category-reorder-form" method="post" action="/settings/asset-categories/reorder" class="category-reorder-form" data-category-reorder-form>
            <input type="hidden" name="_csrf" value="{{ _csrf }}">
            <input type="hidden" name="orderedCategoryIds" data-category-order-input value="">
          </form>

          <div
            class="category-reorder-list"
            role="list"
            aria-label="Global asset category defaults"
            data-category-reorder-list
            data-reorder-url="/settings/asset-categories/reorder"
            data-reorder-form-target="settings-category-reorder-form">
            {% for category in categories %}
              {% set rowEnabled = category.enabled %}
              {% set rowEnabledError = null %}
              {% if enabledControl and enabledControl.categoryId == category.id %}
                {% if enabledControl.submitted is not none %}{% set rowEnabled = enabledControl.submitted %}{% endif %}
                {% set rowEnabledError = enabledControl.errorMessage %}
              {% endif %}
              {% set rowEnabledErrorId = "global-category-" ~ category.id ~ "-enabled-error" %}
              {% set rowEditErrors = {} %}
              {% set rowDisplayName = category.display_name %}
              {% set rowDirectorySlug = category.directory_slug %}
              {% if editingId and editingId == category.id %}
                {% set rowEditErrors = editErrors %}
                {% set rowDisplayName = editValues.displayName %}
                {% set rowDirectorySlug = editValues.directorySlug %}
              {% endif %}
              {% set rowDisplayNameId = "global-category-" ~ category.id ~ "-display-name" %}
              {% set rowDisplayNameErrorId = rowDisplayNameId ~ "-error" %}
              {% set rowDirectorySlugId = "global-category-" ~ category.id ~ "-directory-slug" %}
              {% set rowDirectorySlugErrorId = rowDirectorySlugId ~ "-error" %}
              <article
                class="category-management-card"
                role="listitem"
                data-category-id="{{ category.id }}"
                data-category-label="{{ category.display_name }}"
                data-category-reorder-item
                draggable="true"
                aria-posinset="{{ loop.index }}"
                aria-setsize="{{ categories.length }}">
                <button
                  type="button"
                  class="category-reorder-handle"
                  data-category-reorder-handle
                  draggable="true"
                  aria-label="Reorder {{ category.display_name }}"
                  title="Drag to reorder">
                  <span aria-hidden="true">⠿</span>
                </button>

                <div class="category-management-card-body">
                  <form method="post" action="/settings/asset-categories/{{ category.id }}" class="category-details-form" novalidate data-category-details-form data-category-details-id="{{ category.id }}">
                    <input type="hidden" name="_csrf" value="{{ _csrf }}">
                    {% if rowEditErrors.displayName or rowEditErrors.directorySlug %}
                      <div class="error-summary" role="alert" id="global-category-{{ category.id }}-details-errors">
                        <p>Could not save this category. Fix the fields below and try again.</p>
                      </div>
                    {% endif %}
                    <div class="category-management-card-fields">
                      <div class="category-management-card-field category-management-name{% if rowEditErrors.displayName %} field-error{% endif %}">
                        <label for="{{ rowDisplayNameId }}">Display name <span class="required" aria-label="required">*</span></label>
                        <input type="text" id="{{ rowDisplayNameId }}" name="displayName" value="{{ rowDisplayName }}" maxlength="100" required{% if rowEditErrors.displayName %} aria-describedby="{{ rowDisplayNameErrorId }}" aria-invalid="true"{% endif %}>
                        {% if rowEditErrors.displayName %}<span class="field-error-message" id="{{ rowDisplayNameErrorId }}" role="alert">{{ rowEditErrors.displayName }}</span>{% endif %}
                      </div>

                      <div class="category-management-card-field category-management-slug{% if rowEditErrors.directorySlug %} field-error{% endif %}">
                        <label for="{{ rowDirectorySlugId }}">Directory slug <span class="required" aria-label="required">*</span></label>
                        <input type="text" id="{{ rowDirectorySlugId }}" name="directorySlug" value="{{ rowDirectorySlug }}" maxlength="100" required{% if rowEditErrors.directorySlug %} aria-describedby="{{ rowDirectorySlugErrorId }}" aria-invalid="true"{% endif %}>
                        {% if rowEditErrors.directorySlug %}<span class="field-error-message" id="{{ rowDirectorySlugErrorId }}" role="alert">{{ rowEditErrors.directorySlug }}</span>{% endif %}
                      </div>
                    </div>
                    <span class="sr-only" data-category-details-status aria-live="polite" aria-atomic="true"></span>
                    <noscript>
                      <div class="category-management-details-actions">
                        <button type="submit" class="button button-small button-secondary">Save details</button>
                      </div>
                    </noscript>
                  </form>

                  <div class="category-management-card-controls">
                    <div class="category-management-enabled">
                      <form method="post" action="/settings/asset-categories/{{ category.id }}/enabled" class="category-enabled-form">
                        <input type="hidden" name="_csrf" value="{{ _csrf }}">
                        {{ formSwitch.control(
                          "global-category-enabled-" ~ category.id,
                          "enabled",
                          rowEnabled,
                          "Category " ~ category.display_name ~ " enabled state",
                          rowEnabledErrorId if rowEnabledError else null,
                          true if rowEnabledError else false,
                          false,
                          true,
                          true
                        ) }}
                      </form>
                      {% if rowEnabledError %}<span class="field-error-message" id="{{ rowEnabledErrorId }}" role="alert">{{ rowEnabledError }}</span>{% endif %}
                    </div>

                    <div class="category-management-actions">
                      <form method="post" action="/settings/asset-categories/{{ category.id }}/delete" class="inline-form">
                        <input type="hidden" name="_csrf" value="{{ _csrf }}">
                        <button type="submit" class="button button-small button-danger" data-confirm="Delete this default category? Categories already copied into existing projects are not affected.">Delete</button>
                      </form>
                    </div>
                  </div>
                </div>
              </article>
            {% endfor %}
          </div>
          <div class="category-reorder-live-region sr-only" data-category-reorder-live aria-live="polite" aria-atomic="true"></div>
        {% else %}
          {% set emptyHeading = "No asset category defaults" %}
          {% set emptyDescription = "Add a default above to have it copied into newly created projects." %}
          {% include "partials/empty-state.njk" %}
        {% endif %}
      </div>
    </div>
  </div>
  </div>
{% endblock %}
