{% extends "layout.njk" %}
{% import "partials/page-heading.njk" as pageHeading %}
{% import "partials/asset-browser-preference.njk" as assetBrowserPreferenceForm %}

{% set page_title = "Settings — Defaults" %}

{% block content %}
  {{ pageHeading.render("Choose persistent defaults for new projects, new releases, Projects, Release Management, Published Work, project Assets, and the Asset Viewer.") }}

  {% if notice %}
    {% set noticeVariant = notice.variant %}
    {% set noticeText = notice.text %}
    {% include "partials/notice.njk" %}
  {% endif %}

  <div class="settings-layout">
    {% set activeSettingsSection = "defaults" %}
    {% include "partials/settings-nav.njk" %}

    <div class="settings-content">
      {% if hasErrors %}
        <div class="error-summary" role="alert" id="defaults-errors">
          <p>Defaults could not be saved. Fix the highlighted fields and try again.</p>
          <ul>
            {% for error in errorMessages %}<li>{{ error }}</li>{% endfor %}
          </ul>
        </div>
      {% endif %}

      <form method="post" action="/settings/defaults" class="project-form" novalidate>
        <input type="hidden" name="_csrf" value="{{ _csrf }}">

        {% for section in sections %}
          <div class="form-section">
            <h2>{{ section.title }}</h2>
            {% if section.page == 'new_release' %}
              <p class="help-text">This default applies only to newly created release records. Changing it does not modify existing releases.</p>
            {% elseif section.page == 'new_project' %}
              <p class="help-text">These defaults apply only to new projects. Changing them does not modify existing projects.</p>
            {% endif %}

            {% for field in section.fields %}
              <div class="field{% if field.error %} field-error{% endif %}">
                <label for="{{ field.id }}">{{ field.label }}</label>
                <select id="{{ field.id }}" name="{{ field.name }}" required{% if field.error %} aria-describedby="{{ field.id }}-error" aria-invalid="true"{% endif %}>
                  {% if field.showSubmittedValue %}
                    <option value="{{ field.submittedOptionValue }}" selected>Submitted value: {{ field.submittedDisplayValue }}</option>
                  {% elif field.error %}
                    <option value="" selected>Select a value</option>
                  {% endif %}
                  {% for option in field.options %}
                    <option value="{{ option.value }}"{% if option.value == field.selectedValue %} selected{% endif %}>{{ option.label }}</option>
                  {% endfor %}
                </select>
                {% if field.usesFallback %}
                  <span class="help-text">Application fallback: <strong>{{ field.fallbackLabel }}</strong></span>
                {% else %}
                  <span class="help-text">Saved default: <strong>{{ field.savedLabel }}</strong></span>
                {% endif %}
                {% if field.error %}<span class="field-error-message" id="{{ field.id }}-error">{{ field.error }}</span>{% endif %}
              </div>
            {% endfor %}

            {% if section.page == 'projectAssets' %}
              <section class="settings-section asset-browser-default-section" aria-labelledby="project-assets-default-category-heading">
                <h3 id="project-assets-default-category-heading">Asset browser default</h3>
                <p class="asset-browser-default-description" id="project-assets-default-category-help">
                  For projects set to <strong>Inherit global default</strong>. This does not recopy project categories;
                  unavailable matches fall back to <strong>All Categories</strong>.
                </p>

                {% if assetBrowserPreference.warning %}
                  <div class="notice notice--warning" role="status" id="project-assets-default-category-warning">
                    <p>{{ assetBrowserPreference.warning }}</p>
                  </div>
                {% endif %}

                {% if assetBrowserPreference.errorMessage %}
                  <div class="error-summary" role="alert" id="project-assets-default-category-error">
                    <p>Could not save the global asset browser default. {{ assetBrowserPreference.errorMessage }}</p>
                  </div>
                {% endif %}

                <p class="asset-browser-default-summary">
                  <span><span class="asset-browser-default-summary-label">Saved:</span> <strong>{{ assetBrowserPreference.storedLabel }}</strong></span>
                  {% if assetBrowserPreference.fallback %}
                    <span><span class="asset-browser-default-summary-label">Effective:</span> <strong>All Categories</strong> for inheriting projects</span>
                  {% endif %}
                </p>

                <div class="asset-browser-default-control-row">
                  <div class="field asset-browser-default-field-row{% if assetBrowserPreference.errorMessage %} field-error{% endif %}">
                    {{ assetBrowserPreferenceForm.globalControl(assetBrowserPreference, "project-assets-default-category", "defaultCategory") }}
                    <span class="help-text" id="project-assets-default-category-help-text">Category labels are shown here; the stable directory slug is stored.</span>
                    {% if assetBrowserPreference.errorMessage %}<span class="field-error-message" id="project-assets-default-category-error-message">{{ assetBrowserPreference.errorMessage }}</span>{% endif %}
                  </div>
                </div>
              </section>
            {% endif %}
          </div>
        {% endfor %}

        <div class="form-actions">
          <button type="submit" class="button button-primary">Save Defaults</button>
          <a href="/settings" class="button button-secondary">Cancel</a>
        </div>
      </form>
    </div>
  </div>
{% endblock %}
