{% extends "layout.njk" %}
{% import "partials/page-heading.njk" as pageHeading %}
{% import "partials/dropdown.njk" as dropdown %}

{% set page_title = "Settings — Defaults" %}

{% block content %}
  {{ pageHeading.render("Choose persistent defaults for new projects.") }}

  {% if notice %}
    {% set noticeVariant = notice.variant %}
    {% set noticeText = notice.text %}
    {% include "partials/notice.njk" %}
  {% endif %}

  <div class="settings-layout settings-defaults-layout">

    <div class="settings-content settings-defaults-content" data-settings-defaults-region>
      {% if hasErrors %}
        <div class="error-summary" role="alert" id="defaults-errors">
          <p>Defaults could not be saved. Fix the highlighted fields and try again.</p>
          <ul>
            {% for error in errorMessages %}<li>{{ error }}</li>{% endfor %}
          </ul>
        </div>
      {% endif %}

      <form id="settings-defaults-form" method="post" action="/settings/defaults" class="project-form settings-defaults-form" novalidate>
        <input type="hidden" name="_csrf" value="{{ _csrf }}">

        {% for section in sections %}
          <section id="{{ section.anchor }}" class="settings-section settings-defaults-section" aria-labelledby="{{ section.anchor }}-heading">
            <h3 id="{{ section.anchor }}-heading">{{ section.title }}</h3>
            {% if section.page == 'new_project' %}
              <p class="help-text">These defaults apply only to new projects. Changing them does not modify existing projects.</p>
            {% endif %}

            {% for field in section.fields %}
              <div class="field{% if field.error %} field-error{% endif %}">
                {% if section.page == 'new_project' %}
                  {% set submittedOption = none %}
                  {% set nativeAttributes = [["required", true], ["data-autosubmit", "fetch"]] %}
                  {% set summaryAttributes = [] %}
                  {% if field.showSubmittedValue %}
                    {% set submittedOption = {
                      id: field.id ~ '-submitted',
                      value: field.submittedOptionValue,
                      label: 'Submitted value: ' ~ field.submittedDisplayValue,
                      selected: true
                    } %}
                  {% endif %}
                  {% if field.error %}
                    {% set nativeAttributes = [["required", true], ["data-autosubmit", "fetch"], ["aria-describedby", field.id ~ '-error'], ["aria-invalid", "true"]] %}
                    {% set summaryAttributes = [["aria-describedby", field.id ~ '-error'], ["aria-invalid", "true"]] %}
                  {% endif %}
                  {{ dropdown.singleSelect({
                    id: field.id ~ '-dropdown',
                    name: field.name,
                    label: field.label,
                    options: field.options,
                    selected: field.selectedValue if not field.error or field.showSubmittedValue else none,
                    placeholder: 'Select a value' if field.error and not field.showSubmittedValue else none,
                    optionIdPrefix: field.id,
                    leadingOption: submittedOption,
                    summaryAttributes: summaryAttributes,
                    dispatchNativeChange: true,
                    nativeSelect: {
                      id: field.id,
                      attributes: nativeAttributes
                    }
                  }) }}
                {% else %}
                  <label for="{{ field.id }}">{{ field.label }}</label>
                  <select id="{{ field.id }}" name="{{ field.name }}" required{% if field.error %} aria-describedby="{{ field.id }}-error" aria-invalid="true"{% endif %}>
                    {% if field.showSubmittedValue %}
                      <option value="{{ field.submittedOptionValue }}" selected>Submitted value: {{ field.submittedDisplayValue }}</option>
                    {% elif field.error %}
                      <option value="" selected>Select a value</option>
                    {% endif %}
                    {% for option in field.options %}
                      <option value="{{ option.value }}"{% if option.value == field.selectedValue %} selected{% endif %}>{{ option.label }}</option>
                    {% endfor %}
                  </select>
                {% endif %}
                {% if field.usesFallback %}
                  <span class="help-text" data-settings-defaults-effective>Application fallback: <strong>{{ field.fallbackLabel }}</strong></span>
                {% else %}
                  <span class="help-text" data-settings-defaults-effective>Saved default: <strong>{{ field.savedLabel }}</strong></span>
                {% endif %}
                {% if field.error %}<span class="field-error-message" id="{{ field.id }}-error">{{ field.error }}</span>{% endif %}
              </div>
            {% endfor %}

          </section>
        {% endfor %}

        <span class="help-text" data-settings-fetch-save-status role="status" aria-live="polite" aria-atomic="true"></span>

        <noscript>
          <div class="form-actions">
            <button type="submit" class="button button-primary">Save Defaults</button>
          </div>
        </noscript>
      </form>
    </div>
  </div>
{% endblock %}
