{% extends "layout.njk" %}
{% import "partials/page-heading.njk" as pageHeading %}
{% import "partials/icons.njk" as icons %}
{% import "partials/asset-presentation.njk" as assetCards %}
{% import "partials/view-switcher.njk" as viewSwitcher %}
{% import "partials/release-edit-dialog.njk" as releaseEditDialog %}
{% import "partials/release-signatures-dialog.njk" as releaseSignaturesDialog %}
{% import "partials/release-publish-dialog.njk" as releasePublishDialog %}

{% set page_title = "Releases — " ~ release.title %}
{% set assetVideoPreview = true %}

{% block body_class %}refined-page{% endblock %}

{% macro releaseAssetMetadata(asset, includeCategory=true) %}
  <div class="release-asset-card-details">
    {% set role = asset.releaseContext.role or 'attachment' %}
    <span class="release-asset-card-detail"><strong>Role</strong> {{ role | title }}</span>
    {% if asset.releaseContext.sortOrder is not none %}
      <span class="release-asset-card-detail"><strong>Order</strong> {{ asset.releaseContext.sortOrder }}</span>
    {% endif %}
    {% if includeCategory and asset.categoryLabel %}
      <span class="release-asset-card-detail"><strong>Category</strong> {{ asset.categoryLabel }}{% if asset.categoryDisabled %} (disabled){% endif %}</span>
    {% endif %}
    {% if asset.relative_path %}
      <span class="release-asset-card-detail release-asset-card-path"><strong>Path</strong> <code>{{ asset.relative_path }}</code></span>
    {% endif %}
  </div>
{% endmacro %}

{% macro releaseGridCard(asset, clockFormat) %}
  {% call(slot) assetCards.gridCard(asset, { filenameLink: true, clockFormat: clockFormat }) %}
    {% if slot == 'body' %}
      {{ releaseAssetMetadata(asset) }}
    {% endif %}
  {% endcall %}
{% endmacro %}

{# List row — the shared column List, read-only: Order and Role come from
   the release selection. The title opens the shared list information card,
   which adds the release Role and stored Order; navigation stays on the
   thumbnail and the card's Open asset action. #}
{% macro releaseListCard(asset, clockFormat, columns) %}
  {% set detailId = 'release-asset-list-info-' ~ asset.id %}
  {% call(slot) assetCards.listCard(asset, { columns: columns, cardClass: 'asset-list-card--release', clockFormat: clockFormat, titleInfoId: detailId }) %}
    {% if slot == 'order' and asset.releaseContext.sortOrder is not none %}
      {{ asset.releaseContext.sortOrder }}
    {% elif slot == 'role' %}
      {{ (asset.releaseContext.role or 'attachment') | title }}
    {% elif slot == 'title-info' %}
      {% call(cardSlot) assetCards.listInfoCard(asset, detailId) %}
        {% if cardSlot == 'facts' %}
          <div class="asset-viewer-grid-card-info-row"><dt>Role</dt><dd>{{ (asset.releaseContext.role or 'attachment') | title }}</dd></div>
          <div class="asset-viewer-grid-card-info-row"><dt>Order</dt><dd>{{ asset.releaseContext.sortOrder if asset.releaseContext.sortOrder is not none else '—' }}</dd></div>
        {% endif %}
      {% endcall %}
    {% elif slot == 'asset' and asset.relative_path %}
      <code class="asset-list-card-path" title="{{ asset.relative_path }}">{{ asset.relative_path }}</code>
    {% endif %}
  {% endcall %}
{% endmacro %}

{% block content %}
  {% set releaseArchived = release and release.archived_at %}
  {% set isPublished = release and release.published_date %}
  {% set isArchived = projectArchived or releaseArchived %}
  {% set projectLeadHref = "/projects/" ~ project.id if project and project.id else "" %}
  {% set releaseNavItems = [
    { key: "project", href: projectLeadHref, label: "Project", tooltip: "Go to project details" },
    { key: "assets", href: projectLeadHref ~ "/assets", label: "Assets", tooltip: "Go to project assets" }
  ] if projectLeadHref else none %}
  {# Regions marked data-release-detail-region depend on editable release
     fields; release-detail-refresh.js replaces each one from a fresh render
     of this page (identified by data-release-detail) after an Edit Release
     save. While the release is editable every region renders its wrapper, so
     a refresh always finds the same set. #}
  <div class="release-detail-region" data-release-detail-region="heading" data-release-detail="{{ release.id }}">
  {% if isArchived %}
    {{ pageHeading.render("", "archived", "Archived", navItems=releaseNavItems) }}
  {% else %}
    {% call pageHeading.render(navItems=releaseNavItems) %}
      {% if not isPublished %}
        <a class="button button-small button-primary project-detail-action project-assets-heading-action asset-tooltip asset-tooltip--left"
           href="/releases/{{ release.id }}/publish" data-dialog-open="release-publish-dialog"
           aria-label="Review &amp; Publish" data-tooltip="Review &amp; Publish">
          {{ icons.icon('share-2') }}
        </a>
      {% endif %}
    {% endcall %}

  {% endif %}
  </div>

  <div class="release-detail-region" data-release-detail-region="notices">
  {% if projectArchived %}
    {% set noticeVariant = "warning" %}
    {% set noticeText = "The parent project is archived. This release is read-only." %}
    {% include "partials/notice.njk" %}
  {% endif %}

  {% if releaseArchived %}
    {% set noticeVariant = "warning" %}
    {% set noticeText = "This release is archived and read-only." %}
    {% include "partials/notice.njk" %}
  {% endif %}

  {% if isPublished and not isArchived %}
    {% set noticeVariant = "success" %}
    {% set noticeText = "This release is published. The asset selection is locked and reflects the state at the time of publication. Asset presence is based on the last completed scan — this is not a live filesystem check." %}
    {% include "partials/notice.njk" %}
  {% endif %}
  </div>

  {% if errors.general %}
    <div class="error-summary" role="alert">
      <p>{{ errors.general }}</p>
    </div>
  {% endif %}
  <div class="notice notice--success app-dialog-feedback" data-dialog-feedback role="status" hidden>
    <p data-dialog-feedback-text></p>
  </div>

  <div class="project-detail-summary">
    {% if not isArchived %}
      <div class="project-detail-meta">
        <nav class="project-detail-action-toolbar" aria-label="Release actions">
          {# The Edit action stays outside the region, so a refresh keeps it
             (and the Edit dialog's focus return) in place. #}
          <span class="release-detail-region" data-release-detail-region="asset-actions">
          {% if not isPublished %}
            <a class="button button-small button-secondary project-detail-action asset-tooltip asset-tooltip--right"
               href="/releases/{{ release.id }}/assets" aria-label="Manage Assets" data-tooltip="Manage Assets">
              {{ icons.icon('assets') }}
            </a>
          {% endif %}
          </span>
          <a class="button button-small button-secondary project-detail-action asset-tooltip asset-tooltip--right"
             href="/releases/{{ release.id }}?edit=1" data-release-edit-id="{{ release.id }}" aria-label="Edit release" data-tooltip="Edit release">
            {{ icons.icon('edit') }}
          </a>
        </nav>
      </div>
    {% endif %}

  {# ─── Release details ───────────────────────────────────────────── #}
  {# data-release-link is the saved Release link this render shows; a refresh
     compares it with an open Edit Release dialog's loaded value. #}
  <div class="release-detail-region" data-release-detail-region="details" data-release-link="{{ release.patreon_url or '' }}">
  <section class="project-detail-info project-detail-section">
    <h2>Release details</h2>
    <div class="project-detail-section-body">
      <div class="project-detail-meta">
        {% set status = project.status if project else release.project_status %}{% include "partials/status-badge.njk" %}
        {% if isPublished %}
          <span class="status-badge status-badge--success">Published</span>
        {% endif %}
      </div>
      <dl class="detail-list release-detail-list">
        {% if project %}
          <dt>Project</dt>
          <dd><a href="/projects/{{ project.id }}">{{ project.title }}</a></dd>
        {% endif %}

        {% if release.planned_date %}
          <dt>Planned date</dt>
          <dd>{{ release.planned_date }} <small>(release target)</small></dd>
        {% endif %}

        {% if release.published_date %}
          <dt>Published date</dt>
          <dd>{{ release.published_date }} <small>(release published)</small></dd>
        {% endif %}

        {% if release.patreon_url %}
          <dt>Release link</dt>
          <dd><a href="{{ release.patreon_url }}" target="_blank" rel="noopener">{{ release.patreon_url }}</a> <small>(release link)</small></dd>
        {% endif %}

        <dt>Created</dt>
        <dd>{{ release.created_at | formatSqliteTimestamp(clockFormat) }}</dd>

        <dt>Updated</dt>
        <dd>{{ release.updated_at | formatSqliteTimestamp(clockFormat) }}</dd>

        {% if release.archived_at %}
          <dt>Archived</dt>
          <dd>{{ release.archived_at | formatSqliteTimestamp(clockFormat) }}</dd>
        {% endif %}

        <dt>Selected assets</dt>
        <dd>{{ assetCount }}</dd>
      </dl>
    </div>
  </section>
  </div>

  <div class="release-detail-region" data-release-detail-region="social-preparation">
  {% include "partials/release-social-prep-detail.njk" %}
  </div>

  <div class="release-detail-region" data-release-detail-region="text">
  {% if release.description %}
    <section class="project-detail-section">
      <h2>Description</h2>
      <div class="project-detail-section-body">
        <p class="description">{{ release.description }}</p>
      </div>
    </section>
  {% endif %}

  {% if release.notes %}
    <section class="project-detail-section">
      <h2>Notes</h2>
      <div class="project-detail-section-body">
        <p class="notes">{{ release.notes }}</p>
      </div>
    </section>
  {% endif %}
  </div>

  <section class="asset-browser-layout" aria-label="Selected assets" data-selected-assets>
    <div class="asset-browser-content">
      {% set selectedAssets = assetPresentation.selected or [] %}
      <div class="asset-viewer-display-controls">
        {{ viewSwitcher.render(view, pageUrl, "Asset display", true) }}
        {% set assetGridStyleScreen = 'release-detail' %}
        {% include "partials/asset-grid-style-control.njk" %}
      </div>
      <p class="results-meta">{{ assetCount }} selected asset{% if assetCount != 1 %}s{% endif %}</p>
      {% if selectedAssets.length > 0 %}
        {% if view == 'grid' %}
          <ul class="asset-grid" role="listbox" aria-label="Selected release assets">
            {% for asset in selectedAssets %}
              <li class="asset-grid-item{% if not asset.is_present %} is-missing{% endif %}">
                {{ releaseGridCard(asset, clockFormat) }}
              </li>
            {% endfor %}
          </ul>
        {% else %}
          {% set listColumns = ['order', 'asset', 'category', 'role', 'type', 'presence', 'size', 'modified'] %}
          {% call assetCards.listTable(listColumns, 'Selected release asset table') %}
          <ul class="asset-list asset-list--release" role="list" aria-label="Selected release assets">
            {% for asset in selectedAssets %}
              <li class="asset-list-item{% if not asset.is_present %} is-missing{% endif %}">
                {{ releaseListCard(asset, clockFormat, listColumns) }}
              </li>
            {% endfor %}
          </ul>
          {% endcall %}
        {% endif %}
      {% else %}
        {% set emptyHeading = "No assets selected" %}
        {% set emptyDescription = "No assets are associated with this release." %}
        {% set emptyHeadingLevel = "h3" %}
        {% include "partials/empty-state.njk" %}
      {% endif %}
    </div>
  </section>

  {# ─── Published summary ──────────────────────────────────────────── #}
  <div class="release-detail-region" data-release-detail-region="publication">
  {% if isPublished and not isArchived %}
    <section class="project-detail-section release-publication-summary">
      <h2>Publication summary</h2>
      <div class="project-detail-section-body">
        <p class="publication-summary-badge publication-summary-published">Published</p>
        <ul class="publication-summary-checks">
          <li class="publication-summary-check publication-summary-check-passed">
            <span class="publication-summary-check-icon">&#10003;</span>
            <span class="publication-summary-check-label">Asset selection locked</span>
            <span class="publication-summary-check-detail">The selected assets, roles, and order are final</span>
          </li>
          <li class="publication-summary-check publication-summary-check-passed">
            <span class="publication-summary-check-icon">&#10003;</span>
            <span class="publication-summary-check-label">Published date</span>
            <span class="publication-summary-check-detail">{{ release.published_date }}</span>
          </li>
        </ul>
        <p class="publication-summary-note">
          Asset presence reflects the last completed scan. This page is not performing a live filesystem check.
        </p>
      </div>
    </section>
  {% endif %}
  </div>

  </div>
{% endblock %}

{% block overlay %}
  {% set overlayIsArchived = release.archived_at or projectArchived %}
  {% set overlayIsPublished = release.published_date %}

  {% if not overlayIsArchived %}
    {# The shared async Edit Release dialog (release-edit-dialog.js); saves stay
       on this page. #}
    {{ releaseEditDialog.render(release, releaseEditForm, _csrf, releaseSignatureConfiguration, platformChoices, clockFormat, '', editDeepLink) }}
    {{ releaseSignaturesDialog.render(releaseSignatureConfiguration, _csrf) }}
  {% endif %}

  {# Review & Publish follows the publication state and the saved title and
     platforms, so a refresh replaces it too (never while it is open). #}
  <div class="release-detail-region" data-release-detail-region="publish-dialog">
  {% if not overlayIsArchived and not overlayIsPublished %}
    {{ releasePublishDialog.render(release, project, releaseAssets, publishDialogForm, socialPrepPublish, _csrf, publishDialogOpen, publishProjectStatus) }}
  {% endif %}
  </div>
{% endblock %}
