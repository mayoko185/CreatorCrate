{% extends "layout.njk" %}
{% import "partials/page-heading.njk" as pageHeading %}

{% set page_title = "Releases — " ~ release.title %}

{% block content %}
  {% set projectArchived = project and project.archived_at %}
  {% set releaseArchived = release and release.archived_at %}
  {% set isPublished = release and release.status == 'published' %}
  {% set isArchived = projectArchived or releaseArchived %}
  {% if not projectArchived and not releaseArchived %}
    {% call pageHeading.render("Release record") %}
      <a class="button" href="/releases/{{ release.id }}/edit">Edit</a>
    {% endcall %}
  {% else %}
    {{ pageHeading.render("Release record", "archived", "Archived") }}
  {% endif %}

  {% if projectArchived %}
    {% set noticeVariant = "warning" %}
    {% set noticeText = "The parent project is archived. This release is read-only." %}
    {% include "partials/notice.njk" %}
  {% endif %}

  {% if releaseArchived %}
    {% set noticeVariant = "warning" %}
    {% set noticeText = "This release is archived and read-only." %}
    {% include "partials/notice.njk" %}
  {% endif %}

  {% if isPublished and not isArchived %}
    {% set noticeVariant = "success" %}
    {% set noticeText = "This release is published. The asset selection is locked and reflects the state at the time of publication. Asset presence is based on the last completed scan — this is not a live filesystem check." %}
    {% include "partials/notice.njk" %}
  {% endif %}

  {% if errors.general %}
    <div class="error-summary" role="alert">
      <p>{{ errors.general }}</p>
    </div>
  {% endif %}

  {% if errors.readiness %}
    <div class="error-summary" role="alert">
      <p>Cannot publish due to the following blockers:</p>
      <ul>
        {% for key, details in errors.readiness %}
          <li>
            {% if key == 'status_ready' %}
              Status is "{{ details.status }}", must be "ready".
            {% elif key == 'assets_selected' %}
              No assets selected ({{ details.selectedAssetCount }} selected).
            {% elif key == 'selected_assets_present' %}
              {{ details.missingSelectedAssetCount }} selected asset(s) are missing.
            {% elif key == 'scope_mutable' %}
              {% if details.releaseArchived %}Release is archived.{% elif details.projectArchived %}Parent project is archived.{% endif %}
            {% else %}
              {{ key }}: {{ details | dump }}
            {% endif %}
          </li>
        {% endfor %}
      </ul>
    </div>
  {% endif %}

  {# ─── Release identity ───────────────────────────────────────────── #}
  <section>
    <dl class="detail-list">
      {% if project %}
        <dt>Project</dt>
        <dd><a href="/projects/{{ project.id }}">{{ project.title }}</a></dd>
      {% endif %}

      <dt>Status</dt>
      <dd>{% set status = release.status %}{% include "partials/status-badge.njk" %}</dd>

      {% if release.planned_date %}
        <dt>Planned date</dt>
        <dd>{{ release.planned_date }} <small>(release target)</small></dd>
      {% endif %}

      {% if release.published_date %}
        <dt>Published date</dt>
        <dd>{{ release.published_date }} <small>(release published)</small></dd>
      {% endif %}

      {% if release.patreon_url %}
        <dt>Patreon URL</dt>
        <dd><a href="{{ release.patreon_url }}" target="_blank" rel="noopener">{{ release.patreon_url }}</a> <small>(release link)</small></dd>
      {% endif %}

      <dt>Created</dt>
      <dd>{{ release.created_at }}</dd>

      <dt>Updated</dt>
      <dd>{{ release.updated_at }}</dd>

      {% if release.archived_at %}
        <dt>Archived</dt>
        <dd>{{ release.archived_at }}</dd>
      {% endif %}
    </dl>
  </section>

  {# ─── Assets ──────────────────────────────────────────────────────── #}
  <section>
    <h2>Assets</h2>
    <p>
      {% if not projectArchived and not releaseArchived and not isPublished %}
        <a class="button" href="/releases/{{ release.id }}/assets">Manage Assets</a>
      {% endif %}
      <span class="meta">{{ assetCount }} asset{% if assetCount != 1 %}s{% endif %} selected</span>
    </p>
  </section>

  {% if release.description %}
    <section>
      <h2>Description</h2>
      <p class="description">{{ release.description }}</p>
    </section>
  {% endif %}

  {% if release.notes %}
    <section>
      <h2>Notes</h2>
      <p class="notes">{{ release.notes }}</p>
    </section>
  {% endif %}

  {% if releaseAssets.length > 0 %}
    <section>
      <h2>Selected Assets</h2>
      <div class="table-scroll" tabindex="0" aria-label="Selected release assets">
        <table class="data-table">
          <thead>
            <tr>
              <th>Filename</th>
              <th>Role</th>
              <th>Path</th>
              <th>Status</th>
              {% if not projectArchived and not releaseArchived and not isPublished %}
                <th>Actions</th>
              {% endif %}
            </tr>
          </thead>
          <tbody>
            {% for ra in releaseAssets %}
              <tr>
                <td class="asset-filename">{{ ra.filename }}</td>
                <td>{{ ra.role | title }}</td>
                <td class="asset-path"><code>{{ ra.relative_path }}</code></td>
                <td>
                  {% if ra.is_present == 1 %}
                    {% set status = 'present' %}{% include "partials/status-badge.njk" %}
                  {% else %}
                    {% set status = 'missing' %}{% include "partials/status-badge.njk" %}
                  {% endif %}
                </td>
                {% if not projectArchived and not releaseArchived and not isPublished %}
                  <td class="row-actions">
                    {% if ra.is_present == 0 %}
                      <form method="post" action="/releases/{{ release.id }}/assets/{{ ra.asset_id }}/remove" class="inline-form">
                        <input type="hidden" name="_csrf" value="{{ _csrf }}">
                        <button class="button button-danger button-small" type="submit" data-confirm="Remove this missing asset from the release?">Remove</button>
                      </form>
                    {% endif %}
                  </td>
                {% endif %}
              </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
    </section>
  {% endif %}

  {# ─── Published summary ──────────────────────────────────────────── #}
  {% if isPublished and not isArchived %}
    <section class="panel panel--summary">
      <h2>Publication Summary</h2>
      <p class="readiness-badge readiness-publishable">Published</p>
      <ul class="readiness-checks">
        <li class="readiness-check check-passed">
          <span class="check-icon">&#10003;</span>
          <span class="check-label">Asset selection locked</span>
          <span class="check-detail">The selected assets, roles, and order are final</span>
        </li>
        <li class="readiness-check check-passed">
          <span class="check-icon">&#10003;</span>
          <span class="check-label">Published date</span>
          <span class="check-detail">{{ release.published_date }}</span>
        </li>
      </ul>
      <p class="readiness-note">
        Asset presence reflects the last completed scan. This page is not performing a live filesystem check.
      </p>
    </section>
  {% endif %}

  {# ─── Readiness ───────────────────────────────────────────────────── #}
  {% if readiness %}
    <section class="panel panel--readiness">
      <h2>Readiness</h2>

      {% if readiness.publishable %}
        <p class="readiness-badge readiness-publishable">Publishable</p>
      {% else %}
        <p class="readiness-badge readiness-blocked">Needs attention</p>
      {% endif %}

      <ul class="readiness-checks">
        {% for check in readiness.checks %}
          <li class="readiness-check {% if check.passed %}check-passed{% else %}check-blocked{% endif %}">
            <span class="check-icon">{% if check.passed %}&#10003;{% else %}&#10007;{% endif %}</span>
            <span class="check-label">
              {% if check.key == 'status_ready' %}Status is ready
              {% elif check.key == 'assets_selected' %}Assets selected
              {% elif check.key == 'selected_assets_present' %}Selected assets present
              {% elif check.key == 'scope_mutable' %}Scope is mutable
              {% else %}{{ check.key }}
              {% endif %}
            </span>
            <span class="check-detail">
              {% if check.key == 'status_ready' %}
                Status: {{ check.details.status }}
              {% elif check.key == 'assets_selected' %}
                {{ check.details.selectedAssetCount }} selected
              {% elif check.key == 'selected_assets_present' %}
                {% if check.details.missingSelectedAssetCount > 0 %}
                  {{ check.details.missingSelectedAssetCount }} missing
                {% else %}
                  All present
                {% endif %}
              {% elif check.key == 'scope_mutable' %}
                {% if check.details.releaseArchived %}
                  Release is archived
                {% elif check.details.projectArchived %}
                  Project is archived
                {% else %}
                  Mutable
                {% endif %}
              {% endif %}
            </span>
          </li>
        {% endfor %}
      </ul>

      <p class="readiness-note">
        Asset presence reflects the last completed scan. This page is not performing a live filesystem check.
      </p>

      {% if not readiness.publishable %}
        <ul class="readiness-actions">
          {% set releaseArchived = release.archived_at %}
          {% for check in readiness.checks %}
            {% if not check.passed %}
              {% if check.key === 'status_ready' and not projectArchived and not releaseArchived %}
                <li><a href="/releases/{{ release.id }}/edit">Edit release</a></li>
              {% elif check.key === 'assets_selected' and not projectArchived and not releaseArchived %}
                <li><a href="/releases/{{ release.id }}/assets">Manage assets</a></li>
              {% elif check.key === 'selected_assets_present' and not projectArchived and not releaseArchived %}
                <li><a href="/projects/{{ project.id }}/assets">Project asset browser</a></li>
              {% endif %}
            {% endif %}
          {% endfor %}
        </ul>
      {% endif %}
    </section>
  {% endif %}

  {% if readiness and readiness.publishable %}
    <div class="form-actions form-actions--spaced">
      <a class="button button-primary" href="/releases/{{ release.id }}/publish">Publish</a>
    </div>
  {% endif %}

  {# ─── Destructive action separated from primary actions ──────────── #}
  {% if not projectArchived and not releaseArchived and not isPublished and release.status !== 'cancelled' %}
    <section class="destructive-section">
      <h3>Danger zone</h3>
      <p>Archiving a release makes it read-only. This cannot be undone.</p>
      <form method="post" action="/releases/{{ release.id }}/archive" class="inline-form">
        <input type="hidden" name="_csrf" value="{{ _csrf }}">
        <button class="button button-danger" type="submit" data-confirm="Archive this release? This cannot be undone.">Archive release</button>
      </form>
    </section>
  {% endif %}
{% endblock %}
