{% extends "layout.njk" %}
{% import "partials/page-heading.njk" as pageHeading %}
{% import "partials/asset-presentation.njk" as assetCards %}
{% import "partials/view-switcher.njk" as viewSwitcher %}

{% set page_title = "Releases — " ~ release.title %}

{% macro releaseAssetMetadata(asset, includeCategory=true) %}
  <div class="release-asset-card-details">
    {% set role = asset.releaseContext.role or 'attachment' %}
    <span class="release-asset-card-detail"><strong>Role</strong> {{ role | title }}</span>
    {% if asset.releaseContext.sortOrder is not none %}
      <span class="release-asset-card-detail"><strong>Order</strong> {{ asset.releaseContext.sortOrder }}</span>
    {% endif %}
    {% if includeCategory and asset.categoryLabel %}
      <span class="release-asset-card-detail"><strong>Category</strong> {{ asset.categoryLabel }}{% if asset.categoryDisabled %} (disabled){% endif %}</span>
    {% endif %}
    {% if asset.relative_path %}
      <span class="release-asset-card-detail release-asset-card-path"><strong>Path</strong> <code>{{ asset.relative_path }}</code></span>
    {% endif %}
  </div>
{% endmacro %}

{% macro releaseGridCard(asset) %}
  {% call(slot) assetCards.gridCard(asset, { filenameLink: true }) %}
    {% if slot == 'body' %}
      {{ releaseAssetMetadata(asset) }}
    {% endif %}
  {% endcall %}
{% endmacro %}

{% macro releaseListCard(asset) %}
  {% call(slot) assetCards.listCard(asset) %}
    {% if slot == 'associations' %}
      {{ releaseAssetMetadata(asset, false) }}
    {% endif %}
  {% endcall %}
{% endmacro %}

{% block content %}
  {% set projectArchived = project and project.archived_at %}
  {% set releaseArchived = release and release.archived_at %}
  {% set isPublished = release and release.published_date %}
  {% set isArchived = projectArchived or releaseArchived %}
  {% if not projectArchived and not releaseArchived %}
    {% call pageHeading.render("Release record") %}
      {% if not isPublished %}
        <a class="button button-primary" href="/releases/{{ release.id }}/publish">Review &amp; Publish</a>
        <a class="button" href="/releases/{{ release.id }}/assets">Manage Assets</a>
      {% endif %}
      <a class="button" href="/releases/{{ release.id }}/edit">Edit</a>
      {% if project and project.id %}
        <a class="button button-secondary" href="/projects/{{ project.id }}">Back to Project</a>
      {% endif %}
    {% endcall %}
  {% else %}
    {% call pageHeading.render("Release record", "archived", "Archived") %}
      {% if project and project.id %}
        <a class="button button-secondary" href="/projects/{{ project.id }}">Back to Project</a>
      {% endif %}
    {% endcall %}
  {% endif %}

  {% if projectArchived %}
    {% set noticeVariant = "warning" %}
    {% set noticeText = "The parent project is archived. This release is read-only." %}
    {% include "partials/notice.njk" %}
  {% endif %}

  {% if releaseArchived %}
    {% set noticeVariant = "warning" %}
    {% set noticeText = "This release is archived and read-only." %}
    {% include "partials/notice.njk" %}
  {% endif %}

  {% if isPublished and not isArchived %}
    {% set noticeVariant = "success" %}
    {% set noticeText = "This release is published. The asset selection is locked and reflects the state at the time of publication. Asset presence is based on the last completed scan — this is not a live filesystem check." %}
    {% include "partials/notice.njk" %}
  {% endif %}

  {% if errors.general %}
    <div class="error-summary" role="alert">
      <p>{{ errors.general }}</p>
    </div>
  {% endif %}

  {# ─── Release identity ───────────────────────────────────────────── #}
  <section>
    <dl class="detail-list">
      {% if project %}
        <dt>Project</dt>
        <dd><a href="/projects/{{ project.id }}">{{ project.title }}</a></dd>
      {% endif %}

      <dt>Project status</dt>
      <dd>{% set status = project.status if project else release.project_status %}{% include "partials/status-badge.njk" %}</dd>

      {% if release.planned_date %}
        <dt>Planned date</dt>
        <dd>{{ release.planned_date }} <small>(release target)</small></dd>
      {% endif %}

      {% if release.published_date %}
        <dt>Published date</dt>
        <dd>{{ release.published_date }} <small>(release published)</small></dd>
      {% endif %}

      {% if release.patreon_url %}
        <dt>Release link</dt>
        <dd><a href="{{ release.patreon_url }}" target="_blank" rel="noopener">{{ release.patreon_url }}</a> <small>(release link)</small></dd>
      {% endif %}

      <dt>Created</dt>
      <dd>{{ release.created_at }}</dd>

      <dt>Updated</dt>
      <dd>{{ release.updated_at }}</dd>

      {% if release.archived_at %}
        <dt>Archived</dt>
        <dd>{{ release.archived_at }}</dd>
      {% endif %}
    </dl>
  </section>

  {# ─── Assets ──────────────────────────────────────────────────────── #}
  <section>
    <h2>Assets</h2>
    <p>
      <span class="meta">{{ assetCount }} asset{% if assetCount != 1 %}s{% endif %} selected</span>
    </p>
  </section>

  {% if release.description %}
    <section>
      <h2>Description</h2>
      <p class="description">{{ release.description }}</p>
    </section>
  {% endif %}

  {% if release.notes %}
    <section>
      <h2>Notes</h2>
      <p class="notes">{{ release.notes }}</p>
    </section>
  {% endif %}

  <section>
    <h2>Selected Assets</h2>
    {% set selectedAssets = assetPresentation.selected or [] %}
    {% if selectedAssets.length > 0 %}
      <div class="asset-viewer-display-controls">
        {{ viewSwitcher.render(view, pageUrl, "Asset display") }}
      </div>
      {% if view == 'grid' %}
        <ul class="asset-grid" role="listbox" aria-label="Selected release assets">
          {% for asset in selectedAssets %}
            <li class="asset-grid-item{% if not asset.is_present %} is-missing{% endif %}">
              {{ releaseGridCard(asset) }}
            </li>
          {% endfor %}
        </ul>
      {% else %}
        <ul class="asset-list asset-list--release" role="list" aria-label="Selected release assets">
          {% for asset in selectedAssets %}
            <li class="asset-list-item{% if not asset.is_present %} is-missing{% endif %}">
              {{ releaseListCard(asset) }}
            </li>
          {% endfor %}
        </ul>
      {% endif %}
    {% else %}
      {% set emptyHeading = "No assets selected" %}
      {% set emptyDescription = "No assets are associated with this release." %}
      {% set emptyHeadingLevel = "h3" %}
      {% include "partials/empty-state.njk" %}
    {% endif %}
  </section>

  {# ─── Published summary ──────────────────────────────────────────── #}
  {% if isPublished and not isArchived %}
    <section class="panel panel--summary">
      <h2>Publication Summary</h2>
      <p class="publication-summary-badge publication-summary-published">Published</p>
      <ul class="publication-summary-checks">
        <li class="publication-summary-check publication-summary-check-passed">
          <span class="publication-summary-check-icon">&#10003;</span>
          <span class="publication-summary-check-label">Asset selection locked</span>
          <span class="publication-summary-check-detail">The selected assets, roles, and order are final</span>
        </li>
        <li class="publication-summary-check publication-summary-check-passed">
          <span class="publication-summary-check-icon">&#10003;</span>
          <span class="publication-summary-check-label">Published date</span>
          <span class="publication-summary-check-detail">{{ release.published_date }}</span>
        </li>
      </ul>
      <p class="publication-summary-note">
        Asset presence reflects the last completed scan. This page is not performing a live filesystem check.
      </p>
    </section>
  {% endif %}

  {# ─── Destructive action separated from primary actions ──────────── #}
  {% if not projectArchived and not releaseArchived and not isPublished %}
    <section class="destructive-section">
      <h3>Danger zone</h3>
      <p>Archiving a release makes it read-only. This cannot be undone.</p>
      <form method="post" action="/releases/{{ release.id }}/archive" class="inline-form">
        <input type="hidden" name="_csrf" value="{{ _csrf }}">
        <button class="button button-danger" type="submit" data-confirm="Archive this release? This cannot be undone.">Archive release</button>
      </form>
    </section>
  {% endif %}
{% endblock %}
