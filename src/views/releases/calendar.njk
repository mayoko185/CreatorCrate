{% extends "layout.njk" %}
{% import "partials/page-heading.njk" as pageHeading %}

{% set page_title = "Calendar" %}

{% block content %}
  {% call pageHeading.render("Project scheduling across CreatorCrate.") %}
    <nav class="view-switcher" aria-label="Workflow view">
      <a class="view-switcher-option" href="/releases">Published Work</a>
      <a class="view-switcher-option" href="/release-management">Release Records</a>
      <a class="view-switcher-option" href="/release-management?view=board">Board</a>
      <a class="view-switcher-option" href="/calendar{% if query.month %}?month={{ query.month }}{% endif %}" aria-current="page">Calendar</a>
    </nav>
  {% endcall %}

  <div class="calendar-nav" aria-label="Calendar navigation">
    {% if prevMonth %}
      <a class="button" href="{{ pageUrl({ month: prevMonth }) }}">← Previous</a>
    {% else %}
      <span class="button" aria-disabled="true">← Previous</span>
    {% endif %}
    <h2>{{ month }}</h2>
    <div class="calendar-nav-right">
      {% if isCurrentMonth %}
        <span class="button button-primary" aria-disabled="true" aria-current="page">Today</span>
      {% else %}
        <a class="button button-primary" href="{{ pageUrl({ month: null }) }}">Today</a>
      {% endif %}
      {% if nextMonth %}
        <a class="button" href="{{ pageUrl({ month: nextMonth }) }}">Next →</a>
      {% else %}
        <span class="button" aria-disabled="true">Next →</span>
      {% endif %}
    </div>
  </div>

  {% if days.length > 0 %}
    {# Desktop: dense grid workspace. Hidden below the agenda breakpoint
       (see .calendar-scroll media query) — the agenda list below takes
       over there instead of relying on horizontal scroll. #}
    <div class="calendar-scroll" tabindex="0" aria-label="Calendar grid">
      {# Phase 13.3 (rewrite): a real CSS Grid layout, not a <table> styled
         to look like one — matches the approved Concept D structure.
         Static ARIA table roles (table/row/columnheader/cell, not the
         interactive grid/gridcell roles) preserve equivalent semantics
         to the <table> this replaced, since there's no keyboard grid
         navigation here — .calendar-row uses display:contents so its
         children still participate in the grid's column tracks while
         keeping each week grouped as its own accessible row. #}
      <div class="calendar-table" role="table">
        <div class="calendar-row calendar-row-header" role="row">
          <div class="calendar-th" role="columnheader">Mon</div>
          <div class="calendar-th" role="columnheader">Tue</div>
          <div class="calendar-th" role="columnheader">Wed</div>
          <div class="calendar-th" role="columnheader">Thu</div>
          <div class="calendar-th" role="columnheader">Fri</div>
          <div class="calendar-th" role="columnheader">Sat</div>
          <div class="calendar-th" role="columnheader">Sun</div>
        </div>
        <div class="calendar-row" role="row">
          {# Leading padding cells: tail end of the previous month, dimmed #}
          {% if firstDayWeekday > 0 %}
            {% for i in range(0, firstDayWeekday) %}
              <div class="calendar-day empty-day out-of-month" role="cell">
                <div class="day-header">{{ prevMonthDaysCount - firstDayWeekday + 1 + i }}</div>
              </div>
            {% endfor %}
          {% endif %}

          {# Day cells #}
          {% for day in days %}
            <div class="calendar-day{% if day.entries.length === 0 %} empty{% endif %}{% if day.date == today %} today{% endif %}" role="cell">
              <div class="day-header">{{ day.date.split('-')[2] }}</div>
              <div class="day-releases">
                {% for entry in day.entries %}
                  <div class="calendar-release">
                    <a href="/projects/{{ entry.id }}">{{ entry.title }}</a>
                    {% set status = entry.status %}{% include "partials/status-badge.njk" %}
                  </div>
                {% endfor %}
              </div>
            </div>

            {% if (loop.index + firstDayWeekday) % 7 === 0 and not loop.last %}
        </div>
        <div class="calendar-row" role="row">
            {% endif %}
          {% endfor %}

          {# Trailing padding cells: start of next month, dimmed #}
          {% set lastDow = (days.length + firstDayWeekday) % 7 %}
          {% if lastDow !== 0 %}
            {% for i in range(0, 7 - lastDow) %}
              <div class="calendar-day empty-day out-of-month" role="cell">
                <div class="day-header">{{ i + 1 }}</div>
              </div>
            {% endfor %}
          {% endif %}
        </div>
      </div>
    </div>

    {# Mobile: agenda-first list — same day data, no horizontal scrolling.
       Shown only below the agenda breakpoint; the grid above takes over
       at wider widths. Server-rendered, no JavaScript. #}
    <ul class="calendar-agenda" aria-label="Calendar agenda">
      {% for day in days %}
        <li class="agenda-day{% if day.entries.length === 0 %} agenda-day-empty{% endif %}{% if day.date == today %} today{% endif %}">
          <div class="agenda-day-date">
            {{ day.date }}{% if day.date == today %} <span class="agenda-today-tag">Today</span>{% endif %}
          </div>
          {% if day.entries.length > 0 %}
            <div class="agenda-day-releases">
              {% for entry in day.entries %}
                <div class="agenda-release">
                  <a href="/projects/{{ entry.id }}">{{ entry.title }}</a>
                  {% set status = entry.status %}{% include "partials/status-badge.njk" %}
                </div>
              {% endfor %}
            </div>
          {% endif %}
        </li>
      {% endfor %}
    </ul>
  {% else %}
    {% set emptyHeading = "No projects scheduled for " + month %}
    {% set emptyDescription = "There are no projects scheduled for this month." %}
    {% set emptyActionUrl = "/projects/new" %}
    {% set emptyActionLabel = "New Project" %}
    {% set emptyHeadingLevel = "h2" %}
    {% include "partials/empty-state.njk" %}
  {% endif %}
{% endblock %}
