{% extends "layout.njk" %}
{% import "partials/page-heading.njk" as pageHeading %}

{% block content %}
  {% call pageHeading.render("Release Calendar") %}
    <nav class="view-switcher" aria-label="Release view">
      <a class="view-switcher-option" href="/releases">List</a>
      <a class="view-switcher-option" href="/releases?view=board">Board</a>
      <a class="view-switcher-option" href="/releases/calendar{% if query.month %}?month={{ query.month }}{% endif %}" aria-current="page">Calendar</a>
    </nav>
  {% endcall %}

  <div class="calendar-nav" aria-label="Calendar navigation">
    {% if prevMonth %}
      <a class="button" href="{{ pageUrl({ month: prevMonth }) }}">← Previous</a>
    {% else %}
      <span class="button" aria-disabled="true">← Previous</span>
    {% endif %}
    <h2>{{ month }}</h2>
    {% if nextMonth %}
      <a class="button" href="{{ pageUrl({ month: nextMonth }) }}">Next →</a>
    {% else %}
      <span class="button" aria-disabled="true">Next →</span>
    {% endif %}
  </div>

  {% if days.length > 0 %}
    <div class="calendar-scroll" tabindex="0" aria-label="Release calendar grid">
      <table class="calendar-table">
        <thead>
          <tr>
            <th>Mon</th>
            <th>Tue</th>
            <th>Wed</th>
            <th>Thu</th>
            <th>Fri</th>
            <th>Sat</th>
            <th>Sun</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            {# Leading padding cells #}
            {% if firstDayWeekday > 0 %}
              {% for i in range(0, firstDayWeekday) %}
                <td class="calendar-day empty-day"></td>
              {% endfor %}
            {% endif %}

            {# Day cells #}
            {% for day in days %}
              <td class="calendar-day{% if day.releases.length === 0 %} empty{% endif %}{% if day.date == today %} today{% endif %}">
                <div class="day-header">{{ day.date.split('-')[2] }}</div>
                <div class="day-releases">
                  {% for release in day.releases %}
                    <div class="calendar-release{% if release.archived_at %} archived{% endif %}">
                      <a href="/releases/{{ release.id }}">{{ release.title }}</a>
                      <span class="release-project">{{ release.project_title }}</span>
                      {% set status = release.status %}{% include "partials/status-badge.njk" %}
                      {% if release._readiness %}
                        <span class="release-readiness">
                          {%- if release._readiness.publishable -%}
                            <span class="readiness-publishable">Publishable</span>
                          {%- else -%}
                            <span class="readiness-blocked">Blocked</span>
                          {%- endif -%}
                        </span>
                      {% endif %}
                      {% if release.missing_asset_count > 0 %}
                        <span class="missing-indicator" title="{{ release.missing_asset_count }} missing asset(s)">⚠</span>
                      {% endif %}
                    </div>
                  {% endfor %}
                </div>
              </td>

              {% if (loop.index + firstDayWeekday) % 7 === 0 and not loop.last %}
        </tr>
        <tr>
              {% endif %}
            {% endfor %}

            {# Trailing padding cells #}
            {% set lastDow = (days.length + firstDayWeekday) % 7 %}
            {% if lastDow !== 0 %}
              {% for i in range(0, 7 - lastDow) %}
                <td class="calendar-day empty-day"></td>
              {% endfor %}
            {% endif %}
          </tr>
        </tbody>
      </table>
    </div>
  {% else %}
    {% set emptyHeading = "No releases scheduled for " + month %}
    {% set emptyDescription = "There are no releases scheduled for this month." %}
    {% set emptyActionUrl = "/releases/new" %}
    {% set emptyActionLabel = "New Release" %}
    {% set emptyHeadingLevel = "h2" %}
    {% include "partials/empty-state.njk" %}
  {% endif %}
{% endblock %}
