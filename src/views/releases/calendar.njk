{% extends "layout.njk" %}
{% import "partials/calendar-event.njk" as calendarEvent %}
{% import "partials/dialog.njk" as dialog %}
{% import "partials/dropdown.njk" as dropdown %}
{% import "partials/icons.njk" as icons %}

{% set page_title = "Calendar" %}

{% block content %}
  <div class="asset-viewer-display-controls">
    <div class="project-filter-actions project-filter-actions--projects">
      <a class="button button-small button-secondary project-filter-control asset-tooltip asset-tooltip--left"
         href="#calendar-filter-dialog" aria-label="Filters"
         data-dialog-open="calendar-filter-dialog" data-tooltip="Filters">
        {{ icons.icon('content-filter') }}
      </a>
      <a class="button button-small button-secondary project-filter-control asset-tooltip asset-tooltip--left"
         href="/calendar?defaults=1" aria-label="Page Defaults"
         data-dialog-open="calendar-defaults-dialog" data-tooltip="Page Defaults">
        {{ icons.icon('settings') }}
      </a>
    </div>
  </div>

  <div data-calendar-live-region>
  <span class="sr-only" data-calendar-live-status aria-live="polite" aria-atomic="true"></span>
  <div class="calendar-nav" aria-label="Calendar navigation">
    {% if prevMonth %}
      <a id="calendar-previous" class="button" href="{{ pageUrl({ month: prevMonth }) }}" data-calendar-navigation>← Previous</a>
    {% else %}
      <span class="button" aria-disabled="true">← Previous</span>
    {% endif %}
    <h2 tabindex="-1" data-calendar-month-heading>{{ monthHeading }}</h2>
    <div class="calendar-nav-right">
      {% if isCurrentMonth %}
        <span class="button button-primary" aria-disabled="true" aria-current="page">Today</span>
      {% else %}
        <a id="calendar-today" class="button button-primary" href="{{ pageUrl({ month: null }) }}" data-calendar-navigation>Today</a>
      {% endif %}
      {% if nextMonth %}
        <a id="calendar-next" class="button" href="{{ pageUrl({ month: nextMonth }) }}" data-calendar-navigation>Next →</a>
      {% else %}
        <span class="button" aria-disabled="true">Next →</span>
      {% endif %}
    </div>
  </div>
  <p class="results-meta">{{ releaseCount }} matching release{% if releaseCount != 1 %}s{% endif %}</p>
  {% if releaseCount == 0 %}<p class="calendar-filter-empty" role="status">No releases match these filters.</p>{% endif %}

    <div class="calendar-scroll" tabindex="0" aria-label="Release calendar grid">
      <div class="calendar-table" role="table">
        <div class="calendar-row calendar-row-header" role="row">
          {% if weekStart == 'sunday' %}<div class="calendar-th" role="columnheader">Sun</div>{% endif %}
          <div class="calendar-th" role="columnheader">Mon</div>
          <div class="calendar-th" role="columnheader">Tue</div>
          <div class="calendar-th" role="columnheader">Wed</div>
          <div class="calendar-th" role="columnheader">Thu</div>
          <div class="calendar-th" role="columnheader">Fri</div>
          <div class="calendar-th" role="columnheader">Sat</div>
          {% if weekStart == 'monday' %}<div class="calendar-th" role="columnheader">Sun</div>{% endif %}
        </div>
        <div class="calendar-row" role="row">
          {% if firstDayWeekday > 0 %}
            {% for i in range(0, firstDayWeekday) %}
              <div class="calendar-day empty-day out-of-month" role="cell">
                <div class="day-header">{{ prevMonthDaysCount - firstDayWeekday + 1 + i }}</div>
              </div>
            {% endfor %}
          {% endif %}

          {% for day in days %}
            {% set weekday = (loop.index0 + firstDayWeekday) % 7 %}
            <div class="calendar-day{% if day.entries.length === 0 %} empty{% endif %}{% if day.date == today %} today{% endif %}{% if (weekStart == 'sunday' and (weekday == 0 or weekday == 6)) or (weekStart == 'monday' and (weekday == 5 or weekday == 6)) %} weekend{% endif %}" role="cell">
              <div class="day-header">{{ day.date.split('-')[2] }}</div>
              <div class="day-releases">
                {% for entry in day.entries %}
                  {{ calendarEvent.render(entry, 'grid') }}
                {% endfor %}
              </div>
            </div>

            {% if (loop.index + firstDayWeekday) % 7 === 0 and not loop.last %}
        </div>
        <div class="calendar-row" role="row">
            {% endif %}
          {% endfor %}

          {% set lastDow = (days.length + firstDayWeekday) % 7 %}
          {% if lastDow !== 0 %}
            {% for i in range(0, 7 - lastDow) %}
              <div class="calendar-day empty-day out-of-month" role="cell">
                <div class="day-header">{{ i + 1 }}</div>
              </div>
            {% endfor %}
          {% endif %}
        </div>
      </div>
    </div>

    <ul class="calendar-agenda" aria-label="Release calendar agenda">
      {% for day in days %}
        <li class="agenda-day{% if day.entries.length === 0 %} agenda-day-empty{% endif %}{% if day.date == today %} today{% endif %}">
          <div class="agenda-day-date">
            {{ day.date }}{% if day.date == today %} <span class="agenda-today-tag">Today</span>{% endif %}
          </div>
          {% if day.entries.length > 0 %}
            <div class="agenda-day-releases">
              {% for entry in day.entries %}
                <div class="agenda-release">{{ calendarEvent.render(entry, 'agenda') }}</div>
              {% endfor %}
            </div>
          {% endif %}
        </li>
      {% endfor %}
    </ul>
  </div>
{% endblock %}

{% block overlay %}
  {% call dialog.render('calendar-filter-dialog', 'Filters') %}
    <form id="calendar-filters" class="app-dialog-form project-form" method="get" action="/calendar" data-calendar-filters>
      <div class="app-dialog-body">
        <div class="page-defaults-grid">
          <input type="hidden" name="month" value="{{ month }}">
          {{ dropdown.searchableSingleSelect({ id: 'calendar-project-filter', name: 'project', label: 'Project',
          options: projectOptions, valueKey: 'id', labelKey: 'title', selected: projectId,
          placeholder: 'All projects', panelLabel: 'Project options', searchLabel: 'Search projects',
          searchInputId: 'calendar-project-search', noResultsText: 'No matching projects',
          optionListLabel: 'Project choices', optionIdPrefix: 'calendar-project',
          fieldClasses: 'app-dialog-field asset-viewer-filter-field asset-viewer-project-filter projects-filter-field--project',
          classes: 'asset-project-filter-disclosure' }) }}
          {{ dropdown.singleSelect({ id: 'calendar-status-filter', name: 'status', label: 'Release status',
          options: [{ value: 'all', label: 'All releases' }, { value: 'planned', label: 'Planned' }, { value: 'published', label: 'Published' }],
          selected: status, panelLabel: 'Release status options',
          fieldClasses: 'app-dialog-field asset-viewer-filter-field' }) }}
          {{ dropdown.singleSelect({ id: 'calendar-week-start-filter', name: 'weekStart', label: 'Week starts',
          options: [{ value: 'monday', label: 'Monday' }, { value: 'sunday', label: 'Sunday' }],
          selected: weekStart, panelLabel: 'Week start options',
          fieldClasses: 'app-dialog-field asset-viewer-filter-field' }) }}
        </div>
      </div>
    </form>
    <form class="projects-filter-reset" method="get" action="{{ resetFiltersUrl }}">
      <button class="button" type="submit" data-calendar-reset>Reset filters</button>
    </form>
  {% endcall %}

  {% call dialog.render('calendar-defaults-dialog', 'Page Defaults', false, 'calendar-defaults-description', 'calendar-defaults-form') %}
    <form id="calendar-defaults-form" class="app-dialog-form project-form" method="post" action="/settings/defaults"
          data-dialog-form data-dialog-async="false" data-calendar-defaults-fetch-save novalidate>
      <p id="calendar-defaults-description" class="app-dialog-description">Choose the default release status and week start for Calendar.</p>
      <div class="app-dialog-error" data-dialog-error role="alert" hidden>
        <p data-dialog-error-text></p>
        <ul data-dialog-error-list></ul>
      </div>
      <input type="hidden" name="_csrf" value="{{ _csrf }}">
      <div class="app-dialog-body">
        <div class="page-defaults-grid">
          {% for field in calendarDefaults.fields %}
            <div class="field app-dialog-field" data-dialog-field="{{ field.name }}">
              {{ dropdown.singleSelect({ id: field.id ~ '-dropdown', name: 'calendarStatus' if field.name == 'status' else 'calendarWeekStart',
                label: 'Default release status' if field.name == 'status' else 'Week starts',
                options: field.options, selected: field.selectedValue, optionIdPrefix: field.id,
                nativeSelect: { id: field.id, attributes: [['required', true], ['data-autosubmit', 'fetch']] },
                dispatchNativeChange: true }) }}
            </div>
          {% endfor %}
        </div>
      </div>
      <div class="app-dialog-status" data-settings-fetch-save-status role="status" aria-live="polite" aria-atomic="true"></div>
    </form>
  {% endcall %}
{% endblock %}
