{% extends "layout.njk" %}
{% import "partials/calendar-event.njk" as calendarEvent %}
{% import "partials/dialog.njk" as dialog %}
{% import "partials/dropdown.njk" as dropdown %}
{% import "partials/icons.njk" as icons %}
{% import "partials/release-edit-dialog.njk" as releaseEditDialog %}
{% import "partials/release-signatures-dialog.njk" as releaseSignaturesDialog %}
{% import "partials/view-switcher.njk" as viewSwitcher %}

{% set page_title = "Calendar" %}

{% block content %}
  {# Outside the live region so Calendar refreshes never replace it. #}
  <div class="notice notice--success app-dialog-feedback" data-dialog-feedback role="status" hidden>
    <p data-dialog-feedback-text></p>
  </div>
  <div class="calendar-view-{{ view }}" data-calendar-live-region data-calendar-month="{{ month }}" data-calendar-current-month="{{ today.slice(0, 7) }}">
  <span class="sr-only" data-calendar-live-status aria-live="polite" aria-atomic="true"></span>
  {# WP14a: authoritative defaults metadata of this rendered page (effective
     current View/status/week start, saved-key presence, fallbacks, durable
     generation, displayed month, the Reset filters destination). Data only;
     it travels with every live-region install so a prepared response is
     never mistaken for the installed one. #}
  {% if calendarDefaultsAuthorityJson %}
  <script type="application/json" data-calendar-defaults-authority>{{ calendarDefaultsAuthorityJson | safe }}</script>
  {% endif %}
  {% if calendarDefaultsNotice %}
  <p class="page-notice" role="status" data-calendar-defaults-notice>{{ calendarDefaultsNotice }}</p>
  {% endif %}
  <div class="calendar-nav" aria-label="Calendar navigation">
    <div class="calendar-view-switcher">{{ viewSwitcher.render(view, pageUrl, 'Calendar display', true, 'Calendar', 'List') }}</div>
    <h2 tabindex="-1" data-calendar-month-heading>
      <button type="button" class="calendar-month-trigger" data-dialog-open="calendar-month-dialog"
              aria-haspopup="dialog" aria-controls="calendar-month-dialog" aria-label="Choose month: {{ monthHeading }}">{{ monthHeading }}</button>
    </h2>
    <div class="calendar-nav-right">
      {% if prevMonth %}
        <a id="calendar-previous" class="button button-secondary project-filter-control calendar-nav-control asset-tooltip" href="{{ pageUrl({ month: prevMonth }) }}"
           data-calendar-navigation aria-label="Previous month" data-tooltip="Previous month">{{ icons.icon('chevron-left') }}</a>
      {% else %}
        <span class="button button-secondary project-filter-control calendar-nav-control" role="button" aria-label="Previous month" aria-disabled="true">{{ icons.icon('chevron-left') }}</span>
      {% endif %}
      {% if isCurrentMonth %}
        <span class="button button-primary project-filter-control calendar-nav-control" role="button" aria-label="Today" aria-disabled="true" aria-current="page">{{ icons.icon('calendar') }}<span class="calendar-nav-label">Today</span></span>
      {% else %}
        <a id="calendar-today" class="button button-primary project-filter-control calendar-nav-control asset-tooltip" href="{{ pageUrl({ month: null }) }}"
           data-calendar-navigation aria-label="Today" data-tooltip="Today">{{ icons.icon('calendar') }}<span class="calendar-nav-label">Today</span></a>
      {% endif %}
      {% if nextMonth %}
        <a id="calendar-next" class="button button-secondary project-filter-control calendar-nav-control asset-tooltip" href="{{ pageUrl({ month: nextMonth }) }}"
           data-calendar-navigation aria-label="Next month" data-tooltip="Next month">{{ icons.icon('chevron-right') }}</a>
      {% else %}
        <span class="button button-secondary project-filter-control calendar-nav-control" role="button" aria-label="Next month" aria-disabled="true">{{ icons.icon('chevron-right') }}</span>
      {% endif %}
    </div>
    <div class="calendar-nav-actions project-filter-actions project-filter-actions--projects">
      {# WP14b: the one Filters & Defaults entry (the separate Defaults entry is retired). #}
      <a class="button button-small button-secondary project-filter-control asset-tooltip asset-tooltip--left"
         href="#calendar-filter-dialog" aria-label="Filters &amp; Defaults"
         data-dialog-open="calendar-filter-dialog" data-tooltip="Filters &amp; Defaults">
        {{ icons.icon('content-filter') }}
      </a>
    </div>
  </div>
  <p class="results-meta">{{ releaseCount }} matching release{% if releaseCount != 1 %}s{% endif %}</p>
  {% if releaseCount == 0 %}<p class="calendar-filter-empty" role="status">No releases match these filters.</p>{% endif %}

    <div class="calendar-scroll" tabindex="0" aria-label="Release calendar grid">
      <div class="calendar-table" role="table">
        <div class="calendar-row calendar-row-header" role="row">
          {% if weekStart == 'sunday' %}<div class="calendar-th" role="columnheader">Sun</div>{% endif %}
          <div class="calendar-th" role="columnheader">Mon</div>
          <div class="calendar-th" role="columnheader">Tue</div>
          <div class="calendar-th" role="columnheader">Wed</div>
          <div class="calendar-th" role="columnheader">Thu</div>
          <div class="calendar-th" role="columnheader">Fri</div>
          <div class="calendar-th" role="columnheader">Sat</div>
          {% if weekStart == 'monday' %}<div class="calendar-th" role="columnheader">Sun</div>{% endif %}
        </div>
        <div class="calendar-row" role="row">
          {% if firstDayWeekday > 0 %}
            {% for i in range(0, firstDayWeekday) %}
              <div class="calendar-day empty-day out-of-month{% if (weekStart == 'sunday' and (i == 0 or i == 6)) or (weekStart == 'monday' and (i == 5 or i == 6)) %} weekend{% endif %}" role="cell">
                <div class="day-header">{{ prevMonthDaysCount - firstDayWeekday + 1 + i }}</div>
              </div>
            {% endfor %}
          {% endif %}

          {% for day in days %}
            {% set weekday = (loop.index0 + firstDayWeekday) % 7 %}
            <div class="calendar-day{% if day.entries.length === 0 %} empty{% endif %}{% if day.date == today %} today{% endif %}{% if (weekStart == 'sunday' and (weekday == 0 or weekday == 6)) or (weekStart == 'monday' and (weekday == 5 or weekday == 6)) %} weekend{% endif %}" role="cell">
              <div class="day-header">{{ day.date.split('-')[2] }}</div>
              <div class="day-releases">
                {% for entry in day.entries %}
                  {{ calendarEvent.render(entry, 'grid', clockFormat) }}
                {% endfor %}
              </div>
            </div>

            {% if (loop.index + firstDayWeekday) % 7 === 0 and not loop.last %}
        </div>
        <div class="calendar-row" role="row">
            {% endif %}
          {% endfor %}

          {% set lastDow = (days.length + firstDayWeekday) % 7 %}
          {% if lastDow !== 0 %}
            {% for i in range(0, 7 - lastDow) %}
              <div class="calendar-day empty-day out-of-month{% if (weekStart == 'sunday' and (lastDow + i == 0 or lastDow + i == 6)) or (weekStart == 'monday' and (lastDow + i == 5 or lastDow + i == 6)) %} weekend{% endif %}" role="cell">
                <div class="day-header">{{ i + 1 }}</div>
              </div>
            {% endfor %}
          {% endif %}
        </div>
      </div>
    </div>

    <ul class="calendar-agenda" aria-label="Release calendar agenda">
      {% for day in days %}
        <li class="agenda-day{% if day.entries.length === 0 %} agenda-day-empty{% endif %}{% if day.date == today %} today{% endif %}">
          <div class="agenda-day-date">
            {{ day.date }}{% if day.date == today %} <span class="agenda-today-tag">Today</span>{% endif %}
          </div>
          {% if day.entries.length > 0 %}
            <div class="agenda-day-releases">
              {% for entry in day.entries %}
                <div class="agenda-release">{{ calendarEvent.render(entry, 'agenda', clockFormat) }}</div>
              {% endfor %}
            </div>
          {% endif %}
        </li>
      {% endfor %}
    </ul>
  </div>
{% endblock %}

{% block overlay %}
  {% call dialog.render('calendar-month-dialog', 'Choose month', dialogClass='app-dialog--utility') %}
    <form id="calendar-month-form" class="app-dialog-form project-form" data-dialog-async="false">
      <div class="app-dialog-body">
        <div class="page-defaults-grid">
          {{ dropdown.singleSelect({ id: 'calendar-month-select', name: 'pickerMonth', label: 'Month',
            options: [{ value: '01', label: 'January' }, { value: '02', label: 'February' }, { value: '03', label: 'March' },
              { value: '04', label: 'April' }, { value: '05', label: 'May' }, { value: '06', label: 'June' },
              { value: '07', label: 'July' }, { value: '08', label: 'August' }, { value: '09', label: 'September' },
              { value: '10', label: 'October' }, { value: '11', label: 'November' }, { value: '12', label: 'December' }],
            selected: month.split('-')[1], panelLabel: 'Month options', fieldClasses: 'app-dialog-field' }) }}
          <div class="field app-dialog-field calendar-month-year">
            <label for="calendar-month-year">Year</label>
            <input id="calendar-month-year" name="pickerYear" type="number" min="1000" max="9999" step="1" required inputmode="numeric" value="{{ month.split('-')[0] }}">
          </div>
        </div>
      </div>
    </form>
  {% endcall %}

  {#
    WP14b Filters & Defaults: one dialog, owning forms side by side, no nesting.
    - #calendar-filters-defaults-form holds the saved-state line and the
      explicit-save status. client/calendar-filters-defaults.js binds it
      (data-defaults-explicit-save, no autosave marker): Save new defaults
      posts one snapshot of the THREE eligible settings (Desktop view, Release
      status, Week starts) taken from the INSTALLED page authority, with the
      current durable generation and an operation identity. Save and Reset
      defaults are JavaScript-only: the form has no native mutation
      (method="dialog", no saveable fields), both buttons are rendered disabled
      and type="button", and the controller arms them only once it owns their
      click paths. The legacy per-control autosave form is retired.
    - #calendar-filters (GET) is the only filter state. Every control that
      changes the Calendar (Projects, Project Types, Release status, Desktop
      view, Week starts) belongs to it and navigates through the one Calendar
      live-region engine; the displayed month travels as its hidden field.
      Repeated values stay repeated (project=7&project=12, type=comic&type=book).
  #}
  {% set calendarAuthority = calendarDefaultsAuthority %}
  {% set savedDefaultCount = calendarAuthority.savedKeys.length if calendarAuthority and calendarAuthority.savedKeys else 0 %}
  {% call dialog.render('calendar-filter-dialog', 'Filters & Defaults', calendarDefaultsDialogOpen, '', 'calendar-filters-defaults-form', 'app-dialog--utility app-dialog--filters-defaults calendar-filters-defaults', [], true, 'Calendar') %}
    <div class="app-dialog-body filters-defaults-dialog-body">
      <form id="calendar-filters-defaults-form" method="dialog" class="filters-defaults-defaults-form"
            data-dialog-form data-dialog-async="false" data-defaults-explicit-save novalidate>
        <input type="hidden" name="_csrf" value="{{ _csrf }}">

        <div class="filters-defaults-status-row">
          <p class="filters-defaults-saved-indicator" data-calendar-defaults-indicator>
            {%- if not calendarAuthority -%}Saved defaults could not be read.
            {%- elif savedDefaultCount == 0 -%}No saved defaults.
            {%- elif savedDefaultCount == calendarAuthority.fields.length -%}Defaults saved.
            {%- else -%}{{ savedDefaultCount }} of {{ calendarAuthority.fields.length }} defaults saved.{%- endif -%}
          </p>
        </div>

        <div class="app-dialog-error" data-dialog-error role="alert" hidden>
          <p data-dialog-error-text></p>
          <ul data-dialog-error-list></ul>
        </div>
        <div class="app-dialog-status filters-defaults-status" data-settings-fetch-save-status role="status" aria-live="polite" aria-atomic="true"></div>
        <div class="filters-defaults-recovery" data-calendar-defaults-recovery hidden>
          <button class="button button-small button-secondary" type="button" data-calendar-defaults-retry hidden>Retry</button>
          <button class="button button-small button-secondary" type="button" data-calendar-defaults-check hidden>Check again</button>
        </div>
      </form>

      <form id="calendar-filters" class="filters-defaults-filters" method="get" action="/calendar" data-calendar-filters>
        <input type="hidden" name="month" value="{{ month }}">
        {% for id in carriedProjectIds %}
          <input type="hidden" name="project" value="{{ id }}" data-calendar-intended-carrier data-cc-dropdown-carried-value>
        {% endfor %}

        <section class="filters-defaults-section" aria-labelledby="calendar-filters-heading">
          <h3 id="calendar-filters-heading">Filters</h3>
          <div class="filters-defaults-grid">
            {% if projectFilterSelectedValues.length == 1 and carriedProjectIds.length == 1 %}
              {% set projectFilterSummary = "1 project selected" %}
            {% endif %}
            {{ dropdown.multiSelect({
              id: "calendar-project-filter",
              name: "project",
              label: "Projects",
              options: projectFilterOptions or [],
              selectedValues: projectFilterSelectedValues or [],
              summary: projectFilterSummary,
              selectAll: { value: '' },
              emptySummary: "All projects",
              countLabel: "projects",
              searchable: true,
              searchLabel: "Search projects",
              searchInputId: "calendar-project-filter-search",
              noResultsText: "No matching projects",
              optionListLabel: "Project choices",
              optionIdPrefix: "calendar-project",
              panelLabel: "Project options",
              emptyOptionText: "No projects available",
              fieldClasses: "app-dialog-field asset-viewer-filter-field asset-viewer-project-filter calendar-filter-field--project",
              fieldAttributes: [["data-calendar-project-filter", true]],
              classes: "asset-project-filter-disclosure"
            }) }}

            {{ dropdown.multiSelect({
              id: "calendar-type-filter",
              name: "type",
              label: "Project Types",
              options: projectTypeOptions or [],
              selectedValues: projectTypes or [],
              selectAll: { value: '' },
              emptySummary: "All types",
              countLabel: "types",
              searchable: true,
              searchLabel: "Search project types",
              searchInputId: "calendar-type-filter-search",
              noResultsText: "No matching project types",
              optionListLabel: "Project Type choices",
              optionIdPrefix: "calendar-type",
              panelLabel: "Project Type options",
              emptyOptionText: "No project types available",
              fieldClasses: "app-dialog-field asset-viewer-filter-field asset-viewer-project-filter calendar-filter-field--type",
              fieldAttributes: [["data-calendar-type-filter", true]],
              classes: "asset-project-filter-disclosure"
            }) }}

            {{ dropdown.singleSelect({
              id: "calendar-status-filter",
              name: "status",
              label: "Release status",
              options: [{ value: 'all', label: 'All releases' }, { value: 'planned', label: 'Planned' }, { value: 'published', label: 'Published' }],
              selected: status,
              optionIdPrefix: "calendar-status",
              panelLabel: "Release status options",
              fieldClasses: "app-dialog-field asset-viewer-filter-field"
            }) }}
          </div>
        </section>

        <section class="filters-defaults-section" aria-labelledby="calendar-misc-heading">
          <h3 id="calendar-misc-heading">Miscellaneous</h3>
          <div class="filters-defaults-grid">
            {{ dropdown.singleSelect({
              id: "calendar-view-filter",
              name: "view",
              label: "Desktop view",
              options: [{ value: 'grid', label: 'Calendar' }, { value: 'list', label: 'List' }],
              selected: view,
              optionIdPrefix: "calendar-view",
              panelLabel: "Desktop view options",
              fieldClasses: "app-dialog-field asset-viewer-filter-field"
            }) }}

            {{ dropdown.singleSelect({
              id: "calendar-week-start-filter",
              name: "weekStart",
              label: "Week starts",
              options: [{ value: 'monday', label: 'Monday' }, { value: 'sunday', label: 'Sunday' }],
              selected: weekStart,
              optionIdPrefix: "calendar-week-start",
              panelLabel: "Week start options",
              fieldClasses: "app-dialog-field asset-viewer-filter-field"
            }) }}
          </div>
        </section>
      </form>
    </div>
    <footer class="app-dialog-footer filters-defaults-footer">
      <button class="button button-secondary" type="button" disabled data-calendar-defaults-save>Save new defaults</button>
      {# Reset defaults is JavaScript-only, like Save: no form, no native POST
         and no rendered returnTo/generation. It is disabled until the
         explicit-save controller owns it. #}
      <button class="button button-secondary" type="button" disabled data-calendar-defaults-reset>Reset defaults</button>
      {# GET-only: the server resolves the effective saved/default View, status
         and week start; Projects and Project Types clear. The displayed month
         is a hidden field (a GET form's action query would be replaced). #}
      <form class="calendar-filter-reset filters-defaults-reset-form" method="get" action="/calendar">
        <input type="hidden" name="month" value="{{ month }}">
        <button class="button button-primary" type="submit" data-calendar-filters-reset>Reset filters</button>
      </form>
    </footer>
  {% endcall %}

  {# One Edit Release dialog for every Calendar release; release-edit-dialog.js
     loads the chosen release into it, so it renders without a release. #}
  {{ releaseEditDialog.render({ id: '', published_date: none }, { values: {}, errors: {} }, _csrf, releaseSignatureConfiguration, platformChoices, clockFormat, 'release-edit-field-') }}
  {{ releaseSignaturesDialog.render(releaseSignatureConfiguration, _csrf) }}
{% endblock %}
