{% extends "layout.njk" %}
{% import "partials/page-heading.njk" as pageHeading %}

{% block content %}
  {% call pageHeading.render("Releases") %}
    <nav class="view-switcher" aria-label="View">
      <a class="view-switcher-option" href="{{ pageUrl({ view: 'list' }) }}"{% if view !== 'board' %} aria-current="page"{% endif %}>List</a>
      <a class="view-switcher-option" href="{{ pageUrl({ view: 'board' }) }}"{% if view === 'board' %} aria-current="page"{% endif %}>Board</a>
      <a class="view-switcher-option" href="/releases/calendar{% if query.month %}?month={{ query.month }}{% endif %}">Calendar</a>
    </nav>
    <a class="button button-primary" href="/releases/new">New Release</a>
  {% endcall %}

  {% if view === 'board' %}
    {# ─── Board View ─── #}
    <div class="board-filters">
      <form method="get" action="/releases">
        <input type="hidden" name="view" value="board">
        <div class="field">
          <label for="board-project">Project</label>
          <input type="text" id="board-project" name="project" value="{{ query.project or '' }}" placeholder="Project ID">
        </div>
        <div class="field">
          <label for="board-status">Status</label>
          <select id="board-status" name="status">
            <option value="">All</option>
            {% for s in statuses %}
              <option value="{{ s }}" {% if query.status == s %}selected{% endif %}>{{ s | replace('-', ' ') | title }}</option>
            {% endfor %}
          </select>
        </div>
        <div class="field">
          <label for="board-schedule">Schedule</label>
          <select id="board-schedule" name="schedule">
            <option value="">All</option>
            <option value="overdue" {% if query.schedule == 'overdue' %}selected{% endif %}>Overdue</option>
            <option value="today" {% if query.schedule == 'today' %}selected{% endif %}>Today</option>
            <option value="upcoming" {% if query.schedule == 'upcoming' %}selected{% endif %}>Upcoming</option>
            <option value="unscheduled" {% if query.schedule == 'unscheduled' %}selected{% endif %}>Unscheduled</option>
          </select>
        </div>

        <div class="field">
          <label for="board-readiness">Readiness</label>
          <select id="board-readiness" name="readiness">
            <option value="all" {% if query.readiness == 'all' or not query.readiness %}selected{% endif %}>All</option>
            <option value="publishable" {% if query.readiness == 'publishable' %}selected{% endif %}>Publishable</option>
            <option value="blocked-ready" {% if query.readiness == 'blocked-ready' %}selected{% endif %}>Blocked (ready)</option>
          </select>
        </div>

        <div class="field field--checkbox">
          <input type="checkbox" id="board-includeArchived" name="includeArchived" value="1" {% if query.includeArchived == '1' %}checked{% endif %}>
          <label for="board-includeArchived">Include archived releases</label>
        </div>

        <button class="button" type="submit">Filter</button>
        <a class="button button-secondary" href="/releases?view=board">Clear</a>
      </form>
    </div>

    <div class="board-scroll" tabindex="0" aria-label="Release board columns">
      <div class="board-container">
        {% for status in ['idea', 'planned', 'drafting', 'ready', 'published', 'cancelled'] %}
          {% set column = columns[status] %}
          <div class="board-column">
            <h3 class="board-column-header">{% include "partials/status-badge.njk" %} <span class="count">({{ column.length }})</span></h3>
            <div class="board-column-content">
              {% if column.length > 0 %}
                {% for release in column %}
                  <div class="board-card{% if release.archived_at %} archived{% endif %}">
                    <div class="card-title"><a href="/releases/{{ release.id }}">{{ release.title }}</a></div>
                    <div class="card-project">{{ release.project_title }}</div>
                    <div class="card-meta">
                      {% if release.planned_date %}
                        <span class="card-date">{{ release.planned_date }}</span>
                      {% else %}
                        <span class="card-date unspecified">No date</span>
                      {% endif %}
                      <span class="card-assets">
                        {{ release.selected_asset_count }} asset{% if release.selected_asset_count != 1 %}s{% endif %}
                        {% if release.missing_asset_count > 0 %}
                          <span class="missing-indicator" title="{{ release.missing_asset_count }} missing">⚠ {{ release.missing_asset_count }}</span>
                        {% endif %}
                      </span>
                      {% if release._readiness %}
                        <span class="card-readiness">
                          {%- if release._readiness.publishable -%}
                            <span class="readiness-publishable">Publishable</span>
                          {%- else -%}
                            <span class="readiness-blocked">
                              {%- for label in release._readiness.blockerLabels -%}
                                {{ label }}{% if not loop.last %}; {% endif %}
                              {%- endfor -%}
                            </span>
                          {%- endif -%}
                        </span>
                      {% endif %}
                    </div>
                  </div>
                {% endfor %}
              {% else %}
                {% set emptyHeading = "No releases" %}
                {% set emptyDescription = "" %}
                {% set emptyHeadingLevel = "h4" %}
                {% include "partials/empty-state.njk" %}
              {% endif %}
            </div>
          </div>
        {% endfor %}
      </div>
    </div>

  {% else %}
    {# ─── List View ─── #}
    <form class="filters" method="get" action="/releases">
      <div class="field">
        <label for="list-project">Project</label>
        <input type="text" id="list-project" name="project" value="{{ query.project or '' }}" placeholder="Project ID">
      </div>

      <div class="field">
        <label for="list-status">Status</label>
        <select id="list-status" name="status">
          <option value="">All</option>
          {% for s in statuses %}
            <option value="{{ s }}" {% if query.status == s %}selected{% endif %}>{{ s | replace('-', ' ') | title }}</option>
          {% endfor %}
        </select>
      </div>

      <div class="field">
        <label for="list-schedule">Schedule</label>
        <select id="list-schedule" name="schedule">
          <option value="">All</option>
          <option value="overdue" {% if query.schedule == 'overdue' %}selected{% endif %}>Overdue</option>
          <option value="today" {% if query.schedule == 'today' %}selected{% endif %}>Today</option>
          <option value="upcoming" {% if query.schedule == 'upcoming' %}selected{% endif %}>Upcoming</option>
          <option value="unscheduled" {% if query.schedule == 'unscheduled' %}selected{% endif %}>Unscheduled</option>
        </select>
      </div>

      <div class="field">
        <label for="list-readiness">Readiness</label>
        <select id="list-readiness" name="readiness">
          <option value="all" {% if query.readiness == 'all' or not query.readiness %}selected{% endif %}>All</option>
          <option value="publishable" {% if query.readiness == 'publishable' %}selected{% endif %}>Publishable</option>
          <option value="blocked-ready" {% if query.readiness == 'blocked-ready' %}selected{% endif %}>Blocked (ready)</option>
        </select>
      </div>

      <div class="field">
        <label for="list-sort">Sort</label>
        <select id="list-sort" name="sort">
          {% for opt in sortOptions %}
            <option value="{{ opt }}" {% if query.sort == opt or (not query.sort and opt == 'updated') %}selected{% endif %}>{{ opt | replace('-', ' ') | title }}</option>
          {% endfor %}
        </select>
        <label for="list-order">Sort order</label>
        <select id="list-order" name="order">
          <option value="desc" {% if query.order != 'asc' %}selected{% endif %}>Desc</option>
          <option value="asc" {% if query.order == 'asc' %}selected{% endif %}>Asc</option>
        </select>
      </div>

      <div class="field field--checkbox">
        <input type="checkbox" id="list-includeArchived" name="includeArchived" value="1" {% if query.includeArchived == '1' %}checked{% endif %}>
        <label for="list-includeArchived">Include archived releases</label>
      </div>

      <button class="button" type="submit">Filter</button>
      <a class="button button-secondary" href="/releases">Clear</a>
    </form>

    <p class="results-meta">{{ total }} release{% if total != 1 %}s{% endif %} found</p>

    {% if releases.length > 0 %}
      <div class="table-scroll" tabindex="0" aria-label="Release list">
        <table class="data-table">
        <thead>
          <tr>
            <th>Title</th>
            <th>Project</th>
            <th>Status</th>
            <th>Readiness</th>
            <th>Planned</th>
            <th>Published</th>
            <th class="num">Assets</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          {% for release in releases %}
            <tr{% if release.archived_at %} class="archived-row"{% endif %}>
              <td><a href="/releases/{{ release.id }}">{{ release.title }}</a></td>
              <td>{{ release.project_title }}</td>
              <td>{% set status = release.status %}{% include "partials/status-badge.njk" %}</td>
              <td class="num">
                {% if release._readiness %}
                  {% if release._readiness.publishable %}
                    <span class="readiness-publishable">Publishable</span>
                  {% else %}
                    <span class="readiness-blocked">
                      {%- for label in release._readiness.blockerLabels -%}
                        {{ label }}{% if not loop.last %}; {% endif %}
                      {%- endfor -%}
                    </span>
                    {% if release._readiness.correctiveLinks %}
                      <span class="readiness-links">
                        {% for link in release._readiness.correctiveLinks %}
                          <a href="{{ link.href }}" class="readiness-link">{{ link.label }}</a>{% if not loop.last %} {% endif %}
                        {% endfor %}
                      </span>
                    {% endif %}
                  {% endif %}
                {% else %}
                  <span class="readiness-none">—</span>
                {% endif %}
              </td>
              <td>{{ release.planned_date or '—' }}</td>
              <td>{{ release.published_date or '—' }}</td>
              <td>
                {{ release.selected_asset_count }} asset{% if release.selected_asset_count != 1 %}s{% endif %}
                {% if release.missing_asset_count > 0 %}
                  <span class="missing-indicator" title="{{ release.missing_asset_count }} missing asset(s)">⚠</span>
                {% endif %}
              </td>
              <td>
                {% if release.archived_at %}
                  {% set status = 'archived' %}{% include "partials/status-badge.njk" %}
                {% endif %}
              </td>
            </tr>
          {% endfor %}
        </tbody>
      </table>
      </div>

      <nav class="pagination" aria-label="Release list pages">
        {% if page > 1 %}
          <a class="button" href="{{ pageUrl({ page: page - 1 }) }}">Previous</a>
        {% endif %}

        <span>Page {{ page }} of {{ pageCount }}</span>

        {% if page < pageCount %}
          <a class="button" href="{{ pageUrl({ page: page + 1 }) }}">Next</a>
        {% endif %}
      </nav>
    {% else %}
      {% set releaseFiltersActive = query.project or query.status or query.schedule or query.includeArchived == '1' or (query.readiness and query.readiness != 'all') %}
      {% if releaseFiltersActive and hasAnyReleases %}
        {% set emptyHeading = "No releases match the current filters" %}
        {% set emptyDescription = "Reset the filters to return to the full release list." %}
        {% set emptyActionUrl = "/releases" %}
        {% set emptyActionLabel = "Reset Filters" %}
      {% else %}
        {% set emptyHeading = "No releases yet" %}
        {% set emptyDescription = "Create a release to start tracking publication workflow." %}
        {% set emptyActionUrl = "/releases/new" %}
        {% set emptyActionLabel = "New Release" %}
      {% endif %}
      {% set emptyHeadingLevel = "h2" %}
      {% include "partials/empty-state.njk" %}
    {% endif %}
  {% endif %}
{% endblock %}
