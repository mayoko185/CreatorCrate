{% extends "layout.njk" %}

{% block content %}
  <div class="page-header">
    <h1>Releases</h1>
    <div class="header-actions">
      <div class="view-switcher">
        {% if view === 'board' %}
          <a class="button" href="{{ pageUrl({ view: 'list' }) }}">List</a>
          <span class="button button-primary">Board</span>
        {% else %}
          <span class="button button-primary">List</span>
          <a class="button" href="{{ pageUrl({ view: 'board' }) }}">Board</a>
        {% endif %}
        <a class="button" href="/releases/calendar{% if query.month %}?month={{ query.month }}{% endif %}">Calendar</a>
      </div>
      <a class="button button-primary" href="/releases/new">New Release</a>
    </div>
  </div>

  {% if view === 'board' %}
    {# ─── Board View ─── #}
    <div class="board-filters">
      <form method="get" action="/releases">
        <input type="hidden" name="view" value="board">
        <div class="field">
          <label for="project">Project</label>
          <input type="text" id="project" name="project" value="{{ query.project or '' }}" placeholder="Project ID">
        </div>
        <div class="field">
          <label for="status">Status</label>
          <select id="status" name="status">
            <option value="">All</option>
            {% for s in statuses %}
              <option value="{{ s }}" {% if query.status == s %}selected{% endif %}>{{ s | replace('-', ' ') | title }}</option>
            {% endfor %}
          </select>
        </div>
        <div class="field">
          <label for="schedule">Schedule</label>
          <select id="schedule" name="schedule">
            <option value="">All</option>
            <option value="overdue" {% if query.schedule == 'overdue' %}selected{% endif %}>Overdue</option>
            <option value="today" {% if query.schedule == 'today' %}selected{% endif %}>Today</option>
            <option value="upcoming" {% if query.schedule == 'upcoming' %}selected{% endif %}>Upcoming</option>
            <option value="unscheduled" {% if query.schedule == 'unscheduled' %}selected{% endif %}>Unscheduled</option>
          </select>
        </div>

        <div class="field" style="flex-direction: row; align-items: center; gap: 0.5rem;">
          <input type="checkbox" id="includeArchived" name="includeArchived" value="1" {% if query.includeArchived == '1' %}checked{% endif %}>
          <label for="includeArchived" style="min-width: auto;">Include archived releases</label>
        </div>

        <button class="button" type="submit">Filter</button>
        <a class="button button-secondary" href="/releases?view=board">Clear</a>
      </form>
    </div>

    <div class="board-container">
      {% for status in ['idea', 'planned', 'drafting', 'ready', 'published', 'cancelled'] %}
        {% set column = columns[status] %}
        <div class="board-column">
          <h3 class="board-column-header status-{{ status }}">{{ status | replace('-', ' ') | title }} <span class="count">({{ column.length }})</span></h3>
          <div class="board-column-content">
            {% if column.length > 0 %}
              {% for release in column %}
                <div class="board-card{% if release.archived_at %} archived{% endif %}">
                  <div class="card-title"><a href="/releases/{{ release.id }}">{{ release.title }}</a></div>
                  <div class="card-project">{{ release.project_title }}</div>
                  <div class="card-meta">
                    {% if release.planned_date %}
                      <span class="card-date">{{ release.planned_date }}</span>
                    {% else %}
                      <span class="card-date unspecified">No date</span>
                    {% endif %}
                    <span class="card-assets">
                      {{ release.selected_asset_count }} asset{% if release.selected_asset_count != 1 %}s{% endif %}
                      {% if release.missing_asset_count > 0 %}
                        <span class="missing-indicator" title="{{ release.missing_asset_count }} missing">⚠ {{ release.missing_asset_count }}</span>
                      {% endif %}
                    </span>
                    {% if release._readiness %}
                      <span class="card-readiness">
                        {%- if release._readiness.publishable -%}
                          <span class="readiness-publishable">Publishable</span>
                        {%- else -%}
                          <span class="readiness-blocked">Blocked</span>
                        {%- endif -%}
                      </span>
                    {% endif %}
                  </div>
                </div>
              {% endfor %}
            {% else %}
              <p class="board-empty">No releases</p>
            {% endif %}
          </div>
        </div>
      {% endfor %}
    </div>

  {% else %}
    {# ─── List View ─── #}
    <form class="filters" method="get" action="/releases">
      <div class="field">
        <label for="project">Project</label>
        <input type="text" id="project" name="project" value="{{ query.project or '' }}" placeholder="Project ID">
      </div>

      <div class="field">
        <label for="status">Status</label>
        <select id="status" name="status">
          <option value="">All</option>
          {% for s in statuses %}
            <option value="{{ s }}" {% if query.status == s %}selected{% endif %}>{{ s | replace('-', ' ') | title }}</option>
          {% endfor %}
        </select>
      </div>

      <div class="field">
        <label for="schedule">Schedule</label>
        <select id="schedule" name="schedule">
          <option value="">All</option>
          <option value="overdue" {% if query.schedule == 'overdue' %}selected{% endif %}>Overdue</option>
          <option value="today" {% if query.schedule == 'today' %}selected{% endif %}>Today</option>
          <option value="upcoming" {% if query.schedule == 'upcoming' %}selected{% endif %}>Upcoming</option>
          <option value="unscheduled" {% if query.schedule == 'unscheduled' %}selected{% endif %}>Unscheduled</option>
        </select>
      </div>

      <div class="field">
        <label for="sort">Sort</label>
        <select id="sort" name="sort">
          {% for opt in sortOptions %}
            <option value="{{ opt }}" {% if query.sort == opt or (not query.sort and opt == 'updated') %}selected{% endif %}>{{ opt | replace('-', ' ') | title }}</option>
          {% endfor %}
        </select>
        <select name="order">
          <option value="desc" {% if query.order != 'asc' %}selected{% endif %}>Desc</option>
          <option value="asc" {% if query.order == 'asc' %}selected{% endif %}>Asc</option>
        </select>
      </div>

      <div class="field" style="flex-direction: row; align-items: center; gap: 0.5rem;">
        <input type="checkbox" id="includeArchived" name="includeArchived" value="1" {% if query.includeArchived == '1' %}checked{% endif %}>
        <label for="includeArchived" style="min-width: auto;">Include archived releases</label>
      </div>

      <button class="button" type="submit">Filter</button>
      <a class="button button-secondary" href="/releases">Clear</a>
    </form>

    <p class="results-meta">{{ total }} release{% if total != 1 %}s{% endif %} found</p>

    {% if releases.length > 0 %}
      <table class="project-table">
        <thead>
          <tr>
            <th>Title</th>
            <th>Project</th>
            <th>Status</th>
            <th>Readiness</th>
            <th>Planned</th>
            <th>Published</th>
            <th>Assets</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          {% for release in releases %}
            <tr{% if release.archived_at %} class="archived-row"{% endif %}>
              <td><a href="/releases/{{ release.id }}">{{ release.title }}</a></td>
              <td>{{ release.project_title }}</td>
              <td>{{ release.status | replace('-', ' ') | title }}</td>
              <td>
                {% if release._readiness %}
                  {% if release._readiness.publishable %}
                    <span class="readiness-publishable">Publishable</span>
                  {% else %}
                    <span class="readiness-blocked">
                      Blocked
                      {%- if release._readiness.blockerCount %} ({{ release._readiness.blockerCount }}){% endif -%}
                    </span>
                  {% endif %}
                {% else %}
                  <span class="readiness-none">—</span>
                {% endif %}
              </td>
              <td>{{ release.planned_date or '—' }}</td>
              <td>{{ release.published_date or '—' }}</td>
              <td>
                {{ release.selected_asset_count }} asset{% if release.selected_asset_count != 1 %}s{% endif %}
                {% if release.missing_asset_count > 0 %}
                  <span class="missing-indicator" title="{{ release.missing_asset_count }} missing asset(s)">⚠</span>
                {% endif %}
              </td>
              <td>
                {% if release.archived_at %}
                  <span class="archived-badge">Archived</span>
                {% endif %}
              </td>
            </tr>
          {% endfor %}
        </tbody>
      </table>

      <nav class="pagination" aria-label="Release list pages">
        {% if page > 1 %}
          <a class="button" href="{{ pageUrl({ page: page - 1 }) }}">Previous</a>
        {% endif %}

        <span>Page {{ page }} of {{ pageCount }}</span>

        {% if page < pageCount %}
          <a class="button" href="{{ pageUrl({ page: page + 1 }) }}">Next</a>
        {% endif %}
      </nav>
    {% else %}
      <p class="placeholder">No releases match the current filters.</p>
    {% endif %}
  {% endif %}

  <style>
    .header-actions {
      display: flex;
      gap: 1rem;
      align-items: center;
    }
    .view-switcher {
      display: flex;
      gap: 0.25rem;
    }
    .board-filters {
      margin-bottom: 1rem;
      padding: 1rem;
      background: var(--surface);
      border-radius: 0.5rem;
    }
    .board-filters form {
      display: flex;
      gap: 1rem;
      align-items: flex-end;
      flex-wrap: wrap;
    }
    .board-container {
      display: grid;
      grid-template-columns: repeat(6, 1fr);
      gap: 1rem;
      overflow-x: auto;
      min-width: 0;
    }
    .board-column {
      background: var(--surface);
      border-radius: 0.5rem;
      padding: 0.75rem;
      min-width: 12rem;
    }
    .board-column-header {
      margin: 0 0 0.75rem 0;
      padding: 0.25rem 0.5rem;
      border-radius: 0.25rem;
      font-size: 0.875rem;
      text-transform: uppercase;
      letter-spacing: 0.05em;
    }
    .board-column-header .count {
      color: var(--muted);
      font-weight: normal;
    }
    .board-column-header.status-idea { background: rgba(136,136,136,0.2); }
    .board-column-header.status-planned { background: rgba(74,158,255,0.2); }
    .board-column-header.status-drafting { background: rgba(245,166,35,0.2); }
    .board-column-header.status-ready { background: rgba(70,180,100,0.2); }
    .board-column-header.status-published { background: rgba(70,180,100,0.3); }
    .board-column-header.status-cancelled { background: rgba(229,72,77,0.2); }
    .board-column-content {
      display: flex;
      flex-direction: column;
      gap: 0.5rem;
    }
    .board-card {
      background: var(--bg);
      border-radius: 0.375rem;
      padding: 0.5rem;
      font-size: 0.8rem;
    }
    .board-card.archived {
      opacity: 0.5;
    }
    .card-title {
      font-weight: 600;
      margin-bottom: 0.25rem;
    }
    .card-title a {
      color: var(--text);
      text-decoration: none;
    }
    .card-title a:hover {
      text-decoration: underline;
    }
    .card-project {
      color: var(--muted);
      font-size: 0.7rem;
      margin-bottom: 0.25rem;
    }
    .card-meta {
      display: flex;
      flex-direction: column;
      gap: 0.125rem;
      color: var(--muted);
      font-size: 0.7rem;
    }
    .card-date.unspecified {
      font-style: italic;
      opacity: 0.7;
    }
    .card-assets {
      display: flex;
      gap: 0.25rem;
      align-items: center;
    }
    .board-empty {
      color: var(--muted);
      font-size: 0.8rem;
      text-align: center;
      padding: 1rem;
    }
    .archived-row {
      opacity: 0.6;
    }
    .archived-badge {
      font-size: 0.7rem;
      background: rgba(136,136,136,0.3);
      padding: 0.125rem 0.375rem;
      border-radius: 0.25rem;
    }
    .card-readiness {
      margin-top: 0.125rem;
    }
    .readiness-publishable {
      color: #46b464;
      font-size: 0.7rem;
      font-weight: 600;
    }
    .readiness-blocked {
      color: #e5484d;
      font-size: 0.7rem;
      font-weight: 600;
    }
    .readiness-none {
      color: var(--muted);
      font-size: 0.7rem;
    }
  </style>
{% endblock %}
