{% extends "layout.njk" %}
{% import "partials/page-heading.njk" as pageHeading %}
{% import "partials/dialog.njk" as dialog %}
{% import "partials/dropdown.njk" as dropdown %}
{% import "partials/icons.njk" as icons %}
{% import "partials/asset-presentation.njk" as assetCards %}
{% import "partials/asset-information.njk" as assetInformation %}
{% import "partials/view-switcher.njk" as viewSwitcher %}

{% set page_title = "Releases — " ~ release.title ~ " — Assets" %}

{% macro releaseAssetSelectionControl(asset, readOnly) %}
  {% if not readOnly and (asset.is_present or asset.releaseContext.selected) %}
    {% set selectionLabel = "Deselect " ~ asset.filename if asset.releaseContext.selected else "Select " ~ asset.filename %}
    <label class="asset-selection-control{% if asset.releaseContext.selected %} is-selected{% endif %}" for="release-asset-select-{{ asset.id }}">
      <input type="checkbox" form="release-assets-form" id="release-asset-select-{{ asset.id }}" name="selectedAssetIds" value="{{ asset.id }}"
             class="asset-select-checkbox"
             aria-label="{{ selectionLabel }}"
             {% if asset.releaseContext.selected %}checked{% endif %}>
      <span class="asset-selection-control-mark" aria-hidden="true">✓</span>
    </label>
  {% endif %}
{% endmacro %}

{% macro releaseRoleControl(asset, roles, _csrf, assetActionUrl) %}
  {% if asset.releaseContext.selected %}
    {% set role = asset.releaseContext.role or 'attachment' %}
    <form method="post" action="{{ assetActionUrl(asset.id, 'role') }}" class="inline-form release-asset-role-form">
      <input type="hidden" name="_csrf" value="{{ _csrf }}">
      <label for="role-{{ asset.id }}" class="sr-only">Role for {{ asset.filename }}</label>
      <select id="role-{{ asset.id }}" name="role" data-autosubmit>
        {% for option in roles %}
          <option value="{{ option }}" {% if role == option %}selected{% endif %}>{{ option | title }}</option>
        {% endfor %}
      </select>
    </form>
  {% endif %}
{% endmacro %}

{% macro releaseGridRole(asset, readOnly, roles, _csrf, assetActionUrl) %}
  {% if asset.releaseContext.selected %}
    <div class="release-asset-grid-role">
      <span class="release-asset-grid-role-label">Role</span>
      {% if readOnly %}
        <span class="release-asset-grid-role-value">{{ (asset.releaseContext.role or 'attachment') | title }}</span>
      {% else %}
        {{ releaseRoleControl(asset, roles, _csrf, assetActionUrl) }}
      {% endif %}
    </div>
  {% endif %}
{% endmacro %}

{# Release-specific role/order/path content inside the shared list hierarchy. #}
{% macro releaseAssetInfo(asset, readOnly, roles, _csrf, assetActionUrl) %}
  <div class="asset-list-card-associations">
    {% if asset.releaseContext.selected %}
      <div class="asset-list-card-association asset-list-card-association--role">
        <h3 class="asset-list-card-association-label">Role</h3>
        <div class="asset-list-card-association-content">
          {% if readOnly %}
            <span>{{ (asset.releaseContext.role or 'attachment') | title }}</span>
          {% else %}
            {{ releaseRoleControl(asset, roles, _csrf, assetActionUrl) }}
          {% endif %}
        </div>
      </div>
      <div class="asset-list-card-association asset-list-card-association--order">
        <h3 class="asset-list-card-association-label">Order</h3>
        <div class="asset-list-card-association-content">
          <span>{{ asset.releaseContext.sortOrder }}</span>
        </div>
      </div>
    {% endif %}
    {% if asset.relative_path %}
      <div class="asset-list-card-association asset-list-card-association--path">
        <h3 class="asset-list-card-association-label">Path</h3>
        <div class="asset-list-card-association-content">
          <code>{{ asset.relative_path }}</code>
        </div>
      </div>
    {% endif %}
  </div>
{% endmacro %}

{# Grid card — Project Assets preview-only geometry with Release selection and
   role state in the compact top action row. #}
{% macro releaseGridCard(asset, readOnly, roles, _csrf, assetActionUrl) %}
  {% call(slot) assetCards.gridCard(asset, {
    projectLayout: true,
    cardClass: 'asset-card--release',
    selected: asset.releaseContext.selected,
    selectable: not readOnly and (asset.is_present or asset.releaseContext.selected),
    selectableTabIndex: true,
    assetInformation: true,
    detailsPresenceStatus: true,
    hideBody: true
  }) %}
    {% if slot == 'top-start' %}
      {{ releaseAssetSelectionControl(asset, readOnly) }}
    {% elif slot == 'top-end' %}
      {{ releaseGridRole(asset, readOnly, roles, _csrf, assetActionUrl) }}
    {% elif slot == 'asset-information' %}
      {{ assetInformation.render(asset, {
        showProjectName: false,
        showDimensions: false,
        showReleaseUsage: false,
        showEffectiveTags: false,
        showProjectSummary: false
      }) }}
    {% endif %}
  {% endcall %}
{% endmacro %}

{# List card — Project Assets hierarchy/sizing with Release associations. #}
{% macro releaseListCard(asset, readOnly, roles, _csrf, assetActionUrl) %}
  {% call(slot) assetCards.listCard(asset, {
    cardClass: 'asset-list-card--project asset-list-card--release',
    projectLayout: true,
    headerStatusDetails: true,
    titleControls: true,
    filenameLink: false,
    hideActions: true,
    detailsPresenceStatus: true,
    selected: asset.releaseContext.selected,
    selectable: not readOnly and (asset.is_present or asset.releaseContext.selected)
  }) %}
    {% if slot == 'top' %}
      {{ releaseAssetSelectionControl(asset, readOnly) }}
    {% elif slot == 'associations' %}
      {{ releaseAssetInfo(asset, readOnly, roles, _csrf, assetActionUrl) }}
    {% endif %}
  {% endcall %}
{% endmacro %}

{% block content %}
  {% set releaseArchived = release and release.archived_at %}
  {% set isPublished = release and release.published_date %}
  {% set isArchived = projectArchived or releaseArchived %}
  {% set readOnly = isArchived or isPublished %}
  {% set projectLeadHref = "/projects/" ~ project.id if project and project.id else "" %}
  {% set projectLeadLabel = "Back to main project page: " ~ project.title if project else "" %}
  {% call pageHeading.render("", "", "", projectLeadHref, projectLeadLabel, "", "projects", "/releases/" ~ release.id, "Back to Release", "", "releases") %}
    {% if not readOnly %}
      <form id="release-assets-form" method="post" action="{{ pageUrl({}) }}" class="inline-form" data-asset-selection-form>
        <input type="hidden" name="_csrf" value="{{ _csrf }}">
        <span data-release-assets-hidden-membership>
          {% for assetId in offPageSelectedAssetIds or [] %}
            <input type="hidden" name="selectedAssetIds" value="{{ assetId }}">
          {% endfor %}
        </span>
        <span data-release-assets-persisted-membership>
          {% for assetId in persistedSelectedAssetIds or [] %}
            <input type="hidden" data-release-assets-persisted-id value="{{ assetId }}">
          {% endfor %}
        </span>
        <button class="button button-small button-primary project-detail-action project-assets-heading-action asset-tooltip asset-tooltip--left"
                type="submit" aria-label="Save Selection" data-tooltip="Save Selection">
          {{ icons.icon('assets') }}
        </button>
      </form>
    {% endif %}
  {% endcall %}

  {% if isArchived %}
    {% set noticeVariant = "warning" %}
    {% set noticeText = "This release is archived. Asset selections are read-only." if releaseArchived else "The parent project is archived. Asset selections are read-only." %}
    {% include "partials/notice.njk" %}
  {% endif %}

  {% if isPublished and not isArchived %}
    {% set noticeVariant = "warning" %}
    {% set noticeText = "This release is published. Asset selections are locked and read-only." %}
    {% include "partials/notice.njk" %}
  {% endif %}

  <p class="meta release-workflow-status">
    {% set status = project.status if project else release.project_status %}
    {% include "partials/status-badge.njk" %}
  </p>

  {% if errors.general or errors.assets %}
    <div class="error-summary" role="alert">
      <p>{{ errors.general or errors.assets }}</p>
    </div>
  {% endif %}

  {% if errors.role %}
    <div class="error-summary" role="alert">
      <p>{{ errors.role }}</p>
    </div>
  {% endif %}

  <section data-release-assets-live-region>
    <span class="sr-only" data-release-assets-live-status aria-live="polite" aria-atomic="true"></span>
    {% set selectedAssets = assetPresentation.selected or [] %}
    {% set pageAssets = assetPresentation.assets or [] %}
    {% set selectedCount = selectedAssets.length %}
    {% set displayAssets = selectedAssets if readOnly else pageAssets %}
    {% set activeFilters = assetFilters or candidateFilters %}
    {% set totalAssets = assetTotal if assetTotal is defined else candidateTotal %}
    {% set currentPage = assetPageNumber if assetPageNumber is defined else candidatePage %}
    {% set totalPages = assetPageCount if assetPageCount is defined else candidatePageCount %}
    {% set currentPageSize = assetPageSize if assetPageSize is defined else candidatePageSize %}
    {% set extensionOptions = assetExtensions or candidateExtensions %}
    {% set categoryTotalCount = categoryNavigation and categoryNavigation.totalCount %}
    {% set categoryFilterSummary = "All categories" %}
    {% if categoryTotalCount is not none %}
      {% set categoryFilterSummary = "All categories (" ~ categoryTotalCount ~ ")" %}
    {% endif %}
    {% for category in categoryFilterOptions %}
      {% if activeCategoryId == category.id %}
        {% set categoryFilterSummary = category.displayName ~ " (" ~ category.assetCount ~ ")" %}
      {% endif %}
    {% endfor %}
    {% set categoryFilterOptions = categoryFilterOptions or [] %}
    {% set extensionFilterSummary = "All extensions" %}
    {% if activeFilters.extension %}
      {% set extensionFilterSummary = "." ~ activeFilters.extension %}
    {% endif %}

    <div class="asset-browser-layout">
      <div class="asset-browser-content">
        <div class="asset-viewer-display-controls">
          {% set gridSizeLabelsInteractive = true %}
          {{ viewSwitcher.render(view, pageUrl, "Asset display", true) }}
          {% if view == 'grid' %}
            {% set assetSizeControlMode = 'grid' %}
            {% include "partials/asset-grid-size-control.njk" %}
          {% elif view == 'list' %}
            {% set assetSizeControlMode = 'list' %}
            {% include "partials/asset-grid-size-control.njk" %}
          {% endif %}

          {% if not readOnly %}
            <div class="project-filter-actions project-filter-actions--projects">
              <a class="button button-small button-secondary project-filter-control asset-tooltip asset-tooltip--left"
                 href="#release-assets-filter-dialog" aria-label="Filter assets"
                 data-dialog-open="release-assets-filter-dialog" data-tooltip="Filter assets">
                {{ icons.icon('content-filter') }}
              </a>
            </div>
          {% endif %}
        </div>

        {% if not readOnly %}
          <p class="results-meta release-asset-results-meta">
            {{ totalAssets }} project asset{% if totalAssets != 1 %}s{% endif %} {% if totalAssets == 1 %}matches{% else %}match{% endif %} the current filters.
          </p>
        {% endif %}

        {% if displayAssets.length > 0 %}
          {% if view == 'grid' %}
            <ul class="asset-grid" role="listbox" aria-label="Release assets">
              {% for asset in displayAssets %}
                <li class="asset-grid-item{% if not asset.is_present %} is-missing{% endif %}">
                  {{ releaseGridCard(asset, readOnly, roles, _csrf, releaseAssetActionUrl) }}
                </li>
              {% endfor %}
            </ul>
          {% else %}
            <ul class="asset-list asset-list--project asset-list--release" role="list" aria-label="Release assets" data-list-size="large">
              {% for asset in displayAssets %}
                <li class="asset-list-item{% if not asset.is_present %} is-missing{% endif %}">
                  {{ releaseListCard(asset, readOnly, roles, _csrf, releaseAssetActionUrl) }}
                </li>
              {% endfor %}
            </ul>
          {% endif %}

        {% else %}
          {% if readOnly %}
            {% set emptyHeading = "No assets selected" %}
            {% set emptyDescription = "No assets are associated with this release." %}
          {% elif totalAssets == 0 and (activeFilters.search or activeFilters.extension or activeCategoryId != null) %}
            {% set emptyHeading = "No matching project assets" %}
            {% set emptyDescription = "No eligible project assets match the current filters." %}
          {% elif eligibleAssetCount == 0 %}
            {% set emptyHeading = "No project assets" %}
            {% set emptyDescription = "This project has no present assets eligible for this release." %}
          {% elif not readOnly %}
            {% set emptyHeading = "No project assets" %}
            {% set emptyDescription = "No project assets are available for this release." %}
          {% endif %}
          {% set emptyHeadingLevel = "h2" %}
          {% include "partials/empty-state.njk" %}
        {% endif %}

        {% if displayAssets.length > 0 and not readOnly and totalPages > 1 %}
          <nav class="pagination" aria-label="Release asset pages">
            {% if currentPage > 1 %}
              <a class="pagination-prev" href="{{ pageUrl({ page: currentPage - 1 }) }}">Previous</a>
            {% endif %}
            <span class="pagination-info">Page {{ currentPage }} of {{ totalPages }}</span>
            {% if currentPage < totalPages %}
              <a class="pagination-next" href="{{ pageUrl({ page: currentPage + 1 }) }}">Next</a>
            {% endif %}
          </nav>
        {% endif %}

        {% if not readOnly %}
          <form class="page-size-form" method="get" action="/releases/{{ release.id }}/assets" data-release-assets-live-page-size-form>
            <label for="pageSize">Assets per page:</label>
            <select id="pageSize" name="pageSize" data-autosubmit data-release-assets-live-page-size>
              <option value="10" {% if currentPageSize == 10 %}selected{% endif %}>10</option>
              <option value="25" {% if currentPageSize == 25 %}selected{% endif %}>25</option>
              <option value="50" {% if currentPageSize == 50 %}selected{% endif %}>50</option>
              <option value="100" {% if currentPageSize == 100 %}selected{% endif %}>100</option>
              <option value="150" {% if currentPageSize == 150 %}selected{% endif %}>150</option>
              <option value="200" {% if currentPageSize == 200 %}selected{% endif %}>200</option>
              <option value="all" {% if currentPageSize == 'all' %}selected{% endif %}>View All</option>
            </select>
            {% if activeFilters.search %}
              <input type="hidden" name="search" value="{{ activeFilters.search }}">
            {% endif %}
            {% if activeFilters.extension %}
              <input type="hidden" name="extension" value="{{ activeFilters.extension }}">
            {% endif %}
            {% if activeCategoryId != null %}
              <input type="hidden" name="category" value="{{ activeCategoryId }}">
            {% endif %}
            {% if view == 'list' %}
              <input type="hidden" name="view" value="list">
            {% endif %}
            <noscript><button class="button button-small" type="submit">Apply</button></noscript>
          </form>
        {% endif %}
      </div>
    </div>
  </section>
{% endblock %}

{% block overlay %}
  {% set releaseArchived = release and release.archived_at %}
  {% set isPublished = release and release.published_date %}
  {% set isArchived = projectArchived or releaseArchived %}
  {% set readOnly = isArchived or isPublished %}
  {% if not readOnly %}
    {% set activeFilters = assetFilters or candidateFilters %}
    {% set currentPageSize = assetPageSize if assetPageSize is defined else candidatePageSize %}
    {% set extensionOptions = assetExtensions or candidateExtensions %}
    {% set categoryFilterOptions = categoryFilterOptions or [] %}
    {% set categoryTotalCount = categoryNavigation and categoryNavigation.totalCount %}
    {% set categoryFilterSummary = "All categories" %}
    {% if categoryTotalCount is not none %}
      {% set categoryFilterSummary = "All categories (" ~ categoryTotalCount ~ ")" %}
    {% endif %}
    {% for category in categoryFilterOptions %}
      {% if activeCategoryId == category.id %}
        {% set categoryFilterSummary = category.displayName ~ " (" ~ category.assetCount ~ ")" %}
      {% endif %}
    {% endfor %}
    {% set extensionFilterSummary = "All extensions" %}
    {% if activeFilters.extension %}
      {% set extensionFilterSummary = "." ~ activeFilters.extension %}
    {% endif %}

    {% set extensionFilterOptions = [{
      id: "release-asset-extension-option-all",
      value: "",
      label: "All extensions",
      attributes: [["data-release-assets-live-filter-control", true]]
    }] %}
    {% for ext in extensionOptions %}
      {% set _ = extensionFilterOptions.push({
        id: "release-asset-extension-option-" ~ loop.index,
        value: ext,
        label: "." ~ ext,
        attributes: [["data-release-assets-live-filter-control", true]]
      }) %}
    {% endfor %}

    {% set releaseCategoryFilterOptions = [{
      id: "release-asset-category-option-all",
      value: "",
      label: "All categories (" ~ categoryTotalCount ~ ")" if categoryTotalCount is not none else "All categories",
      attributes: [["data-release-assets-live-filter-control", true]]
    }] %}
    {% for category in categoryFilterOptions %}
      {% set _ = releaseCategoryFilterOptions.push({
        id: "release-asset-category-option-" ~ category.id,
        value: category.id ~ "",
        label: category.displayName ~ " (" ~ category.assetCount ~ ")",
        attributes: [["data-release-assets-live-filter-control", true]]
      }) %}
    {% endfor %}

    {% call dialog.render('release-assets-filter-dialog', 'Filter') %}
      <form id="release-assets-filter" class="app-dialog-form project-form release-assets-filter-dialog-form" method="get" action="/releases/{{ release.id }}/assets" data-release-assets-live-filter>
        <div class="app-dialog-body">
          <div class="page-defaults-grid">
            <input type="hidden" name="view" value="{{ view }}">
            <div class="app-dialog-field field">
              <label for="asset-search">Find project assets</label>
              <input type="search" id="asset-search" name="search" value="{{ activeFilters.search or '' }}" placeholder="Filter by filename…" autocomplete="off" data-release-assets-live-search>
            </div>
            {{ dropdown.singleSelect({
              id: "release-asset-extension-filter",
              name: "extension",
              label: "Extension",
              fieldClasses: "app-dialog-field asset-viewer-filter-field",
              attributes: [["data-cc-viewport-disclosure", true]],
              options: extensionFilterOptions,
              selected: activeFilters.extension or "",
              summary: extensionFilterSummary,
              panelLabel: "Extension options"
            }) }}
            {{ dropdown.singleSelect({
              id: "release-asset-category-filter",
              name: "category",
              label: "Category",
              fieldClasses: "app-dialog-field asset-viewer-filter-field",
              attributes: [["data-cc-viewport-disclosure", true]],
              options: releaseCategoryFilterOptions,
              selected: activeCategoryId ~ "" if activeCategoryId != null else "",
              summary: categoryFilterSummary,
              panelLabel: "Category options"
            }) }}
            {{ dropdown.singleSelect({
              id: "release-asset-page-size-dropdown",
              name: "pageSize",
              label: "Page size",
              fieldClasses: "app-dialog-field asset-viewer-filter-field",
              attributes: [["data-cc-viewport-disclosure", true]],
              dispatchNativeChange: true,
              selected: (currentPageSize if currentPageSize is defined and currentPageSize is not none else 10) ~ "",
              options: [
                { value: "10", label: "10" },
                { value: "25", label: "25" },
                { value: "50", label: "50" },
                { value: "100", label: "100" },
                { value: "150", label: "150" },
                { value: "200", label: "200" },
                { value: "all", label: "View All" }
              ],
              panelLabel: "Page size options",
              nativeSelect: {
                id: "asset-page-size",
                attributes: [["data-release-assets-live-page-size", true]]
              }
            }) }}
          </div>
        </div>
        {% if activeFilters.search or activeFilters.extension or activeCategoryId != null %}
          <a class="button button-secondary" href="{{ pageUrl({ search: '', extension: '', category: '', page: 1 }) }}" data-release-assets-reset>Clear</a>
        {% endif %}
      </form>
    {% endcall %}
  {% endif %}
{% endblock %}
