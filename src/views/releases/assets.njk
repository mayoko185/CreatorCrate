{% extends "layout.njk" %}
{% import "partials/page-heading.njk" as pageHeading %}

{% set page_title = "Releases — " ~ release.title ~ " — Assets" %}

{% block content %}
  {% set projectArchived = project and project.archived_at %}
  {% set releaseArchived = release and release.archived_at %}
  {% set isPublished = release and release.status == 'published' %}
  {% set isArchived = projectArchived or releaseArchived %}
  {% set readOnly = isArchived or isPublished %}
  {% call pageHeading.render() %}
    <a class="button button-secondary" href="/releases/{{ release.id }}">Back to Release</a>
  {% endcall %}

  {% if isArchived %}
    {% set noticeVariant = "warning" %}
    {% set noticeText = "This release is archived. Asset selections are read-only." if releaseArchived else "The parent project is archived. Asset selections are read-only." %}
    {% include "partials/notice.njk" %}
  {% endif %}

  {% if isPublished and not isArchived %}
    {% set noticeVariant = "warning" %}
    {% set noticeText = "This release is published. Asset selections are locked and read-only." %}
    {% include "partials/notice.njk" %}
  {% endif %}

  {% if errors.general or errors.assets %}
    <div class="error-summary" role="alert">
      <p>{{ errors.general or errors.assets }}</p>
    </div>
  {% endif %}

  {% if errors.role %}
    <div class="error-summary" role="alert">
      <p>{{ errors.role }}</p>
    </div>
  {% endif %}

  {# ── Role Guidance ────────────────────────────────────────────────── #}
  <section class="role-guidance panel panel--info" aria-label="Asset role descriptions">
    <h2>Asset Roles</h2>
    <dl class="role-descriptions">
      <div class="role-entry">
        <dt>Primary</dt>
        <dd>The main asset for this release — typically the primary deliverable such as the final image, video, or document that the release is built around.</dd>
      </div>
      <div class="role-entry">
        <dt>Preview</dt>
        <dd>A preview or teaser asset shown before the release is fully consumed — for example, a thumbnail, excerpt, or sample clip.</dd>
      </div>
      <div class="role-entry">
        <dt>Attachment</dt>
        <dd>A supporting asset bundled with the release — such as a PSD source, a PDF, a ZIP archive, or supplementary material.</dd>
      </div>
      <div class="role-entry">
        <dt>Source</dt>
        <dd>The editable or original source file from which the primary asset was derived — for example, a .blend, .psd, .ai, or .xcf file.</dd>
      </div>
    </dl>
  </section>

  {# ── Selected Assets ──────────────────────────────────────────────── #}
  <section>
    <h2>Selected Assets</h2>
    {% if releaseAssets.length > 0 %}
      <div class="table-scroll" tabindex="0" aria-label="Selected release assets">
        <table class="data-table">
          <thead>
            <tr>
              <th>Filename</th>
              <th>Role</th>
              <th>Path</th>
              <th>Status</th>
              <th class="num">Order</th>
              {% if not readOnly %}
                <th>Actions</th>
              {% endif %}
            </tr>
          </thead>
          <tbody>
            {% for ra in releaseAssets %}
              <tr>
                <td class="asset-filename">{{ ra.filename }}</td>
                <td>
                  {% if not readOnly %}
                    <form method="post" action="/releases/{{ release.id }}/assets/{{ ra.asset_id }}/role" class="inline-form">
                      <input type="hidden" name="_csrf" value="{{ _csrf }}">
                      <label for="role-{{ ra.asset_id }}" class="sr-only">Role for {{ ra.filename }}</label>
                      <select id="role-{{ ra.asset_id }}" name="role" data-autosubmit>
                        {% for role in roles %}
                          <option value="{{ role }}" {% if ra.role == role %}selected{% endif %}>{{ role | title }}</option>
                        {% endfor %}
                      </select>
                      <noscript><button class="button button-small" type="submit">Set</button></noscript>
                    </form>
                  {% else %}
                    {{ ra.role | title }}
                  {% endif %}
                </td>
                <td class="asset-path"><code>{{ ra.relative_path }}</code></td>
                <td>
                  {% if ra.is_present == 1 %}
                    {% set status = 'present' %}{% include "partials/status-badge.njk" %}
                  {% else %}
                    {% set status = 'missing' %}{% include "partials/status-badge.njk" %}
                  {% endif %}
                </td>
                <td class="num">{{ ra.sort_order }}</td>
                {% if not readOnly %}
                  <td>
                    <div class="row-actions release-asset-actions">
                      <form method="post" action="/releases/{{ release.id }}/assets/{{ ra.asset_id }}/remove-selected" class="inline-form">
                        <input type="hidden" name="_csrf" value="{{ _csrf }}">
                        <button class="button button-small button-danger" type="submit" aria-label="Remove {{ ra.filename }}">Remove</button>
                      </form>
                      <form method="post" action="/releases/{{ release.id }}/assets/{{ ra.asset_id }}/move-up" class="inline-form">
                        <input type="hidden" name="_csrf" value="{{ _csrf }}">
                        {% if loop.first %}
                          <button class="button button-small" type="submit" disabled aria-label="Move {{ ra.filename }} up (disabled — already first)" title="This asset is already first in the list">Up</button>
                        {% else %}
                          <button class="button button-small" type="submit" aria-label="Move {{ ra.filename }} up">Up</button>
                        {% endif %}
                      </form>
                      <form method="post" action="/releases/{{ release.id }}/assets/{{ ra.asset_id }}/move-down" class="inline-form">
                        <input type="hidden" name="_csrf" value="{{ _csrf }}">
                        {% if loop.last %}
                          <button class="button button-small" type="submit" disabled aria-label="Move {{ ra.filename }} down (disabled — already last)" title="This asset is already last in the list">Down</button>
                        {% else %}
                          <button class="button button-small" type="submit" aria-label="Move {{ ra.filename }} down">Down</button>
                        {% endif %}
                      </form>
                    </div>
                  </td>
                {% endif %}
              </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
    {% else %}
      {% set emptyHeading = "No assets selected" %}
      {% set emptyDescription = "Add assets from the available assets below." %}
      {% set emptyHeadingLevel = "h3" %}
      {% include "partials/empty-state.njk" %}
    {% endif %}
  </section>

  {# ── Available Assets (Candidates) ─────────────────────────────────── #}
  <section>
    <h2>Available Assets</h2>

    {# Filter form #}
    <form method="get" action="/releases/{{ release.id }}/assets" class="filters">
      <div class="field">
          <label for="candidate-search">Search available assets</label>
          <input type="text" id="candidate-search" name="search" value="{{ candidateFilters.search or '' }}" placeholder="Filter by filename…">
      </div>
      <div class="field">
        <label for="candidate-extension">Extension</label>
          <select id="candidate-extension" name="extension">
          <option value="">All extensions</option>
          {% for ext in candidateExtensions %}
            <option value="{{ ext }}" {% if candidateFilters.extension == ext %}selected{% endif %}>{{ ext }}</option>
          {% endfor %}
        </select>
      </div>
      <div class="field">
        <label for="candidate-page-size">Page size</label>
          <select id="candidate-page-size" name="pageSize">
          <option value="25" {% if candidatePageSize == 25 %}selected{% endif %}>25</option>
          <option value="50" {% if candidatePageSize == 50 %}selected{% endif %}>50</option>
          <option value="100" {% if candidatePageSize == 100 %}selected{% endif %}>100</option>
        </select>
      </div>
      <div class="field">
        <button class="button" type="submit">Filter</button>
      </div>
      {% if candidateFilters.search or candidateFilters.extension %}
        <div class="field">
          <a class="button button-secondary" href="/releases/{{ release.id }}/assets">Clear</a>
        </div>
      {% endif %}
    </form>

    <p class="results-meta">{{ candidateTotal }} candidate{% if candidateTotal != 1 %}s{% endif %} available</p>

    {% if candidates.length > 0 %}
      <div class="table-scroll" tabindex="0" aria-label="Available release assets">
        <table class="data-table">
          <thead>
            <tr>
              <th>Filename</th>
              <th>Extension</th>
              <th>Path</th>
              <th class="num">Size</th>
              {% if not readOnly %}
                <th>Add</th>
              {% endif %}
            </tr>
          </thead>
          <tbody>
            {% for asset in candidates %}
              <tr>
                <td class="asset-filename">{{ asset.filename }}</td>
                <td>{{ asset.extension }}</td>
                <td class="asset-path"><code>{{ asset.relative_path }}</code></td>
                <td class="num">{{ asset.size_bytes }}</td>
                {% if not readOnly %}
                  <td>
                    <form method="post" action="/releases/{{ release.id }}/assets/add" class="inline-form">
                      <input type="hidden" name="_csrf" value="{{ _csrf }}">
                      <input type="hidden" name="assetId" value="{{ asset.id }}">
                      <button class="button button-small" type="submit" aria-label="Add {{ asset.filename }}">Add</button>
                    </form>
                  </td>
                {% endif %}
              </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>

      {# Pagination #}
      {% if candidatePageCount > 1 %}
        <nav class="pagination" aria-label="Candidate pagination">
          {% if candidatePage > 1 %}
            <a class="button button-small" href="{{ pageUrl({ page: candidatePage - 1 }) }}">Previous</a>
          {% endif %}
          <span class="pagination-info">Page {{ candidatePage }} of {{ candidatePageCount }}</span>
          {% if candidatePage < candidatePageCount %}
            <a class="button button-small" href="{{ pageUrl({ page: candidatePage + 1 }) }}">Next</a>
          {% endif %}
        </nav>
      {% endif %}
    {% else %}
      {% set emptyHeading = "No matching assets" %}
      {% set emptyDescription = "No available assets match the current filters." %}
      {% set emptyHeadingLevel = "h3" %}
      {% include "partials/empty-state.njk" %}
    {% endif %}
  </section>

  {% if not readOnly %}
  {# ── Existing bulk-selection form (kept for backward compatibility) ─ #}
  <section>
    <h2>Bulk Selection</h2>
    <p class="results-meta">{{ assets.length }} asset{% if assets.length != 1 %}s{% endif %} in project</p>

    <form method="post" action="/releases/{{ release.id }}/assets" class="release-assets-form">
      <input type="hidden" name="_csrf" value="{{ _csrf }}">
      <p id="bulk-selection-help" class="help-text">Select assets, then adjust each selected asset's role and order before saving.</p>
      <div class="table-scroll" tabindex="0" aria-label="Bulk asset selection">
        <table class="data-table">
          <thead>
            <tr>
              <th>Select</th>
              <th>Filename</th>
              <th>Path</th>
              <th>Status</th>
              <th>Role</th>
              <th class="num">Order</th>
            </tr>
          </thead>
          <tbody>
            {% for asset in assets %}
              {% set isSelected = false %}
              {% set currentRole = 'attachment' %}
              {% set currentSortOrder = 0 %}
              {% for ra in releaseAssets %}
                {% if ra.asset_id == asset.id %}
                  {% set isSelected = true %}
                  {% set currentRole = ra.role %}
                  {% set currentSortOrder = ra.sort_order %}
                {% endif %}
              {% endfor %}
              <tr class="{% if asset.is_present == 0 %}is-missing{% endif %}" data-asset-id="{{ asset.id }}">
                <td>
                  {% if asset.is_present == 1 %}
                    <label for="bulk-select-{{ asset.id }}" class="sr-only">Select {{ asset.filename }}</label>
                    <input type="checkbox" id="bulk-select-{{ asset.id }}" name="selectedAssetIds[]" value="{{ asset.id }}" {% if isSelected %}checked{% endif %} class="asset-checkbox" aria-describedby="bulk-selection-help">
                  {% else %}
                    <span class="missing-indicator" title="Asset is missing from disk">✗</span>
                  {% endif %}
                </td>
                <td class="asset-filename">{{ asset.filename }}</td>
                <td class="asset-path"><code>{{ asset.relative_path }}</code></td>
                <td>
                  {% if asset.is_present == 1 %}
                    {% set status = 'present' %}{% include "partials/status-badge.njk" %}
                  {% else %}
                    {% set status = 'missing' %}{% include "partials/status-badge.njk" %}
                  {% endif %}
                </td>
                <td>
                  {% if asset.is_present == 1 %}
                    <label for="bulk-role-{{ asset.id }}" class="sr-only">Role for {{ asset.filename }}</label>
                    <select id="bulk-role-{{ asset.id }}" name="roles[]" {% if not isSelected %}disabled{% endif %} class="asset-role" aria-describedby="bulk-selection-help">
                      {% for role in roles %}
                        <option value="{{ role }}" {% if currentRole == role %}selected{% endif %}>{{ role | title }}</option>
                      {% endfor %}
                    </select>
                  {% else %}
                    <span class="meta">-</span>
                  {% endif %}
                </td>
                <td class="num">
                  {% if asset.is_present == 1 %}
                    <label for="bulk-sort-order-{{ asset.id }}" class="sr-only">Order for {{ asset.filename }}</label>
                    <input type="number" id="bulk-sort-order-{{ asset.id }}" name="sortOrder[]" value="{{ currentSortOrder }}" min="0" {% if not isSelected %}disabled{% endif %} class="asset-sort-order numeric-input-compact" aria-describedby="bulk-selection-help">
                  {% else %}
                    —
                  {% endif %}
                </td>
              </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>

      <div class="form-actions">
        <button class="button button-primary" type="submit">Save Selection</button>
        <a class="button button-secondary" href="/releases/{{ release.id }}">Back</a>
      </div>
    </form>
  </section>

  {% else %}
    {% if assets.length == 0 %}
      {% set emptyHeading = "No project assets" %}
      {% set emptyDescription = "No assets found in this project. Scan the project to discover files." %}
      {% set emptyHeadingLevel = "h3" %}
      {% include "partials/empty-state.njk" %}
    {% endif %}
  {% endif %}
{% endblock %}
