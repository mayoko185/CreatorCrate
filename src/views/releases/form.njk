{% extends "layout.njk" %}
{% import "partials/page-heading.njk" as pageHeading %}
{% import "partials/dropdown.njk" as dropdown %}

{% set title = 'Create Release' %}
{% set page_title = "Releases — " ~ title %}
{% set formDescription = "Create a tracked release record." %}

{% block content %}
  {% call pageHeading.render(formDescription) %}
    <button class="button button-primary" type="submit" form="release-form">Create</button>
    <a class="button button-secondary" href="{% if selectedProjectId %}/projects/{{ selectedProjectId }}{% else %}/releases{% endif %}">Cancel</a>
  {% endcall %}

  {% if errors.general %}
    <div class="error-summary" role="alert">
      <p>{{ errors.general }}</p>
    </div>
  {% endif %}

  <form id="release-form" method="post" action="{{ submitUrl }}" class="project-form" novalidate>
    <input type="hidden" name="_csrf" value="{{ _csrf }}">
    {% for assetId in values.selectedAssetIds %}
      <input type="hidden" name="selectedAssetIds" value="{{ assetId }}">
    {% endfor %}
    {% include "partials/release-form-fields.njk" %}

  </form>

{% endblock %}
