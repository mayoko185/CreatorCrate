{% extends "layout.njk" %}
{% import "partials/page-heading.njk" as pageHeading %}

{% set title = action ~ ' Release' %}
{% set page_title = "Releases — Edit " ~ release.title if action == 'Edit' else "Releases — " ~ title %}
{% set formDescription = "Create a tracked release record." if action == 'Create' else "Update release metadata and scheduling fields." %}

{% block content %}
  {% call pageHeading.render(formDescription) %}
    <button class="button button-primary" type="submit" form="release-form">{{ action }}</button>
    <a class="button button-secondary" href="{% if release %}/releases/{{ release.id }}{% elif selectedProjectId %}/projects/{{ selectedProjectId }}{% else %}/release-management{% endif %}">Cancel</a>
    {% if release and release.project_id %}
      <a class="button button-secondary" href="/projects/{{ release.project_id }}">Back to Project</a>
    {% endif %}
  {% endcall %}

  {% if errors.general %}
    <div class="error-summary" role="alert">
      <p>{{ errors.general }}</p>
    </div>
  {% endif %}

  <form id="release-form" method="post" action="{{ submitUrl }}" class="project-form" novalidate>
    <input type="hidden" name="_csrf" value="{{ _csrf }}">
    {% for assetId in values.selectedAssetIds %}
      <input type="hidden" name="selectedAssetIds" value="{{ assetId }}">
    {% endfor %}
    {% if not release %}
      {% set projectSummary = 'Select a project' %}
      {% for project in projects %}
        {% if selectedProjectId == project.id %}
          {% set projectSummary = project.title %}
        {% endif %}
      {% endfor %}

      <div class="settings-section release-project-section">
        <h3>Project</h3>
        <fieldset class="field asset-viewer-filter-field asset-filter-multiselect-field asset-viewer-project-filter{% if errors.projectId %} field-error{% endif %}">
          <legend>Project <span class="required" aria-label="required">*</span></legend>
          <details class="asset-filter-multiselect asset-filter-multiselect--sized asset-project-filter-disclosure"
                   data-asset-project-filter
                   data-asset-project-filter-name="projectId"
                   data-asset-project-filter-empty-label="Select a project"
                   data-asset-viewer-filter-disclosure>
            <summary id="release-project-filter-trigger"
                     aria-controls="release-project-filter-options"
                     aria-expanded="false"
                     aria-label="Project filter: {{ projectSummary }}"
                     title="{{ projectSummary }}">
              <span class="asset-filter-multiselect-summary" data-asset-project-filter-summary>
                <span class="asset-filter-multiselect-summary-current" data-asset-project-filter-current-summary>{{ projectSummary }}</span>
                <span class="asset-filter-multiselect-summary-width" aria-hidden="true">
                  <span>Select a project</span>
                  {% for project in projects %}
                    <span>{{ project.title }}</span>
                  {% endfor %}
                </span>
              </span>
            </summary>
            <div id="release-project-filter-options" class="asset-filter-multiselect-panel asset-project-filter-panel" role="group" aria-label="Project options">
              <label class="asset-project-filter-search-label" for="release-project-filter-search">Search projects</label>
              <input id="release-project-filter-search" class="asset-project-filter-search" type="search"
                     autocomplete="off" data-asset-project-filter-search>
              <div class="asset-project-filter-option-list" data-asset-project-filter-option-list role="radiogroup" aria-label="Project choices">
                {% for project in projects %}
                  <div class="asset-filter-multiselect-option asset-project-filter-option"
                       data-asset-project-filter-option data-project-title="{{ project.title }}">
                    <label for="release-project-option-{{ project.id }}">
                      <input id="release-project-option-{{ project.id }}" name="projectId" type="radio" value="{{ project.id }}"{% if selectedProjectId == project.id %} checked{% endif %} required{% if errors.projectId %} aria-describedby="projectId-error" aria-invalid="true"{% endif %}>
                      <span>{{ project.title }}</span>
                    </label>
                  </div>
                {% endfor %}
              </div>
              <p class="asset-filter-multiselect-empty asset-project-filter-no-results"
                 data-asset-project-filter-no-results role="status" aria-live="polite" hidden>No matching projects</p>
            </div>
          </details>
          {% if errors.projectId %}<span class="field-error-message" id="projectId-error">{{ errors.projectId }}</span>{% endif %}
        </fieldset>
      </div>
    {% endif %}

    <div class="settings-section">
      <h3>Basic information</h3>

      <div class="field {% if errors.title %}field-error{% endif %}">
        <label for="title">Title <span class="required" aria-label="required">*</span></label>
        <input type="text" id="title" name="title" value="{{ values.title or '' }}" maxlength="200" required{% if errors.title %} aria-describedby="title-error" aria-invalid="true"{% endif %}>
        {% if errors.title %}<span class="field-error-message" id="title-error">{{ errors.title }}</span>{% endif %}
      </div>

      <div class="field {% if errors.description %}field-error{% endif %}">
        <label for="description">Description</label>
        <textarea id="description" name="description" rows="4" maxlength="4000"{% if errors.description %} aria-describedby="description-error" aria-invalid="true"{% endif %}>{{ values.description or '' }}</textarea>
        {% if errors.description %}<span class="field-error-message" id="description-error">{{ errors.description }}</span>{% endif %}
      </div>

      <div class="field {% if errors.notes %}field-error{% endif %}">
        <label for="notes">Notes</label>
        <textarea id="notes" name="notes" rows="6" maxlength="10000"{% if errors.notes %} aria-describedby="notes-error" aria-invalid="true"{% endif %}>{{ values.notes or '' }}</textarea>
        {% if errors.notes %}<span class="field-error-message" id="notes-error">{{ errors.notes }}</span>{% endif %}
      </div>
    </div>

    <div class="settings-section scheduling-section">
      <h3>Scheduling</h3>

      <div class="field-row scheduling-row">
        <div class="field scheduling-field {% if errors.plannedDate or errors.plannedTime %}field-error{% endif %}" data-date-picker-field>
          <label for="plannedDate">Scheduled date</label>
          <div class="picker-control">
            <div class="picker-input-row">
              <input class="picker-input" type="date" id="plannedDate" name="plannedDate" value="{{ values.plannedDate or '' }}" aria-describedby="plannedDate-help{% if errors.plannedDate %} plannedDate-error{% endif %}{% if errors.plannedTime %} plannedTime-error{% endif %}"{% if errors.plannedDate or errors.plannedTime %} aria-invalid="true"{% endif %} data-date-picker-input>
              <button type="button" class="picker-trigger date-picker-trigger" aria-haspopup="dialog" aria-expanded="false" aria-controls="plannedDate-calendar" aria-label="Open calendar for scheduled date">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" focusable="false"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
              </button>
            </div>
            <div id="plannedDate-calendar" class="date-picker-panel" role="dialog" aria-label="Scheduled date calendar" hidden data-date-picker-panel data-date-picker-for="plannedDate"></div>
          </div>
          <span class="help-text" id="plannedDate-help">Target publication date for this release</span>
          {% if errors.plannedDate %}<span class="field-error-message" id="plannedDate-error">{{ errors.plannedDate }}</span>{% endif %}
        </div>

        <div class="field scheduling-field {% if errors.plannedTime %}field-error{% endif %}" data-time-picker-field>
          <label for="plannedTime">Scheduled time</label>
          <div class="picker-control">
            <div class="picker-input-row">
              <input class="picker-input" type="time" id="plannedTime" name="plannedTime" value="{{ values.plannedTime or '' }}" aria-describedby="plannedTime-help{% if errors.plannedTime %} plannedTime-error{% endif %}"{% if errors.plannedTime %} aria-invalid="true"{% endif %} data-time-picker-input>
              <button type="button" class="picker-trigger time-picker-trigger" aria-haspopup="dialog" aria-expanded="false" aria-controls="plannedTime-picker" aria-label="Open time picker for scheduled time" data-time-picker-trigger>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="9"></circle><polyline points="12 7 12 12 15 14"></polyline></svg>
              </button>
            </div>
            <div id="plannedTime-picker" class="date-picker-panel time-picker-panel" role="dialog" aria-label="Scheduled time picker" hidden data-time-picker-panel data-time-picker-for="plannedTime"></div>
          </div>
          <span class="help-text" id="plannedTime-help">Local time this release is scheduled to go live</span>
          {% if errors.plannedTime %}<span class="field-error-message" id="plannedTime-error">{{ errors.plannedTime }}</span>{% endif %}
        </div>

        <div class="field scheduling-field {% if errors.publishedDate %}field-error{% endif %}" data-date-picker-field>
          <label for="publishedDate">Published date</label>
          <div class="picker-control">
            <div class="picker-input-row">
              <input class="picker-input" type="date" id="publishedDate" name="publishedDate" value="{{ values.publishedDate or '' }}" aria-describedby="publishedDate-help{% if errors.publishedDate %} publishedDate-error{% endif %}"{% if errors.publishedDate %} aria-invalid="true"{% endif %} data-date-picker-input>
              <button type="button" class="picker-trigger date-picker-trigger" aria-haspopup="dialog" aria-expanded="false" aria-controls="publishedDate-calendar" aria-label="Open calendar for published date">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" focusable="false"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
              </button>
            </div>
            <div id="publishedDate-calendar" class="date-picker-panel" role="dialog" aria-label="Published date calendar" hidden data-date-picker-panel data-date-picker-for="publishedDate"></div>
          </div>
          <span class="help-text" id="publishedDate-help">When this release was published</span>
          {% if errors.publishedDate %}<span class="field-error-message" id="publishedDate-error">{{ errors.publishedDate }}</span>{% endif %}
        </div>
      </div>
    </div>

    <div class="settings-section">
      <h3>Links</h3>

      <div class="field {% if errors.patreonUrl %}field-error{% endif %}">
        <label for="patreonUrl">Release link</label>
        <input type="url" id="patreonUrl" name="patreonUrl" value="{{ values.patreonUrl or '' }}" aria-describedby="patreonUrl-help{% if errors.patreonUrl %} patreonUrl-error{% endif %}"{% if errors.patreonUrl %} aria-invalid="true"{% endif %}>
        <span class="help-text" id="patreonUrl-help">Optional absolute HTTP or HTTPS URL for this release.</span>
        {% if errors.patreonUrl %}<span class="field-error-message" id="patreonUrl-error">{{ errors.patreonUrl }}</span>{% endif %}
      </div>
    </div>

  </form>

  {% if release %}
    <section class="destructive-section">
      <h2>Danger zone</h2>
      <p>Deleting this release is permanent and cannot be undone. The release record and its asset associations will be removed; the underlying project assets will not be affected.</p>
      <form method="post" action="/releases/{{ release.id }}/delete" class="inline-form">
        <input type="hidden" name="_csrf" value="{{ _csrf }}">
        <button class="button button-danger" type="submit" data-confirm="Delete this release permanently? This action is irreversible and cannot be undone.">Delete Release</button>
      </form>
    </section>
  {% endif %}
{% endblock %}
