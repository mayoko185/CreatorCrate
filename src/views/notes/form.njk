{% extends "layout.njk" %}
{% import "partials/page-heading.njk" as pageHeading %}

{% set title = action ~ ' Note' %}
{% set page_title = "Notes — Edit " ~ note.title if action == 'Edit' else "Notes — " ~ title %}
{% set formDescription = "Capture a standalone note." if action == 'Create' else "Update this note." %}

{% block page_assets %}
{% endblock %}

{% block content %}
  {% call pageHeading.render(formDescription) %}
    <button class="button button-primary" type="submit" form="note-form">{{ action }}</button>
    <a class="button button-secondary" href="{% if note %}/notes/{{ note.id }}{% elif chapter %}/notes/chapters/{{ chapter.id }}{% elif book %}/notes/books/{{ book.id }}{% else %}/notes{% endif %}">Cancel</a>
  {% endcall %}

  {% if errors.general %}
    <div class="error-summary" role="alert">
      <p>{{ errors.general }}</p>
    </div>
  {% endif %}

  <form id="note-form" method="post" action="{{ submitUrl }}" class="project-form notes-form notes-workspace" data-notes-editor-form novalidate>
    <input type="hidden" name="_csrf" value="{{ _csrf }}">
    {% if chapter and action == 'Create' %}
      <input type="hidden" name="chapterId" value="{{ values.chapterId }}">
    {% elif book and action == 'Create' %}
      <input type="hidden" name="bookId" value="{{ values.bookId }}">
    {% endif %}

    <aside class="notes-workspace-context" aria-labelledby="notes-context-heading">
      <p class="notes-workspace-kicker">Book workspace</p>
      <h2 id="notes-context-heading">Hierarchy</h2>
      {% if book or chapter %}
        <dl class="notes-workspace-context-list">
          {% if book %}
            <div>
              <dt>Book</dt>
              <dd><a href="/notes/books/{{ book.id }}">{{ book.title }}</a></dd>
            </div>
          {% endif %}
          {% if chapter %}
            <div>
              <dt>Chapter</dt>
              <dd><a href="/notes/chapters/{{ chapter.id }}">{{ chapter.title }}</a></dd>
            </div>
          {% endif %}
        </dl>
      {% endif %}
      {% if chapter %}
        <a class="notes-workspace-back" href="/notes/chapters/{{ chapter.id }}">Back to Chapter</a>
        <p class="notes-workspace-context-note">This Page will belong to this Chapter.</p>
      {% elif book %}
        <a class="notes-workspace-back" href="/notes/books/{{ book.id }}">Back to Book</a>
        <p class="notes-workspace-context-note">This Page will belong directly to this Book.</p>
      {% endif %}
    </aside>

    <section class="notes-workspace-editor" aria-labelledby="notes-editor-heading">
      <div class="notes-workspace-section-heading">
        <p class="notes-workspace-kicker">Writing surface</p>
        <h2 id="notes-editor-heading">Page content</h2>
      </div>

      <div class="field {% if errors.title %}field-error{% endif %}">
        <label for="title">Page title <span class="required" aria-label="required">*</span></label>
        <input type="text" id="title" name="title" value="{{ values.title or '' }}" maxlength="200" required{% if errors.title %} aria-describedby="title-error" aria-invalid="true"{% endif %}>
        {% if errors.title %}<span class="field-error-message" id="title-error">{{ errors.title }}</span>{% endif %}
      </div>

      <div class="field {% if errors.content %}field-error{% endif %}">
        <label id="content-label" for="content">Content</label>
        <div class="notes-editor" data-notes-editor-host-wrapper>
          <div id="content-editor" class="notes-editor-host" data-notes-editor-host aria-labelledby="content-label" aria-describedby="content-help{% if errors.content %} content-error{% endif %}"></div>
          <textarea id="content" name="content" data-notes-editor-source rows="16" aria-describedby="content-help{% if errors.content %} content-error{% endif %}"{% if errors.content %} aria-invalid="true"{% endif %}>{{ values.content or '' }}</textarea>
        </div>
        <span class="help-text" id="content-help">Markdown source is stored unchanged.</span>
        {% if errors.content %}<span class="field-error-message" id="content-error">{{ errors.content }}</span>{% endif %}
      </div>
    </section>

    <aside class="notes-connections" aria-labelledby="notes-connections-heading">
      <div class="notes-workspace-section-heading">
        <p class="notes-workspace-kicker">Secondary metadata</p>
        <h2 id="notes-connections-heading">Connections</h2>
        <p class="notes-connections-description">Link this Page to existing projects and assets.</p>
      </div>

      {% set projectError = errors.projectIds or errors.associations %}
      {% set projectSummary = 'No projects selected' %}
      {% if selectedProjectIds.length == 1 %}
        {% for project in projects %}
          {% if selectedProjectIds[0] == (project.id | string) %}
            {% set projectSummary = project.title %}
          {% endif %}
        {% endfor %}
      {% elif selectedProjectIds.length > 1 %}
        {% set projectSummary = selectedProjectIds.length ~ ' projects selected' %}
      {% endif %}

      <fieldset class="field notes-connections-field asset-viewer-filter-field asset-filter-multiselect-field{% if projectError %} field-error{% endif %}">
        <legend>Projects</legend>
        <details class="asset-filter-multiselect asset-filter-multiselect--sized">
          <summary id="note-projects-form-trigger"
                   aria-controls="note-projects-form-options"
                   aria-label="Projects: {{ projectSummary }}">
            <span class="asset-filter-multiselect-summary">
              <span class="asset-filter-multiselect-summary-current">{{ projectSummary }}</span>
              <span class="asset-filter-multiselect-summary-width" aria-hidden="true">
                <span>No projects selected</span>
                {% for project in projects %}<span>{{ project.title }}</span>{% endfor %}
                <span>{{ projects.length }} projects selected</span>
              </span>
            </span>
          </summary>
          <div id="note-projects-form-options" class="asset-filter-multiselect-panel" role="group" aria-label="Project options">
            {% if projects.length > 0 %}
              {% for project in projects %}
                <div class="asset-filter-multiselect-option">
                  <label for="note-project-option-{{ project.id }}">
                    <input id="note-project-option-{{ project.id }}" name="projectIds[]" type="checkbox" value="{{ project.id }}"{% if (project.id | string) in selectedProjectIds %} checked{% endif %}{% if projectError %} aria-describedby="projectIds-error" aria-invalid="true"{% endif %}>
                    <span>{{ project.title }}</span>
                  </label>
                </div>
              {% endfor %}
            {% else %}
              <p class="asset-filter-multiselect-empty">No projects available. <a href="/projects/new">Create a project</a>.</p>
            {% endif %}
          </div>
        </details>
        {% if projectError %}<span class="field-error-message" id="projectIds-error">{{ projectError }}</span>{% endif %}
      </fieldset>

      {% set assetError = errors.assetIds or errors.associations %}

      <fieldset class="field notes-connections-field asset-viewer-filter-field asset-filter-multiselect-field{% if assetError %} field-error{% endif %}">
        <legend>Assets</legend>
        <input type="hidden" name="assetIds[]" value="">
        <ul class="notes-selected-assets" aria-label="Selected assets">
          {% for asset in selectedAssets %}
            <li class="notes-selected-asset">
              <label class="notes-selected-asset-control" for="note-asset-option-{{ asset.id }}">
                <input id="note-asset-option-{{ asset.id }}" name="assetIds[]" type="checkbox" value="{{ asset.id }}" aria-label="Deselect {{ asset.filename }}" aria-describedby="{% if assetError %}assetIds-error {% endif %}note-asset-option-description-{{ asset.id }}"{% if (asset.id | string) in selectedAssetIds %} checked{% endif %}{% if assetError %} aria-invalid="true"{% endif %}>
                <span id="note-asset-option-description-{{ asset.id }}" class="notes-selected-asset-details">
                  <span class="notes-selected-asset-filename">{{ asset.filename }}</span>
                  <span class="notes-selected-asset-project">Project: <span>{{ asset.projectTitle }}</span></span>
                  {% if asset.relativePath and asset.relativePath != asset.filename %}<span class="notes-selected-asset-path">Path: <span>{{ asset.relativePath }}</span></span>{% endif %}
                  {% if asset.isProjectArchived %}<span class="notes-selected-asset-state notes-selected-asset-state--archived">Archived project</span>{% endif %}
                  {% if not asset.isPresent %}<span class="notes-selected-asset-state notes-selected-asset-state--missing">Missing</span>{% endif %}
                </span>
              </label>
            </li>
          {% endfor %}
        </ul>
        <p class="notes-selected-assets-empty"{% if selectedAssets.length > 0 %} hidden{% endif %}>No assets selected.</p>
        {% if assetError %}<span class="field-error-message" id="assetIds-error">{{ assetError }}</span>{% endif %}
        <details class="notes-asset-picker-disclosure">
          <summary>Add assets</summary>
          <div id="note-asset-picker" class="notes-asset-picker" data-notes-asset-picker data-projects-url="/notes/asset-picker/projects" data-assets-url="/notes/asset-picker/assets" data-note-form-id="note-form">
            <p class="notes-asset-picker-no-js">Searching for and adding assets requires JavaScript. Existing selected assets can be removed above.</p>
            <div class="notes-asset-picker-field">
              <label for="note-asset-picker-project-search">Project search</label>
              <input type="search" id="note-asset-picker-project-search" autocomplete="off">
            </div>
            <ul id="note-asset-picker-project-results" class="notes-asset-picker-results" aria-label="Project search results"></ul>
            <div class="notes-asset-picker-field">
              <label for="note-asset-picker-asset-search">Asset search</label>
              <input type="search" id="note-asset-picker-asset-search" autocomplete="off" disabled>
            </div>
            <ul id="note-asset-picker-asset-results" class="notes-asset-picker-results" aria-label="Asset search results"></ul>
            <div class="notes-asset-picker-load-more">
              <button type="button" class="button button-secondary" disabled>Load more</button>
            </div>
            <p id="note-asset-picker-status" class="notes-asset-picker-status" role="status" aria-live="polite" aria-atomic="true"></p>
            <p id="note-asset-picker-error" class="notes-asset-picker-error" role="alert" aria-live="assertive" aria-atomic="true"></p>
          </div>
        </details>
      </fieldset>
    </aside>
  </form>
{% endblock %}
