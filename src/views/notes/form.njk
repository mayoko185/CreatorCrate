{% import "partials/dialog.njk" as noteDialog %}
{% import "partials/dropdown.njk" as dropdown %}

{% if noteFormModel %}
  {% set noteTitleId = 'note-edit-title' if noteFormModel.action == 'Edit' else 'note-create-title' %}
  {% set values = noteFormModel.values %}
  {% set errors = noteFormModel.errors %}
  {% set projects = noteFormModel.projects %}
  {% set selectedProjectIds = noteFormModel.selectedProjectIds %}
  {% set selectedAssetIds = noteFormModel.selectedAssetIds %}
  {% set selectedAssets = noteFormModel.selectedAssets %}
  {% call noteDialog.render(noteDialogId, noteDialogTitle, noteDialogOpen, '', 'note-form', 'project-form-dialog') %}
    <div class="app-dialog-body project-edit-dialog-body">
      <form id="note-form" method="post" action="{{ noteFormModel.submitUrl }}" class="app-dialog-form project-form project-edit-dialog-form notes-form notes-workspace"
            data-notes-editor-form data-dialog-form data-dialog-async="false" novalidate>
        <input type="hidden" name="_csrf" value="{{ _csrf }}">
        {% if noteFormModel.action == 'Create' and noteFormModel.chapter %}
          <input type="hidden" name="chapterId" value="{{ values.chapterId }}">
        {% elif noteFormModel.action == 'Create' %}
          <input type="hidden" name="bookId" value="{{ values.bookId }}">
        {% endif %}

        <section class="settings-section project-form-section project-edit-dialog-section" data-notes-dialog-compact-section aria-labelledby="notes-book-contents-heading">
          <h3 id="notes-book-contents-heading">Book contents</h3>
          <details class="notes-book-contents-disclosure">
            <summary class="notes-book-contents-toggle">
              <span class="notes-book-contents-toggle-label notes-book-contents-toggle-label--expand">Expand</span>
              <span class="notes-book-contents-toggle-label notes-book-contents-toggle-label--collapse">Collapse</span>
            </summary>
            <div class="project-form-section-body project-edit-dialog-section-body">
              <aside class="notes-workspace-context notes-book-detail-sidebar notes-book-detail-sidebar--embedded" aria-label="Book contents">
                {% set bookNavHideHeading = true %}
                {% set bookNavHideChapterLinks = true %}
                {% include "partials/book-navigator.njk" %}
                {% set bookNavHideChapterLinks = false %}
                {% set bookNavHideHeading = false %}
              </aside>
            </div>
          </details>
        </section>
        <section class="settings-section project-form-section project-edit-dialog-section" data-notes-dialog-compact-section aria-labelledby="notes-editor-heading">
          <h3 id="notes-editor-heading">Page contents</h3>
          <div class="project-form-section-body project-edit-dialog-section-body notes-page-contents-body">
            {% include "notes/writing-fields.njk" %}
          </div>
        </section>
        <section class="settings-section project-form-section project-edit-dialog-section notes-connections" data-notes-dialog-compact-section aria-labelledby="notes-connections-heading">
          <h3 id="notes-connections-heading">Connections</h3>
          <div class="project-form-section-body project-edit-dialog-section-body">
            {% if errors.general %}
              <div class="error-summary" role="alert"><p>{{ errors.general }}</p></div>
            {% endif %}
            {% include "notes/connections-fields.njk" %}
          </div>
        </section>
      </form>
      {% if noteFormModel.action == 'Edit' %}
        {% set moveTargets = noteFormModel.moveTargets %}
        <section class="settings-section project-form-section project-edit-dialog-section notes-workspace-secondary" aria-labelledby="notes-page-actions-heading">
          <h3 id="notes-page-actions-heading">Page actions</h3>
          <div class="project-form-section-body project-edit-dialog-section-body">

            <details class="notes-workspace-disclosure notes-workspace-disclosure--move">
              <summary>Move Page</summary>
              <div class="notes-workspace-disclosure-content">
                {% set moveOptions = [] %}
                {% for target in moveTargets %}
                  {% set _ = moveOptions.push({ value: 'book:' ~ target.book.id, label: 'Book: ' ~ target.book.title ~ ' (direct Pages)' }) %}
                  {% for targetChapter in target.chapters %}
                    {% set _ = moveOptions.push({ value: 'chapter:' ~ targetChapter.id, label: 'Chapter: ' ~ target.book.title ~ ' / ' ~ targetChapter.title }) %}
                  {% endfor %}
                {% endfor %}
                {{ dropdown.singleSelect({
                  id: 'note-move-dropdown', name: 'targetContainer', label: 'Move Page destination',
                  visuallyHiddenLabel: true, options: moveOptions,
                  selected: ('chapter:' ~ chapter.id) if chapter else ('book:' ~ book.id),
                  panelLabel: 'Page destinations',
                  nativeSelect: { id: 'note-move-target', attributes: [['required', true], ['form', 'note-move-form']] }
                }) }}
                <button class="button button-small button-secondary" type="submit" form="note-move-form">Move Page</button>
              </div>
            </details>

            <details class="notes-workspace-disclosure notes-workspace-disclosure--delete">
              <summary>Delete Page</summary>
              <div class="notes-workspace-disclosure-content">
                <p class="notes-workspace-warning">Permanently delete this Page and its associations. This cannot be undone.</p>
                <button class="button button-small button-danger" type="submit" form="note-delete-form" data-confirm="Delete this Page permanently? This cannot be undone.">Delete Page</button>
              </div>
            </details>
          </div>
        </section>
        <form id="note-move-form" method="post" action="/notes/{{ note.id }}/move" hidden>
          <input type="hidden" name="_csrf" value="{{ _csrf }}">
        </form>
        <form id="note-delete-form" method="post" action="/notes/{{ note.id }}/delete" hidden>
          <input type="hidden" name="_csrf" value="{{ _csrf }}">
        </form>
      {% endif %}
    </div>
    <div class="app-dialog-status" data-dialog-status role="status" aria-live="polite"></div>
    <footer class="app-dialog-footer">
      <button class="button button-primary" type="submit" form="note-form" data-dialog-submit>{{ 'Save' if noteFormModel.action == 'Edit' else 'Create' }}</button>
    </footer>
  {% endcall %}
{% endif %}
