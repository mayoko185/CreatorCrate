{% import "partials/dialog.njk" as dialog %}
{% call dialog.render('chapter-order-dialog', 'Change order', chapterOrderDialogOpen, '', '', 'project-form-dialog') %}
  <form id="notes-chapter-order-form" method="post" action="/notes/chapters/{{ chapter.id }}/notes/reorder" data-chapter-page-reorder-form
        class="app-dialog-form project-form project-edit-dialog-form" data-dialog-form data-dialog-async="false">
    <input type="hidden" name="_csrf" value="{{ _csrf }}">
    <div class="app-dialog-body">
      {% if chapterOrderNotice %}<div class="error-summary" role="alert"><p>{{ chapterOrderNotice.text }}</p></div>{% endif %}
      <section class="notes-chapter-order" data-notes-chapter-order-page aria-labelledby="notes-order-heading">
        <h3 id="notes-order-heading">Pages</h3>

        {% if notes.length > 0 %}
          <p class="help-text" id="notes-chapter-order-instructions">
            Drag a Page card to move it, or focus its handle and use Arrow Up, Arrow Down, Home, or End. Select Save to keep the new order.
          </p>

            <input type="hidden" name="orderedNoteIds" data-chapter-page-order-input value="{% for note in notes %}{{ note.id }}{% if not loop.last %},{% endif %}{% endfor %}">

            <ol
              class="notes-chapter-page-list notes-chapter-order-list notes-reorder-list"
              data-chapter-page-reorder-list
              data-reorder-form-target="notes-chapter-order-form"
              aria-label="Pages in {{ chapter.title }}"
              aria-describedby="notes-chapter-order-instructions">
              {% for note in notes %}
                <li
                  class="notes-chapter-page-row notes-chapter-order-row notes-reorder-row notes-reorder-row--compact"
                  data-chapter-page-reorder-item
                  data-note-id="{{ note.id }}"
                  data-note-label="{{ note.title }}"
                  draggable="true"
                  aria-posinset="{{ loop.index }}"
                  aria-setsize="{{ notes.length }}">
                  <button
                    type="button"
                    class="notes-chapter-order-handle notes-reorder-handle"
                    data-chapter-page-reorder-handle
                    draggable="true"
                    aria-label="Reorder Page: {{ note.title }}"
                    aria-describedby="notes-chapter-order-instructions notes-chapter-order-position-{{ note.id }}"
                    title="Drag to reorder; use the arrow keys to move">
                    <span aria-hidden="true">⠿</span>
                  </button>
                  <div class="notes-chapter-page-copy" draggable="true">
                    <span class="notes-chapter-page-number">Page {{ loop.index }}</span>
                    <h3 class="notes-chapter-page-title"><a href="/notes/{{ note.id }}">{{ note.title }}</a></h3>
                    <span id="notes-chapter-order-position-{{ note.id }}" class="notes-chapter-order-position notes-reorder-position" data-chapter-page-order-position>Position {{ loop.index }} of {{ notes.length }}</span>
                  </div>
                </li>
              {% endfor %}
            </ol>
            <div class="notes-chapter-order-live-region notes-reorder-live-region sr-only" data-chapter-page-reorder-live aria-live="polite" aria-atomic="true"></div>

          <noscript>
            <p class="help-text">JavaScript is required to move Pages. Save still submits the current ordered Page ID list.</p>
          </noscript>
        {% else %}
          {% set emptyHeading = "No Pages yet" %}
          {% set emptyDescription = "Create a Page before changing this chapter's order." %}
          {% set emptyHeadingLevel = "h3" %}
          {% set emptyActionUrl = "/notes/new?chapterId=" ~ chapter.id %}
          {% set emptyActionLabel = "New Page" %}
          {% include "partials/empty-state.njk" %}
        {% endif %}
      </section>
    </div>
    <footer class="app-dialog-footer">
      {% if notes.length > 0 %}
        <button class="button button-primary" type="submit" form="notes-chapter-order-form" data-dialog-submit>Save</button>
      {% endif %}
    </footer>
  </form>
{% endcall %}
