{% import "partials/dialog.njk" as dialog %}

{% call dialog.render('book-order-dialog', 'Change order', bookOrderDialogOpen, '', '', 'project-form-dialog', [], false) %}
  <form id="notes-book-order-form" method="post" action="/notes/books/{{ book.id }}/hierarchy/reorder" data-book-hierarchy-form
        class="app-dialog-form project-form project-edit-dialog-form" data-dialog-form data-dialog-async="false">
    <input type="hidden" name="_csrf" value="{{ _csrf }}">
    <input type="hidden" name="hierarchy" data-book-hierarchy-input value="{{ bookHierarchy.submission }}">
    <div class="app-dialog-body">
      {% if bookOrderNotice %}
        <div class="error-summary" role="alert"><p>{{ bookOrderNotice.text }}</p></div>
      {% endif %}
      <section class="project-edit-dialog-section" data-notes-book-order-page data-book-hierarchy-editor aria-labelledby="notes-book-order-heading">
        <h3 id="notes-book-order-heading">Book hierarchy</h3>
        <div class="project-edit-dialog-section-body">
        {% if bookHierarchy.items.length > 0 %}
          <p class="help-text" id="notes-book-order-instructions">
            Drag cards to reorder. Select Save to apply changes.
          </p>
          <p class="sr-only" aria-live="polite" aria-atomic="true" data-book-hierarchy-live></p>
          <ol class="notes-book-content-list notes-book-order-list notes-reorder-list"
              data-book-hierarchy-container="root"
              aria-label="Book hierarchy in current order"
              aria-describedby="notes-book-order-instructions">
            {% for item in bookHierarchy.items %}
              <li class="notes-book-content-row notes-book-order-row notes-reorder-row notes-reorder-row--compact"
                  data-book-hierarchy-item draggable="true" data-content-key="{{ item.type }}:{{ item.id }}"
                  data-book-hierarchy-label="{% if item.type == 'chapter' %}{{ item.chapter.title }}{% else %}{{ item.page.title }}{% endif %}"
                  aria-posinset="{{ loop.index }}" aria-setsize="{{ bookHierarchy.items.length }}">
                <button type="button" class="notes-reorder-handle" data-book-hierarchy-handle
                        aria-label="Move {% if item.type == 'chapter' %}Chapter: {{ item.chapter.title }}{% else %}Book Page: {{ item.page.title }}{% endif %}"
                        aria-describedby="notes-book-order-instructions" title="Drag or use arrow keys to move">
                  <span aria-hidden="true">⠿</span>
                </button>
                <div class="notes-book-content-copy">
                  {% if item.type == 'chapter' %}
                    <span class="notes-book-content-kind">Chapter</span>
                    <h3 class="notes-book-content-title">{{ item.chapter.title }}</h3>
                    <ol class="notes-book-content-list notes-book-order-list"
                        data-book-hierarchy-container="chapter:{{ item.id }}"
                        aria-label="Pages in {{ item.chapter.title }}">
                      {% for page in item.pages %}
                        <li class="notes-book-content-row notes-book-order-row notes-reorder-row notes-reorder-row--compact"
                            data-book-hierarchy-item draggable="true" data-content-key="page:{{ page.id }}" data-book-hierarchy-label="{{ page.title }}"
                            aria-posinset="{{ loop.index }}" aria-setsize="{{ item.pages.length }}">
                          <button type="button" class="notes-reorder-handle" data-book-hierarchy-handle
                                  aria-label="Move Page: {{ page.title }}"
                                  aria-describedby="notes-book-order-instructions" title="Drag or use arrow keys to move">
                            <span aria-hidden="true">⠿</span>
                          </button>
                          <div class="notes-book-content-copy">
                            <span class="notes-book-content-kind">Page in {{ item.chapter.title }}</span>
                            <h4 class="notes-book-content-title">{{ page.title }}</h4>
                          </div>
                        </li>
                      {% endfor %}
                    </ol>
                  {% else %}
                    <span class="notes-book-content-kind">Book Page</span>
                    <h3 class="notes-book-content-title">{{ item.page.title }}</h3>
                  {% endif %}
                </div>
              </li>
            {% endfor %}
          </ol>
        {% else %}
          <p class="help-text">This Book has no Chapters or Pages to order yet.</p>
        {% endif %}
        </div>
      </section>
    </div>
    <footer class="app-dialog-footer">
      {% if bookHierarchy.items.length > 0 %}
        <button class="button button-primary" type="submit" form="notes-book-order-form" data-dialog-submit>Save</button>
      {% endif %}
    </footer>
  </form>
{% endcall %}
