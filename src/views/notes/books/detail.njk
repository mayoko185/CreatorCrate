{% extends "layout.njk" %}
{% import "partials/page-heading.njk" as pageHeading %}

{% set page_title = "Notes — " ~ book.title %}

{% block content %}
  {% call pageHeading.render("Book") %}
    <a class="button button-primary" href="/notes/books/{{ book.id }}/chapters/new">New Chapter</a>
    <a class="button" href="/notes/new?bookId={{ book.id }}">New Page</a>
    <a class="button" href="/notes/books/{{ book.id }}/edit">Edit Book</a>
  {% endcall %}

  {% if notice %}
    {% set noticeVariant = notice.variant %}
    {% set noticeText = notice.text %}
    {% include "partials/notice.njk" %}
  {% endif %}

  <section class="settings-section">
    <h2>Chapters</h2>
    {% if chapters.length > 0 %}
      <div class="table-scroll" tabindex="0" aria-label="Chapters list">
        <table class="data-table">
          <thead><tr><th>Title</th><th>Actions</th></tr></thead>
          <tbody>
            {% for chapter in chapters %}
              <tr>
                <td><a href="/notes/chapters/{{ chapter.id }}">{{ chapter.title }}</a></td>
                <td><a class="button button-small button-secondary" href="/notes/chapters/{{ chapter.id }}">Manage</a></td>
              </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
    {% else %}
      {% set emptyHeading = "No chapters yet" %}
      {% set emptyDescription = "Create a chapter to start organizing this book." %}
      {% set emptyActionUrl = "/notes/books/" ~ book.id ~ "/chapters/new" %}
      {% set emptyActionLabel = "New Chapter" %}
      {% include "partials/empty-state.njk" %}
    {% endif %}
  </section>

  <section class="settings-section">
    <h2>Pages</h2>
    {% if pages.length > 0 %}
      <div class="table-scroll" tabindex="0" aria-label="Pages list">
        <table class="data-table">
          <thead><tr><th>Title</th></tr></thead>
          <tbody>
            {% for page in pages %}
              <tr>
                <td><a href="/notes/{{ page.id }}">{{ page.title }}</a></td>
              </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
    {% else %}
      {% set emptyHeading = "No pages yet" %}
      {% set emptyDescription = "Pages created directly in this Book will appear here." %}
      {% set emptyActionUrl = "" %}
      {% set emptyActionLabel = "" %}
      {% include "partials/empty-state.njk" %}
    {% endif %}
  </section>
{% endblock %}
