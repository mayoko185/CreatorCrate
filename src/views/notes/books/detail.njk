{% extends "layout.njk" %}
{% import "partials/page-heading.njk" as pageHeading %}

{% set page_title = "Notes — " ~ book.title %}

{% block content %}
  {% call pageHeading.render() %}
    <a class="button button-primary" href="/notes/new?bookId={{ book.id }}">New Page</a>
    <a class="button" href="/notes/books/{{ book.id }}/chapters/new">New Chapter</a>
    <a class="button" href="/notes/books/{{ book.id }}/edit">Edit Book</a>
    {% if canChangeOrder %}
      <a class="button button-secondary" href="/notes/books/{{ book.id }}/order">Change order</a>
    {% endif %}
  {% endcall %}

  {% if notice %}
    {% set noticeVariant = notice.variant %}
    {% set noticeText = notice.text %}
    {% include "partials/notice.njk" %}
  {% endif %}

  {% include "partials/notes-hierarchy.njk" %}

  <div class="notes-book-sections">
    <section class="notes-book-section" aria-labelledby="notes-book-chapters-heading">
      <div class="notes-book-section-heading">
        <h2 id="notes-book-chapters-heading">Chapters</h2>
      </div>
    {% if chapters.length > 0 %}
      <ul class="notes-book-content-list" aria-label="Chapters in {{ book.title }}">
        {% for chapter in chapters %}
          <li class="notes-book-content-row">
            <div class="notes-book-content-copy">
              <span class="notes-book-content-kind">Chapter</span>
              <h3 class="notes-book-content-title"><a href="/notes/chapters/{{ chapter.id }}">{{ chapter.title }}</a></h3>
            </div>
            <div class="notes-book-content-actions">
              <a class="button button-small button-secondary" href="/notes/chapters/{{ chapter.id }}/edit" aria-label="Edit Chapter: {{ chapter.title }}">Edit Chapter</a>
            </div>
          </li>
        {% endfor %}
      </ul>
    {% else %}
      {% set emptyHeading = "No chapters yet" %}
      {% set emptyDescription = "Create a chapter to start organizing this book." %}
      {% set emptyHeadingLevel = "h3" %}
      {% set emptyActionUrl = "/notes/books/" ~ book.id ~ "/chapters/new" %}
      {% set emptyActionLabel = "New Chapter" %}
      {% include "partials/empty-state.njk" %}
    {% endif %}
    </section>

    <section class="notes-book-section" aria-labelledby="notes-book-pages-heading">
      <div class="notes-book-section-heading">
        <h2 id="notes-book-pages-heading">Pages</h2>
      </div>
    {% if pages.length > 0 %}
      <ul class="notes-book-content-list" aria-label="Direct Pages in {{ book.title }}">
        {% for page in pages %}
          <li class="notes-book-content-row">
            <div class="notes-book-content-copy">
              <span class="notes-book-content-kind">Page</span>
              <h3 class="notes-book-content-title"><a href="/notes/{{ page.id }}">{{ page.title }}</a></h3>
            </div>
            <div class="notes-book-content-actions">
              <a class="button button-small button-secondary" href="/notes/{{ page.id }}/edit" aria-label="Edit Page: {{ page.title }}">Edit Page</a>
            </div>
          </li>
        {% endfor %}
      </ul>
    {% else %}
      {% set emptyHeading = "No pages yet" %}
      {% set emptyDescription = "Pages created directly in this Book will appear here." %}
      {% set emptyHeadingLevel = "h3" %}
      {% set emptyActionUrl = "/notes/new?bookId=" ~ book.id %}
      {% set emptyActionLabel = "New Page" %}
      {% include "partials/empty-state.njk" %}
    {% endif %}
    </section>
  </div>
{% endblock %}
