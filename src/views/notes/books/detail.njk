{% extends "layout.njk" %}
{% import "partials/page-heading.njk" as pageHeading %}

{% set page_title = "Notes — " ~ book.title %}

{% block content %}
  {% call pageHeading.render() %}
    <a class="button button-primary" href="/notes/new?bookId={{ book.id }}">New Page</a>
    <a class="button" href="/notes/books/{{ book.id }}/chapters/new">New Chapter</a>
    <a class="button" href="/notes/books/{{ book.id }}/edit">Edit Book</a>
    {% if canChangeOrder %}
      <a class="button button-secondary" href="/notes/books/{{ book.id }}/order">Change order</a>
    {% endif %}
  {% endcall %}

  {% if notice %}
    {% set noticeVariant = notice.variant %}
    {% set noticeText = notice.text %}
    {% include "partials/notice.njk" %}
  {% endif %}

  <div class="notes-surface">
    <nav class="book-outline" aria-label="Contents of {{ book.title }}">
    {% if contents.length > 0 %}
      <ol class="book-outline-list">
        {% for item in contents %}
          {% if item.type == 'chapter' %}
            <li class="book-outline-item book-outline-chapter">
              <details class="book-outline-disclosure">
                <summary class="book-outline-summary">
                  <span class="book-outline-disclosure-indicator" aria-hidden="true"></span>
                  <span class="book-outline-title-wrap">
                    <a class="book-outline-title" href="/notes/chapters/{{ item.id }}">{{ item.chapter.title }}</a>
                  </span>
                  <span class="book-outline-count">{{ item.pages.length }} {% if item.pages.length == 1 %}Page{% else %}Pages{% endif %}</span>
                </summary>
                {% if item.pages.length > 0 %}
                  <ol class="book-outline-children">
                    {% for page in item.pages %}
                      <li class="book-outline-item book-outline-page book-outline-page--child">
                        <a class="book-outline-title" href="/notes/{{ page.id }}">{{ page.title }}</a>
                      </li>
                    {% endfor %}
                  </ol>
                {% else %}
                  <p class="book-outline-empty">No Pages yet</p>
                {% endif %}
              </details>
            </li>
          {% elif item.type == 'page' %}
            <li class="book-outline-item book-outline-page">
              <a class="book-outline-title" href="/notes/{{ item.id }}">{{ item.page.title }}</a>
            </li>
          {% endif %}
        {% endfor %}
      </ol>
    {% else %}
      <p class="book-outline-empty">No Pages or Chapters yet</p>
    {% endif %}
    </nav>
  </div>
{% endblock %}
