{% extends "layout.njk" %}
{% import "partials/page-heading.njk" as pageHeading %}

{% set page_title = "Notes — " ~ book.title %}

{% block content %}
  {% call pageHeading.render() %}
    <a class="button button-primary" href="/notes/new?bookId={{ book.id }}">New Page</a>
    <a class="button" href="/notes/books/{{ book.id }}/chapters/new">New Chapter</a>
    <a class="button" href="/notes/books/{{ book.id }}/edit">Edit Book</a>
    {% if canChangeOrder %}
      <a class="button button-secondary" href="/notes/books/{{ book.id }}/order">Change order</a>
    {% endif %}
  {% endcall %}

  {% if notice %}
    {% set noticeVariant = notice.variant %}
    {% set noticeText = notice.text %}
    {% include "partials/notice.njk" %}
  {% endif %}

  {% include "partials/notes-hierarchy.njk" %}

  <section class="notes-book-section" aria-labelledby="notes-book-content-heading">
    <div class="notes-book-section-heading">
      <h2 id="notes-book-content-heading">Content</h2>
    </div>
    {% if contents.length > 0 %}
      <ul class="notes-book-content-list" aria-label="Pages and Chapters in {{ book.title }}">
        {% for item in contents %}
          <li class="notes-book-content-row">
            {% if item.type == 'chapter' %}
              <div class="notes-book-content-copy">
                <span class="notes-book-content-kind">Chapter</span>
                <h3 class="notes-book-content-title"><a href="/notes/chapters/{{ item.id }}">{{ item.chapter.title }}</a></h3>
              </div>
              <div class="notes-book-content-actions">
                <a class="button button-small button-secondary" href="/notes/chapters/{{ item.id }}/edit" aria-label="Edit Chapter: {{ item.chapter.title }}">Edit Chapter</a>
              </div>
            {% elif item.type == 'page' %}
              <div class="notes-book-content-copy">
                <span class="notes-book-content-kind">Page</span>
                <h3 class="notes-book-content-title"><a href="/notes/{{ item.id }}">{{ item.page.title }}</a></h3>
              </div>
              <div class="notes-book-content-actions">
                <a class="button button-small button-secondary" href="/notes/{{ item.id }}/edit" aria-label="Edit Page: {{ item.page.title }}">Edit Page</a>
              </div>
            {% endif %}
          </li>
        {% endfor %}
      </ul>
    {% else %}
      {% set emptyHeading = "No Pages or Chapters yet" %}
      {% set emptyDescription = "Add a Page or Chapter to start this Book." %}
      {% set emptyHeadingLevel = "h3" %}
      {% include "partials/empty-state.njk" %}
    {% endif %}
  </section>
{% endblock %}
