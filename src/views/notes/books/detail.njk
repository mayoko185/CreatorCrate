{% extends "layout.njk" %}
{% import "partials/page-heading.njk" as pageHeading %}
{% import "partials/book-primary-image.njk" as bookPrimaryImage %}

{% import "partials/dialog.njk" as dialog %}

{% set page_title = "Notes — " ~ book.title %}

{% block content %}
  {% call pageHeading.render() %}
    <a class="button button-primary" href="/notes/new?bookId={{ book.id }}" data-dialog-open="note-create-dialog">New Page</a>
    <a class="button" href="/notes/books/{{ book.id }}/chapters/new" data-dialog-open="chapter-create-dialog">New Chapter</a>
    <a class="button" href="/notes/books/{{ book.id }}/edit" data-dialog-open="book-edit-dialog">Edit Book</a>
    {% if canChangeOrder %}
      <a class="button button-secondary" href="/notes/books/{{ book.id }}/order" data-dialog-open="book-order-dialog">Change order</a>
    {% endif %}
  {% endcall %}

  {% if notice %}
    {% set noticeVariant = notice.variant %}
    {% set noticeText = notice.text %}
    {% include "partials/notice.njk" %}
  {% endif %}

  <div class="notes-page-detail-layout">
    <div class="notes-page-sidebar">
      <aside class="notes-page-detail-sidebar notes-surface notes-surface--compact">
        {{ bookPrimaryImage.render(book, 'preview') }}
        {% include "partials/book-navigator.njk" %}
      </aside>

      {% set detailsHeadingId = "notes-book-details-heading" %}
      {% set detailsCreated = book.created_at %}
      {% set detailsUpdated = book.updated_at %}
      {% include "partials/notes-details-panel.njk" %}
    </div>

    <div class="notes-page-detail-content">
      <div class="notes-surface">
        <nav class="book-outline" aria-label="Contents of {{ book.title }}">
        {% if contents.length > 0 %}
          <ol class="book-outline-list">
            {% for item in contents %}
              {% if item.type == 'chapter' %}
                <li class="book-outline-item book-outline-chapter">
                  <details class="book-outline-disclosure">
                    <summary class="book-outline-summary">
                      <span class="book-outline-disclosure-indicator" aria-hidden="true"></span>
                      <span class="book-outline-title-wrap">
                        <span class="book-outline-title">{{ item.chapter.title }}</span>
                      </span>
                      <span class="book-outline-count">{{ item.pages.length }} {% if item.pages.length == 1 %}Page{% else %}Pages{% endif %}</span>
                    </summary>
                    <p class="book-outline-children">
                      <a class="book-outline-title" href="/notes/chapters/{{ item.id }}">View Chapter</a>
                    </p>
                    {% if item.pages.length > 0 %}
                      <ol class="book-outline-children">
                        {% for page in item.pages %}
                          <li class="book-outline-item book-outline-page book-outline-page--child">
                            <a class="book-outline-title" href="/notes/{{ page.id }}">{{ page.title }}</a>
                          </li>
                        {% endfor %}
                      </ol>
                    {% else %}
                      <p class="book-outline-empty">No Pages yet</p>
                    {% endif %}
                  </details>
                </li>
              {% elif item.type == 'page' %}
                <li class="book-outline-item book-outline-page">
                  <a class="book-outline-title" href="/notes/{{ item.id }}">{{ item.page.title }}</a>
                </li>
              {% endif %}
            {% endfor %}
          </ol>
        {% else %}
          <p class="book-outline-empty">No Pages or Chapters yet</p>
        {% endif %}
        </nav>
      </div>
    </div>
  </div>
{% endblock %}

{% block overlay %}
  {% include "notes/books/order.njk" %}
  {% include "notes/create-dialog.njk" %}
  {% set values = chapterCreateForm.values %}
  {% set errors = chapterCreateForm.errors %}
  {% set chapterTitleId = 'chapter-create-title' %}
  {% call dialog.render('chapter-create-dialog', 'New Chapter', chapterCreateDialogOpen, '', '', 'project-form-dialog') %}
    <form id="chapter-form" method="post" action="{{ chapterCreateForm.submitUrl }}" class="app-dialog-form project-form project-edit-dialog-form"
          data-dialog-form data-dialog-async="false" novalidate>
      <input type="hidden" name="_csrf" value="{{ _csrf }}">
      <div class="app-dialog-body">
        {% if errors.general %}
          <div class="error-summary" role="alert"><p>{{ errors.general }}</p></div>
        {% endif %}
        {% include "notes/chapters/form-fields.njk" %}
      </div>
      <footer class="app-dialog-footer">
        <button class="button button-primary" type="submit" data-dialog-submit>Create</button>
      </footer>
    </form>
  {% endcall %}

  {% set values = bookEditForm.values %}
  {% set errors = bookEditForm.errors %}
  {% set bookCoverSource = bookEditForm.book.primaryImage.selectedSource %}
  {% call dialog.render('book-edit-dialog', 'Edit Book', bookEditDialogOpen, '', '', 'project-form-dialog') %}
    <form id="book-form" method="post" action="{{ bookEditForm.submitUrl }}" enctype="multipart/form-data" class="app-dialog-form project-form project-edit-dialog-form"
          data-dialog-form data-dialog-async="false" novalidate>
      <input type="hidden" name="_csrf" value="{{ _csrf }}">
      <div class="app-dialog-body">
        {% if errors.general %}
          <div class="error-summary" role="alert"><p>{{ errors.general }}</p></div>
        {% endif %}
        {% include "notes/books/form-fields.njk" %}
      </div>
      <footer class="app-dialog-footer">
        <button class="button button-primary" type="submit" data-dialog-submit>Save</button>
      </footer>
    </form>

    <form id="book-delete-form" method="post" action="/notes/books/{{ book.id }}/delete">
      <input type="hidden" name="_csrf" value="{{ _csrf }}">
    </form>
  {% endcall %}
{% endblock %}
