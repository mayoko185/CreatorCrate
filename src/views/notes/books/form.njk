{% extends "layout.njk" %}
{% import "partials/page-heading.njk" as pageHeading %}

{% set title = action ~ " Book" %}
{% set page_title = "Notes — Edit " ~ book.title if action == "Edit" else "Notes — " ~ title %}
{% set submitLabel = "Save" if action == "Edit" else "Create" %}

{% block content %}
  {% call pageHeading.render() %}
    <button class="button button-primary" type="submit" form="book-form">{{ submitLabel }}</button>
    <a class="button button-secondary" href="{% if book %}/notes/books/{{ book.id }}{% else %}/notes{% endif %}">Cancel</a>
  {% endcall %}

  {% if errors.general %}
    <div class="error-summary" role="alert"><p>{{ errors.general }}</p></div>
  {% endif %}

  {% if book and action == "Edit" %}
    {% include "partials/notes-hierarchy.njk" %}
  {% endif %}

  <form id="book-form" method="post" action="{{ submitUrl }}" class="project-form" novalidate>
    <input type="hidden" name="_csrf" value="{{ _csrf }}">
    <div class="settings-section">
      <h2>Basic information</h2>
      <div class="field {% if errors.title %}field-error{% endif %}">
        <label for="title">Title <span class="required" aria-label="required">*</span></label>
        <input type="text" id="title" name="title" value="{{ values.title or '' }}" maxlength="200" required{% if errors.title %} aria-describedby="title-error" aria-invalid="true"{% endif %}>
        {% if errors.title %}<span class="field-error-message" id="title-error">{{ errors.title }}</span>{% endif %}
      </div>
    </div>
  </form>

  {% if book and action == "Edit" %}
    <section class="notes-detail-panel" aria-labelledby="book-actions-heading">
      <div class="notes-detail-section-heading">
        <p class="notes-detail-kicker">Secondary actions</p>
        <h2 id="book-actions-heading">Book actions</h2>
      </div>

      <details class="notes-workspace-disclosure notes-workspace-disclosure--delete">
        <summary>Delete Book</summary>
        <div class="notes-workspace-disclosure-content">
          <p class="notes-workspace-warning">The Book must be empty before it can be deleted. This cannot be undone.</p>
          <form id="book-delete-form" method="post" action="/notes/books/{{ book.id }}/delete">
            <input type="hidden" name="_csrf" value="{{ _csrf }}">
            <button class="button button-small button-danger" type="submit" data-confirm="Delete this Book permanently? This cannot be undone.">Delete Book</button>
          </form>
        </div>
      </details>
    </section>
  {% endif %}
{% endblock %}
