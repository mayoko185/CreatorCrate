{% extends "layout.njk" %}
{% import "partials/page-heading.njk" as pageHeading %}

{% set page_title = "Notes" %}

{% block content %}
  {% call pageHeading.render() %}
    <a class="button button-primary" href="/notes/books/new">New Book</a>
    {% if books.length > 1 %}
      <a class="button button-secondary" href="/notes/books/order">Change order</a>
    {% endif %}
  {% endcall %}

  {% if notice %}
    {% set noticeVariant = notice.variant %}
    {% set noticeText = notice.text %}
    {% include "partials/notice.njk" %}
  {% endif %}

  <section class="notes-books-index" aria-label="Books">
    {% if books.length > 0 %}
      <ul class="notes-book-content-list" aria-label="Books">
        {% for book in books %}
          <li class="notes-book-content-row">
            <div class="notes-book-content-copy">
              <span class="notes-book-content-kind">Book</span>
              <h2 class="notes-book-content-title"><a href="/notes/books/{{ book.id }}">{{ book.title }}</a></h2>
            </div>
            <div class="notes-book-content-actions">
              <a class="button button-small button-secondary" href="/notes/books/{{ book.id }}/edit" aria-label="Edit Book: {{ book.title }}">Edit Book</a>
            </div>
          </li>
        {% endfor %}
      </ul>
    {% else %}
      {% set emptyHeading = "No books yet" %}
      {% set emptyDescription = "Create a book to start organizing your notes." %}
      {% set emptyActionUrl = "/notes/books/new" %}
      {% set emptyActionLabel = "New Book" %}
      {% include "partials/empty-state.njk" %}
    {% endif %}
  </section>
{% endblock %}
