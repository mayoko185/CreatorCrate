{% extends "layout.njk" %}
{% import "partials/page-heading.njk" as pageHeading %}

{% set page_title = "Notes" %}

{% block content %}
  {% call pageHeading.render() %}
    <a class="button button-primary" href="/notes/books/new">New Book</a>
  {% endcall %}

  {% if notice %}
    {% set noticeVariant = notice.variant %}
    {% set noticeText = notice.text %}
    {% include "partials/notice.njk" %}
  {% endif %}

  <section class="settings-section">
    <h2>Books</h2>
    {% if books.length > 0 %}
      <div class="table-scroll" tabindex="0" aria-label="Books list">
        <table class="data-table">
          <thead>
            <tr>
              <th>Title</th>
              <th>Actions</th>
              {% if books.length > 1 %}<th>Order</th>{% endif %}
            </tr>
          </thead>
          <tbody>
            {% for book in books %}
              {% set bookIndex = loop.index0 %}
              <tr>
                <td><a href="/notes/books/{{ book.id }}">{{ book.title }}</a></td>
                <td><a class="button button-small button-secondary" href="/notes/books/{{ book.id }}">Manage</a></td>
                {% if books.length > 1 %}
                  <td>
                    {% if bookIndex > 0 %}
                      <form method="post" action="/notes/books/reorder" class="inline-form">
                        <input type="hidden" name="_csrf" value="{{ _csrf }}">
                        <input type="hidden" name="orderedBookIds" value="{% for orderedBook in books %}{% if loop.index0 == bookIndex - 1 %}{{ book.id }}{% elif loop.index0 == bookIndex %}{{ books[bookIndex - 1].id }}{% else %}{{ orderedBook.id }}{% endif %}{% if not loop.last %},{% endif %}{% endfor %}">
                        <button type="submit" class="button button-small button-secondary" aria-label="Move {{ book.title }} up">Move up</button>
                      </form>
                    {% endif %}
                    {% if bookIndex < books.length - 1 %}
                      <form method="post" action="/notes/books/reorder" class="inline-form">
                        <input type="hidden" name="_csrf" value="{{ _csrf }}">
                        <input type="hidden" name="orderedBookIds" value="{% for orderedBook in books %}{% if loop.index0 == bookIndex %}{{ books[bookIndex + 1].id }}{% elif loop.index0 == bookIndex + 1 %}{{ book.id }}{% else %}{{ orderedBook.id }}{% endif %}{% if not loop.last %},{% endif %}{% endfor %}">
                        <button type="submit" class="button button-small button-secondary" aria-label="Move {{ book.title }} down">Move down</button>
                      </form>
                    {% endif %}
                  </td>
                {% endif %}
              </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
    {% else %}
      {% set emptyHeading = "No books yet" %}
      {% set emptyDescription = "Create a book to start organizing your notes." %}
      {% set emptyActionUrl = "/notes/books/new" %}
      {% set emptyActionLabel = "New Book" %}
      {% include "partials/empty-state.njk" %}
    {% endif %}
  </section>
{% endblock %}
