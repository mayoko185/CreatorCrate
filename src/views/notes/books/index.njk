{% extends "layout.njk" %}
{% import "partials/page-heading.njk" as pageHeading %}
{% import "partials/book-primary-image.njk" as bookPrimaryImage %}
{% import "partials/dialog.njk" as dialog %}
{% import "partials/icons.njk" as icons %}

{% set page_title = "Notes" %}

{% block content %}
  {% call pageHeading.render() %}
    <a class="button button-small button-primary project-detail-action project-assets-heading-action asset-tooltip asset-tooltip--left"
       href="/notes/books/new" data-dialog-open="book-create-dialog" data-dialog-invocation
       aria-label="New Book" data-tooltip="New Book">
      {{ icons.icon('plus') }}
    </a>
    <button class="button button-small button-secondary project-detail-action project-assets-heading-action asset-tooltip asset-tooltip--{{ 'top' if books.length > 1 else 'right' }}"
            type="button" data-dialog-open="book-transfer-dialog"
            aria-label="Import/Export Books" data-tooltip="Import/Export Books">
      {{ icons.icon('database-backup') }}
    </button>
    {% if books.length > 1 %}
      <a class="button button-small button-secondary project-detail-action project-assets-heading-action asset-tooltip asset-tooltip--right"
         href="/notes/books/order" data-dialog-open="books-order-dialog" data-dialog-invocation
         aria-label="Change book order" data-tooltip="Change book order">
        {{ icons.icon('sort') }}
      </a>
    {% endif %}
  {% endcall %}

  {% if notice %}
    {% set noticeVariant = notice.variant %}
    {% set noticeText = notice.text %}
    {% include "partials/notice.njk" %}
  {% endif %}

  <section class="notes-books-index" aria-label="Books" data-notes-books-live-region>
    <span class="sr-only" data-notes-books-live-status aria-live="polite" aria-atomic="true"></span>
    {% if books.length > 0 %}
      <ul class="notes-book-shelf" aria-label="Books">
        {% for book in books %}
          <li class="notes-book-card">
            <article class="notes-book-card-surface">
              {{ bookPrimaryImage.render(book) }}
              <div class="notes-book-card-body">
                <span class="notes-book-content-kind">Book</span>
                <h2 class="notes-book-card-title"><a href="/notes/books/{{ book.id }}">{{ book.title }}</a></h2>
                <div class="notes-book-content-actions">
                  <a class="button button-small button-secondary" href="/notes/books/{{ book.id }}/edit" data-dialog-invocation aria-label="Edit Book: {{ book.title }}">Edit Book</a>
                </div>
              </div>
            </article>
          </li>
        {% endfor %}
      </ul>
    {% else %}
      {% set emptyHeading = "No books yet" %}
      {% set emptyDescription = "Create a book to start organizing your notes." %}
      {% set emptyActionUrl = "/notes/books/new" %}
      {% set emptyActionLabel = "New Book" %}
      {% set emptyActionDialogId = "book-create-dialog" %}
      {% include "partials/empty-state.njk" %}
    {% endif %}
  </section>
{% endblock %}

{% block overlay %}
  {% include "notes/books/transfer.njk" %}
  {% include "notes/books/order-index.njk" %}
  {% set values = bookCreateForm.values %}
  {% set errors = bookCreateForm.errors %}
  {% set bookCoverSource = none %}
  {% call dialog.render('book-create-dialog', 'New Book', bookCreateDialogOpen, '', '', 'project-form-dialog') %}
    <form id="book-form" method="post" action="{{ bookCreateForm.submitUrl }}" enctype="multipart/form-data" class="app-dialog-form project-form project-edit-dialog-form"
          data-dialog-form data-dialog-async="false" data-dialog-reset-on-close{% if errors.title or errors.general %} data-dialog-reset-values="{{ { title: '' } | dump }}"{% endif %} novalidate>
      <input type="hidden" name="_csrf" value="{{ _csrf }}">
      <div class="app-dialog-body">
        {% if errors.general %}
          <div class="error-summary" role="alert"><p>{{ errors.general }}</p></div>
        {% endif %}
        {% include "notes/books/form-fields.njk" %}
      </div>
      <footer class="app-dialog-footer">
        <button class="button button-primary" type="submit" data-dialog-submit>Create</button>
      </footer>
    </form>
  {% endcall %}
{% endblock %}
