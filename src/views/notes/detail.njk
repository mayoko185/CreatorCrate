{% extends "layout.njk" %}
{% import "partials/page-heading.njk" as pageHeading %}

{% set page_title = "Notes — Page — " ~ note.title %}

{% block content %}
  {% call pageHeading.render("Page") %}
    <a class="button button-primary" href="/notes/{{ note.id }}/edit">Edit Page</a>
  {% endcall %}

  <div class="notes-page-detail-layout">
    <div class="notes-page-sidebar">
      <aside class="notes-page-detail-sidebar notes-surface notes-surface--compact">
        {% include "partials/book-navigator.njk" %}
      </aside>

      {% set detailsHeadingId = "notes-detail-details-heading" %}
      {% set detailsCreated = note.created_at %}
      {% set detailsUpdated = note.updated_at %}
      {% include "partials/notes-details-panel.njk" %}
    </div>

    <div class="notes-page-detail-content">
      <section class="notes-detail-content" aria-labelledby="notes-detail-content-heading">
        <div class="notes-detail-section-heading">
          <p class="notes-detail-kicker" id="notes-detail-content-heading">{{ note.title }}</p>
        </div>
        {% if note.content %}
          <div class="notes-content">{{ contentHtml | safe }}</div>
        {% else %}
          <p class="help-text">No content yet.</p>
        {% endif %}
      </section>

      {% if projects.length > 0 %}
        <section class="notes-detail-panel notes-detail-projects" aria-labelledby="notes-detail-projects-heading">
          <h2 id="notes-detail-projects-heading">Projects</h2>
          <ul class="project-list">
            {% for project in projects %}
              <li><a href="/projects/{{ project.id }}">{{ project.title }}</a></li>
            {% endfor %}
          </ul>
        </section>
      {% endif %}

      {% if assets.length > 0 %}
        <section class="notes-detail-panel notes-detail-assets" aria-labelledby="notes-detail-assets-heading">
          <h2 id="notes-detail-assets-heading">Assets</h2>
          <ul class="asset-list notes-detail-asset-list">
            {% for asset in assets %}
              <li class="asset-list-item{% if not asset.isPresent %} is-missing{% endif %}">
                <div class="notes-detail-asset">
                  <a class="notes-detail-asset-link" href="{{ asset.viewerUrl }}">{{ asset.filename }}</a>
                  <span>Project: {{ asset.projectTitle }}</span>
                  <span>{{ asset.relativePath }}</span>
                  {% if not asset.isPresent %}<span>Missing</span>{% endif %}
                </div>
              </li>
            {% endfor %}
          </ul>
        </section>
      {% endif %}
    </div>
  </div>
{% endblock %}
