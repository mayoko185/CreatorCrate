{# Transient Loop toggle for a playable video inside a [data-asset-video-playback] root. Never persisted; toggling only sets `.loop` and never starts playback. #}
<label class="asset-video-loop-control" data-asset-video-loop-control>
  <input type="checkbox" autocomplete="off" data-asset-video-loop>
  <span>Loop</span>
</label>
