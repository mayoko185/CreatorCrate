{% import "partials/dialog.njk" as dialog %}
{% import "partials/dropdown.njk" as dropdown %}

{% call dialog.render('asset-edit-dialog', 'Edit Asset', assetEditDialogOpen, 'asset-edit-description', '', 'asset-edit-dialog asset-form-dialog app-dialog--refined') %}
  <p id="asset-edit-description" class="app-dialog-description">
    Update this asset's primary-image selection or file details.
  </p>

  <div class="app-dialog-body asset-edit-dialog-body">
    {% if formError %}
      <div class="error-summary" role="alert">
        <p>{{ formError.message }}</p>
      </div>
    {% endif %}

    {% if canManageTags %}
      <section class="settings-section asset-edit-dialog-section asset-tags-edit-section" aria-labelledby="asset-tags-edit-heading">
        <h3 id="asset-tags-edit-heading">Tags</h3>
        <div class="asset-edit-dialog-section-body asset-tags-edit-section-body">
          <form id="asset-edit-form" method="post" action="/projects/{{ project.id }}/assets/{{ asset.id }}/tags" data-confirmed-tag-ids="{{ confirmedAssetTagIds | join(',') }}"
                class="app-dialog-form asset-edit-tags-form" data-dialog-form data-dialog-async="false" data-asset-tags-form>
            <input type="hidden" name="_csrf" value="{{ _csrf }}">
            <input type="hidden" name="origin" value="asset-edit">
            {# WP10A1-F3: the saved tag set this form shows, as the save's reviewed state. #}
            <input type="hidden" name="tagReview" value="{{ assetTagReview }}" data-asset-tag-review>
            {{ dropdown.multiSelect({
              id: "asset-tags-form",
              name: "tagIds[]",
              label: "Tags",
              options: assetTagOptions,
              selectedValues: selectedAssetTagIds,
              emptySummary: "No tags selected",
              countLabel: "tags",
              triggerAriaLabel: "Tags: " ~ ("No tags selected" if selectedAssetTagIds.length == 0 else (selectedAssetTagIds.length ~ " tags selected")),
              emptyState: {
                text: "No tags available.",
                link: { text: "Add tags in Settings", href: "/settings/tags" },
                suffix: "."
              },
              fieldClasses: "asset-edit-tags-field",
              panelLabel: "Tag options",
              inputAttributes: { "data-autosubmit": "submit" }
            }) }}
            <span class="help-text">Add new tags in <a href="/settings/tags">Settings › Tags</a>.</span>
          </form>
        </div>
      </section>
    {% endif %}

    {# Primary-image regions. asset-viewer-refresh.js re-installs them from a GET
       after a confirmed change; the wrappers are always rendered (display:
       contents) so a section that appears or disappears still has a place,
       and they carry the saved selection that the page reconciles against. #}
    <div class="asset-edit-dialog-region" data-asset-viewer-region="project-primary-image" data-primary-image-selected="{{ 'true' if isPrimaryImage else 'false' }}">
    {% if isPrimaryImage or canSetAsPrimaryImage %}
      <section class="settings-section asset-edit-dialog-section asset-primary-image-section" aria-labelledby="asset-primary-image-heading">
        <h3 id="asset-primary-image-heading">Primary image</h3>
        <div class="asset-edit-dialog-section-body asset-primary-image-section-body">
          <p class="asset-action-description">Choose the image used to represent this project.</p>
          {% if isPrimaryImage %}
            {% if isPrimaryImageAvailable %}
              <p class="asset-primary-image-status">Currently set as the primary image.</p>
            {% else %}
              <p class="asset-primary-image-status">Currently set as the primary image — unavailable until restored.</p>
            {% endif %}
            {% if canRemovePrimaryImage %}
              <form method="post" action="/projects/{{ project.id }}/assets/{{ asset.id }}/primary-image/remove" class="asset-action-form asset-primary-image-remove-form">
                <input type="hidden" name="_csrf" value="{{ _csrf }}">
                {% for key in contextFields %}
                  {% if context[key] is not none and context[key] != '' %}
                    <input type="hidden" name="{{ key }}" value="{{ context[key] }}">
                  {% endif %}
                {% endfor %}
                <div>
                  <button class="button button-danger" type="submit">Remove primary image</button>
                </div>
              </form>
            {% endif %}
          {% else %}
            <form method="post" action="/projects/{{ project.id }}/assets/{{ asset.id }}/primary-image" class="asset-action-form asset-primary-image-set-form">
              <input type="hidden" name="_csrf" value="{{ _csrf }}">
              {% for key in contextFields %}
                {% if context[key] is not none and context[key] != '' %}
                  <input type="hidden" name="{{ key }}" value="{{ context[key] }}">
                {% endif %}
              {% endfor %}
              <div>
                <button class="button button-primary" type="submit">Set as primary image</button>
              </div>
            </form>
          {% endif %}
        </div>
      </section>
    {% endif %}
    </div>

    <div class="asset-edit-dialog-region" data-asset-viewer-region="book-primary-image" data-book-primary-image-book-ids="{% for usage in bookPrimaryImageUsages %}{{ usage.id }}{% if not loop.last %},{% endif %}{% endfor %}">
    {% if canSetAsBookPrimaryImage or bookPrimaryImageUsages.length > 0 %}
      <section class="settings-section asset-edit-dialog-section asset-book-primary-image-section" aria-labelledby="asset-book-primary-image-heading">
        <h3 id="asset-book-primary-image-heading">Book primary image</h3>
        <div class="asset-edit-dialog-section-body asset-book-primary-image-section-body">
          {% if canSetAsBookPrimaryImage %}
            <p class="asset-action-description">Choose the Book this image represents.</p>
            {% if bookPrimaryImageOptions.length > 0 %}
              <form method="post" action="/projects/{{ project.id }}/assets/{{ asset.id }}/book-primary-image" class="asset-action-form asset-book-primary-image-set-form">
                <input type="hidden" name="_csrf" value="{{ _csrf }}">
                {% for key in contextFields %}
                  {% if context[key] is not none and context[key] != '' %}
                    <input type="hidden" name="{{ key }}" value="{{ context[key] }}">
                  {% endif %}
                {% endfor %}
                {{ dropdown.singleSelect({
                  id: "book-primary-image-book",
                  name: "bookId",
                  label: "Book",
                  options: bookPrimaryImageOptions,
                  placeholder: "Choose a Book",
                  panelLabel: "Book options",
                  nativeSelect: {
                    id: "book-primary-image-book-native",
                    attributes: { required: true }
                  }
                }) }}
                <div>
                  <button class="button button-primary" type="submit">Set as book primary image</button>
                </div>
              </form>
            {% else %}
              <p class="asset-filter-multiselect-empty">No Books available. <a href="/notes/books/new">New Book</a>.</p>
            {% endif %}
          {% endif %}

          {# Re-installed on its own, so the Book choice above keeps its draft. #}
          <div class="asset-edit-dialog-region" data-asset-viewer-region="book-primary-image-usages">
          {% if bookPrimaryImageUsages.length > 0 %}
            <p class="asset-primary-image-status">Currently used as the primary image for:</p>
            <ul class="asset-book-primary-image-usage-list">
              {% for usage in bookPrimaryImageUsages %}
                <li>
                  <strong>{{ usage.title }}</strong>
                  <form method="post" action="/projects/{{ project.id }}/assets/{{ asset.id }}/book-primary-image/remove" class="asset-action-form asset-book-primary-image-remove-form">
                    <input type="hidden" name="_csrf" value="{{ _csrf }}">
                    <input type="hidden" name="bookId" value="{{ usage.id }}">
                    {% for key in contextFields %}
                      {% if context[key] is not none and context[key] != '' %}
                        <input type="hidden" name="{{ key }}" value="{{ context[key] }}">
                      {% endif %}
                    {% endfor %}
                    <div>
                      <button class="button button-danger" type="submit" aria-label="Remove book primary image from {{ usage.title }}">Remove book primary image</button>
                    </div>
                  </form>
                </li>
              {% endfor %}
            </ul>
          {% endif %}
          </div>
        </div>
      </section>
    {% endif %}
    </div>

    {% if canMutate %}
      <section class="settings-section asset-edit-dialog-section asset-actions-section" aria-labelledby="asset-actions-heading">
        <h3 id="asset-actions-heading">File actions</h3>
        <div class="asset-edit-dialog-section-body asset-edit-dialog-actions-body">
          <details class="notes-workspace-disclosure">
            <summary>Rename file</summary>
            <div class="notes-workspace-disclosure-content">
              <p class="asset-action-description">Change only the filename. The category and folder stay the same.</p>
              <form method="post" action="/projects/{{ project.id }}/assets/{{ asset.id }}/rename" class="asset-action-form asset-rename-form">
                <input type="hidden" name="_csrf" value="{{ _csrf }}">
                <input type="hidden" name="origin" value="viewer">
                <input type="hidden" name="{{ assetReviewField }}" value="{{ assetReview }}" data-asset-review>
                {% for key in contextFields %}
                  {% if context[key] is not none and context[key] != '' %}
                    <input type="hidden" name="{{ key }}" value="{{ context[key] }}">
                  {% endif %}
                {% endfor %}
                <div class="field">
                  <label for="rename-filename">New filename</label>
                  <input type="text" id="rename-filename" name="filename" value="{{ submittedFilename }}" data-confirmed-value="{{ asset.filename }}" required maxlength="255" autocomplete="off">
                </div>
                <div>
                  <button class="button button-primary" type="submit">Rename file</button>
                </div>
              </form>
            </div>
          </details>

          <details class="notes-workspace-disclosure">
            <summary>Move file</summary>
            <div class="notes-workspace-disclosure-content">
              <p class="asset-action-description">Move to a category root or Uncategorized. Nested subfolders are not preserved.</p>
              <form method="post" action="/projects/{{ project.id }}/assets/{{ asset.id }}/move" class="asset-action-form asset-move-form">
                <input type="hidden" name="_csrf" value="{{ _csrf }}">
                <input type="hidden" name="{{ assetReviewField }}" value="{{ assetReview }}" data-asset-review>
                {% for key in contextFields %}
                  {% if context[key] is not none and context[key] != '' %}
                    <input type="hidden" name="{{ key }}" value="{{ context[key] }}">
                  {% endif %}
                {% endfor %}
                {% set moveDestinationOptions = [{ value: 'uncategorized', label: 'Uncategorized' }] %}
                {% for category in enabledCategories %}
                  {% set _ = moveDestinationOptions.push({ value: category.id ~ '', label: category.displayName }) %}
                {% endfor %}
                {% set moveDestinationSelectedLabels = [] %}
                {% for option in moveDestinationOptions %}
                  {% if option.value == submittedDestinationCategory %}{% set _ = moveDestinationSelectedLabels.push(option.label) %}{% endif %}
                {% endfor %}
                {# The native select keeps the #move-destination form contract
                   (name, values, data-confirmed-value) that the dialog's
                   close reset reads; the dropdown is its presentation. It sits
                   low in a long dialog, so its panel is placed against the
                   viewport and opens upward when there is no room below. #}
                {{ dropdown.singleSelect({
                  id: "move-destination-dropdown",
                  name: "destinationCategory",
                  label: "Destination",
                  options: moveDestinationOptions,
                  selected: submittedDestinationCategory,
                  triggerAriaLabel: "Destination: " ~ (moveDestinationSelectedLabels[0] or ''),
                  fieldClasses: "asset-move-destination-field",
                  attributes: [["data-cc-viewport-disclosure", true]],
                  panelLabel: "Destination options",
                  nativeSelect: {
                    id: "move-destination",
                    attributes: { "data-confirmed-value": (asset.category_id if asset.category_id is not none else 'uncategorized') ~ '' }
                  }
                }) }}
                <div>
                  <button class="button button-primary" type="submit">Move file</button>
                </div>
              </form>
            </div>
          </details>

          <details class="notes-workspace-disclosure notes-workspace-disclosure--delete">
            <summary>Delete asset</summary>
            <div class="notes-workspace-disclosure-content">
              <p class="notes-workspace-warning">Permanently delete this file from disk. It cannot be restored through CreatorCrate.</p>
              {# data-confirm-submit-required: with scripts, only a completed
                 confirmation may submit this form (requestSubmit and Enter
                 included); the native form and redirect are unchanged. #}
              <form method="post" action="/projects/{{ project.id }}/assets/{{ asset.id }}/delete" class="asset-action-form asset-delete-form" data-confirm-submit-required>
                <input type="hidden" name="_csrf" value="{{ _csrf }}">
                {# The state of the asset this page shows: the server deletes it
                   only while the asset still has exactly this state, so a
                   Delete confirmed here never removes a later rename, move or
                   replacement. A Rename/Move refresh installs the new value. #}
                <input type="hidden" name="{{ assetDeleteReviewField }}" value="{{ assetDeleteReview }}" data-asset-delete-review>
                {% for key in contextFields %}
                  {% if context[key] is not none and context[key] != '' %}
                    <input type="hidden" name="{{ key }}" value="{{ context[key] }}">
                  {% endif %}
                {% endfor %}
                <div>
                  <button class="button button-danger" type="submit"
                          data-confirm-dialog-title="Delete asset?"
                          data-confirm-dialog-confirm-label="Delete asset"
                          data-confirm="The file will be permanently deleted from disk and cannot be restored through CreatorCrate. Continue?">Delete asset</button>
                </div>
              </form>
            </div>
          </details>
        </div>
      </section>
    {% endif %}
  </div>

  {# The dialog's one live region. The in-place tag save, primary-image,
     Rename, Move and Delete actions (asset-edit-dialog.js) report here; it stays
     announced while the dialog is frozen for a save. #}
  <div class="app-dialog-status" data-dialog-status role="status" aria-live="polite"></div>

{% endcall %}
