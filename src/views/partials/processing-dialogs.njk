{# Processing dialogs: Rename, Convert, Workflow Prompt Editor, Watermark, Archives,
   and the global-resource (Watermarks/Scale maps) dialogs they link to. Rendered
   once in the assets page overlay block (outside the live-filtered region,
   so they survive live category/search/sort changes). All async behavior is
   handled by client/processing.js — these are plain [data-processing-*]
   marked-up fields, not [data-dialog-form] forms, so the generic
   appDialogBindForm submit handler never engages them. #}
{% import "partials/dialog.njk" as dialog %}
{% import "partials/dropdown.njk" as dropdown %}
{% import "partials/icons.njk" as icons %}
{% import "partials/processing-recovery-details.njk" as recoveryDetails %}

{# Static-option select: routed through the shared cc-dropdown component like
   every other choice control on this page (see dropdown.njk). #}
{% macro processingSelect(id, field, type, label, options) %}
  <div class="field app-dialog-field">
    {{ dropdown.singleSelect({
      id: id ~ '-dropdown',
      label: label,
      fieldClasses: 'processing-select-field',
      dispatchNativeChange: true,
      options: options,
      optionIdPrefix: id,
      panelLabel: label ~ ' options',
      nativeSelect: {
        id: id,
        attributes: [['data-processing-field', field], ['data-processing-type', type]]
      }
    }) }}
  </div>
{% endmacro %}

{# Async-populated select (presets, global Watermarks/scale maps): rendered
   with the shared cc-dropdown component so it uses the same visual treatment.
   The native select stays as the source of truth; the option list resyncs via
   syncCreatorCrateDropdownFromNative after async loads (processing.js). #}
{% macro processingDynamicSelect(id, field, type, label, placeholderText) %}
  {{ dropdown.singleSelect({
    id: id ~ '-dropdown',
    label: label,
    visuallyHiddenLabel: true,
    fieldClasses: 'processing-select-field',
    dispatchNativeChange: true,
    placeholder: placeholderText,
    selected: '',
    options: [],
    optionIdPrefix: id,
    panelLabel: label ~ ' options',
    nativeSelect: {
      id: id,
      attributes: [['data-processing-field', field], ['data-processing-type', type]]
    }
  }) }}
{% endmacro %}

{% macro scopeSection(prefix, categoryOptions=[], embedded=false) %}
  {% set usesWatermarkScopePattern = prefix == 'watermark' or prefix == 'workflow' %}
  <{% if embedded %}div class="processing-archive-scope"{% else %}section class="settings-section processing-dialog-section"{% endif %} data-processing-scope role="radiogroup" aria-labelledby="{{ prefix }}-scope-heading">
    <h3 id="{{ prefix }}-scope-heading">Scope</h3>
    <div class="processing-dialog-section-body processing-scope-body{% if usesWatermarkScopePattern %} processing-watermark-scope-body{% endif %}">
      {% if usesWatermarkScopePattern %}<div class="processing-watermark-scope-row">{% endif %}
      <label class="field field--checkbox processing-scope-option{% if usesWatermarkScopePattern %} processing-watermark-choice-control{% endif %}">
        <input type="radio" name="{{ prefix }}-scope-type" value="selected" data-processing-scope-option="selected" checked>
        <span>{% if usesWatermarkScopePattern %}Selected{% else %}Selected assets{% endif %} (<span data-processing-selected-count>0</span> selected)</span>
      </label>
      {% if not usesWatermarkScopePattern %}<p class="processing-scope-hint help-text" data-processing-selected-hint hidden>Select assets in the browser list to use this scope.</p>{% endif %}

      {% if usesWatermarkScopePattern %}
        <label class="field field--checkbox processing-scope-option processing-watermark-choice-control">
          <input type="radio" name="{{ prefix }}-scope-type" value="project" data-processing-scope-option="project">
          <span>All categories</span>
        </label>
      {% endif %}
      {% if not usesWatermarkScopePattern %}
        <label class="field field--checkbox processing-scope-option">
          <input type="radio" name="{{ prefix }}-scope-type" value="category" data-processing-scope-option="category">
          <span>Category</span>
        </label>
      {% endif %}
      <div class="processing-scope-category-field">
        {% if usesWatermarkScopePattern %}
          <input class="sr-only" type="radio" name="{{ prefix }}-scope-type" value="category" data-processing-scope-option="category" aria-label="Category scope">
        {% endif %}
        {% set processingSelectedCategoryValue = '' %}
        {% for categoryOption in categoryOptions %}
          {% if categoryOption.selected %}
            {% set processingSelectedCategoryValue = categoryOption.value %}
          {% endif %}
        {% endfor %}
        {{ dropdown.singleSelect({
          id: prefix ~ '-category-select-dropdown',
          label: 'Category',
          visuallyHiddenLabel: true,
          fieldClasses: 'processing-select-field',
          dispatchNativeChange: true,
          selected: processingSelectedCategoryValue,
          placeholder: 'Select a category…',
          options: categoryOptions,
          optionIdPrefix: prefix ~ '-category-select',
          panelLabel: 'Category options',
          nativeSelect: {
            id: prefix ~ '-category-select',
            attributes: [['data-processing-category-select', true]]
          }
        }) }}
      </div>

      {% if prefix == 'archive' %}
        <label class="field field--checkbox processing-scope-option">
          <input type="radio" name="{{ prefix }}-scope-type" value="project" data-processing-scope-option="project">
          <span>Entire project</span>
        </label>
      {% endif %}

      {% if usesWatermarkScopePattern %}
        </div>
        <p class="processing-scope-hint help-text" data-processing-selected-hint hidden>Select assets in the browser list to use this scope.</p>
      {% endif %}
    </div>
  </{% if embedded %}div{% else %}section{% endif %}>
{% endmacro %}

{% macro presetSection(prefix, label='Preset') %}
  <section class="settings-section processing-dialog-section">
    <h3>{{ label }}</h3>
    <div class="processing-dialog-section-body">
      {{ dropdown.singleSelect({
        id: prefix ~ '-preset-select-dropdown',
        label: label,
        visuallyHiddenLabel: true,
        fieldClasses: 'processing-select-field',
        dispatchNativeChange: true,
        placeholder: 'Custom',
        selected: '',
        options: [],
        optionIdPrefix: prefix ~ '-preset-select',
        panelLabel: label ~ ' options',
        nativeSelect: {
          id: prefix ~ '-preset-select',
          attributes: [['data-processing-preset-select', true]]
        }
      }) }}
      <p class="help-text processing-preset-modified" data-processing-preset-modified hidden>Modified from preset.</p>
      <div class="form-actions" data-processing-preset-actions>
        <button type="button" class="button button-small" data-processing-preset-save>Save as preset</button>
        <button type="button" class="button button-small button-secondary" data-processing-preset-update disabled aria-disabled="true">Update preset</button>
      </div>
      <form class="processing-preset-name-form" data-processing-preset-name-form hidden>
        <div class="field">
          <label for="{{ prefix }}-preset-name-input" data-processing-preset-name-label>New preset name</label>
          <input id="{{ prefix }}-preset-name-input" type="text" maxlength="200" required autocomplete="off" data-processing-preset-name-input>
        </div>
        <div class="processing-preset-name-form-actions">
          <button type="submit" class="button button-primary button-small" data-processing-preset-name-submit>Save</button>
          <button type="button" class="button button-secondary button-small" data-processing-preset-name-cancel>Cancel</button>
        </div>
      </form>
      <details class="notes-workspace-disclosure">
        <summary>Preset settings</summary>
        <div class="notes-workspace-disclosure-content">
          <div class="form-actions">
            <button type="button" class="button button-small button-secondary" data-processing-preset-rename disabled aria-disabled="true">Rename preset</button>
            <button type="button" class="button button-small button-secondary" data-processing-preset-import>Import presets</button>
            <button type="button" class="button button-small button-secondary" data-processing-preset-export disabled aria-disabled="true">Export presets</button>
            <button type="button" class="button button-small button-danger" data-processing-preset-delete disabled aria-disabled="true">Delete preset</button>
            <input type="file" accept="application/json,.json" data-processing-preset-import-input hidden>
          </div>
        </div>
      </details>
    </div>
  </section>
{% endmacro %}

{% macro processingOutputSections(withArchiveDetails=false, withWatermarkPreview=false) %}
  <section class="settings-section processing-dialog-section" data-processing-plan hidden>
    <h3>Plan</h3>
    <div class="processing-dialog-section-body">
      <dl class="processing-plan-counts" data-processing-plan-counts></dl>
      <div class="notice notice--warning processing-plan-destructive" data-processing-plan-destructive hidden></div>
      <ul class="processing-plan-items" data-processing-plan-items></ul>
      {% if withArchiveDetails %}
        <div class="processing-archive-plan-details" data-processing-archive-plan-details hidden></div>
      {% endif %}
    </div>
  </section>
  {% if withWatermarkPreview %}
  <section class="settings-section processing-dialog-section" data-processing-watermark-preview hidden>
    <h3>Preview</h3>
    <div class="processing-dialog-section-body">
      <p class="help-text" data-processing-watermark-preview-state></p>
      <p class="help-text" data-processing-watermark-preview-source hidden></p>
      <div class="processing-watermark-rendered-preview" data-processing-watermark-preview-image-wrap hidden>
        <img data-processing-watermark-preview-image alt="Rendered Watermark preview">
      </div>
    </div>
  </section>
  {% endif %}
  <section class="settings-section processing-dialog-section" data-processing-result hidden>
    <h3>Result</h3>
    <div class="processing-dialog-section-body">
      <div data-processing-result-body></div>
      <div class="form-actions">
        <button type="button" class="button button-small button-secondary" data-processing-refresh>Refresh assets</button>
      </div>
      <p class="help-text processing-refresh-status" data-processing-refresh-status role="status" aria-live="polite" hidden></p>
    </div>
  </section>
{% endmacro %}

{% macro planFooter(applyLabel='Apply') %}
  <div class="app-dialog-error processing-error" data-processing-error role="alert" hidden>
    <p data-processing-error-text></p>
  </div>
  <div class="app-dialog-status" data-processing-status role="status" aria-live="polite"></div>
  {{ recoveryDetails.dialogEntryPoint() }}
  <footer class="app-dialog-footer">
    <button type="button" class="button button-secondary" data-processing-preview>Preview</button>
    <button type="button" class="button button-primary" data-processing-apply disabled aria-disabled="true">{{ applyLabel }}</button>
  </footer>
{% endmacro %}

{# ─── Rename ───────────────────────────────────────────────────────────── #}
{% call dialog.render('processing-rename-dialog', 'Rename', false, 'processing-rename-description', '', 'app-dialog--processing app-dialog--processing-rename', [
  ['data-processing-root', true],
  ['data-processing-operation', 'rename'],
  ['data-project-id', project.id],
  ['data-csrf', _csrf]
]) %}
  <p id="processing-rename-description" class="app-dialog-description">Rename each selected file without changing its extension.</p>
  <div class="app-dialog-body processing-dialog-body">
    <section class="settings-section processing-dialog-section">
      <h3>Selected files</h3>
      <div class="processing-dialog-section-body">
        <ol class="processing-plan-items processing-rename-list" data-processing-rename-list></ol>
      </div>
    </section>
    {{ processingOutputSections() }}
  </div>
  {{ planFooter('Save') }}
{% endcall %}

{# ─── Convert ──────────────────────────────────────────────────────────── #}
{% call dialog.render('processing-convert-dialog', 'Convert', false, 'processing-convert-description', '', 'app-dialog--processing', [
  ['data-processing-root', true],
  ['data-processing-operation', 'convert'],
  ['data-project-id', project.id],
  ['data-csrf', _csrf],
  ['data-current-category-id', currentCategoryId or ''],
  ['data-current-category-label', currentCategoryLabel or '']
]) %}
  <p id="processing-convert-description" class="app-dialog-description">Convert selected assets to a different image format.</p>
  <div class="app-dialog-body processing-dialog-body">

    {{ presetSection('convert') }}
    {{ scopeSection('convert', processingCategoryOptions) }}

    <section class="settings-section processing-dialog-section">
      <h3>Conversion</h3>
      <div class="processing-dialog-section-body">
        <div class="processing-convert-options">
          {{ processingSelect('convert-format', 'format', 'string', 'Format', [
            { value: 'png', label: 'PNG' },
            { value: 'jpg', label: 'JPG' },
            { value: 'jpeg', label: 'JPEG' },
            { value: 'bmp', label: 'BMP' },
            { value: 'gif', label: 'GIF' },
            { value: 'webp', label: 'WebP', selected: true }
          ]) }}
          <div class="field app-dialog-field processing-convert-quality-field">
            <label for="convert-quality">Quality</label>
            <input id="convert-quality" type="number" min="1" max="95" placeholder="85"
                   data-processing-field="quality" data-processing-type="int" data-processing-omit-if-empty="true">
            <p class="help-text">Only affects JPEG/WebP output. 1–95, default 85.</p>
          </div>
          {{ processingSelect('convert-original-handling', 'originalHandling', 'string', 'Original handling', [
            { value: 'keep', label: 'Keep originals', selected: true },
            { value: 'move', label: 'Move originals (file-changing)' },
            { value: 'delete', label: 'Delete originals (file-changing)' }
          ]) }}
        </div>
        <p class="help-text">Converting to the same extension requires Keep originals.</p>
      </div>
    </section>

    {{ processingOutputSections() }}
  </div>
  {{ planFooter() }}
{% endcall %}

{# ─── Image workflows editor ──────────────────────────────────────────── #}
{% call dialog.render('processing-workflow-dialog', 'Image workflows editor', false, 'processing-workflow-description', '', 'app-dialog--processing app-dialog--processing-workflow', [
  ['data-processing-root', true],
  ['data-processing-operation', 'workflow-prompt'],
  ['data-project-id', project.id],
  ['data-csrf', _csrf],
  ['data-current-category-id', currentCategoryId or ''],
  ['data-current-category-label', currentCategoryLabel or '']
]) %}
  <p id="processing-workflow-description" class="app-dialog-description">Edit PNG workflow metadata prompts for selected assets.</p>
  <div class="app-dialog-body processing-dialog-body">

    {{ presetSection('workflow') }}
    {{ scopeSection('workflow', processingCategoryOptions) }}

    <p class="help-text">Rules run in Remove → Replace → Prepend → Append order, regardless of the order added below. Within each type, row order matters.</p>

    <template data-processing-rule-row-template>
      <li class="processing-rule-row" data-processing-rule-row>
        <div class="processing-rule-type" data-processing-rule-type>
          {{ dropdown.singleSelect({
            id: 'workflow-rule-operation-dropdown',
            label: 'Operation',
            visuallyHiddenLabel: true,
            fieldClasses: 'processing-select-field',
            dispatchNativeChange: true,
            selected: 'remove',
            options: [
              { value: 'remove', label: 'Remove', selected: true },
              { value: 'replace', label: 'Replace' },
              { value: 'prepend', label: 'Prepend' },
              { value: 'append', label: 'Append' }
            ],
            optionIdPrefix: 'workflow-rule-operation',
            panelLabel: 'Rule operation options',
            nativeSelect: {
              id: 'workflow-rule-operation',
              attributes: [['data-processing-rule-operation', true]]
            }
          }) }}
        </div>
        <input type="text" data-processing-rule-text aria-label="Rule text" placeholder="Text" autocomplete="off">
        <input type="text" data-processing-rule-search aria-label="Search text" placeholder="Search (may be left empty)" autocomplete="off" hidden>
        <input type="text" data-processing-rule-replacement aria-label="Replacement text" placeholder="Replacement" autocomplete="off" hidden>
        <button type="button" class="button button-small button-secondary" data-processing-remove-rule aria-label="Remove rule">X</button>
      </li>
    </template>

    <section class="settings-section processing-dialog-section processing-rule-section" data-processing-rules="positive">
      <h3>Positive prompt rules</h3>
      <div class="processing-dialog-section-body">
        <ul class="processing-rule-list" data-processing-rule-list aria-label="Positive prompt rules"></ul>
        <button type="button" class="button button-small" data-processing-add-rule="positive">Add rule</button>
      </div>
    </section>
    <section class="settings-section processing-dialog-section processing-rule-section" data-processing-rules="negative">
      <h3>Negative prompt rules</h3>
      <div class="processing-dialog-section-body">
        <ul class="processing-rule-list" data-processing-rule-list aria-label="Negative prompt rules"></ul>
        <button type="button" class="button button-small" data-processing-add-rule="negative">Add rule</button>
      </div>
    </section>

    {{ processingOutputSections() }}
  </div>
  {{ planFooter() }}
{% endcall %}

{# ─── Watermark ────────────────────────────────────────────────────────── #}
{% call dialog.render('processing-watermark-dialog', 'Watermark', false, 'processing-watermark-description', '', 'app-dialog--processing', [
  ['data-processing-root', true],
  ['data-processing-operation', 'watermark'],
  ['data-project-id', project.id],
  ['data-csrf', _csrf],
  ['data-current-category-id', currentCategoryId or ''],
  ['data-current-category-label', currentCategoryLabel or '']
]) %}
  <p id="processing-watermark-description" class="app-dialog-description">Apply a global Watermark PNG to selected assets, with optional resize.</p>
  <div class="app-dialog-body processing-dialog-body">

    {{ presetSection('watermark') }}

    <section class="settings-section processing-dialog-section">
      <h3>Watermark source</h3>
      <div class="processing-dialog-section-body">
        <div class="field app-dialog-field">
          <label for="watermark-resource-select">Watermark</label>
          <div class="processing-resource-field">
            {{ processingDynamicSelect('watermark-resource-select', 'watermarkId', 'int-or-null', 'Watermark', 'Select a global Watermark…') }}
          </div>
          <div class="processing-watermark-thumb" data-processing-watermark-thumb hidden>
            <img data-processing-watermark-thumb-img alt="">
          </div>
          <p class="help-text">Place PNG files in the global <code>watermarks/</code> folder. Scan refreshes the list immediately; automatic scanning also refreshes it when <code>AUTO_SCAN_INTERVAL_MINUTES</code> is configured.</p>
          <p class="help-text" data-processing-watermark-default-status hidden></p>
          <button type="button" class="button button-small button-secondary" data-processing-set-default-watermark disabled>Set as default</button>
        </div>
        <div class="form-actions">
          <button type="button" class="button button-small button-secondary" data-dialog-open="processing-manage-watermarks-dialog">Manage watermarks</button>
          <button type="button" class="button button-small button-secondary" data-dialog-open="processing-manage-scale-map-dialog">Manage Scale Map</button>
        </div>
        <input type="hidden" data-processing-field="mode" data-processing-type="string" value="custom">
      </div>
    </section>

    {{ scopeSection('watermark', processingCategoryOptions) }}

    <section class="settings-section processing-dialog-section">
      <h3>Placement</h3>
      <div class="processing-dialog-section-body">
        <div class="processing-watermark-compact-grid processing-watermark-compact-row">
          {{ processingSelect('watermark-position', 'position', 'string', 'Position', [
            { value: 'br', label: 'Bottom-right' },
            { value: 'bl', label: 'Bottom-left', selected: true },
            { value: 'tr', label: 'Top-right' },
            { value: 'tl', label: 'Top-left' },
            { value: 'c', label: 'Center' }
          ]) }}
          {{ processingSelect('watermark-containment', 'containment', 'string', 'Containment', [
            { value: 'clamp', label: 'Clamp', selected: true },
            { value: 'shrink', label: 'Shrink' }
          ]) }}
          <label class="field field--checkbox processing-watermark-choice-control">
          <input type="checkbox" data-processing-field="allowOffCanvas" data-processing-type="bool">
          <span>Allow off-canvas</span>
          </label>
        </div>
      </div>
    </section>

    <section class="settings-section processing-dialog-section">
      <h3>Size &amp; scale</h3>
      <div class="processing-dialog-section-body">
        <div class="processing-watermark-compact-grid processing-watermark-compact-row processing-watermark-compact-row--size-primary">
          {{ processingSelect('watermark-scale-basis', 'scaleBasis', 'string', 'Scale basis', [
            { value: 'width', label: 'Width' },
            { value: 'height', label: 'Height' },
            { value: 'short', label: 'Short side' },
            { value: 'long', label: 'Long side' },
            { value: 'geo', label: 'Geometric mean' },
            { value: 'diagonal', label: 'Diagonal' },
            { value: 'window', label: 'Window', selected: true }
          ]) }}
          <div class="field app-dialog-field processing-watermark-field--numeric">
            <label for="watermark-scale">Scale</label>
            <input id="watermark-scale" type="number" step="any" min="0" placeholder="0.25"
                   data-processing-field="scale" data-processing-type="float" data-processing-omit-if-empty="true">
            <p class="help-text">Used unless overridden by the scale map or fixed width.</p>
          </div>
          <div class="field app-dialog-field processing-watermark-field--numeric processing-watermark-field--fixed-width">
            <label for="watermark-fixed-width">Fixed watermark width (px)</label>
            <input id="watermark-fixed-width" type="number" min="0" step="1" placeholder="0"
                   data-processing-field="fixedWatermarkWidthPx" data-processing-type="int" data-processing-omit-if-empty="true">
            <p class="help-text">Overrides the scale map and manual scale for watermark size; margin can still depend on scale basis.</p>
          </div>
        </div>
        <div class="processing-watermark-compact-grid processing-watermark-compact-row processing-watermark-compact-row--size-secondary">
          <div class="field app-dialog-field processing-watermark-field--numeric">
            <label for="watermark-window-aspect">Window aspect</label>
            <input id="watermark-window-aspect" type="number" step="any" min="0" placeholder="1.777778"
                   data-processing-field="windowAspect" data-processing-type="float" data-processing-omit-if-empty="true">
          </div>
          <div class="field app-dialog-field processing-watermark-field--numeric">
          <label for="watermark-opacity">Opacity</label>
          <input id="watermark-opacity" type="number" step="any" min="0" max="1" placeholder="0.65"
                 data-processing-field="opacity" data-processing-type="float" data-processing-omit-if-empty="true">
          </div>
        </div>
      </div>
    </section>

    <section class="settings-section processing-dialog-section">
      <h3>Offsets</h3>
      <div class="processing-dialog-section-body">
        <div class="processing-watermark-compact-grid processing-watermark-compact-grid--offsets">
          <div class="field app-dialog-field processing-watermark-field--numeric">
            <label for="watermark-margin-ratio">Margin (%/ratio)</label>
            <input id="watermark-margin-ratio" type="number" step="any" min="0" placeholder="0.02"
                   data-processing-field="marginRatio" data-processing-type="float" data-processing-omit-if-empty="true">
          </div>
          <div class="field app-dialog-field">
            <label for="watermark-nudge-x-ratio">Nudge X (%/ratio)</label>
            <input id="watermark-nudge-x-ratio" type="number" step="any" placeholder="0"
                   data-processing-field="nudgeXRatio" data-processing-type="float" data-processing-omit-if-empty="true">
          </div>
          <div class="field app-dialog-field">
            <label for="watermark-nudge-y-ratio">Nudge Y (%/ratio)</label>
            <input id="watermark-nudge-y-ratio" type="number" step="any" placeholder="0"
                   data-processing-field="nudgeYRatio" data-processing-type="float" data-processing-omit-if-empty="true">
          </div>
          <div class="field app-dialog-field">
            <label for="watermark-margin-px">Margin (px)</label>
            <input id="watermark-margin-px" type="number" step="1" placeholder="0"
                   data-processing-field="marginPx" data-processing-type="int" data-processing-omit-if-empty="true">
          </div>
          <div class="field app-dialog-field">
            <label for="watermark-nudge-x">Nudge X (px)</label>
            <input id="watermark-nudge-x" type="number" step="1" placeholder="0"
                   data-processing-field="nudgeX" data-processing-type="int" data-processing-omit-if-empty="true">
          </div>
          <div class="field app-dialog-field">
            <label for="watermark-nudge-y">Nudge Y (px)</label>
            <input id="watermark-nudge-y" type="number" step="1" placeholder="0"
                   data-processing-field="nudgeY" data-processing-type="int" data-processing-omit-if-empty="true">
          </div>
        </div>
      </div>
    </section>

    <section class="settings-section processing-dialog-section">
      <h3>Resize</h3>
      <div class="processing-dialog-section-body">
        <div class="processing-watermark-compact-grid processing-watermark-compact-row">
          <div class="field app-dialog-field processing-watermark-field--numeric">
          <label for="watermark-max-dimension">Max dimension</label>
          <input id="watermark-max-dimension" type="number" min="0" step="1" placeholder="0"
                 data-processing-field="maxDimension" data-processing-type="int" data-processing-omit-if-empty="true">
        </div>
        <label class="field field--checkbox processing-watermark-choice-control">
          <input type="checkbox" data-processing-field="watermarkBeforeResize" data-processing-type="bool">
          <span>Watermark before resize</span>
          </label>
          <label class="field field--checkbox processing-watermark-choice-control">
          <input type="checkbox" data-processing-field="trimWatermark" data-processing-type="bool" checked>
          <span>Trim transparent watermark border</span>
          </label>
        </div>
      </div>
    </section>

    <section class="settings-section processing-dialog-section">
      <h3>Output format</h3>
      <div class="processing-dialog-section-body">
        <div class="processing-watermark-compact-grid processing-watermark-compact-row processing-watermark-compact-row--formats">
          {{ processingSelect('watermark-primary-format', 'primaryFormat', 'string', 'Primary format', [
            { value: 'none', label: 'None' },
            { value: 'png', label: 'PNG', selected: true },
            { value: 'jpeg', label: 'JPG' },
            { value: 'webp', label: 'WebP' }
          ]) }}
          {{ processingSelect('watermark-secondary-format', 'secondaryFormat', 'string', 'Secondary format', [
            { value: 'none', label: 'None', selected: true },
            { value: 'png', label: 'PNG' },
            { value: 'jpeg', label: 'JPG' },
            { value: 'webp', label: 'WebP' }
          ]) }}
          {{ processingSelect('watermark-resized-format', 'resizedFormat', 'string', 'Resized', [
            { value: 'none', label: 'None', selected: true },
            { value: 'png', label: 'PNG' },
            { value: 'jpeg', label: 'JPG' },
            { value: 'webp', label: 'WebP' }
          ]) }}
        </div>
        <div class="processing-watermark-compact-grid processing-watermark-compact-row processing-watermark-compact-row--format-settings">
          <div class="field app-dialog-field processing-watermark-field--numeric" data-processing-format-setting="quality">
            <label for="watermark-quality">Quality</label>
            <input id="watermark-quality" type="number" min="1" max="100" placeholder="90"
                   data-processing-field="quality" data-processing-type="int" data-processing-omit-if-empty="true">
          </div>
          <label class="field field--checkbox processing-watermark-choice-control" data-processing-format-setting="webpLossless">
          <input type="checkbox" data-processing-field="webpLossless" data-processing-type="bool">
          <span>Lossless WebP</span>
          </label>
          <div class="field app-dialog-field processing-watermark-field--text" data-processing-format-setting="jpegBackground">
          <label for="watermark-jpeg-background">JPEG background</label>
          <input id="watermark-jpeg-background" type="text" placeholder="white"
                 data-processing-field="jpegBackground" data-processing-type="string" data-processing-omit-if-empty="true">
          </div>
        </div>
      </div>
    </section>

    <section class="settings-section processing-dialog-section">
      <h3>Output naming</h3>
      <div class="processing-dialog-section-body">
        <div class="processing-watermark-compact-grid processing-watermark-compact-row processing-watermark-compact-row--output-naming-fields">
          <div class="field app-dialog-field processing-watermark-field--output-category" data-processing-output-category-field>
          {{ dropdown.singleSelect({
            id: 'watermark-output-category-dropdown',
            label: 'Output category',
            fieldClasses: 'processing-select-field',
            dispatchNativeChange: true,
            selected: '',
            placeholder: 'Choose an output category…',
            options: processingOutputCategoryOptions,
            optionIdPrefix: 'watermark-output-category',
            panelLabel: 'Output category options',
            nativeSelect: {
              id: 'watermark-output-category',
              attributes: [['data-processing-field', 'outputCategorySlug'], ['data-processing-type', 'string'], ['data-processing-omit-if-empty', true]]
            }
          }) }}
          <p class="help-text" data-processing-output-category-help>Select a project category for generated Watermark outputs.</p>
          </div>
          <div class="field app-dialog-field processing-watermark-field--text">
            <label for="watermark-suffix-unresized">Unresized suffix</label>
            <input id="watermark-suffix-unresized" type="text" placeholder="_wm" autocomplete="off"
                   data-processing-field="unresizedSuffix" data-processing-type="string" data-processing-omit-if-empty="true">
          </div>
          <div class="field app-dialog-field processing-watermark-field--text">
            <label for="watermark-suffix-resized">Resized suffix</label>
            <input id="watermark-suffix-resized" type="text" placeholder="_lq_wm" autocomplete="off"
                   data-processing-field="resizedSuffix" data-processing-type="string" data-processing-omit-if-empty="true">
          </div>
        </div>
        <div class="processing-watermark-compact-grid processing-watermark-compact-row processing-watermark-compact-row--output-naming-options">
          <label class="field field--checkbox processing-watermark-choice-control">
          <input type="checkbox" data-processing-field="overwrite" data-processing-type="bool" checked>
          <span>Replace existing generated outputs</span>
          </label>
          <div data-processing-delete-source-toggle>
            <label class="field field--checkbox processing-watermark-choice-control">
          <input type="checkbox" data-processing-field="deleteSource" data-processing-type="bool">
          <span>Delete source</span>
            </label>
            <p class="notice notice--warning processing-delete-source-warning" data-processing-delete-source-warning hidden>
          Source files are only removed after all required outputs and artifacts succeed. Preview shows any protection or skip conditions — deletion is never guaranteed by this checkbox alone.
            </p>
          </div>
        </div>
      </div>
    </section>

    {{ processingOutputSections(false, true) }}
  </div>
  {{ planFooter() }}
{% endcall %}

{# ─── Archives ──────────────────────────────────────────────────────────── #}
{% call dialog.render('processing-archive-dialog', 'Archives', false, 'processing-archive-description', '', 'app-dialog--processing app-dialog--processing-archive', [
  ['data-processing-root', true],
  ['data-processing-operation', 'archive'],
  ['data-project-id', project.id],
  ['data-csrf', _csrf],
  ['data-current-category-id', currentCategoryId or ''],
  ['data-current-category-label', currentCategoryLabel or '']
]) %}
  <p id="processing-archive-description" class="app-dialog-description">Configure archives from selected image assets.</p>
  <div class="app-dialog-body processing-dialog-body">
    <section class="settings-section processing-dialog-section" data-archive-create aria-labelledby="archive-create-heading">
      <h3 id="archive-create-heading">Create archives</h3>
      <div class="processing-dialog-section-body">
        {{ scopeSection('archive', processingCategoryOptions, true) }}
        <div class="processing-archive-entries" data-archive-entries></div>
        <button type="button" class="button button-primary dashboard-create-action" data-archive-add aria-label="+ archive"><span class="project-create-submit-icon" aria-hidden="true">{{ icons.icon('plus') }}</span>archive</button>
        <p class="sr-only" data-archive-announcement role="status" aria-live="polite" aria-atomic="true"></p>
      </div>
    </section>

    <details class="processing-section" data-archive-advanced>
      <summary>Advanced options</summary>
      <label class="processing-checkbox-label" for="archive-replace-existing">
        <input id="archive-replace-existing" type="checkbox" data-archive-replace> Replace existing archives
      </label>
      <p class="help-text">Replacement applies to all archives in this run.</p>
      <p id="archive-naming-help" class="help-text">Set name overrides Set prefix and Base name when provided. Leave prefix and base name empty to use format defaults. Image format and quality suffixes keep the default JPEG and WebP filenames distinct.</p>
      <div class="processing-archive-naming-list" data-archive-naming-list></div>
    </details>

    <template data-archive-entry-template>
      <fieldset class="processing-archive-entry" data-archive-entry>
        <legend id="archive-entry-heading" data-archive-heading>Archive</legend>
        <div class="processing-archive-entry-fields">
          {{ dropdown.singleSelect({
            id: 'archive-entry-format-dropdown', label: 'Archive format',
            fieldClasses: 'processing-select-field', dispatchNativeChange: true,
            selected: 'zip', options: [
              { value: 'zip', label: 'ZIP' }, { value: '7z', label: '7Z' },
              { value: 'cbz', label: 'CBZ' }, { value: 'cb7', label: 'CB7' }
            ], nativeSelect: { id: 'archive-entry-format', attributes: [['data-archive-field', 'archiveFormat']] }
          }) }}
          <div class="processing-archive-names">
            <div class="field app-dialog-field">
              <label for="archive-entry-set-name">Set name (optional)</label>
              <input id="archive-entry-set-name" type="text" autocomplete="off" placeholder="Optional" data-archive-field="setName" aria-describedby="archive-naming-help">
            </div>
            <div class="field app-dialog-field">
              <label for="archive-entry-prefix">Set prefix</label>
              <input id="archive-entry-prefix" type="text" autocomplete="off" data-archive-field="prefix" aria-describedby="archive-naming-help">
            </div>
          </div>
          <div class="processing-archive-image-settings" role="group" aria-label="Image settings">
            {{ dropdown.singleSelect({
              id: 'archive-entry-image-format-dropdown', label: 'Image Format',
              fieldClasses: 'processing-select-field', dispatchNativeChange: true,
              selected: 'jpeg', options: [
                { value: 'jpeg', label: 'JPEG' }, { value: 'webp', label: 'WebP' }, { value: 'png', label: 'PNG' }
              ], nativeSelect: { id: 'archive-entry-image-format', attributes: [['data-archive-field', 'imageFormat']] }
            }) }}
            <div class="field app-dialog-field" data-archive-jpeg-options>
              <label for="archive-entry-jpeg-quality">JPEG quality</label>
              <input id="archive-entry-jpeg-quality" type="number" min="1" max="100" step="1" value="80" data-archive-field="jpegQuality">
            </div>
            <div class="processing-archive-webp-settings" data-archive-webp-options hidden>
              <div class="field app-dialog-field">
                <label for="archive-entry-webp-quality">WebP quality</label>
                <input id="archive-entry-webp-quality" type="number" min="1" max="100" step="1" value="90" data-archive-field="webpQuality" aria-describedby="archive-entry-lossless-hint">
              </div>
              <label class="processing-checkbox-label" for="archive-entry-lossless">
                <input id="archive-entry-lossless" type="checkbox" data-archive-field="lossless" aria-describedby="archive-entry-lossless-hint"> Lossless
              </label>
              <p id="archive-entry-lossless-hint" class="help-text" data-archive-lossless-hint hidden>Quality does not apply to lossless WebP output. Your lossy quality value is retained.</p>
            </div>
          </div>
          <button type="button" class="button button-small button-secondary" data-archive-remove>Remove</button>
        </div>
      </fieldset>
    </template>
    <template data-archive-naming-template>
      <fieldset class="processing-archive-naming" data-archive-naming>
        <legend data-archive-naming-heading>Archive</legend>
        <div class="field app-dialog-field">
          <label for="archive-entry-base-name">Base name</label>
          <input id="archive-entry-base-name" type="text" autocomplete="off" placeholder="archive" data-archive-field="baseName" aria-describedby="archive-naming-help">
        </div>
      </fieldset>
    </template>

    {{ processingOutputSections(true) }}
  </div>
  {{ planFooter() }}
{% endcall %}

{# ─── Manage Watermarks ───────────────────────────────────────────────── #}
{% call dialog.render('processing-manage-watermarks-dialog', 'Manage watermarks', false, 'processing-manage-watermarks-description', '', '', [
  ['data-processing-manage-watermarks', true],
  ['data-csrf', _csrf]
]) %}
  <p id="processing-manage-watermarks-description" class="app-dialog-description">
    Watermark PNGs come from the global <code>watermarks/</code> folder in CreatorCrate's projects root. This dialog is read-only and lists indexed global candidates.
  </p>
  <div class="app-dialog-body processing-manage-body">
    <p class="help-text">Place PNG files in the global <code>watermarks/</code> folder. Scan refreshes the list immediately; automatic scanning also refreshes it when <code>AUTO_SCAN_INTERVAL_MINUTES</code> is configured.</p>
    <ul class="processing-resource-list" data-processing-watermark-list aria-label="Global Watermark PNGs"></ul>
  </div>
  <div class="app-dialog-error processing-error" data-processing-error role="alert" hidden><p data-processing-error-text></p></div>
  <div class="app-dialog-status" data-processing-status role="status" aria-live="polite"></div>
  <footer class="app-dialog-footer">
    <button type="button" class="button button-primary" data-processing-scan-watermarks>Scan</button>
  </footer>
{% endcall %}

{# ─── Manage Scale Map ────────────────────────────────────────────────── #}
{% call dialog.render('processing-manage-scale-map-dialog', 'Manage Scale Map', false, 'processing-manage-scale-map-description', '', '', [
  ['data-processing-manage-scale-map', true],
  ['data-csrf', _csrf]
]) %}
  <p id="processing-manage-scale-map-description" class="app-dialog-description">
    Watermark scale per exact source resolution (width×height are orientation-specific — 1365×768 is distinct from 768×1365).
  </p>
  <div class="app-dialog-body processing-manage-body">
    <div class="processing-scale-map-editor" data-processing-scale-map-editor>
      <div class="processing-scale-map-grid" role="group" aria-label="Resolution scale rows">
        <div class="processing-scale-map-grid-header" aria-hidden="true">
          <span>Width</span><span>Height</span><span>Scale</span><span></span>
        </div>
        <div data-processing-scale-map-rows></div>
      </div>
      <button type="button" class="button button-small" data-processing-scale-map-add-row>Add resolution</button>
      <div class="field">
        <label for="processing-scale-map-default">Default scale (optional)</label>
        <input id="processing-scale-map-default" type="text" placeholder="e.g. 0.10" data-processing-scale-map-default>
      </div>
    </div>
  </div>
  <div class="app-dialog-error processing-error" data-processing-error role="alert" hidden><p data-processing-error-text></p></div>
  <div class="app-dialog-status" data-processing-status role="status" aria-live="polite"></div>
  <footer class="app-dialog-footer">
    <button type="button" class="button button-primary" data-processing-scale-map-save>Save</button>
  </footer>
{% endcall %}
