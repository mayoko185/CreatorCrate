{#
  Dashboard title trigger paired with its Calendar information card. The
  trigger follows the Calendar convention (data-calendar-info-trigger with
  aria-controls/aria-expanded), so enhanceDashboardTitleInfoCards binds it to
  the Calendar hybrid lifecycle: hover shows the card at the pointer, a click
  pins it, and navigation goes through the card's Open/Edit actions. The card
  carries the full title, so the trigger has no native title tooltip
  competing with it.

  `surface` and `key` keep card ids unique when one record appears in more
  than one row.

  Usage:
    {% import "partials/dashboard-title-info.njk" as titleInfo %}
    {{ titleInfo.release(release, 'scheduled', clockFormat) }}
    {{ titleInfo.project(project, 'table', project.id, clockFormat) }}
#}
{% import "partials/calendar-info-card.njk" as infoCard %}

{% macro trigger(title, detailId) %}
  <button class="dashboard-title-trigger dashboard-truncate" type="button" data-calendar-info-trigger aria-controls="{{ detailId }}" aria-expanded="false">{{ title }}</button>
{% endmacro %}

{% macro release(release, surface, clockFormat) %}
  {% set detailId = 'dashboard-release-info-' ~ surface ~ '-' ~ release.id %}
  <div class="dashboard-title-info" data-dashboard-title-info>
    {{ trigger(release.title, detailId) }}
    {{ infoCard.release(release.infoCard, detailId, clockFormat) }}
  </div>
{% endmacro %}

{% macro project(project, surface, key, clockFormat) %}
  {% set detailId = 'dashboard-project-info-' ~ surface ~ '-' ~ key %}
  <div class="dashboard-title-info" data-dashboard-title-info>
    {{ trigger(project.title, detailId) }}
    {{ infoCard.project(project, detailId, clockFormat) }}
  </div>
{% endmacro %}
