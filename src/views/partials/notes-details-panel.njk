<section class="{% if notesDetailsPresentation == 'project-section' %}project-detail-info project-detail-section{% else %}notes-detail-panel{% endif %} notes-detail-details" aria-labelledby="{{ detailsHeadingId }}">
  <h2 id="{{ detailsHeadingId }}">Details</h2>
  {% if notesDetailsPresentation == 'project-section' %}<div class="project-detail-section-body">{% endif %}
  <dl class="detail-list">
    <dt>Created</dt>
    <dd>{{ detailsCreated }}</dd>

    <dt>Updated</dt>
    <dd>{{ detailsUpdated }}</dd>
  </dl>
  {% if notesDetailsPresentation == 'project-section' %}</div>{% endif %}
</section>
