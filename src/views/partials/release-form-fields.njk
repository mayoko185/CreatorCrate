{% import "partials/dropdown.njk" as dropdown %}
{% import "partials/icons.njk" as icons %}
{% set releaseFormDialog = releaseFormDialog or false %}
{% set releaseProjectDropdownId = releaseProjectDropdownId or 'release-project-filter' %}
{% set releaseSignatureDropdownId = releaseSignatureDropdownId or 'release-description-signature' %}
{% set releasePlatformsDropdownId = releasePlatformsDropdownId or 'release-platforms' %}
{# Hosts that render this form beside another form with the same field names
   (the Dashboard also hosts New Project) pass fieldIdPrefix so ids, labels
   and ARIA references stay unique; other hosts keep the unprefixed ids. #}
{% set idPrefix = fieldIdPrefix or '' %}

{% if not release %}
  {% set projectSummary = 'Select a project' %}
  {% set releaseProjectOptions = [] %}
  {% for project in projects %}
    {% set _ = releaseProjectOptions.push({ value: project.id, title: project.title }) %}
    {% if selectedProjectId == project.id %}
      {% set projectSummary = project.title %}
    {% endif %}
  {% endfor %}

  {# Dialogs show the selector inside Release details with a visible label; the
     standalone page keeps it in its own card, where the heading labels it. #}
  {% set releaseProjectField %}
    {{ dropdown.searchableSingleSelect({
      id: releaseProjectDropdownId,
      name: "projectId",
      label: "Project",
      visuallyHiddenLabel: not releaseFormDialog,
      required: true,
      options: releaseProjectOptions,
      valueKey: "value",
      labelKey: "title",
      selected: selectedProjectId,
      summary: projectSummary,
      summaryAttributes: [
        ["aria-describedby", idPrefix ~ "projectId-error" if errors.projectId else none],
        ["aria-invalid", "true" if errors.projectId else none]
      ],
      panelLabel: "Project options",
      searchLabel: "Search projects",
      searchInputId: releaseProjectDropdownId ~ "-search",
      optionListId: releaseProjectDropdownId ~ "-option-list",
      noResultsText: "No matching projects",
      optionListLabel: "Project choices",
      optionIdPrefix: releaseProjectDropdownId,
      inputAttributes: [
        ["required", true],
        ["aria-describedby", idPrefix ~ "projectId-error" if errors.projectId else none],
        ["aria-invalid", "true" if errors.projectId else none]
      ],
      fieldClasses: "asset-viewer-filter-field asset-viewer-project-filter{% if errors.projectId %} field-error{% endif %}",
      classes: "asset-project-filter-disclosure"
    }) }}
    {% if errors.projectId %}<span class="field-error-message" id="{{ idPrefix }}projectId-error">{{ errors.projectId }}</span>{% endif %}
  {% endset %}

  {% if not releaseFormDialog %}
  <div class="settings-section release-project-section">
    <h3>Project</h3>
    <div class="release-form-section-body">
    {{ releaseProjectField | safe }}
    </div>
  </div>
  {% endif %}
{% endif %}

<div class="settings-section{% if releaseFormDialog %} project-form-section project-edit-dialog-section release-details-section{% endif %}">
  <h3>{{ 'Release details' if releaseFormDialog else 'Basic information' }}</h3>
  <div class="release-form-section-body{% if releaseFormDialog %} project-form-section-body project-edit-dialog-section-body release-details-section-body{% endif %}">
  {% if releaseFormDialog and not release %}
  <div class="release-details-project">
    {{ releaseProjectField | safe }}
  </div>
  {% endif %}
  <div class="field {% if errors.title %}field-error{% endif %}" data-dialog-field="title">
    <label for="{{ idPrefix }}title">Title <span class="required" aria-label="required">*</span></label>
    <input type="text" id="{{ idPrefix }}title" name="title" value="{{ values.title or '' }}" maxlength="200" required{% if errors.title %} aria-describedby="{{ idPrefix }}title-error" aria-invalid="true"{% endif %}>
    {% if errors.title %}<span class="field-error-message" id="{{ idPrefix }}title-error">{{ errors.title }}</span>{% endif %}
  </div>
  {% if releaseFormDialog %}<div class="release-description-group">{% endif %}
  <div class="field {% if errors.description %}field-error{% endif %}" data-dialog-field="description">
    <label for="{{ idPrefix }}description">Description</label>
    <textarea id="{{ idPrefix }}description" name="description" rows="6" maxlength="4000"{% if errors.description %} aria-describedby="{{ idPrefix }}description-error" aria-invalid="true"{% endif %}>{{ values.description or '' }}</textarea>
    {% if errors.description %}<span class="field-error-message" id="{{ idPrefix }}description-error">{{ errors.description }}</span>{% endif %}
  </div>
  <div class="field-row release-signature-row">
    {% set releaseSignatureOptions = [] %}
    {% for signature in releaseSignatureConfiguration.entries %}
      {% set _ = releaseSignatureOptions.push({ value: signature.id, label: signature.name }) %}
    {% endfor %}
    {{ dropdown.singleSelect({
      id: releaseSignatureDropdownId,
      label: 'Signature',
      placeholder: 'No signature',
      options: releaseSignatureOptions,
      panelLabel: 'Signature options',
      nativeSelect: {},
      fieldAttributes: [['data-release-signature-field', true]]
    }) }}
    <button type="button" class="button button-small button-secondary release-signature-manage asset-tooltip asset-tooltip--top"
            data-dialog-open="release-signatures-dialog" aria-label="Manage signatures" data-tooltip="Manage signatures"
            aria-haspopup="dialog" aria-controls="release-signatures-dialog">{{ icons.icon('settings') }}</button>
  </div>
  <p class="help-text" data-release-signature-status role="status" aria-live="polite"></p>
  {% if releaseFormDialog %}</div>{% endif %}
  <div class="field {% if errors.notes %}field-error{% endif %}" data-dialog-field="notes">
    <label for="{{ idPrefix }}notes">Notes</label>
    <textarea id="{{ idPrefix }}notes" name="notes" rows="6" maxlength="10000"{% if errors.notes %} aria-describedby="{{ idPrefix }}notes-error" aria-invalid="true"{% endif %}>{{ values.notes or '' }}</textarea>
    {% if errors.notes %}<span class="field-error-message" id="{{ idPrefix }}notes-error">{{ errors.notes }}</span>{% endif %}
  </div>
  </div>
</div>

<div class="settings-section scheduling-section{% if releaseFormDialog %} project-form-section project-edit-dialog-section{% endif %}">
  <h3>Scheduling</h3>
  <div class="release-form-section-body{% if releaseFormDialog %} project-form-section-body project-edit-dialog-section-body{% endif %}">
  <div class="field-row scheduling-row">
    <div class="field scheduling-field {% if errors.plannedDate or errors.plannedTime %}field-error{% endif %}" data-date-picker-field data-dialog-field="plannedDate">
      <label for="{{ idPrefix }}plannedDate">Scheduled date</label>
      <div class="picker-control"><div class="picker-input-row">
        <input class="picker-input" type="date" id="{{ idPrefix }}plannedDate" name="plannedDate" value="{{ values.plannedDate or '' }}" aria-describedby="{{ idPrefix }}plannedDate-help{% if errors.plannedDate %} {{ idPrefix }}plannedDate-error{% endif %}{% if errors.plannedTime %} {{ idPrefix }}plannedTime-error{% endif %}"{% if errors.plannedDate or errors.plannedTime %} aria-invalid="true"{% endif %} data-date-picker-input>
        <button type="button" class="picker-trigger date-picker-trigger" aria-haspopup="dialog" aria-expanded="false" aria-controls="{{ idPrefix }}plannedDate-calendar" aria-label="Open calendar for scheduled date"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" focusable="false"><rect x="3" y="4" width="18" height="18" rx="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg></button>
      </div><div id="{{ idPrefix }}plannedDate-calendar" class="date-picker-panel" role="dialog" aria-label="Scheduled date calendar" hidden data-date-picker-panel data-date-picker-for="{{ idPrefix }}plannedDate"></div></div>
      <span class="help-text" id="{{ idPrefix }}plannedDate-help">Target publication date for this release</span>
      {% if errors.plannedDate %}<span class="field-error-message" id="{{ idPrefix }}plannedDate-error">{{ errors.plannedDate }}</span>{% endif %}
    </div>
    <div class="field scheduling-field {% if errors.plannedTime %}field-error{% endif %}" data-dialog-field="plannedTime" data-time-picker-field data-clock-format="{{ clockFormat }}">
      <label for="{{ idPrefix }}plannedTime">Scheduled time</label>
      <div class="picker-control"><div class="picker-input-row">
        <input class="picker-input" type="time" id="{{ idPrefix }}plannedTime" name="plannedTime" value="{{ values.plannedTime or '' }}" aria-describedby="{{ idPrefix }}plannedTime-help{% if errors.plannedTime %} {{ idPrefix }}plannedTime-error{% endif %}"{% if errors.plannedTime %} aria-invalid="true"{% endif %} data-time-picker-input>
        <button type="button" class="picker-trigger time-picker-trigger" aria-haspopup="dialog" aria-expanded="false" aria-controls="{{ idPrefix }}plannedTime-picker" aria-label="Open time picker for scheduled time" data-time-picker-trigger><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="9"></circle><polyline points="12 7 12 12 15 14"></polyline></svg></button>
      </div><div id="{{ idPrefix }}plannedTime-picker" class="date-picker-panel time-picker-panel" role="dialog" aria-label="Scheduled time picker" hidden data-time-picker-panel data-time-picker-for="{{ idPrefix }}plannedTime"></div></div>
      <span class="help-text" id="{{ idPrefix }}plannedTime-help">Local time this release is scheduled to go live</span>
      {% if errors.plannedTime %}<span class="field-error-message" id="{{ idPrefix }}plannedTime-error">{{ errors.plannedTime }}</span>{% endif %}
    </div>
    {% if release %}
    <div class="field scheduling-field {% if errors.publishedDate %}field-error{% endif %}" data-date-picker-field data-dialog-field="publishedDate">
      <label for="{{ idPrefix }}publishedDate">Published date</label>
      <div class="picker-control"><div class="picker-input-row">
        <input class="picker-input" type="date" id="{{ idPrefix }}publishedDate" name="publishedDate" value="{{ values.publishedDate or '' }}" aria-describedby="{{ idPrefix }}publishedDate-help{% if errors.publishedDate %} {{ idPrefix }}publishedDate-error{% endif %}"{% if errors.publishedDate %} aria-invalid="true"{% endif %} data-date-picker-input>
        <button type="button" class="picker-trigger date-picker-trigger" aria-haspopup="dialog" aria-expanded="false" aria-controls="{{ idPrefix }}publishedDate-calendar" aria-label="Open calendar for published date"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" focusable="false"><rect x="3" y="4" width="18" height="18" rx="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg></button>
      </div><div id="{{ idPrefix }}publishedDate-calendar" class="date-picker-panel" role="dialog" aria-label="Published date calendar" hidden data-date-picker-panel data-date-picker-for="{{ idPrefix }}publishedDate"></div></div>
      <span class="help-text" id="{{ idPrefix }}publishedDate-help">When this release was published</span>
      {% if errors.publishedDate %}<span class="field-error-message" id="{{ idPrefix }}publishedDate-error">{{ errors.publishedDate }}</span>{% endif %}
    </div>
    {% endif %}
  </div>
  {% if not release %}
  <label class="field field--checkbox release-no-set-date-field" for="{{ idPrefix }}noSetReleaseDate">
    <input type="checkbox" id="{{ idPrefix }}noSetReleaseDate" name="noSetReleaseDate" value="1" aria-controls="{{ idPrefix }}plannedDate {{ idPrefix }}plannedTime"{% if values.noSetReleaseDate %} checked{% endif %}>
    <span>No set release date</span>
  </label>
  {# Schedule set aside while "No set release date" is checked; the client enables these only when it holds a draft. #}
  {% set retainedSchedule = values.retainedSchedule %}
  <input type="hidden" name="retainedPlannedDate" value="{{ retainedSchedule.plannedDate if retainedSchedule else '' }}" data-release-schedule-retained{% if not retainedSchedule %} disabled{% endif %}>
  <input type="hidden" name="retainedPlannedTime" value="{{ retainedSchedule.plannedTime if retainedSchedule else '' }}" data-release-schedule-retained{% if not retainedSchedule %} disabled{% endif %}>
  {% endif %}
{# Dialogs keep Platforms and the release link in the same "Scheduling" section. #}
{% if releaseFormDialog %}
  <div class="field-row release-distribution-row">
{% else %}
  </div>
</div>

<div class="settings-section">
  <h3>Platforms</h3>
  <div class="release-form-section-body">
{% endif %}
    {# In the dialog's two-column row, Platforms and its error form one grid item. #}
    {# The group's error id names the field, not its first checkbox. #}
    {% if releaseFormDialog %}<div class="field release-platforms-field" data-dialog-field="selectedPlatforms" data-dialog-error-ref="{{ idPrefix }}selectedPlatforms-error">{% endif %}
    <input type="hidden" name="selectedPlatformsPresent" value="1">
    {{ dropdown.multiSelect({
      id: releasePlatformsDropdownId,
      name: 'selectedPlatforms',
      label: 'Platforms',
      options: platformChoices,
      selectedValues: values.selectedPlatforms or [],
      emptySummary: 'No platforms selected',
      countLabel: 'platforms',
      panelLabel: 'Platform options',
      fieldClasses: 'asset-viewer-filter-field' ~ (' field-error' if errors.selectedPlatforms else ''),
      summaryAttributes: [
        ['aria-describedby', idPrefix ~ 'selectedPlatforms-error' if errors.selectedPlatforms else none],
        ['aria-invalid', 'true' if errors.selectedPlatforms else none]
      ],
      inputAttributes: [
        ['aria-describedby', idPrefix ~ 'selectedPlatforms-error' if errors.selectedPlatforms else none],
        ['aria-invalid', 'true' if errors.selectedPlatforms else none]
      ]
    }) }}
    {% if errors.selectedPlatforms %}<span class="field-error-message" id="{{ idPrefix }}selectedPlatforms-error">{{ errors.selectedPlatforms }}</span>{% endif %}
    {% if releaseFormDialog %}</div>{% endif %}
{% if not releaseFormDialog %}
  </div>
</div>

<div class="settings-section">
  <h3>Links</h3>
  <div class="release-form-section-body">
{% endif %}
  <div class="field {% if errors.patreonUrl %}field-error{% endif %}" data-dialog-field="patreonUrl">
    <label{% if not releaseFormDialog %} class="sr-only"{% endif %} for="{{ idPrefix }}patreonUrl">Release link</label>
    <input type="url" id="{{ idPrefix }}patreonUrl" name="patreonUrl" value="{{ values.patreonUrl or '' }}" aria-describedby="{{ idPrefix }}patreonUrl-help{% if errors.patreonUrl %} {{ idPrefix }}patreonUrl-error{% endif %}"{% if errors.patreonUrl %} aria-invalid="true"{% endif %}>
    <span class="help-text" id="{{ idPrefix }}patreonUrl-help">Optional absolute HTTP or HTTPS URL for this release.</span>
    {% if errors.patreonUrl %}<span class="field-error-message" id="{{ idPrefix }}patreonUrl-error">{{ errors.patreonUrl }}</span>{% endif %}
  </div>
{% if releaseFormDialog %}
  </div>
{% endif %}
  </div>
</div>
