{% import "partials/dialog.njk" as dialog %}
{% import "partials/icons.njk" as icons %}

{% macro render(projectCreateForm, returnTo, csrfToken, open=false) %}
  {% set values = projectCreateForm.values %}
  {% set errors = projectCreateForm.errors %}
  {% set statuses = projectCreateForm.statuses %}
  {% set projectTypes = projectCreateForm.projectTypes %}
  {% set tags = projectCreateForm.tags %}
  {% set selectedTagIds = projectCreateForm.selectedTagIds %}
  {% call dialog.render('project-create-dialog', 'New Project', open, 'project-create-description', 'project-create-form', 'project-form-dialog app-dialog--refined') %}
    <p id="project-create-description" class="app-dialog-description">
      Create a tracked project record.
    </p>

    <div class="app-dialog-body project-edit-dialog-body">
      <form id="project-create-form" method="post" action="/projects" class="app-dialog-form project-form project-edit-dialog-form"
            data-dialog-form data-dialog-async="true" data-dialog-reset-on-close{% if projectCreateForm.resetValues %} data-dialog-reset-values="{{ projectCreateForm.resetValues | dump }}"{% endif %}
            data-dialog-pending-message="Creating project…"
            data-dialog-error-message="Project could not be created."
            data-dialog-network-error-message="Could not confirm whether the project was created. Check Projects before creating it again." novalidate>
        <input type="hidden" name="_csrf" value="{{ csrfToken }}">
        <input type="hidden" name="returnTo" value="{{ projectCreateForm.invocationReturnTo or returnTo }}"{% if projectCreateForm.invocationReturnTo %} data-dialog-return-location{% endif %}>

        <div class="error-summary" role="alert" data-dialog-error{% if not errors.general %} hidden{% endif %}><p data-dialog-error-text>{{ errors.general }}</p></div>

        {% set projectFormDialog = true %}
        {% include "partials/project-form-fields.njk" %}
      </form>
    </div>

    <div class="app-dialog-status" data-dialog-status role="status" aria-live="polite"></div>

    <footer class="app-dialog-footer">
      <button class="button button-primary" type="submit" form="project-create-form" data-dialog-submit><span class="project-create-submit-icon" aria-hidden="true">{{ icons.icon('plus') }}</span>Create project</button>
    </footer>
  {% endcall %}
{% endmacro %}
