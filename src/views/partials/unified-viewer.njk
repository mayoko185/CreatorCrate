{# Shared viewer shell. The controller supplies authoritative asset context;
   content, playback and fullscreen retain their existing session ownership.
   Navigation overlays the stage outside the media pan surface; footer tools are shared by all hosts. #}
{% import "partials/dialog.njk" as dialog %}
{% import "partials/icons.njk" as icons %}
{% import "partials/dropdown.njk" as dropdown %}
{% call dialog.render('unified-viewer-dialog', 'Image Preview', false, 'unified-viewer-context', '', 'unified-viewer-dialog app-dialog--refined', [['data-unified-viewer-card', true]]) %}
  <div class="unified-viewer" data-unified-viewer data-viewer-item-state="empty">
    <div class="unified-viewer-stage" data-unified-viewer-stage>
      <div class="unified-viewer-media" data-unified-viewer-media></div>
      <p class="unified-viewer-status" data-unified-viewer-status role="status" aria-live="polite"></p>
      <div class="unified-viewer-controls" data-unified-viewer-controls hidden>
        <button type="button" class="button button-small button-secondary unified-viewer-nav asset-tooltip asset-tooltip--top" data-unified-viewer-previous aria-label="Previous" data-tooltip="Previous">{{ icons.icon('chevron-left') }}</button>
        <span class="unified-viewer-position" data-unified-viewer-position aria-live="polite" aria-atomic="true"></span>
        <button type="button" class="button button-small button-secondary unified-viewer-nav asset-tooltip asset-tooltip--top" data-unified-viewer-next aria-label="Next" data-tooltip="Next">{{ icons.icon('chevron-right') }}</button>
      </div>
    </div>
    <footer class="unified-viewer-context" data-unified-viewer-context>
      <p class="unified-viewer-heading" id="unified-viewer-context">
        <span class="unified-viewer-title" data-unified-viewer-title></span>
        <span class="unified-viewer-project" data-unified-viewer-project hidden>
          <span aria-hidden="true">·</span>
          <span class="unified-viewer-source" data-unified-viewer-source></span>
        </span>
      </p>
      <div class="unified-viewer-context-actions">
        <div class="unified-viewer-playback" data-unified-viewer-playback role="group" aria-label="Slideshow" hidden>
          <button type="button" class="button button-small button-secondary unified-viewer-play asset-tooltip asset-tooltip--top" data-unified-viewer-play aria-label="Play slideshow" data-tooltip="Play slideshow">
            <span class="unified-viewer-play-icon" aria-hidden="true">{{ icons.icon('slideshow') }}</span>
            <span class="unified-viewer-pause-icon" aria-hidden="true">{{ icons.icon('pause') }}</span>
          </button>
          {{ dropdown.singleSelect({
            id: "unified-viewer-speed-dropdown",
            label: "Slideshow speed",
            visuallyHiddenLabel: true,
            compact: true,
            selected: "4000",
            dispatchNativeChange: true,
            options: [
              { value: "2000", label: "2 s" },
              { value: "4000", label: "4 s" },
              { value: "6000", label: "6 s" }
            ],
            panelLabel: "Slideshow speed options",
            fieldClasses: "unified-viewer-speed-field",
            attributes: [["data-cc-viewport-disclosure", true]],
            nativeSelect: {
              id: "unified-viewer-speed",
              classes: "unified-viewer-speed",
              attributes: [["data-unified-viewer-speed", true]]
            }
          }) }}
        </div>
        <div class="unified-viewer-view-tools" data-unified-viewer-view-tools role="group" aria-label="Image view" aria-keyshortcuts="Shift+ArrowLeft Shift+ArrowRight Shift+ArrowUp Shift+ArrowDown" hidden>
          <div class="unified-viewer-zoom-tools" data-unified-viewer-zoom-tools>
            <button type="button" class="button button-small button-secondary unified-viewer-tool asset-tooltip asset-tooltip--top" data-unified-viewer-zoom-out aria-label="Zoom out" aria-describedby="unified-viewer-zoom-level" data-tooltip="Zoom out" disabled><span aria-hidden="true">&minus;</span></button>
            <span class="unified-viewer-zoom-level" id="unified-viewer-zoom-level" data-unified-viewer-zoom-level></span>
            <button type="button" class="button button-small button-secondary unified-viewer-tool asset-tooltip asset-tooltip--top" data-unified-viewer-zoom-in aria-label="Zoom in" aria-describedby="unified-viewer-zoom-level" data-tooltip="Zoom in" disabled><span aria-hidden="true">+</span></button>
            <button type="button" class="button button-small button-secondary unified-viewer-tool asset-tooltip asset-tooltip--top" data-unified-viewer-original aria-label="Actual size (100%)" data-tooltip="Actual size (100%)" hidden disabled>{{ icons.icon('original-size') }}</button>
          </div>
          <button type="button" class="button button-small button-secondary unified-viewer-tool asset-tooltip asset-tooltip--top" data-unified-viewer-fit aria-label="Fit to viewer" data-tooltip="Fit to viewer" aria-pressed="false" disabled>{{ icons.icon('fit') }}</button>
        </div>
        <div class="unified-viewer-reader" data-unified-viewer-reader role="group" aria-label="Comic reading" hidden>
          {{ dropdown.singleSelect({
            id: "unified-viewer-direction-dropdown",
            label: "Reading direction",
            visuallyHiddenLabel: true,
            compact: true,
            selected: "ltr",
            dispatchNativeChange: true,
            triggerAriaLabel: "Reading direction: Left-to-Right",
            options: [
              { value: "ltr", label: "Left-to-Right" },
              { value: "rtl", label: "Right-to-Left" }
            ],
            panelLabel: "Reading direction options",
            fieldClasses: "unified-viewer-reader-field",
            attributes: [["data-cc-viewport-disclosure", true]],
            nativeSelect: {
              id: "unified-viewer-direction",
              classes: "unified-viewer-direction",
              attributes: [["data-unified-viewer-direction", true]]
            }
          }) }}
          {{ dropdown.singleSelect({
            id: "unified-viewer-layout-dropdown",
            label: "Page layout",
            visuallyHiddenLabel: true,
            compact: true,
            selected: "single",
            dispatchNativeChange: true,
            triggerAriaLabel: "Page layout: Single Page",
            options: [
              { value: "single", label: "Single Page" },
              { value: "spread-cover-alone", label: "Two-Page Spread — Cover Alone" },
              { value: "spread-pair-from-first", label: "Two-Page Spread — Pair from Page 1" }
            ],
            panelLabel: "Page layout options",
            fieldClasses: "unified-viewer-reader-field",
            attributes: [["data-cc-viewport-disclosure", true]],
            nativeSelect: {
              id: "unified-viewer-layout",
              classes: "unified-viewer-layout",
              attributes: [["data-unified-viewer-layout", true]]
            }
          }) }}
        </div>
        <details class="unified-viewer-overflow" data-unified-viewer-overflow data-cc-viewport-disclosure hidden>
          <summary role="button" class="button button-small button-secondary unified-viewer-tool asset-tooltip asset-tooltip--top" aria-label="More viewer tools" aria-expanded="false" aria-controls="unified-viewer-overflow-panel" data-tooltip="More viewer tools">{{ icons.icon('settings') }}</summary>
          <div id="unified-viewer-overflow-panel" class="asset-filter-multiselect-panel unified-viewer-overflow-panel" role="group" aria-label="Viewer tools" data-unified-viewer-overflow-panel></div>
        </details>
        <button type="button" class="button button-small button-secondary unified-viewer-tool unified-viewer-fullscreen asset-tooltip asset-tooltip--top" data-unified-viewer-fullscreen aria-label="Enter fullscreen" data-tooltip="Enter fullscreen" hidden>
          <span class="unified-viewer-fullscreen-enter" aria-hidden="true">{{ icons.icon('fullscreen') }}</span>
          <span class="unified-viewer-fullscreen-exit" aria-hidden="true">{{ icons.icon('fullscreen-exit') }}</span>
        </button>
        <button type="button" class="button button-small button-secondary unified-viewer-tool asset-tooltip asset-tooltip--top" data-unified-viewer-quality aria-label="Original source" aria-pressed="false" data-tooltip="Show original source" hidden disabled>{{ icons.icon('image-quality') }}</button>
        <a class="button button-small button-secondary unified-viewer-details" data-unified-viewer-details hidden>View details</a>
      </div>
    </footer>
  </div>
{% endcall %}
