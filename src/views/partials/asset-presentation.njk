{% import "partials/icons.njk" as icons %}
{% import "partials/dashboard-title-info.njk" as titleInfo %}
{% import "partials/calendar-info-card.njk" as infoCard %}
{% import "partials/asset-information.njk" as assetInformation %}

{% macro presenceIndicator(asset, tooltipPosition='') %}
  {% set presenceLabel = asset.presenceLabel %}
  {% if not presenceLabel %}
    {% set presenceLabel = 'Present' if asset.is_present else 'Missing at last scan' %}
  {% endif %}
  {% if asset.is_present %}
    <span class="asset-indicator asset-icon-control asset-tooltip{% if tooltipPosition == 'left' %} asset-tooltip--left{% endif %} asset-indicator--present" role="img" tabindex="0"
          aria-label="{{ presenceLabel }}" data-tooltip="{{ presenceLabel }}">P</span>
  {% else %}
    <span class="asset-indicator asset-icon-control asset-tooltip{% if tooltipPosition == 'left' %} asset-tooltip--left{% endif %} asset-indicator--missing" role="img" tabindex="0"
          aria-label="{{ presenceLabel }}" data-tooltip="{{ presenceLabel }}">!</span>
  {% endif %}
{% endmacro %}

{#
  Card media for a supported video in grids and lists. The inert <video> has
  no controls, no autoplay, and is never played: preload="metadata" only lets
  the browser learn the real width/height (and usually paint the first frame)
  so the card uses the video's intrinsic aspect ratio. Pointer events pass
  through to the surrounding link, which never joins the image-only
  slideshow. On every surface an unmodified click on that link opens and plays
  the shared layout-level video preview dialog; modified clicks and no-JS keep
  navigating to `href` (the Asset Viewer). The static placeholder is the
  fallback when there is no playback URL or the frame fails.
#}
{% macro videoPlaceholder(asset, variant='grid', href=null, ariaLabel='', options={}) %}
  {% set typeLabel = asset.typeLabel or (asset.extension | upper) or 'Video' %}
  {% set placeholderClass = 'asset-list-card-media-placeholder' if variant == 'list' else 'asset-card-placeholder' %}
  {% set playbackUrl = asset.preview.playbackUrl if asset.preview else null %}
  {% set content %}
    {%- if playbackUrl -%}
      <span class="asset-video-frame asset-video-frame--{{ variant }}" data-asset-video-frame-root>
        <video class="asset-video-frame-media{% if options.nsfwBlur %} asset-image--nsfw-blurred{% endif %}" src="{{ playbackUrl }}"
               preload="metadata" playsinline disablepictureinpicture aria-hidden="true" data-asset-video-frame></video>
        <span class="asset-video-badge" aria-hidden="true">{{ icons.icon('video') }}<span>{{ typeLabel }}</span></span>
      </span>
    {%- endif -%}
    <span class="{{ placeholderClass }} asset-video-placeholder" data-asset-video-placeholder{% if playbackUrl %} hidden{% endif %}>{{ icons.icon('video') }}<span>{{ typeLabel }} video</span></span>
  {%- endset %}
  {% if href %}
    <a class="{{ 'asset-list-card-media-link' if variant == 'list' else 'asset-card-media-link' }} asset-video-link" href="{{ href }}" aria-label="{{ ariaLabel }}"
       {%- if playbackUrl %} data-asset-video-preview-trigger data-video-src="{{ playbackUrl }}" data-video-title="{{ options.title or asset.displayFilename or asset.filename }}"{% endif %}>{{ content | safe }}</a>
  {% else %}
    {{ content | safe }}
  {% endif %}
{% endmacro %}

{% macro gridCard(asset, options={}) %}
  {% set filenameLabel = asset.filename or asset.displayFilename or 'Unnamed asset' %}
  {% set displayName = asset.displayFilename or asset.filename or 'Unnamed asset' %}
  {% set previewUrl = asset.preview_url or asset.thumbnail_url %}
  {% set previewAvailable = asset.is_present and previewUrl and asset.preview_state != 'unsupported' and asset.preview_state != 'missing' %}
  <article class="asset-card{% if options.projectLayout %} asset-card--project{% endif %}{% if options.cardClass %} {{ options.cardClass }}{% endif %}{% if options.selected %} is-selected{% endif %}"
           data-asset-id="{{ asset.id }}" role="option" aria-selected="{% if options.selected %}true{% else %}false{% endif %}"{% if options.selectable %} data-asset-selectable-card{% if options.selectableTabIndex %} tabindex="0"{% endif %}
           aria-label="Toggle selection for {{ filenameLabel }}"{% endif %}>
    <div class="asset-card-top">
      {% if caller %}{{ caller('top-start') }}{% endif %}
      {% if not options.detailsPresenceStatus %}{{ presenceIndicator(asset, 'left') }}{% endif %}
      {% if caller %}{{ caller('top-end') }}{% endif %}
      {% if asset.viewerUrl %}
        <a class="asset-details-link{% if options.detailsPresenceStatus %} asset-details-link--{{ 'present' if asset.is_present else 'missing' }}{% endif %} asset-tooltip asset-tooltip--right" href="{{ asset.viewerUrl }}"
           aria-label="{% if options.detailsPresenceStatus %}Asset details | File {{ 'present' if asset.is_present else 'missing!' }}{% else %}View details for {{ filenameLabel }}{% endif %}" data-tooltip="{% if options.detailsPresenceStatus %}Asset details | File {{ 'present' if asset.is_present else 'missing!' }}{% else %}View asset details{% endif %}">
          {{ icons.icon('details') }}<span class="sr-only">View details</span>
        </a>
      {% endif %}
    </div>

    <div class="asset-card-media{% if asset.preview and asset.preview.kind == 'krita' %} asset-media--krita{% endif %}"{% if options.assetInformation %} data-asset-viewer-preview{% endif %}{% if previewAvailable %} data-preview-enhancement data-preview-state="loading"{% endif %}>
      {% if previewAvailable %}
        {% if asset.viewerUrl %}
          <a class="asset-card-media-link" href="{{ asset.viewerUrl }}" aria-label="View details for {{ filenameLabel }}"{% if options.previewSlideshowAssetId is defined and options.previewSlideshowAssetId is not none %} data-project-assets-preview-id="{{ options.previewSlideshowAssetId }}"{% endif %}>
            <img class="asset-card-thumb{% if options.nsfwBlur %} asset-image--nsfw-blurred{% endif %}"
                 src="{{ previewUrl }}"
                 alt="{{ asset.previewAltText or ('Preview of ' ~ filenameLabel) }}"
                 loading="lazy"
                 decoding="async"
                 data-preview-image>
          </a>
        {% else %}
           <img class="asset-card-thumb{% if options.nsfwBlur %} asset-image--nsfw-blurred{% endif %}"
               src="{{ previewUrl }}"
               alt="{{ asset.previewAltText or ('Preview of ' ~ filenameLabel) }}"
               loading="lazy"
               decoding="async"
               data-preview-image>
        {% endif %}
        <span class="asset-card-placeholder asset-card-fallback" data-preview-fallback hidden>{{ asset.typeLabel or 'File' }}</span>
      {% elif not asset.is_present %}
        <span class="asset-card-placeholder asset-card-placeholder-missing">Missing at last scan</span>
      {% elif asset.preview_state == 'video' %}
        {{ videoPlaceholder(asset, 'grid', asset.viewerUrl, 'Play video ' ~ filenameLabel, { nsfwBlur: options.nsfwBlur, title: displayName }) }}
      {% elif asset.preview_state == 'unsupported' %}
        <span class="asset-card-placeholder">{{ asset.typeLabel or 'File' }} — preview not supported</span>
      {% else %}
        <span class="asset-card-placeholder">Preview unavailable</span>
      {% endif %}
      {% if options.assetInformation and caller %}{{ caller('asset-information') }}{% endif %}
    </div>

    {% if not options.hideBody %}
    <div class="asset-card-body">
      {% if options.projectLayout %}<div class="asset-card-identity">{% endif %}
      <div class="asset-card-title-controls">
        <div class="asset-card-title-row" data-asset-title-row{% if options.titleRowHidden %} hidden{% endif %}>
          {% if options.filenameLink and asset.viewerUrl %}
            <a class="asset-card-title-text asset-file-link" href="{{ asset.viewerUrl }}">{{ displayName }}</a>
          {% else %}
            <span class="asset-card-title-text">{{ displayName }}</span>
          {% endif %}
          {% if caller %}{{ caller('title-row') }}{% endif %}
        </div>
        {% if caller %}{{ caller('title-controls') }}{% endif %}
      </div>
      {% if options.projectLayout %}
        {% if asset.locationLabel %}<span class="asset-card-location" data-asset-containing-location>{{ asset.locationLabel }}</span>{% endif %}
        </div>
        <dl class="asset-card-primary-metadata" aria-label="Primary metadata">
          <div class="asset-card-fact asset-card-fact--category">
            <dt>Category</dt>
            <dd>
              {{ asset.categoryLabel or 'Uncategorized' }}
              {% if asset.categoryDisabled %}<em class="asset-category-disabled-marker">(disabled)</em>{% endif %}
            </dd>
          </div>
          <div class="asset-card-fact asset-card-fact--type">
            <dt>Type</dt>
            <dd><span class="asset-type-label">{{ asset.typeLabel or 'File' }}</span></dd>
          </div>
          <div class="asset-card-fact asset-card-fact--size">
            <dt>Size</dt>
            <dd>{{ asset.formattedSize or '—' }}</dd>
          </div>
          <div class="asset-card-fact asset-card-fact--modified">
            <dt>Modified</dt>
            <dd>{{ asset.modified_at | formatSqliteTimestamp(options.clockFormat or '24h') | formatIsoTimestamp(options.clockFormat or '24h') or '—' }}</dd>
          </div>
        </dl>
        <section class="asset-card-associations-region" aria-label="Asset associations">
          <h3 class="asset-card-associations-heading">Associations</h3>
          {% if caller %}{{ caller('associations') }}{% endif %}
        </section>
      {% else %}
        {% if options.categoryLabel %}<span class="asset-card-meta asset-card-category">{{ options.categoryLabel }}</span>{% endif %}
        {% if asset.locationLabel %}<span class="asset-card-location">{{ asset.locationLabel }}</span>{% endif %}
        {% if asset.typeLabel or asset.formattedSize %}
          <span class="asset-card-meta">{{ asset.typeLabel }}{% if asset.typeLabel and asset.formattedSize %} · {% endif %}{{ asset.formattedSize }}</span>
        {% endif %}
        {% if caller %}{{ caller('body') }}{% endif %}
      {% endif %}
    </div>
    {% endif %}
  </article>
{% endmacro %}


{#
  Column-aligned asset List shared by Project Assets, Release detail
  (Selected assets) and Release Manage Assets. The caller passes the column
  names in display order; the same list drives listTable's header and every
  listCard row, so headers and cells always agree.

  Columns: select, order, asset, category, role, type, presence, releases,
  size, modified, actions. Slots for caller-owned content are named after
  their column (select, order, role, releases, actions) plus title-controls
  (the inline rename editor) and asset (secondary details under the title).
  An empty data slot renders a muted dash (SafeString output is checked by
  length, since an empty SafeString is truthy).

  A caller that passes options.titleInfoId also fills the title-info slot
  with a Calendar information card (usually listInfoCard, on the
  partials/calendar-info-card.njk shell) using that id. The title then renders as the Dashboard title trigger, and
  enhanceDashboardTitleInfoCards binds the shared hover/pin lifecycle.
  Without titleInfoId the title output is unchanged.

  Rows stay <ul>/<li>/<article> so selection, ordering (draggable list
  items with aria-posinset) and per-row forms keep their established DOM.
  The rows sit in the Dashboard panel and table-scroll surfaces and align on
  shared subgrid columns; see "Column-aligned asset List" in creatorcrate.css.

  Usage:
    {% call assetPresentation.listTable(columns, 'Project assets') %}
      <ul class="asset-list ...">…{% call(slot) assetPresentation.listCard(asset, { columns: columns }) %}…{% endcall %}…</ul>
    {% endcall %}
#}
{% macro listTable(columns, ariaLabel) %}
  {% set labels = {
    select: 'Select', order: 'Order', asset: 'Asset', category: 'Category', role: 'Role', type: 'Type',
    presence: 'Presence', releases: 'Releases', size: 'Size', modified: 'Modified', actions: 'Actions'
  } %}
  {% set trailingOrder = ('order' in columns) and columns.indexOf('order') > columns.indexOf('asset') %}
  <div class="dashboard dashboard-panel asset-list-panel">
    <div class="dashboard-table-scroll asset-list-scroll" role="region" aria-label="{{ ariaLabel }}" tabindex="0">
      <div class="asset-list-table{% if trailingOrder %} asset-list-table--trailing-order{% endif %}" data-asset-list-columns="{{ columns | join(' ') }}">
        <div class="asset-list-header" aria-hidden="true">
          {% for column in columns %}<span class="asset-list-cell asset-list-cell--{{ column }}">{% if column != 'select' %}{{ labels[column] }}{% endif %}</span>{% endfor %}
        </div>
        {{ caller() }}
      </div>
    </div>
  </div>
{% endmacro %}

{#
  List title information card for listCard's title-info slot, on the
  Calendar card shell bound by enhanceDashboardTitleInfoCards. It carries the
  details the compact row leaves out (full name and path, full timestamp).
  Only an image preview is shown: videos and other files state their preview
  instead, so hovering never loads or plays media.

  Caller slots: 'facts' adds rows after Category (Release Detail: Role and
  Order); 'sections' adds sections after the fact list (Project Assets: tags
  and releases).
#}
{% macro listInfoCard(asset, detailId) %}
  {% set previewUrl = asset.preview_url or asset.thumbnail_url %}
  {% set previewAvailable = asset.is_present and previewUrl and asset.preview_state != 'unsupported' and asset.preview_state != 'missing' and asset.preview_state != 'video' %}
  {% set cardImage = { state: 'available', previewUrl: previewUrl, alt: asset.previewAltText or ('Preview of ' ~ asset.filename) } if previewAvailable else null %}
  {% set typeLabel = asset.typeLabel or 'File' %}
  {% set slotCaller = caller %}
  {% call infoCard.shell(detailId, asset.filename, cardImage, asset.nsfwBlur) %}
    {% if asset.viewerUrl %}
      <div class="calendar-release-info-actions">
        <a class="button button-small button-secondary" href="{{ asset.viewerUrl }}">Open asset</a>
      </div>
    {% endif %}
    <h3 class="asset-viewer-grid-card-info-heading asset-list-info-filename">{{ asset.filename }}</h3>
    <dl class="asset-viewer-grid-card-info-list">
      <div class="asset-viewer-grid-card-info-row"><dt>Path</dt><dd class="asset-list-info-path">{{ asset.relative_path or '—' }}</dd></div>
      {% if not previewAvailable %}
        <div class="asset-viewer-grid-card-info-row"><dt>Preview</dt><dd>
          {%- if not asset.is_present %}File missing at last scan
          {%- elif asset.preview_state == 'video' %}{{ typeLabel }} video — play it from the row thumbnail
          {%- elif asset.preview_state == 'unsupported' %}{{ typeLabel }} — preview not supported
          {%- else %}Preview unavailable{% endif -%}
        </dd></div>
      {% endif %}
      <div class="asset-viewer-grid-card-info-row"><dt>Presence</dt><dd>{{ asset.presenceLabel or ('Present' if asset.is_present else 'Missing at last scan') }}</dd></div>
      <div class="asset-viewer-grid-card-info-row"><dt>Category</dt><dd>{{ assetInformation.renderCategory(asset) }}</dd></div>
      {% if slotCaller %}{{ slotCaller('facts') }}{% endif %}
      <div class="asset-viewer-grid-card-info-row"><dt>Type</dt><dd>{{ typeLabel }}{% if asset.extension %} (.{{ asset.extension }}){% endif %}</dd></div>
      <div class="asset-viewer-grid-card-info-row"><dt>Size</dt><dd>{{ asset.formattedSize or '—' }}</dd></div>
      <div class="asset-viewer-grid-card-info-row"><dt>Modified</dt><dd>{{ asset.formattedModified or '—' }}</dd></div>
    </dl>
    {% if slotCaller %}{{ slotCaller('sections') }}{% endif %}
  {% endcall %}
{% endmacro %}

{% macro listCard(asset, options={}) %}
  {% set columns = options.columns or ['asset', 'category', 'type', 'presence', 'size', 'modified', 'actions'] %}
  {% set filenameLabel = asset.filename or asset.displayFilename or 'Unnamed asset' %}
  {% set displayName = asset.displayFilename or asset.filename or 'Unnamed asset' %}
  {% set previewUrl = asset.preview_url or asset.thumbnail_url %}
  {% set previewAvailable = asset.is_present and previewUrl and asset.preview_state != 'unsupported' and asset.preview_state != 'missing' %}
  {% set typeLabel = asset.typeLabel or 'File' %}
  <article class="asset-list-card{% if options.cardClass %} {{ options.cardClass }}{% endif %}{% if options.selected %} is-selected{% endif %}" data-asset-id="{{ asset.id }}"{% if options.selectable %} data-asset-selectable-card aria-selected="{% if options.selected %}true{% else %}false{% endif %}"{% endif %}{% if options.titleControls %} data-asset-rename-scope{% endif %}>
    {% for column in columns %}
      {% set slotContent = (caller(column) | trim) if caller and column in ['select', 'order', 'role', 'releases', 'actions'] else '' %}
      {% if column == 'select' %}
        <div class="asset-list-cell asset-list-cell--select">{{ slotContent | safe }}</div>
      {% elif column == 'asset' %}
        <div class="asset-list-cell asset-list-cell--asset">
          <div class="asset-list-card-media dashboard-thumb{% if asset.preview and asset.preview.kind == 'krita' %} asset-media--krita{% endif %}"{% if previewAvailable %} data-preview-enhancement data-preview-state="loading"{% endif %}>
            {% if previewAvailable %}
              {% if asset.viewerUrl %}
                <a class="asset-list-card-media-link" href="{{ asset.viewerUrl }}" aria-label="View preview of {{ filenameLabel }}{% if options.mediaContextLabel %} from {{ options.mediaContextLabel }}{% endif %}"{% if options.previewSlideshowAssetId is defined and options.previewSlideshowAssetId is not none %} data-project-assets-preview-id="{{ options.previewSlideshowAssetId }}"{% endif %}>
                  <img class="asset-list-card-media-image{% if options.nsfwBlur %} asset-image--nsfw-blurred{% endif %}"
                       src="{{ previewUrl }}"
                       alt=""
                       loading="lazy"
                       decoding="async"
                       data-preview-image>
                </a>
              {% else %}
                <img class="asset-list-card-media-image{% if options.nsfwBlur %} asset-image--nsfw-blurred{% endif %}"
                     src="{{ previewUrl }}"
                     alt=""
                     loading="lazy"
                     decoding="async"
                     data-preview-image>
              {% endif %}
              <span class="asset-list-card-media-fallback" data-preview-fallback hidden>{{ typeLabel }}</span>
            {% elif not asset.is_present %}
              <span class="asset-list-card-media-placeholder asset-list-card-media-placeholder--missing" title="Missing at last scan">{{ icons.icon('warning') }}<span class="sr-only">Missing at last scan</span></span>
            {% elif asset.preview_state == 'video' %}
              {{ videoPlaceholder(asset, 'list', asset.viewerUrl, 'Play video ' ~ filenameLabel ~ ((' from ' ~ options.mediaContextLabel) if options.mediaContextLabel else ''), { nsfwBlur: options.nsfwBlur, title: displayName }) }}
            {% elif asset.preview_state == 'unsupported' %}
              <span class="asset-list-card-media-placeholder" title="{{ typeLabel }} — preview not supported">{{ typeLabel }}<span class="sr-only"> — preview not supported</span></span>
            {% else %}
              <span class="asset-list-card-media-placeholder" title="Preview unavailable">{{ icons.icon('assets') }}<span class="sr-only">Preview unavailable</span></span>
            {% endif %}
          </div>
          <div class="asset-list-card-heading">
            {% set titleInfoCard = (caller('title-info') | trim) if caller and options.titleInfoId else '' %}
            {% set titleMarkup %}
              {% if titleInfoCard | length %}
                <div class="dashboard-title-info asset-list-card-title-info" data-dashboard-title-info>
                  <h2 class="asset-list-card-title">{{ titleInfo.trigger(displayName, options.titleInfoId) }}</h2>
                  {{ titleInfoCard | safe }}
                </div>
              {% else %}
                <h2 class="asset-list-card-title">
                  {% if (options.filenameLink is not defined or options.filenameLink) and asset.viewerUrl %}
                    <a class="asset-file-link" href="{{ asset.viewerUrl }}">{{ displayName }}</a>
                  {% else %}
                    {{ displayName }}
                  {% endif %}
                </h2>
              {% endif %}
            {% endset %}
            {% if options.titleControls %}
              <div class="asset-card-title-controls">
                <div class="asset-card-title-row" data-asset-title-row{% if options.titleRowHidden %} hidden{% endif %}>{{ titleMarkup | safe }}</div>
                {% if caller %}{{ caller('title-controls') }}{% endif %}
              </div>
            {% else %}
              {{ titleMarkup | safe }}
            {% endif %}
            {% set assetDetails = (caller('asset') | trim) if caller else '' %}
            {% if asset.locationLabel or assetDetails | length %}
              <div class="asset-list-card-details">
                {% if asset.locationLabel %}<span class="asset-list-card-location asset-location" data-asset-containing-location>{{ asset.locationLabel }}</span>{% endif %}
                {{ assetDetails | safe }}
              </div>
            {% endif %}
          </div>
        </div>
      {% elif column == 'presence' %}
        <dl class="asset-list-cell asset-list-cell--presence asset-list-card-meta asset-list-card-meta--presence">
          <dt>Presence</dt>
          <dd class="asset-list-card-presence">{{ presenceIndicator(asset, 'left') }}</dd>
        </dl>
      {% elif column == 'actions' %}
        <div class="asset-list-cell asset-list-cell--actions">
          <div class="asset-list-card-actions">
            {% if asset.viewerUrl %}
              <a class="asset-details-link{% if options.detailsPresenceStatus %} asset-details-link--{{ 'present' if asset.is_present else 'missing' }}{% endif %} asset-tooltip asset-tooltip--right" href="{{ asset.viewerUrl }}"
                 aria-label="{% if options.detailsPresenceStatus %}Asset details | File {{ 'present' if asset.is_present else 'missing!' }}{% else %}View details for {{ filenameLabel }}{% endif %}" data-tooltip="{% if options.detailsPresenceStatus %}Asset details | File {{ 'present' if asset.is_present else 'missing!' }}{% else %}View asset details{% endif %}">
                {{ icons.icon('details') }}<span class="sr-only">View details</span>
              </a>
            {% endif %}
            {{ slotContent | safe }}
          </div>
        </div>
      {% else %}
        {% if column == 'category' %}
          {% set label = 'Category' %}
          {% set value %}{% if asset.categoryLabel %}{{ asset.categoryLabel }}{% if asset.categoryDisabled %} <em class="asset-category-disabled-marker">(disabled)</em>{% endif %}{% endif %}{% endset %}
        {% elif column == 'type' %}
          {% set label = 'Type' %}
          {% set value %}{% if asset.typeLabel %}<span class="asset-type-label">{{ asset.typeLabel }}</span>{% endif %}{% endset %}
        {% elif column == 'size' %}
          {% set label = 'Size' %}
          {% set value %}{{ asset.formattedSize }}{% endset %}
        {% elif column == 'modified' %}
          {% set label = 'Modified' %}
          {% set value %}{% if asset.modified_at %}{{ asset.formattedModified }}{% endif %}{% endset %}
        {% else %}
          {% set label = column | capitalize %}
          {% set value = slotContent %}
        {% endif %}
        <dl class="asset-list-cell asset-list-cell--{{ column }} asset-list-card-meta asset-list-card-meta--{{ column }}">
          <dt>{{ label }}</dt>
          <dd>{% if value | trim | length %}{{ value | safe }}{% else %}<span class="dashboard-muted">—</span>{% endif %}</dd>
        </dl>
      {% endif %}
    {% endfor %}
  </article>
{% endmacro %}
