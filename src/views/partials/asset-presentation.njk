{% import "partials/icons.njk" as icons %}

{% macro presenceIndicator(asset, tooltipPosition='') %}
  {% set presenceLabel = asset.presenceLabel %}
  {% if not presenceLabel %}
    {% set presenceLabel = 'Present' if asset.is_present else 'Missing at last scan' %}
  {% endif %}
  {% if asset.is_present %}
    <span class="asset-indicator asset-icon-control asset-tooltip{% if tooltipPosition == 'left' %} asset-tooltip--left{% endif %} asset-indicator--present" role="img" tabindex="0"
          aria-label="{{ presenceLabel }}" data-tooltip="{{ presenceLabel }}">P</span>
  {% else %}
    <span class="asset-indicator asset-icon-control asset-tooltip{% if tooltipPosition == 'left' %} asset-tooltip--left{% endif %} asset-indicator--missing" role="img" tabindex="0"
          aria-label="{{ presenceLabel }}" data-tooltip="{{ presenceLabel }}">!</span>
  {% endif %}
{% endmacro %}

{% macro gridCard(asset, options={}) %}
  {% set filenameLabel = asset.filename or asset.displayFilename or 'Unnamed asset' %}
  {% set displayName = asset.displayFilename or asset.filename or 'Unnamed asset' %}
  {% set previewUrl = asset.preview_url or asset.thumbnail_url %}
  {% set previewAvailable = asset.is_present and previewUrl and asset.preview_state != 'unsupported' and asset.preview_state != 'missing' %}
  <article class="asset-card{% if options.projectLayout %} asset-card--project{% endif %}{% if options.cardClass %} {{ options.cardClass }}{% endif %}{% if options.selected %} is-selected{% endif %}"
           data-asset-id="{{ asset.id }}" role="option" aria-selected="{% if options.selected %}true{% else %}false{% endif %}"{% if options.selectable %} data-asset-selectable-card{% if options.selectableTabIndex %} tabindex="0"{% endif %}
           aria-label="Toggle selection for {{ filenameLabel }}"{% endif %}>
    <div class="asset-card-top">
      {% if caller %}{{ caller('top-start') }}{% endif %}
      {{ presenceIndicator(asset, 'left') }}
      {% if caller %}{{ caller('top-end') }}{% endif %}
      {% if asset.viewerUrl %}
        <a class="asset-details-link asset-tooltip asset-tooltip--right" href="{{ asset.viewerUrl }}"
           aria-label="View details for {{ filenameLabel }}" data-tooltip="View asset details">
          {{ icons.icon('details') }}<span class="sr-only">View details</span>
        </a>
      {% endif %}
    </div>

    <div class="asset-card-media{% if asset.preview and asset.preview.kind == 'krita' %} asset-media--krita{% endif %}"{% if previewAvailable %} data-preview-enhancement data-preview-state="loading"{% endif %}>
      {% if previewAvailable %}
        {% if asset.viewerUrl %}
          <a class="asset-card-media-link" href="{{ asset.viewerUrl }}" aria-label="View details for {{ filenameLabel }}"{% if options.previewSlideshowAssetId is defined and options.previewSlideshowAssetId is not none %} data-project-assets-preview-id="{{ options.previewSlideshowAssetId }}"{% endif %}>
            <img class="asset-card-thumb{% if options.nsfwBlur %} asset-image--nsfw-blurred{% endif %}"
                 src="{{ previewUrl }}"
                 alt="{{ asset.previewAltText or ('Preview of ' ~ filenameLabel) }}"
                 loading="lazy"
                 decoding="async"
                 data-preview-image>
          </a>
        {% else %}
           <img class="asset-card-thumb{% if options.nsfwBlur %} asset-image--nsfw-blurred{% endif %}"
               src="{{ previewUrl }}"
               alt="{{ asset.previewAltText or ('Preview of ' ~ filenameLabel) }}"
               loading="lazy"
               decoding="async"
               data-preview-image>
        {% endif %}
        <span class="asset-card-placeholder asset-card-fallback" data-preview-fallback hidden>{{ asset.typeLabel or 'File' }}</span>
      {% elif not asset.is_present %}
        <span class="asset-card-placeholder asset-card-placeholder-missing">Missing at last scan</span>
      {% elif asset.preview_state == 'unsupported' %}
        <span class="asset-card-placeholder">{{ asset.typeLabel or 'File' }} — preview not supported</span>
      {% else %}
        <span class="asset-card-placeholder">Preview unavailable</span>
      {% endif %}
    </div>

    <div class="asset-card-body">
      {% if options.projectLayout %}<div class="asset-card-identity">{% endif %}
      <div class="asset-card-title-controls">
        <div class="asset-card-title-row" data-asset-title-row{% if options.titleRowHidden %} hidden{% endif %}>
          {% if options.filenameLink and asset.viewerUrl %}
            <a class="asset-card-title-text asset-file-link" href="{{ asset.viewerUrl }}">{{ displayName }}</a>
          {% else %}
            <span class="asset-card-title-text">{{ displayName }}</span>
          {% endif %}
          {% if caller %}{{ caller('title-row') }}{% endif %}
        </div>
        {% if caller %}{{ caller('title-controls') }}{% endif %}
      </div>
      {% if options.projectLayout %}
        {% if asset.locationLabel %}<span class="asset-card-location" data-asset-containing-location>{{ asset.locationLabel }}</span>{% endif %}
        </div>
        <dl class="asset-card-primary-metadata" aria-label="Primary metadata">
          <div class="asset-card-fact asset-card-fact--category">
            <dt>Category</dt>
            <dd>
              {{ asset.categoryLabel or 'Uncategorized' }}
              {% if asset.categoryDisabled %}<em class="asset-category-disabled-marker">(disabled)</em>{% endif %}
            </dd>
          </div>
          <div class="asset-card-fact asset-card-fact--type">
            <dt>Type</dt>
            <dd><span class="asset-type-label">{{ asset.typeLabel or 'File' }}</span></dd>
          </div>
          <div class="asset-card-fact asset-card-fact--size">
            <dt>Size</dt>
            <dd>{{ asset.formattedSize or '—' }}</dd>
          </div>
          <div class="asset-card-fact asset-card-fact--modified">
            <dt>Modified</dt>
            <dd>{{ asset.modified_at or '—' }}</dd>
          </div>
        </dl>
        <section class="asset-card-associations-region" aria-label="Asset associations">
          <h3 class="asset-card-associations-heading">Associations</h3>
          {% if caller %}{{ caller('associations') }}{% endif %}
        </section>
      {% else %}
        {% if options.categoryLabel %}<span class="asset-card-meta asset-card-category">{{ options.categoryLabel }}</span>{% endif %}
        {% if asset.locationLabel %}<span class="asset-card-location">{{ asset.locationLabel }}</span>{% endif %}
        {% if asset.typeLabel or asset.formattedSize %}
          <span class="asset-card-meta">{{ asset.typeLabel }}{% if asset.typeLabel and asset.formattedSize %} · {% endif %}{{ asset.formattedSize }}</span>
        {% endif %}
        {% if caller %}{{ caller('body') }}{% endif %}
      {% endif %}
    </div>
  </article>
{% endmacro %}

{% macro listCard(asset, options={}) %}
  {% set filenameLabel = asset.filename or asset.displayFilename or 'Unnamed asset' %}
  {% set displayName = asset.displayFilename or asset.filename or 'Unnamed asset' %}
  {% set previewUrl = asset.preview_url or asset.thumbnail_url %}
  {% set previewAvailable = asset.is_present and previewUrl and asset.preview_state != 'unsupported' and asset.preview_state != 'missing' %}
  {% set hasCategory = asset.categoryLabel %}
  {% set hasType = asset.typeLabel %}
  {% set hasSize = asset.formattedSize %}
  {% set hasModified = asset.modified_at is defined %}
  <article class="asset-list-card{% if options.cardClass %} {{ options.cardClass }}{% endif %}{% if options.selected %} is-selected{% endif %}" data-asset-id="{{ asset.id }}"{% if options.selectable %} data-asset-selectable-card aria-selected="{% if options.selected %}true{% else %}false{% endif %}"{% endif %}>
    {% if caller %}
      <div class="asset-list-card-top">
        {% if options.projectLayout %}
          <div class="asset-list-card-top-selection">
            {{ caller('top') }}
          </div>
        {% else %}
          {{ caller('top') }}
        {% endif %}
      </div>
    {% endif %}

    <div class="asset-list-card-media"{% if previewAvailable %} data-preview-enhancement data-preview-state="loading"{% endif %}>
      {% if previewAvailable %}
        {% if asset.viewerUrl %}
          <a class="asset-list-card-media-link" href="{{ asset.viewerUrl }}" aria-label="View preview of {{ filenameLabel }}{% if options.mediaContextLabel %} from {{ options.mediaContextLabel }}{% endif %}"{% if options.previewSlideshowAssetId is defined and options.previewSlideshowAssetId is not none %} data-project-assets-preview-id="{{ options.previewSlideshowAssetId }}"{% endif %}>
            <img class="asset-list-card-media-image{% if options.nsfwBlur %} asset-image--nsfw-blurred{% endif %}"
                 src="{{ previewUrl }}"
                 alt=""
                 loading="lazy"
                 decoding="async"
                 data-preview-image>
          </a>
        {% else %}
           <img class="asset-list-card-media-image{% if options.nsfwBlur %} asset-image--nsfw-blurred{% endif %}"
               src="{{ previewUrl }}"
               alt=""
               loading="lazy"
               decoding="async"
               data-preview-image>
        {% endif %}
        <span class="asset-list-card-media-fallback" data-preview-fallback hidden>{{ asset.typeLabel or 'File' }}</span>
      {% elif not asset.is_present %}
        <span class="asset-list-card-media-placeholder asset-list-card-media-placeholder--missing">Missing at last scan</span>
      {% elif asset.preview_state == 'unsupported' %}
        <span class="asset-list-card-media-placeholder">{{ asset.typeLabel or 'File' }} — preview not supported</span>
      {% else %}
        <span class="asset-list-card-media-placeholder">Preview unavailable</span>
      {% endif %}
    </div>

    <div class="asset-list-card-body">
      <div class="asset-list-card-header{% if options.projectLayout %} asset-list-card-identity{% endif %}">
        <div class="asset-list-card-heading">
          {% if options.titleControls %}
            <div class="asset-card-title-controls">
              {% if options.projectLayout %}<div class="asset-list-card-title-control-row">{% endif %}
              <div class="asset-card-title-row" data-asset-title-row{% if options.titleRowHidden %} hidden{% endif %}>
                <h2 class="asset-list-card-title">
                  {% if (options.filenameLink is not defined or options.filenameLink) and asset.viewerUrl %}
                    <a class="asset-file-link" href="{{ asset.viewerUrl }}">{{ displayName }}</a>
                  {% else %}
                    {{ displayName }}
                  {% endif %}
                </h2>
                {% if caller %}<div class="asset-list-card-title-actions">{{ caller('title-row') }}</div>{% endif %}
              </div>
              {% if options.projectLayout %}
                <div class="asset-list-card-status" role="group" aria-label="Asset status">
                  <span class="asset-list-card-presence">
                    {{ presenceIndicator(asset) }}
                  </span>
                  {% if caller %}{{ caller('status') }}{% endif %}
                  {% if options.headerStatusDetails and asset.viewerUrl %}
                    <a class="asset-details-link asset-tooltip asset-tooltip--right" href="{{ asset.viewerUrl }}"
                       aria-label="View details for {{ filenameLabel }}" data-tooltip="View asset details">
                      {{ icons.icon('details') }}<span class="sr-only">View details</span>
                    </a>
                  {% endif %}
                </div>
              {% endif %}
              {% if options.projectLayout %}</div>{% endif %}
              {% if caller %}{{ caller('title-controls') }}{% endif %}
            </div>
          {% else %}
            <h2 class="asset-list-card-title">
              {% if (options.filenameLink is not defined or options.filenameLink) and asset.viewerUrl %}
                <a class="asset-file-link" href="{{ asset.viewerUrl }}">{{ displayName }}</a>
              {% else %}
                {{ displayName }}
              {% endif %}
            </h2>
          {% endif %}
          {% if asset.locationLabel %}<span class="asset-list-card-location asset-location" data-asset-containing-location>{{ asset.locationLabel }}</span>{% endif %}
        </div>
        {% if not options.projectLayout %}
          <div class="asset-list-card-status" role="group" aria-label="Asset status">
            <span class="asset-list-card-presence">
              {{ presenceIndicator(asset) }}
            </span>
            {% if caller %}{{ caller('status') }}{% endif %}
            {% if options.headerStatusDetails and asset.viewerUrl %}
              <a class="asset-details-link asset-tooltip asset-tooltip--right" href="{{ asset.viewerUrl }}"
                 aria-label="View details for {{ filenameLabel }}" data-tooltip="View asset details">
                {{ icons.icon('details') }}<span class="sr-only">View details</span>
              </a>
            {% endif %}
          </div>
        {% endif %}
      </div>

      {% if hasCategory or hasType or hasSize or hasModified %}
        <dl class="asset-list-card-metadata{% if options.projectLayout %} asset-list-card-primary-metadata{% endif %}">
          {% if hasCategory %}
            <div class="asset-list-card-meta asset-list-card-meta--category">
              <dt>Category</dt>
              <dd>
                {{ asset.categoryLabel }}
                {% if asset.categoryDisabled %}<em class="asset-category-disabled-marker">(disabled)</em>{% endif %}
              </dd>
            </div>
          {% endif %}
          {% if hasType %}
            <div class="asset-list-card-meta asset-list-card-meta--type">
              <dt>Type</dt>
              <dd><span class="asset-type-label">{{ asset.typeLabel }}</span></dd>
            </div>
          {% endif %}
          {% if hasSize %}
            <div class="asset-list-card-meta asset-list-card-meta--size">
              <dt>Size</dt>
              <dd>{{ asset.formattedSize }}</dd>
            </div>
          {% endif %}
          {% if hasModified %}
            <div class="asset-list-card-meta asset-list-card-meta--modified">
              <dt>Modified</dt>
              <dd>{{ asset.modified_at or '—' }}</dd>
            </div>
          {% endif %}
        </dl>
      {% endif %}

      {% if caller %}
        {% if options.projectLayout %}<section class="asset-list-card-associations-region" aria-label="Asset associations">{% endif %}
        {% if options.projectLayout %}<h3 class="asset-list-card-associations-heading">Associations</h3>{% endif %}
        {{ caller('associations') }}
        {% if options.projectLayout %}</section>{% endif %}
      {% endif %}

      {% if not options.hideActions and (caller or (asset.viewerUrl and not options.headerStatusDetails)) %}
        <div class="asset-list-card-actions">
          {% if asset.viewerUrl and not options.headerStatusDetails %}
            <a class="asset-details-link asset-tooltip" href="{{ asset.viewerUrl }}"
               aria-label="View details for {{ filenameLabel }}" data-tooltip="View asset details">
              {{ icons.icon('details') }}<span class="sr-only">View details</span>
            </a>
          {% endif %}
          {% if caller %}{{ caller('actions') }}{% endif %}
        </div>
      {% endif %}
    </div>
  </article>
{% endmacro %}
