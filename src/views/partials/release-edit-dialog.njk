{% import "partials/dialog.njk" as dialog %}

{# The one Edit Release dialog: always rendered closed, loaded from the JSON
   edit model and saved through the shared async binder (POST /releases/:id
   with Accept: application/json). Hosts that also render New Release pass
   fieldIdPrefix so ids, dropdowns and pickers stay unique. deepLink marks
   Release Detail's ?edit=1 deep link, which the async controller opens
   through its normal Edit path. #}
{% macro render(release, releaseEditForm, csrfToken, configuration, platformOptions, clockFormat='24h', fieldIdPrefix='', deepLink=false) %}
  {% set values = releaseEditForm.values %}
  {% set errors = releaseEditForm.errors %}
  {% set releaseSignatureConfiguration = configuration %}
  {% set platformChoices = platformOptions %}
  {% if fieldIdPrefix %}
    {% set releaseSignatureDropdownId = fieldIdPrefix ~ 'signature' %}
    {% set releasePlatformsDropdownId = fieldIdPrefix ~ 'platforms' %}
  {% endif %}
  {% call dialog.render('release-edit-dialog', 'Edit Release', false, 'release-edit-description', 'release-edit-form', 'project-form-dialog app-dialog--refined') %}
    <p id="release-edit-description" class="app-dialog-description">
      Update release metadata and scheduling fields.
    </p>
    <div class="app-dialog-body project-edit-dialog-body">
      <form id="release-edit-form" method="post" action="/releases/{{ release.id }}" class="app-dialog-form project-form project-edit-dialog-form"
            data-dialog-form data-dialog-async="true"{% if deepLink and release.id %} data-release-edit-deep-link="{{ release.id }}"{% endif %} data-dialog-reset-on-close
            data-dialog-pending-message="Saving release…" data-dialog-success-message="Release updated."
            data-dialog-error-message="Release could not be saved."
            data-dialog-network-error-message="Could not save the release. Check your connection and try again." novalidate>
        <input type="hidden" name="_csrf" value="{{ csrfToken }}">
        <div class="error-summary" role="alert" data-dialog-error hidden><p data-dialog-error-text></p></div>
        {% set releaseFormDialog = true %}
        {% include "partials/release-form-fields.njk" %}
      </form>

      <section class="settings-section project-edit-dialog-section project-actions project-edit-dialog-actions" aria-labelledby="release-actions-heading">
        <h3 id="release-actions-heading">Release actions</h3>
        <div class="project-edit-dialog-section-body project-edit-dialog-actions-body">
          {# Always rendered so the async controller can reveal it when the loaded
             release becomes archivable; hidden and targetless until a release
             is known to be eligible. #}
          {% set archiveEligible = release.id and not release.published_date %}
          <details class="notes-workspace-disclosure notes-workspace-disclosure--archive" data-release-edit-action="archive"{% if not archiveEligible %} hidden{% endif %}>
            <summary>Archive release</summary>
            <div class="notes-workspace-disclosure-content">
              <p class="notes-workspace-warning">Archiving a release makes it read-only. This cannot be undone.</p>
              <form method="post" action="{{ '/releases/' ~ release.id ~ '/archive' if archiveEligible else '' }}">
                <input type="hidden" name="_csrf" value="{{ csrfToken }}">
                <button class="button button-small button-secondary" type="submit" data-confirm="Archive this release? This cannot be undone.">Archive release</button>
              </form>
            </div>
          </details>

          <details class="notes-workspace-disclosure notes-workspace-disclosure--delete" data-release-edit-action="delete">
            <summary>Delete Release</summary>
            <div class="notes-workspace-disclosure-content">
              <p class="notes-workspace-warning">Deleting this release is permanent and cannot be undone. The release record and its asset associations will be removed; the underlying project assets will not be affected.</p>
              <form method="post" action="/releases/{{ release.id }}/delete">
                <input type="hidden" name="_csrf" value="{{ csrfToken }}">
                <button class="button button-small button-danger" type="submit" data-confirm="Delete this release permanently? This action is irreversible and cannot be undone.">Delete Release</button>
              </form>
            </div>
          </details>
        </div>
      </section>
    </div>
    <div class="app-dialog-status" data-dialog-status role="status" aria-live="polite"></div>
    <footer class="app-dialog-footer">
      <button class="button button-primary" type="submit" form="release-edit-form" data-dialog-submit>Save changes</button>
    </footer>
  {% endcall %}
{% endmacro %}
