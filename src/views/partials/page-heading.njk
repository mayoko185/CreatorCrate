{#
  Shared page heading macro — navigation and status only. The page title lives
  in the compact top header (see layout.njk's `page_title` contract), not here:
  authenticated pages render exactly one <h1>, and this macro never emits one.

  This area is reserved for a leading navigation item, action buttons, and an
  optional status badge. Page descriptions are intentionally NOT rendered —
  the first argument is accepted for backward compatibility but ignored, so
  existing callers do not need to be changed.

  Usage with actions:
    {% import "partials/page-heading.njk" as pageHeading %}
    {% call pageHeading.render() %}
      <a class="button button-primary" href="/new">Create</a>
    {% endcall %}

  Renders nothing when there is no lead item, badge, or caller content —
  callers should not end up with an empty wrapper.

  Text parameters are escaped by Nunjucks autoescaping. Action markup is only
  accepted through the Nunjucks caller block; do not pass arbitrary HTML strings.
#}
{% macro render(description='', badgeStatus='', badgeText='', leadHref='', leadLabel='', leadClass='') %}
{% if leadHref and leadLabel or badgeStatus or badgeText or caller is defined %}
<header class="page-heading">
  {% if leadHref and leadLabel %}
    <a class="button button-secondary page-heading-lead{% if leadClass %} {{ leadClass }}{% endif %}" href="{{ leadHref }}">{{ leadLabel }}</a>
  {% endif %}
  {% if badgeStatus or badgeText %}
    <div class="page-heading-copy">
      {% if badgeText %}
        {% set headingBadgeStatus = badgeStatus or 'neutral' %}
        {% set headingBadgeText = badgeText %}
        {% if headingBadgeStatus == 'success' or headingBadgeStatus == 'present' or headingBadgeStatus == 'ready' %}
          <span class="status-badge status-badge--success">{{ headingBadgeText }}</span>
        {% elif headingBadgeStatus == 'warning' or headingBadgeStatus == 'unsupported' or headingBadgeStatus == 'unavailable' %}
          <span class="status-badge status-badge--warning">{{ headingBadgeText }}</span>
        {% elif headingBadgeStatus == 'error' or headingBadgeStatus == 'danger' or headingBadgeStatus == 'missing' %}
          <span class="status-badge status-badge--error">{{ headingBadgeText }}</span>
        {% else %}
          <span class="status-badge status-badge--neutral">{{ headingBadgeText }}</span>
        {% endif %}
      {% else %}
        {% set status = badgeStatus %}
        {% include "partials/status-badge.njk" %}
      {% endif %}
    </div>
  {% endif %}
  {% if caller is defined %}
    <div class="page-heading-actions">
      {{ caller() }}
    </div>
  {% endif %}
</header>
{% endif %}
{% endmacro %}
