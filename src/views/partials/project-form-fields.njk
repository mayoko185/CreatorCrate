{% import "partials/dropdown.njk" as dropdown %}
{# Hosts that render New Project and Edit Project together pass
   projectFieldIdPrefix so ids, labels and ARIA references stay unique; other
   hosts keep the unprefixed ids. #}
{% set idPrefix = projectFieldIdPrefix or '' %}

<section class="settings-section project-form-section{% if projectFormDialog %} project-edit-dialog-section{% endif %}">
  <h3>{{ 'Project details' if projectFormDialog else 'Basic information' }}</h3>
  <div class="project-form-section-body{% if projectFormDialog %} project-edit-dialog-section-body project-form-details-body{% endif %}">

  <div class="field {% if errors.title %}field-error{% endif %}" data-dialog-field="title">
    <label for="{{ idPrefix }}title">Title <span class="required" aria-label="required">*</span></label>
    <input type="text" id="{{ idPrefix }}title" name="title" value="{{ values.title or '' }}" maxlength="200" required{% if errors.title %} aria-describedby="{{ idPrefix }}title-error" aria-invalid="true"{% endif %}>
    {% if errors.title %}<span class="field-error-message" id="{{ idPrefix }}title-error">{{ errors.title }}</span>{% endif %}
  </div>

  <div class="field {% if errors.description %}field-error{% endif %}" data-dialog-field="description">
    <label for="{{ idPrefix }}description">Description</label>
    <textarea id="{{ idPrefix }}description" name="description" rows="{{ 3 if projectFormDialog else 6 }}" maxlength="4000"{% if errors.description %} aria-describedby="{{ idPrefix }}description-error" aria-invalid="true"{% endif %}>{{ values.description or '' }}</textarea>
    {% if errors.description %}<span class="field-error-message" id="{{ idPrefix }}description-error">{{ errors.description }}</span>{% endif %}
  </div>

  <div class="field {% if errors.notes %}field-error{% endif %}" data-dialog-field="notes">
    <label for="{{ idPrefix }}notes">Notes</label>
    <textarea id="{{ idPrefix }}notes" name="notes" rows="{{ 3 if projectFormDialog else 4 }}" maxlength="10000"{% if errors.notes %} aria-describedby="{{ idPrefix }}notes-error" aria-invalid="true"{% endif %}>{{ values.notes or '' }}</textarea>
    {% if errors.notes %}<span class="field-error-message" id="{{ idPrefix }}notes-error">{{ errors.notes }}</span>{% endif %}
  </div>
{# Dialogs keep these controls in the same "Project details" section. #}
{% if not projectFormDialog %}
  </div>
</section>

<section class="settings-section status-section project-form-section">
  <h3>Status</h3>
  <div class="project-form-section-body">
{% endif %}

  {% set statusSummary = '' %}
  {% for statusOption in statuses %}
    {% if values.status == statusOption.value %}
      {% set statusSummary = statusOption.label %}
    {% endif %}
  {% endfor %}

  {% set projectTypeSummary = '' %}
  {% set projectTypeOptions = [] %}
  {% for projectTypeOption in projectTypes %}
    {% set _ = projectTypeOptions.push({ value: projectTypeOption.value, label: projectTypeOption.label }) %}
    {% if values.projectType == projectTypeOption.value %}
      {% set projectTypeSummary = projectTypeOption.label %}
    {% endif %}
  {% endfor %}

  {% set tagSummary = 'No tags selected' %}
  {% if selectedTagIds.length == 1 %}
    {% for tag in tags %}
      {% if selectedTagIds[0] == (tag.id | string) %}
        {% set tagSummary = tag.displayName %}
      {% endif %}
    {% endfor %}
  {% elif selectedTagIds.length > 1 %}
    {% set tagSummary = selectedTagIds.length ~ ' tags selected' %}
  {% endif %}

  {% set tagOptions = [] %}
  {% for tag in tags %}
    {% set _ = tagOptions.push({ value: tag.id | string, label: tag.displayName }) %}
  {% endfor %}

  {% set statusOptions = [] %}
  {% for statusOption in statuses %}
    {% set _ = statusOptions.push({ value: statusOption.value, label: statusOption.label }) %}
  {% endfor %}

  <div class="field-row status-row">
    <div class="field status-field" data-dialog-field="status" data-dialog-error-ref="{{ idPrefix }}status-error">
      {{ dropdown.singleSelect({
        id: idPrefix ~ "project-status-form",
        name: "status",
        label: "Status",
        required: true,
        options: statusOptions,
        selected: values.status,
        summary: statusSummary,
        triggerAriaLabel: "Status: " ~ statusSummary,
        summaryAttributes: [
          ["aria-describedby", idPrefix ~ "status-error" if errors.status else none],
          ["aria-invalid", "true" if errors.status else none]
        ],
        inputAttributes: [
          ["required", true],
          ["aria-describedby", idPrefix ~ "status-error" if errors.status else none],
          ["aria-invalid", "true" if errors.status else none]
        ],
        fieldClasses: "status-field asset-viewer-filter-field" ~ (" field-error" if errors.status else ""),
        panelLabel: "Status options"
      }) }}
      {% if errors.status %}<span class="field-error-message" id="{{ idPrefix }}status-error">{{ errors.status }}</span>{% endif %}
    </div>

    <div class="field status-field" data-dialog-field="projectType" data-dialog-error-ref="{{ idPrefix }}projectType-error">
      {{ dropdown.singleSelect({
        id: idPrefix ~ "project-type-form",
        name: "projectType",
        label: "Project type",
        required: true,
        options: projectTypeOptions,
        selected: values.projectType,
        summary: projectTypeSummary,
        triggerAriaLabel: "Project type: " ~ projectTypeSummary,
        summaryAttributes: [
          ["aria-describedby", idPrefix ~ "projectType-error" if errors.projectType else none],
          ["aria-invalid", "true" if errors.projectType else none]
        ],
        inputAttributes: [
          ["required", true],
          ["aria-describedby", idPrefix ~ "projectType-error" if errors.projectType else none],
          ["aria-invalid", "true" if errors.projectType else none]
        ],
        fieldClasses: "status-field asset-viewer-filter-field" ~ (" field-error" if errors.projectType else ""),
        panelLabel: "Project type options"
      }) }}
      {% if errors.projectType %}<span class="field-error-message" id="{{ idPrefix }}projectType-error">{{ errors.projectType }}</span>{% endif %}
    </div>

    <div class="field status-field" data-dialog-field="tagIds" data-dialog-error-ref="{{ idPrefix }}tagIds-error">
      {{ dropdown.multiSelect({
        id: idPrefix ~ "project-tags-form",
        name: "tagIds[]",
        label: "Tags",
        options: tagOptions,
        selectedValues: selectedTagIds,
        emptySummary: "No tags selected",
        countLabel: "tags",
        summary: tagSummary,
        triggerAriaLabel: "Tags: " ~ tagSummary,
        summaryAttributes: [
          ["aria-describedby", idPrefix ~ "tagIds-error" if errors.tagIds else none],
          ["aria-invalid", "true" if errors.tagIds else none]
        ],
        inputAttributes: [
          ["aria-describedby", idPrefix ~ "tagIds-error" if errors.tagIds else none],
          ["aria-invalid", "true" if errors.tagIds else none]
        ],
        emptyState: {
          text: "No tags available.",
          link: { text: "Add tags in Settings", href: "/settings/tags" },
          suffix: "."
        },
        fieldClasses: "status-field asset-viewer-filter-field" ~ (" field-error" if errors.tagIds else ""),
        panelLabel: "Tag options"
      }) }}
      {% if errors.tagIds %}<span class="field-error-message" id="{{ idPrefix }}tagIds-error">{{ errors.tagIds }}</span>{% endif %}
      <span class="help-text">Add new tags in <a href="/settings/tags">Settings › Tags</a>.</span>
    </div>
  </div>
  </div>
</section>

<section class="settings-section project-form-section{% if projectFormDialog %} project-edit-dialog-section{% endif %}">
  <h3>{{ 'Project link' if projectFormDialog else 'Links' }}</h3>
  <div class="project-form-section-body{% if projectFormDialog %} project-edit-dialog-section-body{% endif %}">

  <div class="field {% if errors.patreonUrl %}field-error{% endif %}" data-dialog-field="patreonUrl">
    <label for="{{ idPrefix }}patreonUrl"{% if projectFormDialog %} class="sr-only"{% endif %}>Project link</label>
    <input type="url" id="{{ idPrefix }}patreonUrl" name="patreonUrl" value="{{ values.patreonUrl or '' }}" aria-describedby="{{ idPrefix }}patreonUrl-help{% if errors.patreonUrl %} {{ idPrefix }}patreonUrl-error{% endif %}"{% if errors.patreonUrl %} aria-invalid="true"{% endif %}>
    <span class="help-text" id="{{ idPrefix }}patreonUrl-help">Optional absolute HTTP or HTTPS URL for this project.</span>
    {% if errors.patreonUrl %}<span class="field-error-message" id="{{ idPrefix }}patreonUrl-error">{{ errors.patreonUrl }}</span>{% endif %}
  </div>
  </div>
</section>
