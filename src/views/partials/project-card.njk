{% macro render(project, variant = 'grid') %}
  {% set imageUrl = project.primaryImage.previewUrl %}
  {% if variant == 'list' %}
    {% set imageUrl = project.primaryImage.thumbnailUrl %}
  {% endif %}

  <li class="{% if variant == 'list' %}project-list-item{% else %}project-grid-item{% endif %}">
    <article class="project-card project-card--{{ variant }}{% if project.archived_at %} project-card--archived{% endif %}" data-project-card>
      {% if project.primaryImage.state == 'available' %}
        <div class="project-card-media project-card-media--image{% if project.primaryImage.mediaModifier %} project-card-media--{{ project.primaryImage.mediaModifier }}{% endif %}" data-preview-enhancement data-preview-state="loading">
          <img class="project-card-media-image{% if variant == 'list' %} project-card-media-image--list{% endif %}{% if project.primaryImage.mediaModifier %} project-card-media-image--{{ project.primaryImage.mediaModifier }}{% endif %}" data-preview-image src="{{ imageUrl }}" alt="{{ project.primaryImage.alt }}" loading="lazy" decoding="async">
          <span class="project-card-media-fallback" data-preview-fallback hidden>Image unavailable</span>
        </div>
      {% elif project.primaryImage.state == 'unavailable' %}
        <div class="project-card-media project-card-media--fallback" data-primary-image-state="unavailable">
          <span>Image unavailable</span>
        </div>
      {% else %}
        <div class="project-card-media project-card-media--fallback" data-primary-image-state="none">
          <span>No image</span>
        </div>
      {% endif %}

      <div class="project-card-body">
        <h2 class="project-card-title">
          <a class="project-card-link" data-project-card-link href="/projects/{{ project.id }}">{{ project.title }}</a>
        </h2>

        <div class="project-card-details">
          {% if caller is defined %}
            {{ caller() }}
          {% endif %}
        </div>
      </div>
    </article>
  </li>
{% endmacro %}
