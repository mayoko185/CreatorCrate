{% macro render(project, variant = 'grid', headingLevel = 'h2') %}
  {% set imageUrl = project.primaryImage.previewUrl %}
  {% if variant == 'list' %}
    {% set imageUrl = project.primaryImage.thumbnailUrl %}
  {% endif %}

  <li class="{% if variant == 'list' %}project-list-item{% else %}project-grid-item{% endif %}">
    <article class="project-card project-card--{{ variant }}{% if variant == 'grid' %} project-grid-card{% else %} project-list-card{% endif %}{% if project.archived_at %} project-card--archived{% endif %}" data-project-card>
      {% if variant == 'list' %}
        {% if project.primaryImage.state == 'available' %}
          <div class="project-list-card-media project-card-media project-card-media--image{% if project.primaryImage.mediaModifier %} project-card-media--{{ project.primaryImage.mediaModifier }}{% endif %}" data-preview-enhancement data-preview-state="loading">
            <a class="project-list-card-media-link" href="/projects/{{ project.id }}" aria-label="View preview of {{ project.title }}">
              <img class="project-list-card-media-image project-card-media-image project-card-media-image--list{% if project.nsfwBlur %} project-image--nsfw-blurred{% endif %}{% if project.primaryImage.mediaModifier %} project-card-media-image--{{ project.primaryImage.mediaModifier }}{% endif %}" data-preview-image src="{{ imageUrl }}" alt="{{ project.primaryImage.alt }}" loading="lazy" decoding="async">
              <span class="project-list-card-media-fallback project-card-media-fallback" data-preview-fallback hidden>Image unavailable</span>
            </a>
          </div>
        {% elif project.primaryImage.state == 'unavailable' %}
          <div class="project-list-card-media project-card-media project-card-media--fallback" data-primary-image-state="unavailable">
            <a class="project-list-card-media-link project-list-card-media-link--fallback" href="/projects/{{ project.id }}" aria-label="View project {{ project.title }}">
              <span>Image unavailable</span>
            </a>
          </div>
        {% else %}
          <div class="project-list-card-media project-card-media project-card-media--fallback" data-primary-image-state="none">
            <a class="project-list-card-media-link project-list-card-media-link--fallback" href="/projects/{{ project.id }}" aria-label="View project {{ project.title }}">
              <span>No image</span>
            </a>
          </div>
        {% endif %}

        <div class="project-list-card-body project-card-body">
          <div class="project-list-card-header">
            <div class="project-list-card-heading">
              <{{ headingLevel }} class="project-list-card-title project-card-title">
                <a class="project-list-card-link project-card-link" data-project-card-link href="/projects/{{ project.id }}">{{ project.title }}</a>
              </{{ headingLevel }}>
            </div>
            <div class="project-list-card-indicators" aria-label="Project status">
              <span class="project-list-card-status">
                {% set status = project.status %}{% include "partials/status-badge.njk" %}
              </span>
            </div>
          </div>

          <dl class="project-list-card-metadata">
            <div class="project-list-card-meta">
              <dt>Status</dt>
              <dd>{% set status = project.status %}{% include "partials/status-badge.njk" %}</dd>
            </div>
            <div class="project-list-card-meta project-list-card-meta--date">
              <dt>Updated</dt>
              <dd>{{ project.updated_at }}</dd>
            </div>
            <div class="project-list-card-meta project-list-card-meta--date">
              <dt>Planned</dt>
              <dd>{{ project.planned_date or '—' }}</dd>
            </div>
            <div class="project-list-card-meta project-list-card-meta--date">
              <dt>Published</dt>
              <dd>{{ project.published_date or '—' }}</dd>
            </div>
          </dl>

          <div class="project-list-card-associations">
            <section class="project-list-card-association project-list-card-association--tags">
              <h3 class="project-list-card-association-label">Tags</h3>
              <div class="project-list-card-association-content">
                {% if project.tags and project.tags.length > 0 %}
                  <ul class="project-list-card-tags" aria-label="Assigned tags">
                    {% for tag in project.tags %}
                      <li>{{ tag.displayName }}</li>
                    {% endfor %}
                  </ul>
                {% else %}
                  <span class="project-list-card-empty">No tags assigned</span>
                {% endif %}
              </div>
            </section>
          </div>
        </div>
      {% else %}
        <div class="project-grid-card-status" aria-label="Project status">
          {% set status = project.status %}{% include "partials/status-badge.njk" %}
        </div>

        <div class="project-grid-card-preview project-card-media{% if project.primaryImage.state == 'available' %} project-card-media--image{% if project.primaryImage.mediaModifier %} project-card-media--{{ project.primaryImage.mediaModifier }}{% endif %}{% else %} project-card-media--fallback{% endif %}"
             data-project-grid-preview
             {% if project.primaryImage.state == 'available' %}data-preview-enhancement data-preview-state="loading"{% elif project.primaryImage.state == 'unavailable' %}data-primary-image-state="unavailable"{% else %}data-primary-image-state="none"{% endif %}>
          {% if project.primaryImage.state == 'available' %}
            <a class="project-grid-card-preview-link" href="/projects/{{ project.id }}" aria-label="View preview of {{ project.title }}">
              <img class="project-card-media-image{% if project.nsfwBlur %} project-image--nsfw-blurred{% endif %}{% if project.primaryImage.mediaModifier %} project-card-media-image--{{ project.primaryImage.mediaModifier }}{% endif %}" data-preview-image src="{{ imageUrl }}" alt="{{ project.primaryImage.alt }}" loading="lazy" decoding="async">
              <span class="project-card-media-fallback" data-preview-fallback hidden>Image unavailable</span>
            </a>
          {% elif project.primaryImage.state == 'unavailable' %}
            <a class="project-grid-card-preview-link project-grid-card-preview-link--fallback" href="/projects/{{ project.id }}" aria-label="View project {{ project.title }}">
              <span>Image unavailable</span>
            </a>
          {% else %}
            <a class="project-grid-card-preview-link project-grid-card-preview-link--fallback" href="/projects/{{ project.id }}" aria-label="View project {{ project.title }}">
              <span>No image</span>
            </a>
          {% endif %}

          <div class="project-grid-card-info" data-project-info-card role="group" aria-label="Project information">
            <h3 class="project-grid-card-info-heading">Project information</h3>
            <dl class="project-grid-card-info-list">
              <div class="project-grid-card-info-row">
                <dt>Status</dt>
                <dd>{% set status = project.status %}{% include "partials/status-badge.njk" %}</dd>
              </div>
              <div class="project-grid-card-info-row">
                <dt>Updated</dt>
                <dd>{{ project.updated_at }}</dd>
              </div>
              <div class="project-grid-card-info-row">
                <dt>Planned</dt>
                <dd>{{ project.planned_date or '—' }}</dd>
              </div>
              <div class="project-grid-card-info-row">
                <dt>Published</dt>
                <dd>{{ project.published_date or '—' }}</dd>
              </div>
            </dl>

            <div class="project-grid-card-info-section">
              <span class="project-grid-card-info-section-label">Tags</span>
              {% if project.tags and project.tags.length > 0 %}
                <ul class="project-grid-card-info-tags" aria-label="Assigned tags">
                  {% for tag in project.tags %}
                    <li>{{ tag.displayName }}</li>
                  {% endfor %}
                </ul>
              {% else %}
                <span class="project-grid-card-info-empty">No tags assigned</span>
              {% endif %}
            </div>
          </div>
        </div>

        <div class="project-grid-card-title-area">
          <{{ headingLevel }} class="project-grid-card-title">
            <a class="project-card-link" data-project-card-link href="/projects/{{ project.id }}">{{ project.title }}</a>
          </{{ headingLevel }}>
        </div>
      {% endif %}
    </article>
  </li>
{% endmacro %}
