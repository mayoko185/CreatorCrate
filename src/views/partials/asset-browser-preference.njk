{% import "partials/dropdown.njk" as dropdown %}

{% macro project(model, projectId, action, controlId, csrf, archived=false, context=null, contextFields=[], returnTo=null, live=false) %}
  <section class="project-category-management-panel project-category-management-default-section settings-section asset-browser-default-section asset-browser-default-section--project" aria-labelledby="{{ controlId }}-heading"{% if live %} data-asset-browser-default{% endif %}>
    <h3 id="{{ controlId }}-heading">Asset browser default</h3>
    <p class="asset-browser-default-description" id="{{ controlId }}-help">Choose the category opened when visiting Assets without filters.</p>

    {% if model.fallbackExplanation %}
      <div class="notice notice--warning" role="status" id="{{ controlId }}-fallback"{% if live %} data-asset-browser-default-fallback{% endif %}>
        <p{% if live %} data-asset-browser-default-fallback-text{% endif %}>{{ model.fallbackExplanation }}</p>
      </div>
    {% elif live %}
      <div class="notice notice--warning" role="status" id="{{ controlId }}-fallback" data-asset-browser-default-fallback hidden>
        <p data-asset-browser-default-fallback-text></p>
      </div>
    {% endif %}

    {% if model.errorMessage %}
      <div class="error-summary" role="alert" id="{{ controlId }}-error"{% if live %} data-asset-browser-default-error{% endif %}>
        <p{% if live %} data-asset-browser-default-error-text{% endif %}>Could not save the asset browser default. {{ model.errorMessage }}</p>
      </div>
    {% elif live %}
      <div class="error-summary" role="alert" id="{{ controlId }}-error" data-asset-browser-default-error hidden>
        <p data-asset-browser-default-error-text></p>
      </div>
    {% endif %}

    {% if archived %}
      <p class="help-text asset-browser-default-readonly">This archived project is read-only; its saved default is shown for reference.</p>
    {% else %}
      <form method="post" action="{{ action }}" class="project-form asset-browser-default-form"{% if live %} data-dialog-form data-dialog-async="false" data-asset-browser-default-live{% endif %} novalidate>
        <input type="hidden" name="_csrf" value="{{ csrf }}">
        {% if context %}
          {% for key in contextFields %}
            {% if context[key] is not none and context[key] != '' %}
              <input type="hidden" name="{{ key }}" value="{{ context[key] }}">
            {% endif %}
          {% endfor %}
        {% endif %}
        {% if returnTo %}<input type="hidden" name="returnTo" value="{{ returnTo }}">{% endif %}
        <div class="asset-browser-default-control-row">
          <div class="field asset-browser-default-field-row">
            {% set nativeAttributes = [["required", true], ["aria-describedby", controlId ~ "-help"]] %}
            {% set summaryAttributes = [] %}
            {% if model.errorMessage %}
              {% set nativeAttributes = [["required", true], ["aria-describedby", controlId ~ "-help " ~ controlId ~ "-error"], ["aria-invalid", true]] %}
              {% set summaryAttributes = [["aria-describedby", controlId ~ "-error"], ["aria-invalid", true]] %}
            {% endif %}
            {{ dropdown.singleSelect({
              id: controlId ~ "-dropdown",
              name: "defaultCategory",
              label: "Default category",
              fieldClasses: "asset-browser-default-dropdown-field",
              options: model.options,
              selected: model.selectedValue,
              leadingOption: model.submittedOption or model.selectionPlaceholder,
               summaryAttributes: summaryAttributes,
               panelLabel: "Default category options",
               dispatchNativeChange: live,
               nativeSelect: {
                id: controlId,
                classes: "form-control",
                attributes: nativeAttributes
              }
            }) }}
          </div>
        </div>
        {% if live %}
          <div class="app-dialog-status" data-asset-browser-default-status role="status" aria-live="polite"></div>
          <noscript>
            <div class="form-actions asset-browser-default-action-row">
              <button type="submit" class="button button-primary">Apply selection</button>
            </div>
          </noscript>
        {% else %}
          <div class="form-actions asset-browser-default-action-row">
            <button type="submit" class="button button-primary">Save default</button>
          </div>
        {% endif %}
      </form>
    {% endif %}
  </section>
{% endmacro %}

{% macro globalControl(model, controlId, fieldName) %}
  {% set nativeAttributes = [["required", true], ["aria-describedby", controlId ~ "-help"]] %}
  {% set summaryAttributes = [] %}
  {% if model.errorMessage %}
    {% set nativeAttributes = [["required", true], ["aria-describedby", controlId ~ "-help " ~ controlId ~ "-error"], ["aria-invalid", true]] %}
    {% set summaryAttributes = [["aria-describedby", controlId ~ "-error"], ["aria-invalid", true]] %}
  {% endif %}
  {{ dropdown.singleSelect({
    id: controlId ~ "-dropdown",
    name: fieldName,
    label: "Default category",
    options: model.options,
    selected: model.selectedValue,
    leadingOption: model.submittedOption or model.selectionPlaceholder,
    summaryAttributes: summaryAttributes,
    panelLabel: "Default category options",
    nativeSelect: {
      id: controlId,
      classes: "form-control",
      attributes: nativeAttributes
    }
  }) }}
{% endmacro %}

{% macro global(model, action, controlId, csrf) %}
  <section class="settings-section asset-browser-default-section" aria-labelledby="{{ controlId }}-heading">
    <h3 id="{{ controlId }}-heading">Asset browser default</h3>
    <p class="asset-browser-default-description" id="{{ controlId }}-help">
      For projects set to <strong>Inherit global default</strong>. This does not recopy project categories;
      unavailable matches fall back to <strong>All Categories</strong>.
    </p>

    {% if model.warning %}
      <div class="notice notice--warning" role="status" id="{{ controlId }}-warning">
        <p>{{ model.warning }}</p>
      </div>
    {% endif %}

    {% if model.errorMessage %}
      <div class="error-summary" role="alert" id="{{ controlId }}-error">
        <p>Could not save the global asset browser default. {{ model.errorMessage }}</p>
      </div>
    {% endif %}

    <p class="asset-browser-default-summary">
      <span><span class="asset-browser-default-summary-label">Saved:</span> <strong>{{ model.storedLabel }}</strong></span>
      {% if model.fallback %}
        <span><span class="asset-browser-default-summary-label">Effective:</span> <strong>All Categories</strong> for inheriting projects</span>
      {% endif %}
    </p>

    <form method="post" action="{{ action }}" class="project-form asset-browser-default-form" novalidate>
      <input type="hidden" name="_csrf" value="{{ csrf }}">
      <div class="asset-browser-default-control-row">
        <div class="field asset-browser-default-field-row">
          {{ globalControl(model, controlId, "defaultCategory") }}
        </div>
        <span class="help-text">Category labels are shown here; the stable directory slug is stored.</span>
      </div>
      <div class="form-actions asset-browser-default-action-row">
        <button type="submit" class="button button-primary">Save default</button>
      </div>
    </form>
  </section>
{% endmacro %}

{% macro preview(model, action, controlId, csrf) %}
  <section class="settings-section asset-browser-default-section" aria-labelledby="{{ controlId }}-heading">
    <h3 id="{{ controlId }}-heading">Preview category</h3>
    <p class="asset-browser-default-description" id="{{ controlId }}-help">
      Choose the global asset category for preview selection. The stable directory slug is stored.
    </p>

    {% if model.errorMessage %}
      <div class="error-summary" role="alert" id="{{ controlId }}-error">
        <p>Could not save the preview category. {{ model.errorMessage }}</p>
      </div>
    {% endif %}

    <p class="asset-browser-default-summary">
      <span><span class="asset-browser-default-summary-label">Saved:</span> <strong>{{ model.storedLabel }}</strong></span>
    </p>

    <form method="post" action="{{ action }}" class="project-form asset-browser-default-form" novalidate>
      <input type="hidden" name="_csrf" value="{{ csrf }}">
        <div class="asset-browser-default-control-row">
          <div class="field asset-browser-default-field-row">
          {% set nativeAttributes = [["required", true], ["aria-describedby", controlId ~ "-help"]] %}
          {% set summaryAttributes = [] %}
          {% if model.errorMessage %}
            {% set nativeAttributes = [["required", true], ["aria-describedby", controlId ~ "-help " ~ controlId ~ "-error"], ["aria-invalid", true]] %}
            {% set summaryAttributes = [["aria-describedby", controlId ~ "-error"], ["aria-invalid", true]] %}
          {% endif %}
          {{ dropdown.singleSelect({
            id: controlId ~ "-dropdown",
            name: "previewCategory",
            label: "Preview category",
            options: model.options,
            selected: model.selectedValue,
            leadingOption: model.submittedOption or model.selectionPlaceholder,
            summaryAttributes: summaryAttributes,
            panelLabel: "Preview category options",
            nativeSelect: {
              id: controlId,
              classes: "form-control",
              attributes: nativeAttributes
            }
          }) }}
        </div>
      </div>
      <div class="form-actions asset-browser-default-action-row">
        <button type="submit" class="button button-primary">Save preview category</button>
      </div>
    </form>
  </section>
{% endmacro %}
