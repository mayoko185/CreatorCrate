<div class="form-switch asset-grid-details-control">
  <input class="form-switch-control" id="asset-grid-details-toggle" type="checkbox" role="switch"
         checked data-asset-grid-details-toggle>
  <label class="form-switch-label" for="asset-grid-details-toggle">
    <span class="form-switch-track" aria-hidden="true"><span class="form-switch-thumb"></span></span>
    <span class="form-switch-state">Details</span>
    <span class="sr-only">Show or hide additional information below grid previews</span>
  </label>
</div>
