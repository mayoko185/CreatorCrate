{% extends "layout.njk" %}
{% import "partials/page-heading.njk" as pageHeading %}
{% import "partials/icons.njk" as icons %}

{% set page_title = "Assets — " ~ project.title ~ " — " ~ asset.filename %}

{% block content %}
  {% call pageHeading.render("", "", "", "/projects/" ~ project.id, "Project: " ~ project.title, "asset-viewer-project") %}
    <a class="button button-secondary asset-viewer-back" href="{{ backToAssetsLink.href }}">Back to Assets</a>
  {% endcall %}

  {% if canMutate or canManageTags or canSetAsPrimaryImage or canRemovePrimaryImage or openLocallyUri %}
    <nav class="project-detail-action-toolbar asset-viewer-action-toolbar" aria-label="Asset actions">
      {% if canMutate or canManageTags or canSetAsPrimaryImage or canRemovePrimaryImage %}
        <a class="button button-small button-secondary project-detail-action asset-viewer-action asset-viewer-edit asset-tooltip asset-tooltip--right"
           href="{{ assetEditDialogUrl }}" aria-label="Edit asset" data-dialog-open="asset-edit-dialog" data-tooltip="Edit asset">
          {{ icons.icon('edit') }}
        </a>
      {% endif %}
      {% if openLocallyUri %}
        <a class="button button-small button-secondary project-detail-action asset-viewer-action asset-viewer-open-locally asset-tooltip asset-tooltip--right"
           href="{{ openLocallyUri }}" aria-label="Open locally" data-tooltip="Open locally">
          {{ icons.icon('open-locally') }}
        </a>
      {% endif %}
    </nav>
  {% endif %}

  {% if filteredOut %}
    {% set noticeVariant = "warning" %}
    {% set noticeText = "This asset is outside the current asset-browser filters. Previous and Next links are unavailable for this filter context." %}
    {% include "partials/notice.njk" %}
  {% endif %}

  {% if notice %}
    {% set noticeVariant = "success" %}
    {% set noticeText = noticeMessage %}
    {% include "partials/notice.njk" %}
  {% endif %}

  {% if formError and not assetEditDialogOpen %}
    {% set noticeVariant = "error" %}
    {% set noticeText = formError.message %}
    {% include "partials/notice.njk" %}
  {% endif %}

  <section class="asset-preview-section" aria-labelledby="asset-preview-heading">
    <h2 id="asset-preview-heading">Preview</h2>
    <div class="asset-preview-viewer">
      {% if asset.preview.previewable and asset.preview_url %}
        <figure class="asset-preview-frame{% if asset.preview.kind == 'krita' %} asset-media--krita{% endif %}" data-preview-enhancement data-preview-state="loading">
          {% if asset.original_url %}
            <a class="asset-preview-link" href="{{ asset.original_url }}" aria-label="View original {{ asset.filename }}">
              <img class="asset-preview-image" src="{{ asset.preview_url }}" alt="{{ asset.previewAltText }}" data-preview-image>
            </a>
          {% else %}
            <img class="asset-preview-image" src="{{ asset.preview_url }}" alt="{{ asset.previewAltText }}" data-preview-image>
          {% endif %}
          <p class="asset-preview-placeholder asset-preview-fallback" data-preview-fallback hidden>Preview unavailable</p>
        </figure>
        <noscript>
          <p class="notice asset-preview-noscript">
            JavaScript is disabled. {% if asset.original_url %}Select the preview image to open the asset{% else %}The asset cannot be opened as an original{% endif %}.
          </p>
        </noscript>
      {% elseif asset.missing %}
        {% set noticeVariant = "danger" %}
        {% set noticeText = "Missing at last scan. Preview and original viewing are unavailable." %}
        {% include "partials/notice.njk" %}
        <p class="asset-preview-placeholder">Preview unavailable for missing assets.</p>
      {% elseif asset.preview_state == 'unsupported' %}
        {% set noticeVariant = "warning" %}
        {% set noticeText = "Unsupported asset preview. This asset type or recorded MIME cannot be previewed inline." %}
        {% include "partials/notice.njk" %}
        <p class="asset-preview-placeholder">Preview unavailable for unsupported assets.</p>
      {% else %}
        {% set noticeVariant = "neutral" %}
        {% set noticeText = "Preview unavailable because recorded source metadata is incomplete." %}
        {% include "partials/notice.njk" %}
        <p class="asset-preview-placeholder">No preview link is available.</p>
      {% endif %}
      {% if previousAssetLink %}
        <a class="asset-preview-nav asset-preview-nav--previous" href="{{ previousAssetLink.href }}" rel="prev" aria-label="Previous asset">{{ icons.icon('chevron-left') }}</a>
      {% endif %}
      {% if nextAssetLink %}
        <a class="asset-preview-nav asset-preview-nav--next" href="{{ nextAssetLink.href }}" rel="next" aria-label="Next asset">{{ icons.icon('chevron-right') }}</a>
      {% endif %}
    </div>
  </section>

  <section class="settings-section asset-viewer-section asset-metadata-section" aria-labelledby="asset-metadata-heading">
    <h3 id="asset-metadata-heading">Metadata</h3>
    <div class="asset-viewer-section-body asset-metadata-section-body">
      <dl class="detail-list asset-metadata asset-metadata--summary">
        <dt>Filename</dt>
        <dd><code>{{ asset.filename }}</code></dd>

        <dt>Location</dt>
        <dd>/{{ project.slug }}/{% if asset.category %}{{ asset.category.directorySlug }}/{% endif %}</dd>
      </dl>

      <section class="asset-metadata-group asset-metadata-group--panel" aria-labelledby="asset-metadata-file-details-heading">
        <h4 id="asset-metadata-file-details-heading" class="asset-metadata-group-title">File details</h4>
        <dl class="detail-list asset-metadata">
          <dt>Category</dt>
          <dd>
            {{ asset.categoryLabel }}
            {% if asset.categoryDisabled %}<em class="asset-category-disabled-marker">(disabled)</em>{% endif %}
          </dd>

          <dt>Extension</dt>
          <dd><code>{{ asset.extension or '—' }}</code></dd>

          <dt>Recorded MIME type</dt>
          <dd><code>{{ asset.mime_type or '—' }}</code></dd>

          <dt>Size</dt>
          <dd>
            {% if asset.size_bytes == 0 or asset.size_bytes %}
              {{ asset.size_bytes }} bytes
            {% else %}
              —
            {% endif %}
          </dd>

          <dt>Recorded modified time</dt>
          <dd>{{ asset.modified_at or '—' }}</dd>
        </dl>
      </section>

      <section class="asset-metadata-group asset-metadata-group--panel" aria-labelledby="asset-metadata-state-heading">
        <h4 id="asset-metadata-state-heading" class="asset-metadata-group-title">State and history</h4>
        <dl class="detail-list asset-metadata">
          <dt>Presence</dt>
          <dd>
            {% if asset.is_present %}
              {% set status = 'present-at-last-scan' %}{% include "partials/status-badge.njk" %}
            {% else %}
              {% set status = 'missing-at-last-scan' %}{% include "partials/status-badge.njk" %}
            {% endif %}
          </dd>

          <dt>Last seen</dt>
          <dd>{{ asset.last_seen_at or '—' }}</dd>

          <dt>Missing since</dt>
          <dd>{{ asset.missing_since or '—' }}</dd>
        </dl>
      </section>
    </div>
  </section>

  <section class="settings-section asset-viewer-section asset-tags-section" aria-labelledby="asset-tags-heading">
    <h3 id="asset-tags-heading">Tags</h3>
    <div class="asset-viewer-section-body asset-tags-section-body">
      {% if assetTags.length > 0 %}
        <ul class="tag-chip-list">
          {% for tag in assetTags %}
            <li class="tag-chip">{{ tag.displayName }}</li>
          {% endfor %}
        </ul>
      {% else %}
        <p class="help-text">No tags assigned to this asset.</p>
      {% endif %}
    </div>
  </section>


  <section class="settings-section asset-viewer-section asset-release-usage-section" aria-labelledby="asset-release-usage-heading">
    <h3 id="asset-release-usage-heading">Release usage</h3>
    <div class="asset-viewer-section-body asset-release-usage-section-body">
      {% if asset.release_usage_summary.count > 0 %}
        <p>
          Used by {{ asset.release_usage_summary.count }} release{% if asset.release_usage_summary.count != 1 %}s{% endif %}.
        </p>
        {% if asset.release_usage.length > 0 %}
          <ul class="release-detail-list">
            {% for usage in asset.release_usage %}
              <li>
                <a href="/releases/{{ usage.release_id }}">{{ usage.title }}</a>
                <span class="release-role">{{ usage.role | title }}</span>
              </li>
            {% endfor %}
          </ul>
        {% endif %}
      {% else %}
        <p>Not used by a release.</p>
      {% endif %}
    </div>
  </section>
{% endblock %}
{% block overlay %}
  {% include "partials/asset-edit-dialog.njk" %}
{% endblock %}
