{% extends "layout.njk" %}
{% import "partials/page-heading.njk" as pageHeading %}
{% import "partials/project-card.njk" as projectCard %}
{% import "partials/view-switcher.njk" as viewSwitcher %}
{% import "partials/icons.njk" as icons %}
{% import "partials/dialog.njk" as dialog %}
{% import "partials/dropdown.njk" as dropdown %}
{% import "partials/project-create-dialog.njk" as projectCreateDialog %}
{% import "partials/project-edit-dialog.njk" as projectEditDialog %}

{% set page_title = "Projects" %}

{% block content %}
  {% call pageHeading.render("Browse active and archived project records.") %}
    <a class="button button-primary dashboard-create-action" href="/projects/new" data-dialog-open="project-create-dialog" data-dialog-invocation><span class="project-create-submit-icon" aria-hidden="true">{{ icons.icon('plus') }}</span>New Project</a>
  {% endcall %}

  {% if notice %}
    {% set noticeVariant = notice.variant %}
    {% set noticeText = notice.text %}
    {% include "partials/notice.njk" %}
  {% endif %}

  <div class="notice notice--success app-dialog-feedback" data-dialog-feedback role="status" hidden>
    <p data-dialog-feedback-text></p>
  </div>

  <div data-projects-live-region>
    <span class="sr-only" data-projects-live-status aria-live="polite" aria-atomic="true"></span>
    {# WP10b: authoritative defaults metadata of this rendered page (effective
       current values of the seven saveable settings, saved-key presence,
       fallbacks, durable generation). Data only; it travels with every
       live-region install so a prepared response is never mistaken for the
       installed one. #}
    {% if projectsDefaultsAuthorityJson %}
    <script type="application/json" data-projects-defaults-authority>{{ projectsDefaultsAuthorityJson | safe }}</script>
    {% endif %}

    <div class="asset-viewer-display-controls"{% if view == 'grid' %} data-project-grid-size-controls{% endif %}>
      {{ viewSwitcher.render(view, pageUrl, "Project display", true) }}

      {% if view == 'grid' %}
        {% set gridSizeLabelsInteractive = true %}
        {% include "partials/asset-grid-size-control.njk" %}
      {% endif %}

      <div class="project-filter-actions project-filter-actions--projects">
        {# WP10b: the one Filters & Defaults entry (the separate Defaults entry is retired). #}
        <a class="button button-small button-secondary project-filter-control asset-tooltip asset-tooltip--left"
           href="#projects-filter-dialog" aria-label="Filters &amp; Defaults"
           data-dialog-open="projects-filter-dialog"
           data-tooltip="Filters &amp; Defaults">
          {{ icons.icon('content-filter') }}
        </a>
        {% set nsfwToggleLabel = "Disable NSFW filter" if nsfwFilterEnabled else "Enable NSFW filter" %}
        <form method="post" action="/projects/nsfw-filter" class="inline-form" data-projects-nsfw-filter>
          <input type="hidden" name="_csrf" value="{{ _csrf }}">
          <input type="hidden" name="enabled" value="{{ '0' if nsfwFilterEnabled else '1' }}" data-projects-nsfw-value>
          <input type="hidden" name="returnTo" value="{{ projectsNsfwReturnUrl }}">
          <button class="button button-small button-secondary project-filter-control asset-tooltip asset-tooltip--left"
                  id="projects-nsfw-toggle" type="submit" data-projects-nsfw-toggle
                  aria-pressed="{{ 'true' if nsfwFilterEnabled else 'false' }}"
                  aria-label="{{ nsfwToggleLabel }}" data-tooltip="{{ nsfwToggleLabel }}">
            {{ icons.icon('nsfw-filter') }}
          </button>
        </form>
      </div>
    </div>

    <p class="results-meta">{{ total }} project{% if total != 1 %}s{% endif %} found</p>

    {% if projects.length > 0 %}
      {% if view == 'list' %}
        {# The Dashboard Projects panel and table, inside a Dashboard scope so the
           table, title-trigger focus and card typography rules apply unchanged. #}
        <div class="dashboard dashboard-panel dashboard-projects projects-list-panel">
          <div class="dashboard-table-scroll projects-list-scroll" role="region" aria-label="Projects" tabindex="0">
            <table class="dashboard-projects-table projects-list-table" data-projects-list-table>
              <caption class="sr-only">Projects</caption>
              <thead>
                <tr>
                  {% set sortDirection = 'ascending' if query.order == 'asc' else 'descending' %}
                  <th scope="col"{% if query.sort == 'title' %} aria-sort="{{ sortDirection }}"{% endif %}>Project</th>
                  <th scope="col">Status</th>
                  <th scope="col">Type</th>
                  <th scope="col">Assets</th>
                  <th scope="col"{% if query.sort == 'updated' %} aria-sort="{{ sortDirection }}"{% endif %}>Updated</th>
                </tr>
              </thead>
              <tbody>
                {% for project in projects %}
                {{ projectCard.listRow(project, clockFormat) }}
                {% endfor %}
              </tbody>
            </table>
          </div>
        </div>
      {% else %}
        <ul class="project-grid" data-grid-style="{{ gridStyle }}">
          {% for project in projects %}
          {{ projectCard.render(project, view, 'h2', clockFormat) }}
          {% endfor %}
        </ul>
      {% endif %}

      {% if pageCount > 1 %}
        <nav class="pagination" aria-label="Project list pages">
          {% if page > 1 %}
            <a class="button" href="{{ pageUrl({ page: page - 1 }) }}">Previous</a>
          {% endif %}

          <span>Page {{ page }} of {{ pageCount }}</span>

          {% if page < pageCount %}
            <a class="button" href="{{ pageUrl({ page: page + 1 }) }}">Next</a>
          {% endif %}
        </nav>
      {% endif %}
    {% else %}
    {% if filtersActive and hasAnyProjects %}
      {% set emptyHeading = "No projects found" %}
        {% set emptyDescription = "No projects match the current filters." %}
        {% set emptyHeadingLevel = "h2" %}
    {% else %}
      {% set emptyActionDialogId = "project-create-dialog" %}
      {% set emptyActionAttributes = [['data-dialog-invocation', true]] %}
      {% set emptyHeading = "No projects yet" %}
        {% set emptyDescription = "Create your first project to get started." %}
        {% set emptyActionUrl = "/projects/new" %}
        {% set emptyActionLabel = "New Project" %}
        {% set emptyHeadingLevel = "h2" %}
      {% endif %}
      {% include "partials/empty-state.njk" %}
    {% endif %}
  </div>
  <noscript><button class="button" type="submit" form="project-filters">Filter</button></noscript>
{% endblock %}

{% block overlay %}
  {{ projectCreateDialog.render(projectCreateForm, '/projects', _csrf, projectCreateDialogOpen) }}
  {# One Edit Project dialog for every List information card;
     project-edit-dialog.js loads the chosen project into it. #}
  {% if projectEditForm %}{{ projectEditDialog.render(none, projectEditForm, _csrf, false, '', 'edit-project-') }}{% endif %}

  {#
    WP10b Filters & Defaults: one dialog, owning forms side by side, no nesting.
    - #projects-defaults-form holds the saved-state line and the explicit-save
      status. client/projects-filters-defaults.js binds it
      (data-defaults-explicit-save, no autosave marker): Save new defaults
      posts one snapshot of the seven eligible settings from the INSTALLED
      page authority plus the session Grid style, with the current durable
      generation and an operation identity. Save and Reset defaults are
      JavaScript-only: the form has no native mutation (method="dialog", no
      saveable fields), both buttons are rendered disabled and type="button",
      and the controller arms them only once it owns their click paths.
    - #project-filters (GET) is the only filter state. Every control that
      changes results (Search, Projects, Status, Project Type, Tag, Sort by,
      Sort order, View) belongs to it and navigates through the one Projects
      live-region engine. Repeated values stay repeated (project=7&project=12).
    - Grid style is a current-session presentation choice: it has no name, so
      it never joins the GET and never posts; the controller owns it until
      Save, Reset filters or Reset defaults.
  #}
  {% set projectsAuthority = projectsDefaultsAuthority %}
  {% set gridStyleChoices = [{ value: 'uncropped', label: 'Uncropped' }, { value: 'cropped', label: 'Cropped' }] %}
  {% if projectsDefaults and projectsDefaults.fields %}
    {% for field in projectsDefaults.fields %}
      {% if field.name == 'gridStyle' and field.options and field.options.length > 0 %}{% set gridStyleChoices = field.options %}{% endif %}
    {% endfor %}
  {% endif %}
  {% set savedDefaultCount = projectsAuthority.savedKeys.length if projectsAuthority and projectsAuthority.savedKeys else 0 %}
  {% call dialog.render('projects-filter-dialog', 'Filters & Defaults', projectsDefaultsDialogOpen, '', 'projects-defaults-form', 'app-dialog--utility app-dialog--filters-defaults projects-filters-defaults', [], true, 'Projects') %}
    <div class="app-dialog-body filters-defaults-dialog-body">
      <form id="projects-defaults-form" method="dialog" class="filters-defaults-defaults-form"
            data-dialog-form data-dialog-async="false" data-defaults-explicit-save novalidate>
        <input type="hidden" name="_csrf" value="{{ _csrf }}">

        <div class="filters-defaults-status-row">
          <p class="filters-defaults-saved-indicator" data-projects-defaults-indicator>
            {%- if not projectsAuthority -%}Saved defaults could not be read.
            {%- elif savedDefaultCount == 0 -%}No saved defaults.
            {%- elif savedDefaultCount == projectsAuthority.fields.length -%}Defaults saved.
            {%- else -%}{{ savedDefaultCount }} of {{ projectsAuthority.fields.length }} defaults saved.{%- endif -%}
          </p>
        </div>

        <div class="app-dialog-error" data-dialog-error role="alert" hidden>
          <p data-dialog-error-text></p>
          <ul data-dialog-error-list></ul>
        </div>
        {% if projectsDefaults and projectsDefaults.fields %}
          {% for field in projectsDefaults.fields %}
            {% if field.error %}
              <p class="field-error-message" id="{{ field.id }}-error" role="alert" data-projects-defaults-field-error="{{ field.name }}">{{ field.label }}: {{ field.error }}</p>
            {% endif %}
          {% endfor %}
        {% endif %}
        <div class="app-dialog-status filters-defaults-status" data-settings-fetch-save-status role="status" aria-live="polite" aria-atomic="true"></div>
        <div class="filters-defaults-recovery" data-projects-defaults-recovery hidden>
          <button class="button button-small button-secondary" type="button" data-projects-defaults-retry hidden>Retry</button>
          <button class="button button-small button-secondary" type="button" data-projects-defaults-check hidden>Check again</button>
        </div>
      </form>

      <form id="project-filters" class="filters-defaults-filters" method="get" action="/projects">
        <section class="filters-defaults-section" aria-labelledby="projects-filters-heading">
          <h3 id="projects-filters-heading">Filters</h3>
          <div class="filters-defaults-grid">
            <div class="app-dialog-field field projects-search-field">
              <label for="projects-search">Search</label>
              <input id="projects-search" name="search" type="search" value="{{ query.search or '' }}" maxlength="200" autocomplete="off" data-projects-search>
            </div>

            {{ dropdown.multiSelect({
              id: "project-project-filter",
              name: "project",
              label: "Projects",
              options: projectFilterOptions or [],
              selectedValues: projectFilterSelectedValues or [],
              selectAll: { value: '' },
              emptySummary: "All projects",
              countLabel: "projects",
              searchable: true,
              searchLabel: "Search projects",
              searchInputId: "project-project-filter-search",
              noResultsText: "No matching projects",
              optionListLabel: "Project choices",
              optionIdPrefix: "project-project",
              panelLabel: "Project options",
              emptyOptionText: "No projects available",
              fieldClasses: "app-dialog-field asset-viewer-filter-field asset-viewer-project-filter projects-filter-field--project",
              fieldAttributes: [["data-projects-project-filter", true]],
              classes: "asset-project-filter-disclosure"
            }) }}

            {{ dropdown.multiSelect({
              id: "project-status-filter",
              name: "status",
              label: "Status",
              fieldClasses: "app-dialog-field asset-viewer-filter-field",
              options: statusOptions,
              optionIdPrefix: "project-status",
              selectedValues: query.statuses,
              selectAll: { value: '' },
              emptySummary: "All active",
              countLabel: "statuses",
              panelLabel: "Status options"
            }) }}

            {{ dropdown.multiSelect({
              id: "project-type-filter",
              name: "type",
              label: "Project Type",
              fieldClasses: "app-dialog-field asset-viewer-filter-field",
              options: projectTypeOptions,
              optionIdPrefix: "project-type",
              selectedValues: query.projectTypes,
              selectAll: { value: '' },
              emptySummary: "All types",
              countLabel: "types",
              panelLabel: "Project Type options"
            }) }}

            {{ dropdown.multiSelect({
              id: "project-tag-filter",
              name: "tag",
              label: "Tag",
              fieldClasses: "app-dialog-field asset-viewer-filter-field",
              options: tagOptions,
              optionIdPrefix: "project-tag",
              selectedValues: query.tagIds,
              selectAll: { value: '' },
              emptySummary: "All tags",
              countLabel: "tags",
              panelLabel: "Tag options",
              emptyOptionText: "No tags available"
            }) }}
          </div>
        </section>

        <section class="filters-defaults-section" aria-labelledby="projects-sort-heading">
          <h3 id="projects-sort-heading">Sort options</h3>
          <div class="filters-defaults-grid">
            {{ dropdown.singleSelect({
              id: "project-sort-filter",
              name: "sort",
              label: "Sort by",
              fieldClasses: "app-dialog-field asset-viewer-filter-field",
              options: [
                { value: "updated", label: "Updated" },
                { value: "created", label: "Created" },
                { value: "title", label: "Title" }
              ],
              selected: query.sort or "created",
              optionIdPrefix: "project-sort",
              panelLabel: "Sort by options"
            }) }}

            {{ dropdown.singleSelect({
              id: "project-order-filter",
              name: "order",
              label: "Sort order",
              fieldClasses: "app-dialog-field asset-viewer-filter-field",
              options: [
                { id: "project-order-option-asc", value: "asc", label: "Ascending" },
                { id: "project-order-option-desc", value: "desc", label: "Descending" }
              ],
              selected: query.order or "desc",
              optionIdPrefix: "project-order",
              panelLabel: "Sort order options"
            }) }}
          </div>
        </section>

        <section class="filters-defaults-section" aria-labelledby="projects-misc-heading">
          <h3 id="projects-misc-heading">Miscellaneous</h3>
          <div class="filters-defaults-grid">
            {{ dropdown.singleSelect({
              id: "project-view-filter",
              name: "view",
              label: "View",
              fieldClasses: "app-dialog-field asset-viewer-filter-field",
              options: [
                { value: "grid", label: "Grid" },
                { value: "list", label: "List" }
              ],
              selected: view,
              optionIdPrefix: "project-view",
              panelLabel: "View options"
            }) }}

            {# Unnamed on purpose: a session presentation choice, never a GET key. #}
            {{ dropdown.singleSelect({
              id: "project-grid-style-filter",
              label: "Grid style",
              fieldClasses: "app-dialog-field asset-viewer-filter-field",
              fieldAttributes: [["data-projects-grid-style-field", true], ["data-filters-visible-when-view", "grid"], ["hidden", view == "list"]],
              options: gridStyleChoices,
              selected: gridStyle,
              optionIdPrefix: "project-grid-style",
              dispatchNativeChange: true,
              panelLabel: "Grid style options",
              nativeSelect: {
                id: "projects-grid-style",
                attributes: [["data-projects-grid-style", true]]
              }
            }) }}
          </div>
        </section>
      </form>
    </div>
    <footer class="app-dialog-footer filters-defaults-footer">
      <button class="button button-secondary" type="button" disabled data-projects-defaults-save>Save new defaults</button>
      {# Reset defaults is JavaScript-only, like Save: no form, no native POST
         and no rendered returnTo/generation. It is disabled until the
         explicit-save controller owns it. #}
      <button class="button button-secondary" type="button" disabled data-projects-defaults-reset>Reset defaults</button>
      {# GET-only: the server resolves the effective saved/default destination. #}
      <form class="projects-filter-reset filters-defaults-reset-form" method="get" action="{{ resetFiltersUrl or '/projects' }}">
        <button class="button button-primary" type="submit" data-projects-filters-reset>Reset filters</button>
      </form>
    </footer>
  {% endcall %}
{% endblock %}
