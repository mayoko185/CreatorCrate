{% extends "layout.njk" %}
{% import "partials/page-heading.njk" as pageHeading %}

{% set page_title = "Projects" %}

{% block content %}
  {% call pageHeading.render("Browse active and archived project records.") %}
    <a class="button button-primary" href="/projects/new">New Project</a>
  {% endcall %}

  <form class="filters" method="get" action="/projects">
    <div class="field">
      <label for="search">Search</label>
      <input type="search" id="search" name="search" value="{{ query.search or '' }}">
    </div>

    <div class="field">
      <label for="status">Status</label>
      <select id="status" name="status">
        <option value="" {% if not query.status %}selected{% endif %}>All active</option>
        {% for s in statuses %}
          <option value="{{ s }}" {% if query.status == s %}selected{% endif %}>{{ s | replace('-', ' ') | title }}</option>
        {% endfor %}
      </select>
    </div>

    <div class="field">
      <label for="sort">Sort</label>
      <select id="sort" name="sort">
        {% for opt in sortOptions %}
          <option value="{{ opt }}" {% if query.sort == opt or (not query.sort and opt == 'updated') %}selected{% endif %}>{{ opt | replace('-', ' ') | title }}</option>
        {% endfor %}
      </select>
    </div>

    <div class="field">
      <label for="order">Sort order</label>
      <select id="order" name="order">
        <option value="desc" {% if query.order != 'asc' %}selected{% endif %}>Desc</option>
        <option value="asc" {% if query.order == 'asc' %}selected{% endif %}>Asc</option>
      </select>
    </div>

    <button class="button" type="submit">Filter</button>
    <a class="button button-secondary" href="{{ resetFiltersUrl }}">Reset Filters</a>
  </form>

  <p class="results-meta">{{ total }} project{% if total != 1 %}s{% endif %} found</p>

  {% if projects.length > 0 %}
    <ul class="project-grid">
      {% for project in projects %}
        <li class="project-grid-item">
          <article class="project-card{% if project.archived_at %} project-card--archived{% endif %}" data-project-card>
            {% if project.primaryImage.state == 'available' %}
              <div class="project-card-media project-card-media--image" data-preview-enhancement data-preview-state="loading">
                <img class="project-card-media-image" data-preview-image src="{{ project.primaryImage.previewUrl }}" alt="{{ project.primaryImage.alt }}" loading="lazy" decoding="async">
                <span class="project-card-media-fallback" data-preview-fallback hidden>Image unavailable</span>
              </div>
            {% elif project.primaryImage.state == 'unavailable' %}
              <div class="project-card-media project-card-media--fallback" data-primary-image-state="unavailable">
                <span>Image unavailable</span>
              </div>
            {% else %}
              <div class="project-card-media project-card-media--fallback" data-primary-image-state="none">
                <span>No image</span>
              </div>
            {% endif %}

            <div class="project-card-body">
              <h2 class="project-card-title">
                <a class="project-card-link" data-project-card-link href="/projects/{{ project.id }}">{{ project.title }}</a>
              </h2>

              <dl class="project-card-metadata">
                <div class="project-card-meta">
                  <dt>Status</dt>
                  <dd>{% set status = project.status %}{% include "partials/status-badge.njk" %}</dd>
                </div>
                <div class="project-card-meta">
                  <dt>Priority</dt>
                  <dd>{{ project.priority | title }}</dd>
                </div>
                <div class="project-card-meta project-card-meta--date">
                  <dt>Updated</dt>
                  <dd>{{ project.updated_at }}</dd>
                </div>
                <div class="project-card-meta project-card-meta--date">
                  <dt>Planned</dt>
                  <dd>{{ project.planned_date or '—' }}</dd>
                </div>
                <div class="project-card-meta project-card-meta--date">
                  <dt>Published</dt>
                  <dd>{{ project.published_date or '—' }}</dd>
                </div>
              </dl>
            </div>
          </article>
        </li>
      {% endfor %}
    </ul>

    {% if pageCount > 1 %}
      <nav class="pagination" aria-label="Project list pages">
        {% if page > 1 %}
          <a class="button" href="{{ pageUrl({ page: page - 1 }) }}">Previous</a>
        {% endif %}

        <span>Page {{ page }} of {{ pageCount }}</span>

        {% if page < pageCount %}
          <a class="button" href="{{ pageUrl({ page: page + 1 }) }}">Next</a>
        {% endif %}
      </nav>
    {% endif %}
  {% else %}
    {% if filtersActive and hasAnyProjects %}
      {% set emptyHeading = "No projects found" %}
      {% set emptyDescription = "No projects match the current filters." %}
      {% set emptyActionUrl = resetFiltersUrl %}
      {% set emptyActionLabel = "Reset Filters" %}
      {% set emptyHeadingLevel = "h2" %}
    {% else %}
      {% set emptyHeading = "No projects yet" %}
      {% set emptyDescription = "Create your first project to get started." %}
      {% set emptyActionUrl = "/projects/new" %}
      {% set emptyActionLabel = "New Project" %}
      {% set emptyHeadingLevel = "h2" %}
    {% endif %}
    {% include "partials/empty-state.njk" %}
  {% endif %}
{% endblock %}
