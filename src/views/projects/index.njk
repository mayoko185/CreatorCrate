{% extends "layout.njk" %}
{% import "partials/page-heading.njk" as pageHeading %}
{% import "partials/project-card.njk" as projectCard %}
{% import "partials/view-switcher.njk" as viewSwitcher %}
{% import "partials/icons.njk" as icons %}
{% import "partials/dialog.njk" as dialog %}
{% import "partials/dropdown.njk" as dropdown %}
{% import "partials/project-create-dialog.njk" as projectCreateDialog %}

{% set page_title = "Projects" %}

{% macro renderFilterSummary(selectedValues, options, emptyLabel, countLabel, prefix) -%}
  {%- if selectedValues.length == 0 -%}
    {{ emptyLabel }}
  {%- elif selectedValues.length == 1 -%}
    {%- for option in options -%}
      {%- if option.selected -%}
        {{ prefix or '' }}{{ option.label or option.displayName }}
      {%- endif -%}
    {%- endfor -%}
  {%- else -%}
    {{ selectedValues.length }} {{ countLabel }} selected
  {%- endif -%}
{%- endmacro %}

{% block content %}
  {% call pageHeading.render("Browse active and archived project records.") %}
    <a class="button button-primary" href="/projects/new" data-dialog-open="project-create-dialog">New Project</a>
  {% endcall %}

  {% if notice %}
    {% set noticeVariant = notice.variant %}
    {% set noticeText = notice.text %}
    {% include "partials/notice.njk" %}
  {% endif %}

  <div class="notice notice--success app-dialog-feedback" data-dialog-feedback role="status" hidden>
    <p data-dialog-feedback-text></p>
  </div>

  <div data-projects-live-region>
    <span class="sr-only" data-projects-live-status aria-live="polite" aria-atomic="true"></span>

    <div class="asset-viewer-display-controls"{% if view == 'grid' %} data-project-grid-size-controls{% endif %}>
      {{ viewSwitcher.render(view, pageUrl, "Project display", true) }}

      {% if view == 'grid' %}
        {% set gridSizeLabelsInteractive = true %}
        {% include "partials/asset-grid-size-control.njk" %}
      {% endif %}

      <div class="project-filter-actions project-filter-actions--projects">
        <a class="asset-viewer-defaults-link button button-small button-secondary project-filter-control asset-tooltip asset-tooltip--left"
           href="/projects?defaults=1" aria-label="Projects defaults"
           data-dialog-open="projects-defaults-dialog"
           data-tooltip="Projects defaults">
          {{ icons.icon('settings') }}
        </a>
        {% set nsfwToggleLabel = "Disable NSFW filter" if nsfwFilterEnabled else "Enable NSFW filter" %}
        <form method="post" action="/projects/nsfw-filter" class="inline-form" data-projects-nsfw-filter>
          <input type="hidden" name="_csrf" value="{{ _csrf }}">
          <input type="hidden" name="enabled" value="{{ '0' if nsfwFilterEnabled else '1' }}" data-projects-nsfw-value>
          <input type="hidden" name="returnTo" value="{{ projectsNsfwReturnUrl }}">
          <button class="button button-small button-secondary project-filter-control asset-tooltip asset-tooltip--left"
                  id="projects-nsfw-toggle" type="submit" data-projects-nsfw-toggle
                  aria-pressed="{{ 'true' if nsfwFilterEnabled else 'false' }}"
                  aria-label="{{ nsfwToggleLabel }}" data-tooltip="{{ nsfwToggleLabel }}">
            {{ icons.icon('nsfw-filter') }}
          </button>
        </form>
        <a class="button button-small button-secondary project-filter-control asset-tooltip asset-tooltip--left"
           href="{{ resetFiltersUrl }}" aria-label="Reset filters"
           data-tooltip="Reset filters" data-projects-reset>
          {{ icons.icon('reset') }}
        </a>
      </div>
    </div>

    <form id="project-filters" class="filters asset-viewer-filters asset-viewer-filters--projects" method="get" action="/projects">
      {% if view == 'list' or preserveViewQuery %}
        <input type="hidden" name="view" value="{{ view }}">
      {% endif %}

      {{ dropdown.searchableSingleSelect({
        id: "project-project-filter",
        name: "project",
        label: "Project",
        options: projectOptions,
        valueKey: "id",
        labelKey: "title",
        selected: selectedProject.id if selectedProject else null,
        placeholder: "All projects",
        panelLabel: "Project options",
        searchLabel: "Search projects",
        searchInputId: "project-project-filter-search",
        noResultsText: "No matching projects",
        optionListLabel: "Project choices",
        optionIdPrefix: "project-project",
        fieldClasses: "asset-viewer-filter-field asset-viewer-project-filter",
        classes: "asset-project-filter-disclosure"
      }) }}

      {{ dropdown.multiSelect({
        id: "project-status-filter",
        name: "status",
        label: "Status",
        fieldClasses: "asset-viewer-filter-field",
        options: statusOptions,
        optionIdPrefix: "project-status",
        selectedValues: query.statuses,
        summary: renderFilterSummary(query.statuses, statusOptions, "All active", "statuses", ""),
        emptySummary: "All active",
        countLabel: "statuses",
        panelLabel: "Status options"
      }) }}

      {{ dropdown.multiSelect({
        id: "project-type-filter",
        name: "type",
        label: "Project Type",
        fieldClasses: "asset-viewer-filter-field",
        options: projectTypeOptions,
        optionIdPrefix: "project-type",
        selectedValues: query.projectTypes,
        summary: renderFilterSummary(query.projectTypes, projectTypeOptions, "All types", "types", ""),
        emptySummary: "All types",
        countLabel: "types",
        panelLabel: "Project Type options"
      }) }}

      {{ dropdown.multiSelect({
        id: "project-tag-filter",
        name: "tag",
        label: "Tag",
        fieldClasses: "asset-viewer-filter-field",
        options: tagOptions,
        optionIdPrefix: "project-tag",
        selectedValues: query.tagIds,
        summary: renderFilterSummary(query.tagIds, tagOptions, "All tags", "tags", ""),
        emptySummary: "All tags",
        countLabel: "tags",
        panelLabel: "Tag options",
        emptyOptionText: "No tags available"
      }) }}

      {% set sortSummary = '' %}
      {% for opt in sortOptions %}
        {% if query.sort == opt or (not query.sort and opt == 'created') %}
          {% set sortSummary = opt | replace('-', ' ') | title %}
        {% endif %}
      {% endfor %}
      {% set orderSummary = 'Desc' %}
      {% if query.order == 'asc' %}
        {% set orderSummary = 'Asc' %}
      {% endif %}

      {{ dropdown.singleSelect({
        id: "project-sort-filter",
        name: "sort",
        label: "Sort",
        fieldClasses: "asset-viewer-filter-field",
        options: [
          { value: "updated", label: "Updated" },
          { value: "created", label: "Created" },
          { value: "title", label: "Title" },
          { value: "published", label: "Published" }
        ],
        selected: query.sort or "created",
        summary: sortSummary,
        optionIdPrefix: "project-sort",
        panelLabel: "Sort options"
      }) }}

      {{ dropdown.singleSelect({
        id: "project-order-filter",
        name: "order",
        label: "Sort order",
        fieldClasses: "asset-viewer-filter-field",
        options: [
          { id: "project-order-option-desc", value: "desc", label: "Desc" },
          { id: "project-order-option-asc", value: "asc", label: "Asc" }
        ],
        selected: query.order or "desc",
        summary: orderSummary,
        optionIdPrefix: "project-order",
        panelLabel: "Sort order options"
      }) }}

    </form>

    <p class="results-meta">{{ total }} project{% if total != 1 %}s{% endif %} found</p>

    {% if projects.length > 0 %}
        <ul class="{% if view == 'list' %}project-list{% else %}project-grid{% endif %}">
          {% for project in projects %}
          {{ projectCard.render(project, view) }}
          {% endfor %}
        </ul>

      {% if pageCount > 1 %}
        <nav class="pagination" aria-label="Project list pages">
          {% if page > 1 %}
            <a class="button" href="{{ pageUrl({ page: page - 1 }) }}">Previous</a>
          {% endif %}

          <span>Page {{ page }} of {{ pageCount }}</span>

          {% if page < pageCount %}
            <a class="button" href="{{ pageUrl({ page: page + 1 }) }}">Next</a>
          {% endif %}
        </nav>
      {% endif %}
    {% else %}
    {% if filtersActive and hasAnyProjects %}
      {% set emptyActionDialogId = "" %}
      {% set emptyActionAttributes = [["data-projects-reset", true]] %}
      {% set emptyHeading = "No projects found" %}
        {% set emptyDescription = "No projects match the current filters." %}
        {% set emptyActionUrl = resetFiltersUrl %}
        {% set emptyActionLabel = "Reset" %}
        {% set emptyHeadingLevel = "h2" %}
    {% else %}
      {% set emptyActionDialogId = "project-create-dialog" %}
      {% set emptyActionAttributes = [] %}
      {% set emptyHeading = "No projects yet" %}
        {% set emptyDescription = "Create your first project to get started." %}
        {% set emptyActionUrl = "/projects/new" %}
        {% set emptyActionLabel = "New Project" %}
        {% set emptyHeadingLevel = "h2" %}
      {% endif %}
      {% include "partials/empty-state.njk" %}
    {% endif %}
  </div>
  <noscript><button class="button" type="submit" form="project-filters">Filter</button></noscript>
{% endblock %}

{% block overlay %}
  {{ projectCreateDialog.render(projectCreateForm, '/projects', _csrf, projectCreateDialogOpen) }}

  {% call dialog.render('projects-defaults-dialog', 'Projects defaults', projectsDefaultsDialogOpen, 'projects-defaults-description', 'projects-defaults-form') %}
    <form id="projects-defaults-form" method="post" action="/projects/defaults" class="app-dialog-form project-form"
          data-dialog-form data-dialog-async novalidate>
      <p id="projects-defaults-description" class="app-dialog-description">
        Choose the presentation used when Projects opens without explicit view options.
      </p>

      <div class="app-dialog-error" data-dialog-error role="alert" hidden>
        <p data-dialog-error-text></p>
        <ul data-dialog-error-list></ul>
      </div>

      <input type="hidden" name="_csrf" value="{{ _csrf }}">

      <div class="app-dialog-body">
        {% for field in projectsDefaults.fields %}
          {% set submittedOption = none %}
          {% set nativeAttributes = [["required", true]] %}
          {% set summaryAttributes = [] %}
          {% if field.showSubmittedValue %}
            {% set submittedOption = {
              id: field.id ~ '-submitted',
              value: field.submittedOptionValue,
              label: 'Submitted value: ' ~ field.submittedDisplayValue,
              attributes: [["data-dialog-submitted-value", true]],
              selected: true
            } %}
          {% endif %}
          {% if field.error %}
            {% set nativeAttributes = [["required", true], ["aria-describedby", field.id ~ '-error'], ["aria-invalid", true]] %}
            {% set summaryAttributes = [["aria-describedby", field.id ~ '-error'], ["aria-invalid", true]] %}
          {% endif %}
          <div class="field app-dialog-field{% if field.error %} field-error{% endif %}" data-dialog-field="{{ field.name }}">
            {{ dropdown.singleSelect({
              id: field.id ~ '-dropdown',
              name: field.name,
              label: field.label,
              options: field.options,
              selected: field.selectedValue,
              optionIdPrefix: field.id,
              leadingOption: submittedOption,
              summaryAttributes: summaryAttributes,
              nativeSelect: {
                id: field.id,
                attributes: nativeAttributes
              }
            }) }}
            {% if field.error %}<span class="field-error-message" id="{{ field.id }}-error">{{ field.error }}</span>{% endif %}
          </div>
        {% endfor %}
      </div>

      <div class="app-dialog-status" data-dialog-status role="status" aria-live="polite"></div>

      <footer class="app-dialog-footer">
        <button class="button button-secondary" type="submit" formmethod="dialog" data-dialog-close>Cancel</button>
        <button class="button button-primary" type="submit" data-dialog-submit>Save defaults</button>
      </footer>
    </form>
  {% endcall %}
{% endblock %}
