{% extends "layout.njk" %}
{% import "partials/page-heading.njk" as pageHeading %}

{% set page_title = "Auto Rename — " ~ project.title %}

{% block content %}
  <div class="auto-rename-confirmation">
    {% call pageHeading.render("Review the server-generated names before changing files on disk.") %}
      <a class="button button-secondary" href="{{ cancelUrl }}">Cancel</a>
    {% endcall %}

    <section class="panel panel--summary auto-rename-overview" aria-labelledby="auto-rename-overview-heading">
      <h2 id="auto-rename-overview-heading">Auto Rename review</h2>
      <dl class="summary-list auto-rename-summary">
        <dt>Project</dt>
        <dd>{{ project.title }}</dd>
        <dt>Category</dt>
        <dd>{{ plan.category.displayName }} <code>{{ plan.category.directorySlug }}</code></dd>
        <dt>Assets</dt>
        <dd>{{ plan.counts.selected }}</dd>
        <dt>Naming rule</dt>
        <dd><code>{project-slug}-{category-directory-slug}-{NN}{exact-extension}</code></dd>
      </dl>
      <p class="auto-rename-rule-note">
        This is a read-only review of the complete category. The chosen category order is authorized by the signed plan and is not submitted again.
      </p>
    </section>

    <section class="panel auto-rename-counts" aria-labelledby="auto-rename-counts-heading">
      <h2 id="auto-rename-counts-heading">Plan counts</h2>
      <dl class="summary-list">
        <dt>Assets</dt>
        <dd>{{ plan.counts.selected }}</dd>
        <dt>Rename</dt>
        <dd>{{ plan.counts.rename }}</dd>
        <dt>Unchanged</dt>
        <dd>{{ plan.counts.unchanged }}</dd>
        <dt>Blocked</dt>
        <dd>{{ plan.counts.blocked }}</dd>
      </dl>
    </section>

    {% if plan.counts.blocked > 0 %}
      {% set noticeVariant = "error" %}
      {% set noticeText = "Auto Rename cannot be applied because one or more category assets are blocked." %}
      {% include "partials/notice.njk" %}
    {% elseif plan.counts.rename == 0 %}
      {% set noticeVariant = "warning" %}
      {% set noticeText = "All category assets are already named according to the rule. There are no changes to apply." %}
      {% include "partials/notice.njk" %}
    {% endif %}

    <section class="auto-rename-review" aria-labelledby="auto-rename-review-heading">
      <h2 id="auto-rename-review-heading">{{ plan.category.displayName }} assets</h2>
      <ol class="auto-rename-review-list">
        {% for item in plan.items %}
          {% set itemLabel = item.currentFilename %}
          {% if not itemLabel or itemLabel == '—' %}{% set itemLabel = item.currentRelativePath %}{% endif %}
          {% if not itemLabel or itemLabel == '—' %}{% set itemLabel = 'Asset ' ~ item.assetId %}{% endif %}
          <li class="auto-rename-review-item{% if item.status == 'blocked' %} auto-rename-review-item--blocked{% endif %}">
            <article class="asset-card auto-rename-card">
              {% if item.thumbnailUrl %}
                <div class="asset-card-media{% if item.previewKind == 'krita' %} asset-media--krita{% endif %}"
                     data-preview-enhancement data-preview-state="loading">
                  <img class="asset-card-thumb"
                       src="{{ item.thumbnailUrl }}"
                       alt="Preview thumbnail for {{ itemLabel }}"
                       loading="lazy"
                       decoding="async"
                       data-preview-image>
                  <span class="asset-card-placeholder asset-card-fallback" data-preview-fallback hidden>{{ item.typeLabel }} preview unavailable</span>
                </div>
              {% elseif item.previewState == 'unsupported' %}
                <div class="asset-card-media">
                  <span class="asset-card-placeholder">{{ item.typeLabel }} — preview not supported</span>
                </div>
              {% elseif item.previewState == 'missing' %}
                <div class="asset-card-media">
                  <span class="asset-card-placeholder asset-card-placeholder-missing">Missing at last scan — preview unavailable</span>
                </div>
              {% else %}
                <div class="asset-card-media">
                  <span class="asset-card-placeholder">Preview unavailable</span>
                </div>
              {% endif %}

              <div class="asset-card-body">
                <div class="auto-rename-card-header">
                  <span>Position {{ loop.index }} of {{ plan.items.length }}</span>
                  <span class="auto-rename-status auto-rename-status--{{ item.status }}">Status: {{ item.statusLabel }}</span>
                </div>

                <dl class="detail-list auto-rename-card-details">
                  <dt>Current relative path</dt>
                  <dd><code class="auto-rename-path">{{ item.currentRelativePath }}</code></dd>
                  <dt>Proposed relative path</dt>
                  <dd><code class="auto-rename-path">{{ item.proposedRelativePath or '—' }}</code></dd>
                  <dt>Current filename</dt>
                  <dd><code>{{ item.currentFilename }}</code></dd>
                  <dt>Proposed filename</dt>
                  <dd><code>{{ item.proposedFilename or '—' }}</code></dd>
                </dl>

                {% if item.blockedReason %}
                  <p class="auto-rename-block-reason"><strong>Blocked reason:</strong> {{ item.blockedReason }}</p>
                {% endif %}
              </div>
            </article>
          </li>
        {% endfor %}
      </ol>
    </section>

    <section class="panel panel--danger auto-rename-apply-panel" aria-labelledby="auto-rename-apply-heading">
      <h2 id="auto-rename-apply-heading">Apply changes</h2>
      <form method="post" action="/projects/{{ project.id }}/assets/auto-rename/apply" class="auto-rename-form">
        <input type="hidden" name="_csrf" value="{{ _csrf }}">
        <input type="hidden" name="planToken" value="{{ plan.token }}">
        {% if context.category is defined and context.category is not none and context.category != '' %}
          <input type="hidden" name="categoryId" value="{{ context.category }}">
        {% endif %}
        {% if context.view is defined and context.view is not none and context.view != '' %}
          <input type="hidden" name="view" value="{{ context.view }}">
        {% endif %}

        {% if plan.canApply %}
          <p>Applying this signed review will rename the category files on disk and update their asset records.</p>
          <div class="auto-rename-form-actions">
            <button class="button button-primary" type="submit">Apply Auto Rename</button>
            <a class="button button-secondary" href="{{ cancelUrl }}">Cancel</a>
          </div>
        {% elseif plan.counts.blocked > 0 %}
          <p>Apply is unavailable until all blocked category assets are resolved.</p>
          <div class="auto-rename-form-actions">
            <button class="button button-primary" type="submit" disabled aria-disabled="true">Apply Auto Rename</button>
            <a class="button button-secondary" href="{{ cancelUrl }}">Cancel</a>
          </div>
        {% else %}
          <p>There are no changes to apply because all category assets are unchanged.</p>
          <div class="auto-rename-form-actions">
            <button class="button button-primary" type="submit" disabled aria-disabled="true">Apply Auto Rename</button>
            <a class="button button-secondary" href="{{ cancelUrl }}">Cancel</a>
          </div>
        {% endif %}
      </form>
    </section>
  </div>
{% endblock %}
