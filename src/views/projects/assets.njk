{% extends "layout.njk" %}
{% import "partials/page-heading.njk" as pageHeading %}

{% macro releaseUsageInline(asset) %}
  {% if asset.releaseSummary.mode == 'none' %}
    <span class="asset-unused">No releases</span>
  {% elif asset.releaseSummary.mode == 'single' %}
    {% set usage = asset.releaseSummary.releases[0] %}
    <a href="/releases/{{ usage.release_id }}">{{ usage.title }}</a>
    <span class="release-role">{{ usage.role | title }}</span>
    <span class="release-status">({{ usage.status }})</span>
  {% else %}
    <details class="release-usage-details">
      <summary>{{ asset.releaseSummary.count }} releases</summary>
      <ul class="release-detail-list">
        {% for usage in asset.releaseSummary.releases %}
          <li>
            <a href="/releases/{{ usage.release_id }}">{{ usage.title }}</a>
            <span class="release-role">{{ usage.role | title }}</span>
            <span class="release-status">({{ usage.status }})</span>
          </li>
        {% endfor %}
      </ul>
    </details>
  {% endif %}
{% endmacro %}

{% macro assetRow(asset, isArchived, submittedSelectedAssetIds, project, context, contextFields, renameFailure, _csrf) %}
  {% set renameAttempt = renameFailure and renameFailure.assetId == asset.id %}
  <tr{% if not asset.is_present %} class="is-missing"{% endif %}>
    {% if not isArchived %}
      <td class="asset-select-cell">
        {% if asset.is_present %}
          <input type="checkbox" form="bulk-select-form" name="selectedAssetIds" value="{{ asset.id }}"
                 aria-label="Select {{ asset.filename }}"
                 {% if (asset.id ~ '') in submittedSelectedAssetIds %}checked{% endif %}>
        {% else %}
          <input type="checkbox" disabled aria-label="{{ asset.filename }} is missing at last scan and cannot be selected">
        {% endif %}
      </td>
    {% endif %}
    <td class="asset-thumb-cell">
      {% if asset.hasThumbnail %}
        <span class="asset-thumb" data-preview-enhancement data-preview-state="loading">
          <img class="asset-thumb-image"
               src="{{ asset.thumbnail_url }}"
               alt=""
               loading="lazy"
               decoding="async"
               width="48"
               height="48"
               data-preview-image>
          <span class="asset-thumb-fallback" data-preview-fallback hidden>{{ asset.typeLabel }}</span>
        </span>
      {% elif not asset.is_present %}
        <span class="asset-thumb-missing" aria-hidden="true">—</span>
      {% else %}
        <span class="asset-thumb-type">{{ asset.typeLabel }}</span>
      {% endif %}
    </td>
    <td class="asset-file-cell">
      <a class="asset-file-link" href="{{ asset.viewerUrl }}">{{ asset.filename }}</a>
      {% if asset.locationLabel %}<br><small class="asset-location">{{ asset.locationLabel }}</small>{% endif %}
    </td>
    <td class="asset-category-cell">
      {{ asset.categoryLabel }}
      {% if asset.categoryDisabled %}<em class="asset-category-disabled-marker">(disabled)</em>{% endif %}
    </td>
    <td><span class="asset-type-label">{{ asset.typeLabel }}</span></td>
    <td>
      {% if asset.is_present %}
        {% set status = 'present' %}{% include "partials/status-badge.njk" %}
      {% else %}
        {% set status = 'missing-at-last-scan' %}{% include "partials/status-badge.njk" %}
      {% endif %}
    </td>
    <td class="asset-release-usage-cell">
      {{ releaseUsageInline(asset) }}
    </td>
    <td class="asset-actions-cell">
      <span class="row-actions">
        <a class="button button-small" href="{{ asset.viewerUrl }}">View details</a>
        {% if not isArchived and asset.is_present %}
          <form method="post" action="/projects/{{ project.id }}/assets/{{ asset.id }}/rename" class="row-rename-form">
            <input type="hidden" name="_csrf" value="{{ _csrf }}">
            <input type="hidden" name="origin" value="assets">
            {% for key in contextFields %}
              {% if context[key] is not none and context[key] != '' %}
                <input type="hidden" name="{{ key }}" value="{{ context[key] }}">
              {% endif %}
            {% endfor %}
            <input type="text" name="filename" value="{% if renameAttempt %}{{ renameFailure.submittedFilename }}{% else %}{{ asset.filename }}{% endif %}"
                   class="row-rename-input" required maxlength="255"
                   aria-label="New filename for {{ asset.filename }}" autocomplete="off">
            <button type="submit" class="button button-small">Rename</button>
          </form>
          {% if renameAttempt %}
            <span class="asset-action-error" role="alert">{{ renameFailure.message }}</span>
          {% endif %}
        {% endif %}
      </span>
    </td>
  </tr>
{% endmacro %}

{% macro assetCard(asset, isArchived, submittedSelectedAssetIds, project, context, contextFields, renameFailure, _csrf) %}
  {% set renameAttempt = renameFailure and renameFailure.assetId == asset.id %}
  <li class="asset-grid-item{% if not asset.is_present %} is-missing{% endif %}">
    <article class="asset-card" data-asset-id="{{ asset.id }}">
      <div class="asset-card-top">
        {% if not isArchived %}
          {% if asset.is_present %}
            <input type="checkbox" form="bulk-select-form" id="asset-card-select-{{ asset.id }}" name="selectedAssetIds" value="{{ asset.id }}"
                   aria-label="Select {{ asset.filename }}"
                   {% if (asset.id ~ '') in submittedSelectedAssetIds %}checked{% endif %}>
          {% else %}
            <input type="checkbox" id="asset-card-select-{{ asset.id }}" disabled aria-label="{{ asset.filename }} is missing at last scan and cannot be selected">
          {% endif %}
        {% endif %}
        {% if asset.is_present %}
          {% set status = 'present' %}{% include "partials/status-badge.njk" %}
        {% else %}
          {% set status = 'missing-at-last-scan' %}{% include "partials/status-badge.njk" %}
        {% endif %}
      </div>

      <div class="asset-card-media"{% if asset.hasThumbnail %} data-preview-enhancement data-preview-state="loading"{% endif %}>
        {% if asset.hasThumbnail %}
          <img class="asset-card-thumb"
               src="{{ asset.thumbnail_url }}"
               alt="{{ asset.previewAltText }}"
               loading="lazy"
               decoding="async"
               data-preview-image>
          <span class="asset-card-placeholder asset-card-fallback" data-preview-fallback hidden>{{ asset.typeLabel }}</span>
        {% elif not asset.is_present %}
          <span class="asset-card-placeholder asset-card-placeholder-missing">Missing at last scan</span>
        {% elif asset.preview_state == 'unsupported' %}
          <span class="asset-card-placeholder">{{ asset.typeLabel }} — preview not supported</span>
        {% else %}
          <span class="asset-card-placeholder">Preview unavailable</span>
        {% endif %}
      </div>

      <div class="asset-card-body">
        <a class="asset-card-filename" href="{{ asset.viewerUrl }}">{{ asset.filename }}</a>
        <span class="asset-card-category">
          {{ asset.categoryLabel }}
          {% if asset.categoryDisabled %}<em class="asset-category-disabled-marker">(disabled)</em>{% endif %}
          {% if asset.locationLabel %} · {{ asset.locationLabel }}{% endif %}
        </span>
        <span class="asset-card-meta">{{ asset.typeLabel }} · {{ asset.formattedSize }}</span>
        <span class="asset-card-usage">{{ releaseUsageInline(asset) }}</span>
        <a class="button button-small asset-card-view" href="{{ asset.viewerUrl }}">View details</a>
        {% if not isArchived and asset.is_present %}
          <form method="post" action="/projects/{{ project.id }}/assets/{{ asset.id }}/rename" class="asset-card-rename-form">
            <input type="hidden" name="_csrf" value="{{ _csrf }}">
            <input type="hidden" name="origin" value="assets">
            {% for key in contextFields %}
              {% if context[key] is not none and context[key] != '' %}
                <input type="hidden" name="{{ key }}" value="{{ context[key] }}">
              {% endif %}
            {% endfor %}
            <input type="text" name="filename" value="{% if renameAttempt %}{{ renameFailure.submittedFilename }}{% else %}{{ asset.filename }}{% endif %}"
                   class="asset-card-rename-input" required maxlength="255"
                   aria-label="New filename for {{ asset.filename }}" autocomplete="off">
            <button type="submit" class="button button-small">Rename</button>
          </form>
          {% if renameAttempt %}
            <span class="asset-action-error" role="alert">{{ renameFailure.message }}</span>
          {% endif %}
        {% endif %}
      </div>
    </article>
  </li>
{% endmacro %}

{% set page_title = "Assets — " + project.title %}

{% block content %}
  {% set assetsHeadingDescription = "Browse scanned files, category, and release usage." %}
  {% if project.archived_at %}
    {% call pageHeading.render(assetsHeadingDescription, "archived") %}
      <a class="button" href="/projects/{{ project.id }}">Back to Project</a>
    {% endcall %}
  {% else %}
    {% call pageHeading.render(assetsHeadingDescription) %}
    {% if not project.archived_at %}
      <form method="post" action="/projects/{{ project.id }}/scan" class="inline-form">
        <input type="hidden" name="_csrf" value="{{ _csrf }}">
        {% for key in contextFields %}
          {% if context[key] is not none and context[key] != '' %}
            <input type="hidden" name="{{ key }}" value="{{ context[key] }}">
          {% endif %}
        {% endfor %}
        <button class="button button-primary" type="submit">Scan Now</button>
      </form>
    {% endif %}
    <a class="button" href="/projects/{{ project.id }}">Back to Project</a>
    {% endcall %}
  {% endif %}

  {% if project.archived_at %}
    {% set noticeVariant = "warning" %}
    {% set noticeText = "This project is archived. Asset browsing is read-only and scanning is not available." %}
    {% include "partials/notice.njk" %}
  {% endif %}

  {% if query.scan_result == 'ok' %}
    <div class="scan-success">
      <p>
        Scan complete — Added: {{ query.added }}, Updated: {{ query.updated }}, Missing: {{ query.missing }}.
        {{ query.total }} total assets.
      </p>
    </div>
  {% endif %}

  {% if bulkNotice %}
    <div class="scan-success">
      <p>
        Added {{ bulkNotice.added }} asset{% if bulkNotice.added != 1 %}s{% endif %} to the release.
        {% if bulkNotice.alreadyAssociated > 0 %}
          {{ bulkNotice.alreadyAssociated }} were already associated and were skipped.
        {% endif %}
      </p>
    </div>
  {% endif %}

  {% if bulkError %}
    {% set noticeVariant = "danger" %}
    {% set noticeText = bulkError.message %}
    {% include "partials/notice.njk" %}
  {% endif %}

  {% if moveNotice %}
    <div class="scan-success">
      <p>
        Moved {{ moveNotice.movedCount }} asset{% if moveNotice.movedCount != 1 %}s{% endif %}.
      </p>
    </div>
  {% endif %}

  {% if assetActionNotice %}
    {% set noticeVariant = "success" %}
    {% set noticeText = assetActionNotice.message %}
    {% include "partials/notice.njk" %}
  {% endif %}

  {% if bulkMoveError %}
    {% set noticeVariant = "danger" %}
    {% set noticeText = bulkMoveError.message %}
    {% include "partials/notice.njk" %}
  {% endif %}

  {% if error %}
    {% set noticeVariant = "danger" %}
    {% set noticeText = "Scan failed. The project directory may be missing or inaccessible." %}
    {% include "partials/notice.njk" %}
  {% endif %}

  {% if archivedError %}
    {% set noticeVariant = "warning" %}
    {% set noticeText = "Scanning is not available for archived projects." %}
    {% include "partials/notice.njk" %}
  {% endif %}

  <p class="results-meta">
    {{ total }} asset{% if total != 1 %}s{% endif %} found
    {% if filters.search or filters.extension or filters.presence != 'all' or filters.usage != 'all' or filters.category != 'all' %}
      (filtered)
    {% endif %}
  </p>

  <p class="scan-freshness">
    Asset presence reflects the last completed scan — files are not checked live, and CreatorCrate never deletes
    files on disk. "Missing at last scan" means the file was not found during the last completed scan, not that it
    was removed by CreatorCrate. Disabled categories are still scanned — disabling a category only hides it from
    this navigation, it does not stop CreatorCrate from indexing files inside it.
  </p>

  <div class="asset-browser-layout">
    <nav class="asset-browser-nav" aria-label="Asset categories">
      <ul class="asset-browser-nav-list">
        <li>
          <a href="{{ pageUrl({ category: 'all', presence: 'all', page: 1 }) }}"
             {% if categoryNavigation.allActive %}aria-current="page"{% endif %}>
            <span class="asset-nav-label">All Assets</span>
            <span class="asset-nav-count">{{ categoryNavigation.totalCount }}</span>
          </a>
        </li>
        <li>
          <a href="{{ pageUrl({ category: 'uncategorized', presence: 'all', page: 1 }) }}"
             {% if categoryNavigation.uncategorizedActive %}aria-current="page"{% endif %}>
            <span class="asset-nav-label">Uncategorized</span>
            <span class="asset-nav-count">{{ categoryNavigation.uncategorizedCount }}</span>
          </a>
        </li>
      </ul>

      <div class="asset-browser-nav-section">
        <p class="asset-browser-nav-heading">Categories</p>
        {% if categoryNavigation.enabled.length > 0 %}
          <ul class="asset-browser-nav-list">
            {% for cat in categoryNavigation.enabled %}
              <li>
                <a href="{{ pageUrl({ category: cat.id, presence: 'all', page: 1 }) }}"
                   {% if cat.isActive %}aria-current="page"{% endif %}>
                  <span class="asset-nav-label">{{ cat.displayName }}</span>
                  <span class="asset-nav-count">{{ cat.assetCount }}</span>
                </a>
              </li>
            {% endfor %}
          </ul>
        {% else %}
          <p class="asset-browser-nav-empty">No enabled categories.</p>
        {% endif %}
      </div>

      <div class="asset-browser-nav-section asset-browser-nav-section--disabled">
        <p class="asset-browser-nav-heading">Disabled Categories</p>
        {% if categoryNavigation.disabled.length > 0 %}
          <ul class="asset-browser-nav-list">
            {% for cat in categoryNavigation.disabled %}
              <li>
                <a href="{{ pageUrl({ category: cat.id, presence: 'all', page: 1 }) }}"
                   {% if cat.isActive %}aria-current="page"{% endif %}>
                  <span class="asset-nav-label">{{ cat.displayName }} <em class="asset-nav-disabled-marker">(disabled)</em></span>
                  <span class="asset-nav-count">{{ cat.assetCount }}</span>
                </a>
              </li>
            {% endfor %}
          </ul>
        {% else %}
          <p class="asset-browser-nav-empty">No disabled categories.</p>
        {% endif %}
      </div>

      <ul class="asset-browser-nav-list">
        <li>
          <a href="{{ pageUrl({ category: 'all', presence: 'missing', page: 1 }) }}"
             {% if categoryNavigation.missingActive %}aria-current="page"{% endif %}>
            <span class="asset-nav-label">Missing Assets</span>
            <span class="asset-nav-count">{{ categoryNavigation.missingCount }}</span>
          </a>
        </li>
      </ul>

      <a class="asset-browser-nav-manage" href="/projects/{{ project.id }}/asset-categories">Manage Categories</a>
    </nav>

    <div class="asset-browser-content">
      <nav class="view-switcher" aria-label="Asset display">
        <a class="view-switcher-option" href="{{ pageUrl({ view: 'list' }) }}"
           {% if filters.view != 'grid' %}aria-current="page"{% endif %}>List</a>
        <a class="view-switcher-option" href="{{ pageUrl({ view: 'grid' }) }}"
           {% if filters.view == 'grid' %}aria-current="page"{% endif %}>Grid</a>
      </nav>

      <form class="filters" method="get" action="/projects/{{ project.id }}/assets">
        {% if filters.view != 'list' %}
          <input type="hidden" name="view" value="{{ filters.view }}">
        {% endif %}
        <div class="field">
          <label for="search">Search</label>
          <input id="search" name="search" type="search" value="{{ filters.search or '' }}" maxlength="{{ searchMaxLength }}">
        </div>

        <div class="field">
          <label for="category">Category</label>
          <select id="category" name="category">
            <option value="all" {% if filters.category == 'all' %}selected{% endif %}>All categories</option>
            <option value="uncategorized" {% if filters.category == 'uncategorized' %}selected{% endif %}>Uncategorized</option>
            {% for cat in categoryNavigation.enabled %}
              <option value="{{ cat.id }}" {% if filters.category == cat.id %}selected{% endif %}>{{ cat.displayName }}</option>
            {% endfor %}
            {% for cat in categoryNavigation.disabled %}
              <option value="{{ cat.id }}" {% if filters.category == cat.id %}selected{% endif %}>{{ cat.displayName }} (disabled)</option>
            {% endfor %}
          </select>
        </div>

        <div class="field">
          <label for="extension">Extension</label>
          <select id="extension" name="extension">
            <option value="" {% if not filters.extension %}selected{% endif %}>All extensions</option>
            {% for choice in extensionChoices %}
              <option value="{{ choice.value }}" {% if choice.selected %}selected{% endif %}>.{{ choice.label }}</option>
            {% endfor %}
          </select>
        </div>

        <div class="field">
          <label for="presence">Show</label>
          <select id="presence" name="presence">
            <option value="all" {% if filters.presence == 'all' %}selected{% endif %}>All assets</option>
            <option value="present" {% if filters.presence == 'present' %}selected{% endif %}>Present at last scan</option>
            <option value="missing" {% if filters.presence == 'missing' %}selected{% endif %}>Missing at last scan</option>
          </select>
        </div>

        <div class="field">
          <label for="usage">Usage</label>
          <select id="usage" name="usage">
            <option value="all" {% if filters.usage == 'all' %}selected{% endif %}>All assets</option>
            <option value="used" {% if filters.usage == 'used' %}selected{% endif %}>Used by a release</option>
            <option value="unused" {% if filters.usage == 'unused' %}selected{% endif %}>Not used by a release</option>
          </select>
        </div>

        <div class="field">
          <label for="sort">Sort by</label>
          <select id="sort" name="sort">
            <option value="filename" {% if filters.sort == 'filename' %}selected{% endif %}>Filename</option>
            <option value="modified" {% if filters.sort == 'modified' %}selected{% endif %}>Modified date</option>
            <option value="size" {% if filters.sort == 'size' %}selected{% endif %}>File size</option>
            <option value="category" {% if filters.sort == 'category' %}selected{% endif %}>Category &amp; location</option>
          </select>
        </div>

        <div class="field">
          <label for="order">Order</label>
          <select id="order" name="order">
            <option value="asc" {% if filters.order == 'asc' %}selected{% endif %}>Ascending</option>
            <option value="desc" {% if filters.order == 'desc' %}selected{% endif %}>Descending</option>
          </select>
        </div>

        <button class="button" type="submit">Filter</button>
        <a class="button button-secondary" href="{{ pageUrl({ search: '', extension: '', presence: 'all', usage: 'all', category: 'all', sort: 'filename', order: 'asc', page: 1, pageSize: 25 }) }}">Reset</a>
      </form>

      {% if assets.length > 0 %}
        {% if not isArchived %}
          {# bulk-select-form wraps only the toolbar. Checkboxes in the table
             below are associated via form="bulk-select-form" so that per-row
             rename forms can live inside the table without nesting issues.
             The Move button uses formaction to submit to move-selected while
             still carrying the checked selectedAssetIds. #}
          <form id="bulk-select-form" method="post" action="/projects/{{ project.id }}/assets/add-to-release" class="bulk-select-form" data-asset-selection-form>
            <input type="hidden" name="_csrf" value="{{ _csrf }}">
            {% for key in contextFields %}
              {% if context[key] is not none and context[key] != '' %}
                <input type="hidden" name="{{ key }}" value="{{ context[key] }}">
              {% endif %}
            {% endfor %}

            <p class="selection-scope-note">Selection applies to this page.</p>

            <div class="bulk-toolbar">
              <button type="button" class="button button-small" data-select-all>Select all visible</button>
              <button type="button" class="button button-small button-secondary" data-clear-selection>Clear selection</button>
              <span class="selected-count" data-selected-count>0 selected</span>

              <label class="field bulk-release-field">
                <span>Add to release</span>
                <select name="releaseId" data-release-select>
                  <option value="">Select a release…</option>
                  {% for target in releaseTargets %}
                    <option value="{{ target.id }}"{% if submittedReleaseId == (target.id ~ '') %} selected{% endif %}>{{ target.title }}</option>
                  {% endfor %}
                </select>
              </label>
              <button type="submit" class="button button-primary" data-bulk-submit>Add selected to release</button>

              <span class="bulk-toolbar-divider" aria-hidden="true"></span>

              <label class="field bulk-move-field">
                <span>Move selected to</span>
                <select name="destinationCategory">
                  <option value="uncategorized">Uncategorized</option>
                  {% for cat in categoryNavigation.enabled %}
                    <option value="{{ cat.id }}">{{ cat.displayName }}</option>
                  {% endfor %}
                </select>
              </label>
              <button type="submit" class="button"
                      formaction="/projects/{{ project.id }}/assets/move-selected">Move selected</button>
            </div>
          </form>
        {% endif %}

        {% if filters.view == 'grid' %}
          <ul class="asset-grid">
            {% for asset in assets %}
               {{ assetCard(asset, isArchived, submittedSelectedAssetIds, project, context, contextFields, renameFailure, _csrf) }}
            {% endfor %}
          </ul>
        {% else %}
          <div class="table-scroll" tabindex="0" aria-label="Project assets">
            <table class="data-table asset-table">
              <thead>
                <tr>
                  {% if not isArchived %}<th scope="col"><span class="sr-only">Select</span></th>{% endif %}
                  <th scope="col">Preview</th>
                  <th scope="col">File</th>
                  <th scope="col">Category</th>
                  <th scope="col">Type</th>
                  <th scope="col">Presence</th>
                  <th scope="col">Release usage</th>
                  <th scope="col">Actions</th>
                </tr>
              </thead>
              <tbody>
                {% for asset in assets %}
                   {{ assetRow(asset, isArchived, submittedSelectedAssetIds, project, context, contextFields, renameFailure, _csrf) }}
                {% endfor %}
              </tbody>
            </table>
          </div>
        {% endif %}

        {# Pagination #}
        {% if pageCount > 1 %}
          <nav class="pagination" aria-label="Asset list pages">
            {% if page > 1 %}
              <a href="{{ pageUrl({ page: page - 1 }) }}" class="pagination-prev">← Prev</a>
            {% endif %}

            <span class="pagination-info">Page {{ page }} of {{ pageCount }}</span>

            {% if page < pageCount %}
              <a href="{{ pageUrl({ page: page + 1 }) }}" class="pagination-next">Next →</a>
            {% endif %}
          </nav>

          <form class="page-size-form" method="get" action="/projects/{{ project.id }}/assets">
            <label for="pageSize">Assets per page:</label>
            <select id="pageSize" name="pageSize" data-autosubmit>
              <option value="10" {% if pageSize == 10 %}selected{% endif %}>10</option>
              <option value="25" {% if pageSize == 25 %}selected{% endif %}>25</option>
              <option value="50" {% if pageSize == 50 %}selected{% endif %}>50</option>
              <option value="100" {% if pageSize == 100 %}selected{% endif %}>100</option>
            </select>
            {# Preserve current filters in pageSize form #}
            {% if filters.category != 'all' %}
              <input type="hidden" name="category" value="{{ filters.category }}">
            {% endif %}
            {% if filters.search %}
              <input type="hidden" name="search" value="{{ filters.search }}">
            {% endif %}
            {% if filters.extension %}
              <input type="hidden" name="extension" value="{{ filters.extension }}">
            {% endif %}
            {% if filters.presence != 'all' %}
              <input type="hidden" name="presence" value="{{ filters.presence }}">
            {% endif %}
            {% if filters.usage != 'all' %}
              <input type="hidden" name="usage" value="{{ filters.usage }}">
            {% endif %}
            {% if filters.sort != 'filename' %}
              <input type="hidden" name="sort" value="{{ filters.sort }}">
            {% endif %}
            {% if filters.order != 'asc' %}
              <input type="hidden" name="order" value="{{ filters.order }}">
            {% endif %}
            {% if filters.view != 'list' %}
              <input type="hidden" name="view" value="{{ filters.view }}">
            {% endif %}
            <button class="button button-small" type="submit">Apply</button>
          </form>
        {% endif %}
      {% elseif emptyState %}
        {% set emptyHeading = emptyState.heading %}
        {% set emptyDescription = emptyState.description %}
        {% set emptyHeadingLevel = "h2" %}
        {# The 'no-assets' cases direct the user to the existing authenticated,
           CSRF-protected POST "Scan Now" form already rendered in the page
           heading above — no separate action link here. A GET anchor cannot
           perform a scan, so no-assets/no-assets-archived intentionally omit
           emptyActionUrl/emptyActionLabel. #}
        {% if emptyState.kind != 'no-assets' and emptyState.kind != 'no-assets-archived' %}
          {% set emptyActionUrl = pageUrl({ search: '', extension: '', presence: 'all', usage: 'all', category: 'all', sort: 'filename', order: 'asc', page: 1, pageSize: 25 }) %}
          {% set emptyActionLabel = "Reset Filters" %}
        {% endif %}
        {% include "partials/empty-state.njk" %}
      {% endif %}
    </div>
  </div>
{% endblock %}
