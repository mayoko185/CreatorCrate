{% extends "layout.njk" %}
{% import "partials/page-heading.njk" as pageHeading %}
{% import "partials/icons.njk" as icons %}
{% import "partials/asset-presentation.njk" as assetPresentation %}
{% import "partials/view-switcher.njk" as viewSwitcher %}
{% import "partials/dialog.njk" as dialog %}

{% macro renderFilterSummary(selectedValues, options, emptyLabel, countLabel, prefix) -%}
  {%- if selectedValues.length == 0 -%}
    {{ emptyLabel }}
  {%- elif selectedValues.length == 1 -%}
    {%- for option in options -%}
      {%- if option.selected -%}
        {{ prefix or '' }}{{ option.label or option.displayName }}
      {%- endif -%}
    {%- endfor -%}
  {%- else -%}
    {{ selectedValues.length }} {{ countLabel }} selected
  {%- endif -%}
{%- endmacro %}

{% macro renderContextFields(context, contextFields, disabled) %}
  {% for key in contextFields %}
    {% set fieldValue = context[key] %}
    {% if fieldValue is not none and fieldValue != '' %}
      {% if fieldValue is iterable and fieldValue is not string %}
        {% for value in fieldValue %}
          {% if value is not none and value != '' %}
            <input type="hidden" name="{{ key }}" value="{{ value }}"{% if disabled %} disabled{% endif %}>
          {% endif %}
        {% endfor %}
      {% else %}
        <input type="hidden" name="{{ key }}" value="{{ fieldValue }}"{% if disabled %} disabled{% endif %}>
      {% endif %}
    {% endif %}
  {% endfor %}
{% endmacro %}

{% macro releaseUsageInline(asset) %}
  {% if asset.releaseSummary.mode == 'none' %}
    <span class="asset-indicator asset-icon-control asset-tooltip asset-indicator--unused" role="img" tabindex="0"
          aria-label="Not used by a release" data-tooltip="Not used by a release">U</span>
  {% elif asset.releaseSummary.mode == 'single' %}
    {% set usage = asset.releaseSummary.releases[0] %}
    <a class="asset-indicator asset-icon-control asset-tooltip asset-indicator--used" href="/releases/{{ usage.release_id }}"
       aria-label="Used in release {{ usage.title }} ({{ usage.role | title }})"
       data-tooltip="Used in release">R</a>
  {% else %}
    <details class="release-usage-details asset-usage-details">
      <summary class="asset-indicator asset-icon-control asset-tooltip asset-indicator--used"
                aria-label="Used in {{ asset.releaseSummary.count }} releases"
                 data-tooltip="Used in multiple releases">R</summary>
      <ul class="release-detail-list">
        {% for usage in asset.releaseSummary.releases %}
          <li>
            <a href="/releases/{{ usage.release_id }}">{{ usage.title }}</a>
            <span class="release-role">{{ usage.role | title }}</span>
          </li>
        {% endfor %}
      </ul>
    </details>
  {% endif %}
{% endmacro %}

{% macro assetRow(asset, isArchived, submittedSelectedAssetIds, project, context, contextFields, renameFailure, _csrf, autoRenameSurface, autoRenameInitialIndex, autoRenameTotal) %}
  {% set renameAttempt = renameFailure and renameFailure.assetId == asset.id %}
  <tr{% if not asset.is_present %} class="is-missing"{% endif %}{% if autoRenameSurface %}
      data-auto-rename-asset
      data-auto-rename-asset-id="{{ asset.id }}"
      data-auto-rename-initial-index="{{ autoRenameInitialIndex }}"
      draggable="true"
      tabindex="0"
      aria-grabbed="false"
      aria-posinset="{{ autoRenameInitialIndex + 1 }}"
      aria-setsize="{{ autoRenameTotal }}"
      aria-label="Reorder {{ asset.filename }}"
      aria-describedby="auto-rename-instructions"{% endif %}>
    {% if not isArchived %}
      <td class="asset-select-cell">
        {% if asset.is_present %}
          <input type="checkbox" form="bulk-select-form" name="selectedAssetIds" value="{{ asset.id }}"
                 class="asset-select-checkbox"
                 aria-label="Select {{ asset.filename }}"
                 {% if (asset.id ~ '') in submittedSelectedAssetIds %}checked{% endif %}>
        {% else %}
          <input type="checkbox" disabled aria-label="{{ asset.filename }} is missing at last scan and cannot be selected">
        {% endif %}
      </td>
    {% endif %}
    {% if autoRenameSurface %}
      <td class="asset-auto-rename-order-cell">
        <span class="auto-rename-order-indicator" data-auto-rename-order-indicator>{{ autoRenameInitialIndex + 1 }} of {{ autoRenameTotal }}</span>
      </td>
    {% endif %}
    <td class="asset-thumb-cell">
      {% if asset.hasThumbnail %}
        <a class="asset-thumb-link" href="{{ asset.viewerUrl }}" aria-label="View details for {{ asset.filename }}">
          <span class="asset-thumb{% if asset.preview.kind == 'krita' %} asset-media--krita{% endif %}" data-preview-enhancement data-preview-state="loading">
            <img class="asset-thumb-image{% if asset.nsfwBlur %} asset-image--nsfw-blurred{% endif %}"
                 src="{{ asset.thumbnail_url }}"
                 alt=""
                 loading="lazy"
                 decoding="async"
                 {% if asset.preview.kind != 'krita' %}width="48" height="48"{% endif %}
                 data-preview-image>
            <span class="asset-thumb-fallback" data-preview-fallback hidden>{{ asset.typeLabel }}</span>
          </span>
        </a>
      {% elif not asset.is_present %}
        <span class="asset-thumb-missing" aria-hidden="true">—</span>
      {% else %}
        <span class="asset-thumb-type">{{ asset.typeLabel }}</span>
      {% endif %}
    </td>
    <td class="asset-file-cell">
      <a class="asset-file-link" href="{{ asset.viewerUrl }}">{{ asset.displayFilename }}</a>
      {% if asset.locationLabel %}<br><small class="asset-location">{{ asset.locationLabel }}</small>{% endif %}
    </td>
    <td class="asset-category-cell">
      {{ asset.categoryLabel }}
      {% if asset.categoryDisabled %}<em class="asset-category-disabled-marker">(disabled)</em>{% endif %}
    </td>
    <td class="asset-tags-cell">
      {% if asset.tags and asset.tags.length > 0 %}
        <ul class="asset-tag-list" aria-label="Assigned tags">
          {% for tag in asset.tags %}
            <li>{{ tag.displayName }}</li>
          {% endfor %}
        </ul>
      {% endif %}
    </td>
    <td><span class="asset-type-label">{{ asset.typeLabel }}</span></td>
    <td>
      {% if asset.is_present %}
        <span class="asset-indicator asset-icon-control asset-tooltip asset-indicator--present" role="img" tabindex="0"
              aria-label="{{ asset.presenceLabel }}" data-tooltip="{{ asset.presenceLabel }}">P</span>
      {% else %}
        <span class="asset-indicator asset-icon-control asset-tooltip asset-indicator--missing" role="img" tabindex="0"
              aria-label="{{ asset.presenceLabel }}" data-tooltip="{{ asset.presenceLabel }}">!</span>
      {% endif %}
    </td>
    <td class="asset-release-usage-cell">
      {{ releaseUsageInline(asset) }}
    </td>
    <td class="asset-actions-cell">
      <span class="row-actions">
        <a class="asset-details-link asset-tooltip" href="{{ asset.viewerUrl }}"
           aria-label="View details for {{ asset.filename }}" data-tooltip="View asset details">
          {{ icons.icon('details') }}<span class="sr-only">View details</span>
        </a>
        {% if not isArchived and asset.is_present %}
          <form method="post" action="/projects/{{ project.id }}/assets/{{ asset.id }}/rename" class="row-rename-form">
            <input type="hidden" name="_csrf" value="{{ _csrf }}">
            <input type="hidden" name="origin" value="assets">
            {{ renderContextFields(context, contextFields, false) }}
            <input type="text" name="filename" value="{% if renameAttempt %}{{ renameFailure.submittedFilename }}{% else %}{{ asset.displayFilename }}{% endif %}"
                   class="row-rename-input" required maxlength="255"
                   aria-label="New basename for {{ asset.filename }}" autocomplete="off">
            {% if asset.extension %}<span class="asset-rename-extension" aria-hidden="true">.{{ asset.extension }}</span>{% endif %}
            <button type="submit" class="button button-small">Rename</button>
          </form>
          {% if renameAttempt %}
            <span class="asset-action-error" role="alert">{{ renameFailure.message }}</span>
          {% endif %}
        {% endif %}
      </span>
    </td>
  </tr>
{% endmacro %}

{% macro assetCard(asset, isArchived, submittedSelectedAssetIds, project, context, contextFields, renameFailure, _csrf, autoRenameSurface, autoRenameInitialIndex, autoRenameTotal) %}
  {% set renameAttempt = renameFailure and renameFailure.assetId == asset.id %}
  {% set selected = (asset.id ~ '') in submittedSelectedAssetIds %}
  <li class="asset-grid-item{% if not asset.is_present %} is-missing{% endif %}"{% if autoRenameSurface %}
      data-auto-rename-asset
      data-auto-rename-asset-id="{{ asset.id }}"
      data-auto-rename-initial-index="{{ autoRenameInitialIndex }}"
      draggable="true"
      tabindex="0"
      aria-grabbed="false"
      aria-posinset="{{ autoRenameInitialIndex + 1 }}"
      aria-setsize="{{ autoRenameTotal }}"
      aria-label="Reorder {{ asset.filename }}"
      aria-describedby="auto-rename-instructions"{% endif %}>
    {% call(slot) assetPresentation.gridCard(asset, {
      selected: selected,
      selectable: not isArchived and asset.is_present,
      selectableTabIndex: not autoRenameSurface,
      titleRowHidden: renameAttempt,
      nsfwBlur: asset.nsfwBlur
    }) %}
      {% if slot == 'top-start' %}
        {% if not isArchived %}
          {% if asset.is_present %}
            <label class="asset-selection-control{% if selected %} is-selected{% endif %}" for="asset-card-select-{{ asset.id }}">
              <input type="checkbox" form="bulk-select-form" id="asset-card-select-{{ asset.id }}" name="selectedAssetIds" value="{{ asset.id }}"
                     class="asset-select-checkbox"
                     aria-label="Select {{ asset.filename }}"
                     {% if selected %}checked{% endif %}>
              <span class="asset-selection-control-mark" aria-hidden="true">✓</span>
            </label>
          {% else %}
            <label class="asset-selection-control is-disabled" for="asset-card-select-{{ asset.id }}">
              <input type="checkbox" id="asset-card-select-{{ asset.id }}" disabled aria-label="{{ asset.filename }} is missing at last scan and cannot be selected">
              <span class="asset-selection-control-mark" aria-hidden="true">✓</span>
            </label>
          {% endif %}
        {% endif %}
        {% if autoRenameSurface %}
          <span class="auto-rename-order-indicator" data-auto-rename-order-indicator>{{ autoRenameInitialIndex + 1 }} of {{ autoRenameTotal }}</span>
        {% endif %}
      {% elif slot == 'top-end' %}
        <span class="asset-card-usage">{{ releaseUsageInline(asset) }}</span>
      {% elif slot == 'title-row' %}
        {% if not isArchived and asset.is_present %}
          <a class="button button-small asset-rename-trigger" data-asset-rename-trigger
             href="{{ asset.viewerUrl }}" aria-label="Rename {{ asset.filename }}">Rename</a>
        {% endif %}
      {% elif slot == 'title-controls' %}
        {% if not isArchived and asset.is_present %}
          <form method="post" action="/projects/{{ project.id }}/assets/{{ asset.id }}/rename"
                class="asset-card-rename-editor" data-asset-rename-editor{% if not renameAttempt %} hidden inert{% endif %}>
            <input type="hidden" name="_csrf" value="{{ _csrf }}"{% if not renameAttempt %} disabled{% endif %}>
            <input type="hidden" name="origin" value="assets"{% if not renameAttempt %} disabled{% endif %}>
            {{ renderContextFields(context, contextFields, not renameAttempt) }}
            <span class="asset-card-rename-field{% if asset.extension %} has-extension{% endif %}">
              <input type="text" name="filename" value="{% if renameAttempt %}{{ renameFailure.submittedFilename }}{% else %}{{ asset.displayFilename }}{% endif %}"
                     class="asset-card-rename-input" data-asset-rename-input required maxlength="255"
                     aria-label="New basename for {{ asset.filename }}" autocomplete="off"{% if not renameAttempt %} disabled{% endif %}>
              {% if asset.extension %}<span class="asset-rename-extension" aria-hidden="true">.{{ asset.extension }}</span>{% endif %}
            </span>
            <button type="submit" class="button button-small" data-asset-rename-confirm{% if not renameAttempt %} disabled{% endif %}>Confirm</button>
            <button type="button" class="button button-small button-secondary" data-asset-rename-cancel{% if not renameAttempt %} disabled{% endif %}>Cancel</button>
          </form>
          {% if renameAttempt %}
            <span class="asset-action-error" role="alert">{{ renameFailure.message }}</span>
          {% endif %}
        {% endif %}
      {% elif slot == 'body' %}
        {% if asset.tags and asset.tags.length > 0 %}
          <ul class="asset-card-tags" aria-label="Assigned tags">
            {% for tag in asset.tags %}
              <li>{{ tag.displayName }}</li>
            {% endfor %}
          </ul>
        {% endif %}
      {% endif %}
    {% endcall %}
  </li>
{% endmacro %}

{% macro assetListCard(asset, isArchived, submittedSelectedAssetIds, project, context, contextFields, renameFailure, _csrf) %}
  {% set renameAttempt = renameFailure and renameFailure.assetId == asset.id %}
  {% set selectionLabel = asset.relative_path or asset.filename %}
  {% set selected = not isArchived and asset.is_present and (asset.id ~ '') in submittedSelectedAssetIds %}
  <li class="asset-list-item{% if not asset.is_present %} is-missing{% endif %}">
    {% call(slot) assetPresentation.listCard(asset, {
      cardClass: 'asset-list-card--project',
      selected: selected,
      selectable: not isArchived and asset.is_present,
      mediaContextLabel: project.title,
      nsfwBlur: asset.nsfwBlur
    }) %}
      {% if slot == 'top' %}
        {% if not isArchived %}
          {% if asset.is_present %}
            <label class="asset-selection-control{% if selected %} is-selected{% endif %}" for="asset-list-card-select-{{ asset.id }}">
              <input type="checkbox" form="bulk-select-form" id="asset-list-card-select-{{ asset.id }}" name="selectedAssetIds" value="{{ asset.id }}"
                     class="asset-select-checkbox"
                     aria-label="Select {{ selectionLabel }}"
                     {% if selected %}checked{% endif %}>
              <span class="asset-selection-control-mark" aria-hidden="true">✓</span>
            </label>
          {% else %}
            <label class="asset-selection-control is-disabled" for="asset-list-card-select-{{ asset.id }}">
              <input type="checkbox" id="asset-list-card-select-{{ asset.id }}" disabled aria-label="{{ selectionLabel }} is missing at last scan and cannot be selected">
              <span class="asset-selection-control-mark" aria-hidden="true">✓</span>
            </label>
          {% endif %}
        {% endif %}
      {% elif slot == 'associations' %}
        <div class="asset-list-card-associations">
          <section class="asset-list-card-association asset-list-card-association--tags">
            <h3 class="asset-list-card-association-label">Tags</h3>
            <div class="asset-list-card-association-content">
              {% if asset.tags and asset.tags.length > 0 %}
                <ul class="asset-tag-list asset-list-card-tags" aria-label="Assigned tags">
                  {% for tag in asset.tags %}
                    <li>{{ tag.displayName }}</li>
                  {% endfor %}
                </ul>
              {% else %}
                <span class="asset-list-card-empty">None assigned</span>
              {% endif %}
            </div>
          </section>
          <section class="asset-list-card-association asset-list-card-association--releases">
            <h3 class="asset-list-card-association-label">Release usage</h3>
            <div class="asset-list-card-association-content">
              {{ releaseUsageInline(asset) }}
            </div>
          </section>
        </div>
      {% elif slot == 'actions' %}
        {% if not isArchived and asset.is_present %}
          <form method="post" action="/projects/{{ project.id }}/assets/{{ asset.id }}/rename" class="row-rename-form asset-list-card-rename-form">
            <input type="hidden" name="_csrf" value="{{ _csrf }}">
            <input type="hidden" name="origin" value="assets">
            {{ renderContextFields(context, contextFields, false) }}
            <input type="text" name="filename" value="{% if renameAttempt %}{{ renameFailure.submittedFilename }}{% else %}{{ asset.displayFilename }}{% endif %}"
                   class="row-rename-input asset-list-card-rename-input" required maxlength="255"
                   aria-label="New basename for {{ asset.filename }}" autocomplete="off">
            {% if asset.extension %}<span class="asset-rename-extension" aria-hidden="true">.{{ asset.extension }}</span>{% endif %}
            <button type="submit" class="button button-small">Rename</button>
          </form>
          {% if renameAttempt %}
            <span class="asset-action-error" role="alert">{{ renameFailure.message }}</span>
          {% endif %}
        {% endif %}
      {% endif %}
    {% endcall %}
  </li>
{% endmacro %}

{% set page_title = "Assets — " + project.title %}

{% block content %}
  {% set assetsHeadingDescription = "Browse scanned files, category, and release usage." %}
  {% if project.archived_at %}
    {% call pageHeading.render(assetsHeadingDescription, "archived") %}
      <a class="button button-secondary" href="/projects/{{ project.id }}/asset-categories">Manage Categories</a>
      <a class="button" href="/projects/{{ project.id }}">Back to Project</a>
      {% if openLocallyUri %}
        <a class="button button-secondary" href="{{ openLocallyUri }}">Open locally</a>
      {% endif %}
    {% endcall %}
  {% else %}
    {% call pageHeading.render(assetsHeadingDescription) %}
    {% if not project.archived_at %}
      <form method="post" action="/projects/{{ project.id }}/scan" class="inline-form">
        <input type="hidden" name="_csrf" value="{{ _csrf }}">
        {{ renderContextFields(context, contextFields, false) }}
        <button class="button button-primary" type="submit">Scan Now</button>
        </form>
      {% if categoryNavigation.missingCount > 0 %}
        <a class="button button-danger" href="{{ removeMissingAssetsDialogUrl }}"
           data-dialog-open="remove-missing-assets-dialog">Remove missing assets</a>
      {% endif %}
      <a class="button" href="/projects/{{ project.id }}/edit">Edit project</a>
      {% endif %}
    <a class="button button-secondary" href="/projects/{{ project.id }}/asset-categories">Manage Categories</a>
    <a class="button" href="/projects/{{ project.id }}">Back to Project</a>
    {% if openLocallyUri %}
      <a class="button button-secondary" href="{{ openLocallyUri }}">Open locally</a>
    {% endif %}
    {% endcall %}
  {% endif %}

  {% if project.archived_at %}
    {% set noticeVariant = "warning" %}
    {% set noticeText = "This project is archived. Asset browsing is read-only and scanning is not available." %}
    {% include "partials/notice.njk" %}
  {% endif %}

  {% if query.scan_result == 'ok' %}
    <div class="scan-success">
      <p>
        Scan complete — Added: {{ query.added }}, Updated: {{ query.updated }}, Missing: {{ query.missing }}.
        {{ query.total }} total assets.
      </p>
    </div>
  {% endif %}

  {% if bulkNotice %}
    <div class="scan-success">
      <p>
        Added {{ bulkNotice.added }} asset{% if bulkNotice.added != 1 %}s{% endif %} to the release.
        {% if bulkNotice.alreadyAssociated > 0 %}
          {{ bulkNotice.alreadyAssociated }} were already associated and were skipped.
        {% endif %}
      </p>
    </div>
  {% endif %}

  {% if bulkError %}
    {% set noticeVariant = "danger" %}
    {% set noticeText = bulkError.message %}
    {% include "partials/notice.njk" %}
  {% endif %}

  {% if moveNotice %}
    <div class="scan-success">
      <p>
        Moved {{ moveNotice.movedCount }} asset{% if moveNotice.movedCount != 1 %}s{% endif %}.
      </p>
    </div>
  {% endif %}

  {% if copyNotice %}
    <div class="scan-success">
      <p>
        Copied {{ copyNotice.copiedCount }} asset{% if copyNotice.copiedCount != 1 %}s{% endif %}.
      </p>
    </div>
  {% endif %}

  {% if deleteNotice %}
    <div class="scan-success">
      <p>
        Deleted {{ deleteNotice.deletedCount }} asset{% if deleteNotice.deletedCount != 1 %}s{% endif %}.
      </p>
    </div>
  {% endif %}

  {% if query.missing_cleanup == 'ok' %}
    <div class="scan-success">
      <p>
        Missing asset cleanup complete: removed {{ query.missing_removed }} of {{ query.missing_candidates }} missing asset record{% if query.missing_candidates != '1' %}s{% endif %}.
        {% if query.missing_protected != '0' %}
          Kept {{ query.missing_protected }} missing asset record{% if query.missing_protected != '1' %}s{% endif %} protected by published-release rules.
        {% endif %}
      </p>
    </div>
  {% endif %}

  {% if assetActionNotice %}
    {% set noticeVariant = "success" %}
    {% set noticeText = assetActionNotice.message %}
    {% include "partials/notice.njk" %}
  {% endif %}

  {% if autoRenameNotice %}
    {% set noticeVariant = "success" %}
    {% set noticeText = autoRenameNotice.message %}
    {% include "partials/notice.njk" %}
  {% endif %}

  {% if autoRenameError %}
    {% set noticeVariant = "error" %}
    {% set noticeText = autoRenameError.message %}
    {% include "partials/notice.njk" %}
  {% endif %}

  {% if bulkMoveError %}
    {% set noticeVariant = "danger" %}
    {% set noticeText = bulkMoveError.message %}
    {% include "partials/notice.njk" %}
  {% endif %}

  {% if copyError %}
    {% set noticeVariant = "danger" %}
    {% set noticeText = copyError.message %}
    {% include "partials/notice.njk" %}
  {% endif %}

  {% if deleteError %}
    {% set noticeVariant = "danger" %}
    {% set noticeText = deleteError.message %}
    {% include "partials/notice.njk" %}
  {% endif %}

  {% if error %}
    {% set noticeVariant = "danger" %}
    {% set noticeText = "Scan failed. The project directory may be missing or inaccessible." %}
    {% include "partials/notice.njk" %}
  {% endif %}

  {% if archivedError %}
    {% set noticeVariant = "warning" %}
    {% set noticeText = "Scanning is not available for archived projects." %}
    {% include "partials/notice.njk" %}
  {% endif %}

  {% if projectAssetsDefaultsNotice %}
    {% set noticeVariant = "success" %}
    {% set noticeText = projectAssetsDefaultsNotice.message %}
    {% include "partials/notice.njk" %}
  {% endif %}

  {% if projectAssetsNsfwError %}
    {% set noticeVariant = "danger" %}
    {% set noticeText = projectAssetsNsfwError %}
    {% include "partials/notice.njk" %}
  {% endif %}

  <div class="notice notice--success app-dialog-feedback" data-dialog-feedback role="status" hidden>
    <p data-dialog-feedback-text></p>
  </div>

  {% if completeCategorySurface %}
    <p class="results-meta">
      {{ total }} asset{% if total != 1 %}s{% endif %} in the complete {{ autoRenameCategory.displayName if autoRenameCategory else filters.category }} category
    </p>
  {% endif %}

  <div data-project-assets-live-region>
    <span class="sr-only" data-project-assets-live-status aria-live="polite" aria-atomic="true"></span>

  <div class="asset-browser-layout">
    <div class="asset-browser-content">
      {% set categoryFilterSummary = "All categories (" ~ categoryNavigation.totalCount ~ ")" %}
      {% if filters.category == 'all' and filters.presence == 'missing' %}
        {% set categoryFilterSummary = "Missing (" ~ categoryNavigation.missingCount ~ ")" %}
      {% elif filters.category == 'uncategorized' %}
        {% set categoryFilterSummary = "Uncategorized (" ~ categoryNavigation.uncategorizedCount ~ ")" %}
      {% elif filters.category != 'all' %}
        {% for cat in categoryNavigation.enabled %}
          {% if cat.id == filters.category %}{% set categoryFilterSummary = cat.displayName ~ " (" ~ cat.assetCount ~ ")" %}{% endif %}
        {% endfor %}
        {% for cat in categoryNavigation.disabled %}
          {% if cat.id == filters.category %}{% set categoryFilterSummary = cat.displayName ~ " (" ~ cat.assetCount ~ ") (disabled)" %}{% endif %}
        {% endfor %}
      {% endif %}

      <div class="asset-viewer-display-controls">
        {% if filters.view == 'grid' %}
          {% set gridSizeLabelsInteractive = true %}
        {% endif %}
        {{ viewSwitcher.render(filters.view, pageUrl, "Asset display", true) }}

        {% if filters.view == 'grid' %}
          {% include "partials/asset-grid-size-control.njk" %}
        {% endif %}

        <div class="project-filter-actions project-filter-actions--projects">
           <a class="asset-viewer-defaults-link button button-small button-secondary project-filter-control asset-tooltip asset-tooltip--left"
              href="{{ projectAssetsDefaultsUrl }}" aria-label="Project Assets defaults"
              data-dialog-open="project-assets-defaults-dialog" data-tooltip="Project Assets defaults" data-asset-viewer-defaults-link>
            {{ icons.icon('settings') }}
          </a>
          {% set nsfwToggleLabel = "Disable NSFW filter" if nsfwFilterEnabled else "Enable NSFW filter" %}
          <form method="post" action="/projects/{{ project.id }}/assets/nsfw-filter" class="inline-form" data-project-assets-nsfw-filter>
            <input type="hidden" name="_csrf" value="{{ _csrf }}">
            <input type="hidden" name="enabled" value="{{ '0' if nsfwFilterEnabled else '1' }}" data-project-assets-nsfw-value>
            <input type="hidden" name="returnTo" value="{{ projectAssetsNsfwReturnUrl }}">
            <button class="button button-small button-secondary project-filter-control asset-tooltip asset-tooltip--left"
                    id="project-assets-nsfw-toggle" type="submit" data-project-assets-nsfw-toggle
                    aria-pressed="{{ 'true' if nsfwFilterEnabled else 'false' }}"
                    aria-label="{{ nsfwToggleLabel }}" data-tooltip="{{ nsfwToggleLabel }}">
              {{ icons.icon('nsfw-filter') }}
            </button>
          </form>
           <button class="slideshow-trigger button button-small button-secondary project-filter-control asset-tooltip asset-tooltip--left"
                   type="button"
                   aria-label="Start slideshow"
                  data-tooltip="Start slideshow"
                  data-slideshow-trigger>{{ icons.icon('slideshow') }}</button>
            <a class="button button-small button-secondary project-filter-control asset-tooltip asset-tooltip--left"
               href="{{ pageUrl({ search: '', tag: '', extension: '', presence: 'all', usage: 'all', category: 'all', sort: 'filename', order: 'asc', page: 1, pageSize: 25 }) }}"
               aria-label="Reset filters" data-tooltip="Reset filters" data-project-assets-reset>{{ icons.icon('reset') }}<span class="sr-only">Reset</span></a>
        </div>
      </div>

      <form class="filters asset-viewer-filters asset-viewer-filters--project-assets" method="get" action="/projects/{{ project.id }}/assets" id="asset-filters">
        {% if filters.view == 'list' or preserveViewQuery %}
          <input type="hidden" name="view" value="{{ filters.view }}">
        {% endif %}
        {% if pageSize != 25 or preservePageSizeQuery %}
          <input type="hidden" name="pageSize" value="{{ pageSize }}">
        {% endif %}
        <fieldset class="field asset-viewer-filter-field asset-filter-multiselect-field asset-project-category-filter" data-asset-category-filter>
          <legend>Category</legend>
          <details class="asset-filter-multiselect asset-filter-multiselect--sized" data-asset-viewer-filter-disclosure>
            <summary id="asset-category-filter-trigger"
                     aria-controls="asset-category-filter-options"
                     aria-expanded="false"
                     aria-label="Category filter: {{ categoryFilterSummary }}"
                     title="{{ categoryFilterSummary }}">
              <span class="asset-filter-multiselect-summary" data-asset-category-filter-summary>
                <span class="asset-filter-multiselect-summary-current" data-asset-category-filter-current-summary>{{ categoryFilterSummary }}</span>
                <span class="asset-filter-multiselect-summary-width" aria-hidden="true">
                  <span>All categories ({{ categoryNavigation.totalCount }})</span>
                  <span>Uncategorized ({{ categoryNavigation.uncategorizedCount }})</span>
                  {% for cat in categoryNavigation.enabled %}
                    <span>{{ cat.displayName }} ({{ cat.assetCount }})</span>
                  {% endfor %}
                  {% for cat in categoryNavigation.disabled %}
                    <span>{{ cat.displayName }} ({{ cat.assetCount }}) (disabled)</span>
                  {% endfor %}
                  <span>Missing ({{ categoryNavigation.missingCount }})</span>
                </span>
              </span>
            </summary>
            <div id="asset-category-filter-options" class="asset-filter-multiselect-panel" role="radiogroup" aria-label="Category options">
              <div class="asset-filter-multiselect-option">
                <label for="asset-category-option-all">
                  <input id="asset-category-option-all" name="category" type="radio" value="all"
                         data-asset-category-presence="all"
                         {% if filters.category == 'all' and filters.presence != 'missing' %}checked{% endif %}>
                  <span>All categories ({{ categoryNavigation.totalCount }})</span>
                </label>
              </div>
              <div class="asset-filter-multiselect-option">
                <label for="asset-category-option-uncategorized">
                  <input id="asset-category-option-uncategorized" name="category" type="radio" value="uncategorized"
                         data-asset-category-presence="all"
                         {% if filters.category == 'uncategorized' %}checked{% endif %}>
                  <span>Uncategorized ({{ categoryNavigation.uncategorizedCount }})</span>
                </label>
              </div>
              {% for cat in categoryNavigation.enabled %}
                <div class="asset-filter-multiselect-option">
                  <label for="asset-category-option-{{ cat.id }}">
                    <input id="asset-category-option-{{ cat.id }}" name="category" type="radio" value="{{ cat.id }}"
                           data-asset-category-presence="all"
                           {% if filters.category == cat.id %}checked{% endif %}>
                    <span>{{ cat.displayName }} ({{ cat.assetCount }})</span>
                  </label>
                </div>
              {% endfor %}
              {% for cat in categoryNavigation.disabled %}
                <div class="asset-filter-multiselect-option">
                  <label for="asset-category-option-{{ cat.id }}">
                    <input id="asset-category-option-{{ cat.id }}" name="category" type="radio" value="{{ cat.id }}"
                           data-asset-category-presence="all"
                           {% if filters.category == cat.id %}checked{% endif %}>
                    <span>{{ cat.displayName }} ({{ cat.assetCount }}) <em class="asset-category-disabled-marker">(disabled)</em></span>
                  </label>
                </div>
              {% endfor %}
              <div class="asset-filter-multiselect-option">
                <label for="asset-category-option-missing">
                  <input id="asset-category-option-missing" name="category" type="radio" value="all"
                         data-asset-category-presence="missing"
                         {% if filters.category == 'all' and filters.presence == 'missing' %}checked{% endif %}>
                  <span>Missing ({{ categoryNavigation.missingCount }})</span>
                </label>
              </div>
            </div>
          </details>
        </fieldset>

      {% set tagFilterSelection = filters.tags or [] %}
      {% set extensionFilterSummary = "All extensions" %}
      {% if filters.extension %}
        {% set extensionFilterSummary = "." ~ filters.extension %}
      {% endif %}

        <div class="field">
          <label for="search">Search</label>
          <input id="search" name="search" type="search" value="{{ filters.search or '' }}" maxlength="{{ searchMaxLength }}">
        </div>

        <fieldset class="field asset-viewer-filter-field asset-filter-multiselect-field">
          <legend>Tag</legend>
          <details class="asset-filter-multiselect asset-filter-multiselect--sized" data-asset-viewer-filter-disclosure>
            <summary id="asset-tag-filter-trigger"
                     aria-controls="asset-tag-filter-options"
                     aria-expanded="false"
                     aria-label="Tag filter: {{ renderFilterSummary(tagFilterSelection, tagOptions, 'All tags', 'tags', '') }}"
                     title="{{ renderFilterSummary(tagFilterSelection, tagOptions, 'All tags', 'tags', '') }}">
              <span class="asset-filter-multiselect-summary">
                <span class="asset-filter-multiselect-summary-current">{{ renderFilterSummary(tagFilterSelection, tagOptions, 'All tags', 'tags', '') }}</span>
                <span class="asset-filter-multiselect-summary-width" aria-hidden="true">
                  <span>All tags</span>
                  {% for tag in tagOptions %}<span>{{ tag.displayName }}</span>{% endfor %}
                  <span>{{ tagOptions.length }} tags selected</span>
                </span>
              </span>
            </summary>
            <div id="asset-tag-filter-options" class="asset-filter-multiselect-panel" role="group" aria-label="Tag options">
              {% if tagOptions.length > 0 %}
                {% for tag in tagOptions %}
                  <div class="asset-filter-multiselect-option">
                    <label for="asset-tag-option-{{ loop.index }}">
                      <input id="asset-tag-option-{{ loop.index }}" name="tag" type="checkbox" value="{{ tag.value }}"{% if tag.selected %} checked{% endif %}>
                      <span>{{ tag.displayName }}</span>
                    </label>
                  </div>
                {% endfor %}
              {% else %}
                <p class="asset-filter-multiselect-empty">No tags available</p>
              {% endif %}
            </div>
          </details>
        </fieldset>

        <fieldset class="field asset-viewer-filter-field asset-filter-multiselect-field">
          <legend>Extension</legend>
          <details class="asset-filter-multiselect asset-filter-multiselect--sized" data-asset-viewer-filter-disclosure>
            <summary id="asset-extension-filter-trigger"
                     aria-controls="asset-extension-filter-options"
                     aria-expanded="false"
                     aria-label="Extension filter: {{ extensionFilterSummary }}"
                     title="{{ extensionFilterSummary }}">
              <span class="asset-filter-multiselect-summary">
                <span class="asset-filter-multiselect-summary-current">{{ extensionFilterSummary }}</span>
                <span class="asset-filter-multiselect-summary-width" aria-hidden="true">
                  <span>All extensions</span>
                  {% for choice in extensionChoices %}<span>.{{ choice.label }}</span>{% endfor %}
                </span>
              </span>
            </summary>
            <div id="asset-extension-filter-options" class="asset-filter-multiselect-panel" role="radiogroup" aria-label="Extension options">
              <div class="asset-filter-multiselect-option">
                <label for="asset-extension-option-all">
                  <input id="asset-extension-option-all" name="extension" type="radio" value=""{% if not filters.extension %} checked{% endif %}>
                  <span>All extensions</span>
                </label>
              </div>
              {% for choice in extensionChoices %}
                <div class="asset-filter-multiselect-option">
                  <label for="asset-extension-option-{{ loop.index }}">
                    <input id="asset-extension-option-{{ loop.index }}" name="extension" type="radio" value="{{ choice.value }}"{% if choice.selected %} checked{% endif %}>
                    <span>.{{ choice.label }}</span>
                  </label>
                </div>
              {% endfor %}
            </div>
          </details>
        </fieldset>

        {% set presenceFilterSummary = "All assets" %}
        {% if filters.presence == 'present' %}
          {% set presenceFilterSummary = "Present at last scan" %}
        {% elif filters.presence == 'missing' %}
          {% set presenceFilterSummary = "Missing at last scan" %}
        {% endif %}
        <fieldset class="field asset-viewer-filter-field asset-filter-multiselect-field">
          <legend>Show</legend>
          <details class="asset-filter-multiselect asset-filter-multiselect--sized" data-asset-viewer-filter-disclosure>
            <summary id="asset-presence-filter-trigger"
                     aria-controls="asset-presence-filter-options"
                     aria-expanded="false"
                     aria-label="Show filter: {{ presenceFilterSummary }}"
                     title="{{ presenceFilterSummary }}">
              <span class="asset-filter-multiselect-summary">
                <span class="asset-filter-multiselect-summary-current">{{ presenceFilterSummary }}</span>
                <span class="asset-filter-multiselect-summary-width" aria-hidden="true">
                  <span>All assets</span>
                  <span>Present at last scan</span>
                  <span>Missing at last scan</span>
                </span>
              </span>
            </summary>
            <div id="asset-presence-filter-options" class="asset-filter-multiselect-panel" role="radiogroup" aria-label="Show options">
              <div class="asset-filter-multiselect-option">
                <label for="asset-presence-option-all">
                  <input id="asset-presence-option-all" name="presence" type="radio" value="all"{% if filters.presence == 'all' %} checked{% endif %}>
                  <span>All assets</span>
                </label>
              </div>
              <div class="asset-filter-multiselect-option">
                <label for="asset-presence-option-present">
                  <input id="asset-presence-option-present" name="presence" type="radio" value="present"{% if filters.presence == 'present' %} checked{% endif %}>
                  <span>Present at last scan</span>
                </label>
              </div>
              <div class="asset-filter-multiselect-option">
                <label for="asset-presence-option-missing">
                  <input id="asset-presence-option-missing" name="presence" type="radio" value="missing"{% if filters.presence == 'missing' %} checked{% endif %}>
                  <span>Missing at last scan</span>
                </label>
              </div>
            </div>
          </details>
        </fieldset>

        {% set usageFilterSummary = "All assets" %}
        {% if filters.usage == 'used' %}
          {% set usageFilterSummary = "Used by a release" %}
        {% elif filters.usage == 'unused' %}
          {% set usageFilterSummary = "Not used by a release" %}
        {% endif %}
        <fieldset class="field asset-viewer-filter-field asset-filter-multiselect-field">
          <legend>Usage</legend>
          <details class="asset-filter-multiselect asset-filter-multiselect--sized" data-asset-viewer-filter-disclosure>
            <summary id="asset-usage-filter-trigger"
                     aria-controls="asset-usage-filter-options"
                     aria-expanded="false"
                     aria-label="Usage filter: {{ usageFilterSummary }}"
                     title="{{ usageFilterSummary }}">
              <span class="asset-filter-multiselect-summary">
                <span class="asset-filter-multiselect-summary-current">{{ usageFilterSummary }}</span>
                <span class="asset-filter-multiselect-summary-width" aria-hidden="true">
                  <span>All assets</span>
                  <span>Used by a release</span>
                  <span>Not used by a release</span>
                </span>
              </span>
            </summary>
            <div id="asset-usage-filter-options" class="asset-filter-multiselect-panel" role="radiogroup" aria-label="Usage options">
              <div class="asset-filter-multiselect-option">
                <label for="asset-usage-option-all">
                  <input id="asset-usage-option-all" name="usage" type="radio" value="all"{% if filters.usage == 'all' %} checked{% endif %}>
                  <span>All assets</span>
                </label>
              </div>
              <div class="asset-filter-multiselect-option">
                <label for="asset-usage-option-used">
                  <input id="asset-usage-option-used" name="usage" type="radio" value="used"{% if filters.usage == 'used' %} checked{% endif %}>
                  <span>Used by a release</span>
                </label>
              </div>
              <div class="asset-filter-multiselect-option">
                <label for="asset-usage-option-unused">
                  <input id="asset-usage-option-unused" name="usage" type="radio" value="unused"{% if filters.usage == 'unused' %} checked{% endif %}>
                  <span>Not used by a release</span>
                </label>
              </div>
            </div>
          </details>
        </fieldset>

        {% set sortFilterSummary = "Filename" %}
        {% if filters.sort == 'modified' %}
          {% set sortFilterSummary = "Modified date" %}
        {% elif filters.sort == 'size' %}
          {% set sortFilterSummary = "File size" %}
        {% elif filters.sort == 'category' %}
          {% set sortFilterSummary = "Category & location" %}
        {% endif %}
        <fieldset class="field asset-viewer-filter-field asset-filter-multiselect-field">
          <legend>Sort by</legend>
          <details class="asset-filter-multiselect asset-filter-multiselect--sized" data-asset-viewer-filter-disclosure>
            <summary id="asset-sort-filter-trigger"
                     aria-controls="asset-sort-filter-options"
                     aria-expanded="false"
                     aria-label="Sort by filter: {{ sortFilterSummary }}"
                     title="{{ sortFilterSummary }}">
              <span class="asset-filter-multiselect-summary">
                <span class="asset-filter-multiselect-summary-current">{{ sortFilterSummary }}</span>
                <span class="asset-filter-multiselect-summary-width" aria-hidden="true">
                  <span>Filename</span>
                  <span>Modified date</span>
                  <span>File size</span>
                  <span>Category &amp; location</span>
                </span>
              </span>
            </summary>
            <div id="asset-sort-filter-options" class="asset-filter-multiselect-panel" role="radiogroup" aria-label="Sort by options">
              <div class="asset-filter-multiselect-option">
                <label for="asset-sort-option-filename">
                  <input id="asset-sort-option-filename" name="sort" type="radio" value="filename"{% if filters.sort == 'filename' %} checked{% endif %}>
                  <span>Filename</span>
                </label>
              </div>
              <div class="asset-filter-multiselect-option">
                <label for="asset-sort-option-modified">
                  <input id="asset-sort-option-modified" name="sort" type="radio" value="modified"{% if filters.sort == 'modified' %} checked{% endif %}>
                  <span>Modified date</span>
                </label>
              </div>
              <div class="asset-filter-multiselect-option">
                <label for="asset-sort-option-size">
                  <input id="asset-sort-option-size" name="sort" type="radio" value="size"{% if filters.sort == 'size' %} checked{% endif %}>
                  <span>File size</span>
                </label>
              </div>
              <div class="asset-filter-multiselect-option">
                <label for="asset-sort-option-category">
                  <input id="asset-sort-option-category" name="sort" type="radio" value="category"{% if filters.sort == 'category' %} checked{% endif %}>
                  <span>Category &amp; location</span>
                </label>
              </div>
            </div>
          </details>
        </fieldset>

        {% set orderFilterSummary = "Ascending" %}
        {% if filters.order == 'desc' %}
          {% set orderFilterSummary = "Descending" %}
        {% endif %}
        <fieldset class="field asset-viewer-filter-field asset-filter-multiselect-field">
          <legend>Order</legend>
          <details class="asset-filter-multiselect asset-filter-multiselect--sized" data-asset-viewer-filter-disclosure>
            <summary id="asset-order-filter-trigger"
                     aria-controls="asset-order-filter-options"
                     aria-expanded="false"
                     aria-label="Order filter: {{ orderFilterSummary }}"
                     title="{{ orderFilterSummary }}">
              <span class="asset-filter-multiselect-summary">
                <span class="asset-filter-multiselect-summary-current">{{ orderFilterSummary }}</span>
                <span class="asset-filter-multiselect-summary-width" aria-hidden="true">
                  <span>Ascending</span>
                  <span>Descending</span>
                </span>
              </span>
            </summary>
            <div id="asset-order-filter-options" class="asset-filter-multiselect-panel" role="radiogroup" aria-label="Order options">
              <div class="asset-filter-multiselect-option">
                <label for="asset-order-option-asc">
                  <input id="asset-order-option-asc" name="order" type="radio" value="asc"{% if filters.order == 'asc' %} checked{% endif %}>
                  <span>Ascending</span>
                </label>
              </div>
              <div class="asset-filter-multiselect-option">
                <label for="asset-order-option-desc">
                  <input id="asset-order-option-desc" name="order" type="radio" value="desc"{% if filters.order == 'desc' %} checked{% endif %}>
                  <span>Descending</span>
                </label>
              </div>
            </div>
          </details>
        </fieldset>

      </form>
      <noscript>
             <button class="button button-primary" type="submit" form="asset-filters">Filter</button>
      </noscript>

      {% if assets.length > 0 %}
        {% if completeCategorySurface %}
          <section class="asset-auto-rename-surface" data-auto-rename-surface data-auto-rename-view="{{ filters.view }}"
                   aria-labelledby="auto-rename-surface-heading">
            <h2 id="auto-rename-surface-heading">{{ autoRenameCategory.displayName }} assets</h2>
            <p id="auto-rename-instructions" class="sr-only">
              Focus an asset card or row and press Space or Enter to grab it. Use the arrow keys to reorder it, Space or Enter to commit, or Escape to cancel.
            </p>
            {% if autoRenameSurface and autoRenameCategory %}
              <div class="asset-actions-panel" data-asset-actions-panel>
                <div class="asset-actions-category-row">
                  <div class="asset-actions-category-copy">
                    <span class="asset-actions-label">Category order</span>
                    <span class="asset-actions-helper">Drag assets to change their filename order</span>
                  </div>
                  <form method="post" action="/projects/{{ project.id }}/assets/auto-rename/preview"
                        class="auto-rename-assets-form" data-auto-rename-form>
                    <input type="hidden" name="_csrf" value="{{ _csrf }}">
                    <input type="hidden" name="categoryId" value="{{ autoRenameCategory.categoryId }}">
                    <input type="hidden" name="orderedAssetIds" value="{{ autoRenameCategory.orderedAssetIdsJson }}"
                           data-auto-rename-order-input>
                    <input type="hidden" name="view" value="{{ filters.view }}">
                    <button type="submit" class="button button-primary" data-auto-rename-submit disabled aria-disabled="true">Auto Rename</button>
                    <div class="auto-rename-live-region sr-only" data-auto-rename-live aria-live="polite" aria-atomic="true"></div>
                  </form>
                </div>
                {% if not isArchived %}
                  {# Checkboxes below are associated via form="bulk-select-form"
                     so per-row rename forms can remain outside this form. #}
                  <form id="bulk-select-form" method="post" action="/projects/{{ project.id }}/assets/add-to-release" class="bulk-select-form" data-asset-selection-form>
                    <input type="hidden" name="_csrf" value="{{ _csrf }}">
                    {{ renderContextFields(context, contextFields, false) }}

                    <div class="asset-selection-header">
                      <span class="asset-actions-selection-label">Selected assets</span>
                      <span class="selected-count" data-selected-count data-selected-total="{{ assets.length }}">0 of {{ assets.length }} selected</span>
                    </div>
                    <div class="asset-selection-controls">
                      <div class="asset-selection-tools" role="group" aria-label="Selection controls">
                        <button type="button" class="button button-small" data-select-all>Select all visible</button>
                        <button type="button" class="button button-small button-secondary" data-clear-selection>Clear selection</button>
                      </div>
                      <div class="asset-action-groups">
                        <fieldset class="asset-action-group">
                          <legend>Release actions</legend>
                          <div class="asset-action-group-controls">
                            <label class="field bulk-release-field">
                              <span>Add to release</span>
                              <select name="releaseId" data-release-select>
                                <option value="">Select a release…</option>
                                {% for target in releaseTargets %}
                                  <option value="{{ target.id }}"{% if submittedReleaseId == (target.id ~ '') %} selected{% endif %}>{{ target.title }}</option>
                                {% endfor %}
                              </select>
                            </label>
                            <button type="submit" class="button button-primary" data-bulk-submit>Add selected to release</button>
                            <button type="submit" class="button button-secondary"
                                    formaction="/projects/{{ project.id }}/assets/create-release">Create release with selected</button>
                          </div>
                        </fieldset>
                        <fieldset class="asset-action-group">
                          <legend>Category &amp; file actions</legend>
                          <div class="asset-action-group-controls">
                            <label class="field bulk-move-field">
                              <span>Move selected to</span>
                              <select name="destinationCategory">
                                <option value="uncategorized"{% if submittedDestinationCategory == 'uncategorized' %} selected{% endif %}>Uncategorized</option>
                                {% for cat in categoryNavigation.enabled %}
                                  <option value="{{ cat.id }}"{% if submittedDestinationCategory == (cat.id ~ '') %} selected{% endif %}>{{ cat.displayName }}</option>
                                {% endfor %}
                              </select>
                            </label>
                            <button type="submit" class="button"
                                    formaction="/projects/{{ project.id }}/assets/move-selected">Move selected</button>
                            <button type="submit" class="button button-secondary"
                                    formaction="/projects/{{ project.id }}/assets/copy-selected">Copy selected</button>
                            <button type="submit" class="button button-danger"
                                    formaction="/projects/{{ project.id }}/assets/delete-selected"
                                    data-confirm="The selected files will be permanently deleted from disk and cannot be restored through CreatorCrate. Continue?">Delete selected</button>
                          </div>
                        </fieldset>
                      </div>
                    </div>
                  </form>
                {% endif %}
              </div>
            {% endif %}
        {% endif %}

        {% if not completeCategorySurface and not isArchived %}
          <div class="asset-actions-panel asset-actions-panel--selection-only" data-asset-actions-panel>
            <form id="bulk-select-form" method="post" action="/projects/{{ project.id }}/assets/add-to-release" class="bulk-select-form" data-asset-selection-form>
              <input type="hidden" name="_csrf" value="{{ _csrf }}">
              {{ renderContextFields(context, contextFields, false) }}

              <div class="asset-selection-header">
                <span class="asset-actions-selection-label">Selected assets</span>
                <span class="selected-count" data-selected-count data-selected-total="{{ assets.length }}">0 of {{ assets.length }} selected</span>
              </div>
              <div class="asset-selection-controls">
                <div class="asset-selection-tools" role="group" aria-label="Selection controls">
                  <button type="button" class="button button-small" data-select-all>Select all visible</button>
                  <button type="button" class="button button-small button-secondary" data-clear-selection>Clear selection</button>
                </div>
                <div class="asset-action-groups">
                  <fieldset class="asset-action-group">
                    <legend>Release actions</legend>
                    <div class="asset-action-group-controls">
                      <label class="field bulk-release-field">
                        <span>Add to release</span>
                        <select name="releaseId" data-release-select>
                          <option value="">Select a release…</option>
                          {% for target in releaseTargets %}
                            <option value="{{ target.id }}"{% if submittedReleaseId == (target.id ~ '') %} selected{% endif %}>{{ target.title }}</option>
                          {% endfor %}
                        </select>
                      </label>
                      <button type="submit" class="button button-primary" data-bulk-submit>Add selected to release</button>
                      <button type="submit" class="button button-secondary"
                              formaction="/projects/{{ project.id }}/assets/create-release">Create release with selected</button>
                    </div>
                  </fieldset>
                  <fieldset class="asset-action-group">
                    <legend>Category &amp; file actions</legend>
                    <div class="asset-action-group-controls">
                      <label class="field bulk-move-field">
                        <span>Move selected to</span>
                        <select name="destinationCategory">
                          <option value="uncategorized"{% if submittedDestinationCategory == 'uncategorized' %} selected{% endif %}>Uncategorized</option>
                          {% for cat in categoryNavigation.enabled %}
                            <option value="{{ cat.id }}"{% if submittedDestinationCategory == (cat.id ~ '') %} selected{% endif %}>{{ cat.displayName }}</option>
                          {% endfor %}
                        </select>
                      </label>
                      <button type="submit" class="button"
                              formaction="/projects/{{ project.id }}/assets/move-selected">Move selected</button>
                      <button type="submit" class="button button-secondary"
                              formaction="/projects/{{ project.id }}/assets/copy-selected">Copy selected</button>
                      <button type="submit" class="button button-danger"
                              formaction="/projects/{{ project.id }}/assets/delete-selected"
                              data-confirm="The selected files will be permanently deleted from disk and cannot be restored through CreatorCrate. Continue?">Delete selected</button>
                    </div>
                  </fieldset>
                </div>
              </div>
            </form>
          </div>
        {% endif %}

        {% if filters.view == 'grid' %}
          <ul class="asset-grid" role="listbox" aria-label="Assets">
            {% for asset in assets %}
             {{ assetCard(asset, isArchived, submittedSelectedAssetIds, project, context, contextFields, renameFailure, _csrf, autoRenameSurface, loop.index0, assets.length) }}
            {% endfor %}
          </ul>
        {% elif not completeCategorySurface %}
          <ul class="asset-list asset-list--project" role="list" aria-label="Project assets">
            {% for asset in assets %}
              {{ assetListCard(asset, isArchived, submittedSelectedAssetIds, project, context, contextFields, renameFailure, _csrf) }}
            {% endfor %}
          </ul>
        {% else %}
          <div class="table-scroll" tabindex="0" aria-label="Project assets">
            <table class="data-table asset-table">
              <thead>
                <tr>
                   {% if not isArchived %}<th scope="col"><span class="sr-only">Select</span></th>{% endif %}
                  {% if autoRenameSurface %}<th scope="col">Order</th>{% endif %}
                  <th scope="col">Preview</th>
                   <th scope="col">File</th>
                   <th scope="col">Category</th>
                   <th scope="col">Tags</th>
                   <th scope="col">Type</th>
                  <th scope="col">Presence</th>
                  <th scope="col">Release usage</th>
                  <th scope="col">Actions</th>
                </tr>
              </thead>
              <tbody>
                {% for asset in assets %}
                   {{ assetRow(asset, isArchived, submittedSelectedAssetIds, project, context, contextFields, renameFailure, _csrf, autoRenameSurface, loop.index0, assets.length) }}
                {% endfor %}
              </tbody>
            </table>
          </div>
        {% endif %}

        {% if completeCategorySurface %}
          </section>
        {% endif %}

         {# Pagination #}
         {% if not completeCategorySurface and pageCount > 1 %}
          <nav class="pagination" aria-label="Asset list pages">
            {% if page > 1 %}
              <a href="{{ pageUrl({ page: page - 1 }) }}" class="pagination-prev">← Prev</a>
            {% endif %}

            <span class="pagination-info">Page {{ page }} of {{ pageCount }}</span>

            {% if page < pageCount %}
              <a href="{{ pageUrl({ page: page + 1 }) }}" class="pagination-next">Next →</a>
            {% endif %}
          </nav>

          <form class="page-size-form" method="get" action="/projects/{{ project.id }}/assets">
            <label for="pageSize">Assets per page:</label>
             <select id="pageSize" name="pageSize" data-autosubmit>
              <option value="10" {% if pageSize == 10 %}selected{% endif %}>10</option>
              <option value="25" {% if pageSize == 25 %}selected{% endif %}>25</option>
              <option value="50" {% if pageSize == 50 %}selected{% endif %}>50</option>
              <option value="100" {% if pageSize == 100 %}selected{% endif %}>100</option>
            </select>
            {# Preserve current filters in pageSize form #}
            {% if filters.category != 'all' or context.categoryWasSupplied %}
              <input type="hidden" name="category" value="{{ filters.category }}">
            {% endif %}
            {% if filters.search %}
              <input type="hidden" name="search" value="{{ filters.search }}">
            {% endif %}
            {% if filters.tags %}
              {% for tagId in filters.tags %}
                <input type="hidden" name="tag" value="{{ tagId }}">
              {% endfor %}
            {% endif %}
            {% if filters.extension %}
              <input type="hidden" name="extension" value="{{ filters.extension }}">
            {% endif %}
            {% if filters.presence != 'all' %}
              <input type="hidden" name="presence" value="{{ filters.presence }}">
            {% endif %}
            {% if filters.usage != 'all' %}
              <input type="hidden" name="usage" value="{{ filters.usage }}">
            {% endif %}
            {% if filters.sort != 'filename' or preserveSortQuery %}
              <input type="hidden" name="sort" value="{{ filters.sort }}">
            {% endif %}
            {% if filters.order != 'asc' or preserveOrderQuery %}
              <input type="hidden" name="order" value="{{ filters.order }}">
            {% endif %}
            {% if filters.view == 'list' or preserveViewQuery %}
              <input type="hidden" name="view" value="{{ filters.view }}">
            {% endif %}
            <button class="button button-small" type="submit">Apply</button>
          </form>
        {% endif %}
      {% elseif emptyState %}
        {% set emptyHeading = emptyState.heading %}
        {% set emptyDescription = emptyState.description %}
        {% set emptyHeadingLevel = "h2" %}
        {# The 'no-assets' cases direct the user to the existing authenticated,
           CSRF-protected POST "Scan Now" form already rendered in the page
           heading above — no separate action link here. A GET anchor cannot
           perform a scan, so no-assets/no-assets-archived intentionally omit
           emptyActionUrl/emptyActionLabel. #}
        {% if emptyState.kind != 'no-assets' and emptyState.kind != 'no-assets-archived' %}
           {% set emptyActionUrl = pageUrl({ search: '', tag: '', extension: '', presence: 'all', usage: 'all', category: 'all', sort: 'filename', order: 'asc', page: 1, pageSize: 25 }) %}
          {% set emptyActionLabel = "Reset Filters" %}
        {% endif %}
        {% include "partials/empty-state.njk" %}
      {% endif %}
    </div>
  </div>

  </div>

{% endblock %}
{% block overlay %}
  {% call dialog.render('project-assets-defaults-dialog', 'Project Assets defaults', projectAssetsDefaultsDialogOpen, 'project-assets-defaults-description', 'project-assets-defaults-form') %}
    <form id="project-assets-defaults-form" method="post" action="/projects/{{ project.id }}/assets/defaults" class="app-dialog-form project-form"
          data-dialog-form data-dialog-async novalidate>
      <p id="project-assets-defaults-description" class="app-dialog-description">
        Choose the presentation used when Project Assets opens without explicit options.
      </p>

      <div class="app-dialog-error" data-dialog-error role="alert" hidden>
        <p data-dialog-error-text></p>
        <ul data-dialog-error-list></ul>
      </div>

       <input type="hidden" name="_csrf" value="{{ _csrf }}">
       <input type="hidden" name="returnTo" value="{{ projectAssetsDefaultsReturnUrl }}">

      <div class="app-dialog-body">
        {% for field in projectAssetsDefaults.fields %}
          <div class="field app-dialog-field{% if field.error %} field-error{% endif %}" data-dialog-field="{{ field.name }}">
            <label for="{{ field.id }}">{{ field.label }}</label>
            <select id="{{ field.id }}" name="{{ field.name }}" required{% if field.error %} aria-describedby="{{ field.id }}-error" aria-invalid="true"{% endif %}>
              {% if field.showSubmittedValue %}
                <option value="{{ field.submittedOptionValue }}" data-dialog-submitted-value selected>Submitted value: {{ field.submittedDisplayValue }}</option>
              {% endif %}
              {% for option in field.options %}
                <option value="{{ option.value }}"{% if option.value == field.selectedValue %} selected{% endif %}>{{ option.label }}</option>
              {% endfor %}
            </select>
            {% if field.error %}<span class="field-error-message" id="{{ field.id }}-error">{{ field.error }}</span>{% endif %}
          </div>
        {% endfor %}
      </div>

      <div class="app-dialog-status" data-dialog-status role="status" aria-live="polite"></div>

      <footer class="app-dialog-footer">
        <button class="button button-secondary" type="submit" formmethod="dialog" data-dialog-close>Cancel</button>
        <button class="button button-primary" type="submit" data-dialog-submit>Save defaults</button>
      </footer>
    </form>
  {% endcall %}
  {% if not project.archived_at and categoryNavigation.missingCount > 0 %}
    {% call dialog.render('remove-missing-assets-dialog', 'Remove missing assets', removeMissingAssetsDialogOpen, 'remove-missing-assets-description', 'remove-missing-assets-form') %}
      <form id="remove-missing-assets-form" method="post" action="/projects/{{ project.id }}/assets/remove-missing"
            class="app-dialog-form" data-dialog-form data-dialog-async="false">
        <p id="remove-missing-assets-description" class="app-dialog-description">
          Only asset records currently marked missing will be removed. Files that are present will not be deleted.
        </p>
        <ul>
          <li>Missing assets protected by published-release rules will remain.</li>
          <li>This permanently removes eligible missing records and their associations. No files are deleted.</li>
        </ul>

        <input type="hidden" name="_csrf" value="{{ _csrf }}">
        <input type="hidden" name="returnTo" value="{{ removeMissingAssetsReturnUrl }}">

        <footer class="app-dialog-footer">
          <button class="button button-secondary" type="submit" formmethod="dialog" data-dialog-close>Cancel</button>
          <button class="button button-danger" type="submit" data-dialog-submit>Remove missing assets</button>
        </footer>
      </form>
    {% endcall %}
  {% endif %}
  {% if autoRenameConfirmationPlan %}
    {% set autoRenameDialogPlan = autoRenameConfirmationPlan %}
    {% set autoRenameDialogContext = autoRenameConfirmationContext or {} %}
    {% call dialog.render('auto-rename-confirmation-dialog', 'Auto Rename confirmation', autoRenameConfirmationDialogOpen, 'auto-rename-confirmation-description', 'auto-rename-confirmation-form') %}
      <form id="auto-rename-confirmation-form" method="post" action="/projects/{{ project.id }}/assets/auto-rename/apply"
            class="app-dialog-form auto-rename-confirmation-form" data-dialog-form data-dialog-async="false">
        <p id="auto-rename-confirmation-description" class="app-dialog-description">
          Review the server-generated names before changing files on disk.
        </p>

        {% if autoRenameDialogPlan.counts.blocked > 0 %}
          <div class="notice notice--danger auto-rename-confirmation-notice" role="alert">
            <p>Auto Rename cannot be applied because one or more category assets are blocked.</p>
          </div>
        {% elseif autoRenameDialogPlan.counts.rename == 0 %}
          <div class="notice notice--warning auto-rename-confirmation-notice" role="status">
            <p>All category assets are already named according to the rule. There are no changes to apply.</p>
          </div>
        {% endif %}

        <input type="hidden" name="_csrf" value="{{ _csrf }}">
        <input type="hidden" name="planToken" value="{{ autoRenameDialogPlan.token }}">
        {% if autoRenameDialogContext.category is defined and autoRenameDialogContext.category is not none and autoRenameDialogContext.category != '' %}
          <input type="hidden" name="categoryId" value="{{ autoRenameDialogContext.category }}">
        {% endif %}
        {% if autoRenameDialogContext.tag is defined and autoRenameDialogContext.tag is not none and autoRenameDialogContext.tag != '' %}
          <input type="hidden" name="tag" value="{{ autoRenameDialogContext.tag }}">
        {% endif %}
        {% if autoRenameDialogContext.view is defined and autoRenameDialogContext.view is not none and autoRenameDialogContext.view != '' %}
          <input type="hidden" name="view" value="{{ autoRenameDialogContext.view }}">
        {% endif %}

        <div class="app-dialog-body auto-rename-confirmation-body">
          <p class="auto-rename-confirmation-summary">
            {{ autoRenameDialogPlan.counts.selected }} asset{% if autoRenameDialogPlan.counts.selected != 1 %}s{% endif %}:
            {{ autoRenameDialogPlan.counts.rename }} to rename,
            {{ autoRenameDialogPlan.counts.unchanged }} unchanged{% if autoRenameDialogPlan.counts.blocked > 0 %},
              {{ autoRenameDialogPlan.counts.blocked }} blocked{% endif %}.
          </p>

          <ol class="auto-rename-confirmation-list">
            {% for item in autoRenameDialogPlan.items %}
              {% set itemLabel = item.currentFilename %}
              {% if not itemLabel or itemLabel == '—' %}{% set itemLabel = item.currentRelativePath %}{% endif %}
              {% if not itemLabel or itemLabel == '—' %}{% set itemLabel = 'Asset ' ~ item.assetId %}{% endif %}
              {% if item.status == 'rename' %}
                {% set statusVariant = 'success' %}
              {% elseif item.status == 'unchanged' %}
                {% set statusVariant = 'neutral' %}
              {% else %}
                {% set statusVariant = 'danger' %}
              {% endif %}
              <li class="auto-rename-confirmation-item{% if item.status == 'blocked' %} auto-rename-confirmation-item--blocked{% endif %}">
                <div class="auto-rename-confirmation-preview{% if item.previewKind == 'krita' %} asset-media--krita{% endif %}">
                  {% if item.thumbnailUrl %}
                    <img src="{{ item.thumbnailUrl }}" alt="Preview thumbnail for {{ itemLabel }}"
                         width="56" height="56" loading="lazy" decoding="async">
                  {% elif item.previewState == 'unsupported' %}
                    <span class="auto-rename-confirmation-preview-placeholder">{{ item.typeLabel }}<span class="sr-only"> preview not supported</span></span>
                  {% elif item.previewState == 'missing' %}
                    <span class="auto-rename-confirmation-preview-placeholder">Missing<span class="sr-only"> at last scan</span></span>
                  {% else %}
                    <span class="auto-rename-confirmation-preview-placeholder">{{ item.typeLabel }}</span>
                  {% endif %}
                </div>
                <div class="auto-rename-confirmation-copy">
                  <div class="auto-rename-confirmation-names">
                    <span class="auto-rename-confirmation-name auto-rename-confirmation-name--current">
                      <span class="sr-only">Current name: </span><code>{{ item.currentFilename }}</code>
                    </span>
                    <span aria-hidden="true">&rarr;</span>
                    <span class="auto-rename-confirmation-name auto-rename-confirmation-name--proposed">
                      <span class="sr-only">Proposed name: </span><code>{% if item.proposedFilename %}{{ item.proposedFilename }}{% else %}&mdash;{% endif %}</code>
                    </span>
                  </div>
                  <span class="status-badge status-badge--{{ statusVariant }}">Status: {{ item.statusLabel }}</span>
                  {% if item.blockedReason %}
                    <p class="auto-rename-block-reason"><strong>Blocked:</strong> {{ item.blockedReason }}</p>
                  {% endif %}
                </div>
              </li>
            {% endfor %}
          </ol>

          {% if autoRenameDialogPlan.canApply %}
            <p class="auto-rename-confirmation-apply-note">Applying this signed review will rename the category files on disk and update their asset records.</p>
          {% elseif autoRenameDialogPlan.counts.blocked > 0 %}
            <p class="auto-rename-confirmation-apply-note">Apply is unavailable until all blocked category assets are resolved.</p>
          {% else %}
            <p class="auto-rename-confirmation-apply-note">There are no changes to apply because all category assets are unchanged.</p>
          {% endif %}
        </div>

        <footer class="app-dialog-footer">
          <a class="button button-secondary" href="{{ autoRenameConfirmationReturnUrl }}">Cancel</a>
          <button class="button button-primary" type="submit"{% if not autoRenameDialogPlan.canApply %} disabled aria-disabled="true"{% endif %}>Apply Auto Rename</button>
        </footer>
      </form>
    {% endcall %}
  {% endif %}
  <div data-slideshow-scaffold class="slideshow-scaffold" hidden inert role="dialog" aria-modal="true" aria-label="Slideshow">
      <script type="application/json" data-slideshow-sequence>{{ slideshowSequenceJson | default('[]') | safe }}</script>
      <div class="slideshow-scaffold-inner">
        <div class="slideshow-header">
          <span class="slideshow-status" data-slideshow-status aria-live="polite" aria-atomic="true"></span>
          <span class="slideshow-media-status" data-slideshow-media-status role="status" aria-live="polite" hidden></span>
          <div class="slideshow-header-actions">
            <button type="button" class="slideshow-fullscreen" data-slideshow-fullscreen aria-label="Enter fullscreen" aria-pressed="false" title="Enter fullscreen">
              <span class="slideshow-fullscreen-enter-icon" aria-hidden="true">{{ icons.icon('fullscreen') }}</span>
              <span class="slideshow-fullscreen-exit-icon" aria-hidden="true">{{ icons.icon('fullscreen-exit') }}</span>
            </button>
            <button type="button" class="slideshow-close" data-slideshow-close aria-label="Close slideshow">{{ icons.icon('close') }}</button>
            <button type="button" class="slideshow-original-size" data-slideshow-original-size aria-label="View original size" aria-pressed="false" title="View original size">
              {{ icons.icon('original-size') }}
            </button>
          </div>
        </div>
      <div class="slideshow-preview" data-slideshow-preview></div>
      <div class="slideshow-controls">
        <button type="button" class="slideshow-nav-btn" data-slideshow-prev aria-label="Previous">{{ icons.icon('chevron-left') }}</button>
        <button type="button" class="slideshow-play-pause" data-slideshow-play-pause aria-label="Play" disabled>
          <span class="slideshow-play-icon" aria-hidden="true">{{ icons.icon('slideshow') }}</span>
          <span class="slideshow-pause-icon" aria-hidden="true">{{ icons.icon('pause') }}</span>
        </button>
        <select class="slideshow-speed" data-slideshow-speed aria-label="Slideshow speed" disabled>
          <option value="2000">2 s</option>
          <option value="4000" selected>4 s</option>
          <option value="6000">6 s</option>
        </select>
        <button type="button" class="slideshow-nav-btn" data-slideshow-next aria-label="Next">{{ icons.icon('chevron-right') }}</button>
      </div>
    </div>
  </div>
{% endblock %}
