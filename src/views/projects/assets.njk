{% extends "layout.njk" %}

{% block body_class %}asset-browser-page{% endblock %}

{% block content %}
  <div class="page-header">
    <h1>Assets — {{ project.title }}</h1>
    <div class="actions">
      {% if not project.archived_at %}
        <form method="post" action="/projects/{{ project.id }}/scan" class="inline-form">
          <button class="button button-primary" type="submit">Scan Now</button>
        </form>
      {% endif %}
      <a class="button" href="/projects/{{ project.id }}">Back to Project</a>
    </div>
  </div>

  {% if query.scan_result %}
    <div class="scan-success">
      <p>
        {% if query.scan_result == 'no_changes' %}
          Scan complete: no changes. {{ query.total or '?' }} total assets.
        {% else %}
          Scan complete: {{ query.scan_result | replace('+', ', ') }}. {{ query.total or '?' }} total assets.
        {% endif %}
      </p>
    </div>
  {% endif %}

  {% if error %}
    <div class="scan-error">
      <p>Scan failed. The project directory may be missing or inaccessible.</p>
    </div>
  {% endif %}

  {% if archivedError %}
    <div class="scan-error">
      <p>Scanning is not available for archived projects.</p>
    </div>
  {% endif %}

  <p class="results-meta">
    {{ total }} asset{% if total != 1 %}s{% endif %} found
    {% if filters.search or filters.extension or filters.presence != 'all' or filters.usage != 'all' %}
      (filtered)
    {% endif %}
  </p>

  <p class="scan-freshness">
    Asset state reflects the last completed scan — files are not checked live.
    Failed or incomplete scans do not update this information.
  </p>

  <div class="asset-toolbar">
    <nav class="view-switcher" aria-label="Asset display">
      <a href="{{ pageUrl({ view: 'list' }) }}"
         class="view-switcher-option view-switcher-list"
         {% if filters.view != 'grid' %}aria-current="page"{% endif %}>List</a>
      <a href="{{ pageUrl({ view: 'grid' }) }}"
         class="view-switcher-option view-switcher-grid"
         {% if filters.view == 'grid' %}aria-current="page"{% endif %}>Grid</a>
    </nav>

    <form class="filters" method="get" action="/projects/{{ project.id }}/assets">
    {% if filters.view != 'list' %}
      <input type="hidden" name="view" value="{{ filters.view }}">
    {% endif %}

    <div class="field">
      <label for="search">Search</label>
      <input id="search" name="search" type="search" value="{{ filters.search or '' }}" maxlength="{{ searchMaxLength }}">
    </div>

    <div class="field">
      <label for="extension">Extension</label>
      <select id="extension" name="extension">
        <option value="" {% if not filters.extension %}selected{% endif %}>All extensions</option>
        {% for choice in extensionChoices %}
          <option value="{{ choice.value }}" {% if choice.selected %}selected{% endif %}>.{{ choice.label }}</option>
        {% endfor %}
      </select>
    </div>

    <div class="field">
      <label for="presence">Show</label>
      <select id="presence" name="presence">
        <option value="all" {% if filters.presence == 'all' %}selected{% endif %}>All assets</option>
        <option value="present" {% if filters.presence == 'present' %}selected{% endif %}>Present at last scan</option>
        <option value="missing" {% if filters.presence == 'missing' %}selected{% endif %}>Missing at last scan</option>
      </select>
    </div>

    <div class="field">
      <label for="usage">Usage</label>
      <select id="usage" name="usage">
        <option value="all" {% if filters.usage == 'all' %}selected{% endif %}>All assets</option>
        <option value="used" {% if filters.usage == 'used' %}selected{% endif %}>Used by a release</option>
        <option value="unused" {% if filters.usage == 'unused' %}selected{% endif %}>Not used by a release</option>
      </select>
    </div>

    <button class="button" type="submit">Filter</button>
    <a class="button button-secondary" href="{{ pageUrl({ search: '', extension: '', presence: 'all', usage: 'all', page: 1, pageSize: 25 }) }}">Reset</a>
  </form>
  </div>

  {% if assets.length > 0 %}
    {% if filters.view == 'grid' %}
      <ul class="asset-grid">
        {% for card in cards %}
          <li class="asset-grid-item">
            <article class="asset-card" data-asset-id="{{ card.id }}">
              <a class="asset-card-link" href="{{ card.viewerUrl }}">
                <div class="asset-card-media"{% if card.thumbnailUrl %} data-preview-enhancement data-preview-state="loading"{% endif %}>
                  {% if card.thumbnailUrl %}
                    <img class="asset-card-thumb"
                         src="{{ card.thumbnailUrl }}"
                         alt="{{ card.previewAltText }}"
                         loading="lazy"
                         decoding="async"
                         width="256"
                         height="256"
                         data-preview-image>
                    <span class="asset-card-placeholder asset-card-fallback" data-preview-fallback hidden>Preview unavailable</span>
                  {% elseif not card.isPresent %}
                    <span class="asset-card-placeholder asset-card-placeholder-missing">Missing at last scan</span>
                  {% else %}
                    <span class="asset-card-placeholder asset-card-placeholder-no-preview">{{ card.statusText }}</span>
                  {% endif %}
                </div>
                <div class="asset-card-body">
                  <span class="asset-card-filename" title="{{ card.filename }}">{{ card.filename }}</span>
                  <span class="asset-card-meta">{{ card.formattedSize }}{% if card.compactTypeLabel %} · {{ card.compactTypeLabel }}{% endif %}</span>
                  <span class="asset-card-status">{{ card.statusText }}</span>
                  {% if card.releaseUsageCount > 0 %}
                    <span class="asset-card-usage">Used by {{ card.releaseUsageCount }} release{% if card.releaseUsageCount != 1 %}s{% endif %}</span>
                  {% endif %}
                </div>
              </a>
            </article>
          </li>
        {% endfor %}
      </ul>
    {% else %}
    <table class="asset-table">
      <thead>
        <tr>
          <th>Filename</th>
          <th>Type</th>
          <th>State</th>
          <th>Last Seen</th>
          <th>Missing Since</th>
          <th>Release Usage</th>
        </tr>
      </thead>
      <tbody>
        {% for asset in assets %}
          <tr>
            <td class="asset-filename">
              <code>{{ asset.filename }}</code>
              <br><small class="asset-path">{{ asset.relative_path }}</small>
            </td>
            <td><code>{{ asset.extension or '—' }}</code></td>
            <td>
              {% if asset.is_present %}
                <span class="asset-present">Present at last scan</span>
              {% else %}
                <span class="asset-missing">Missing at last scan</span>
              {% endif %}
            </td>
            <td class="asset-date">
              {% if asset.last_seen_at %}
                {{ asset.last_seen_at }}
              {% else %}
                —
              {% endif %}
            </td>
            <td class="asset-date">
              {% if asset.missing_since %}
                {{ asset.missing_since }}
              {% else %}
                —
              {% endif %}
            </td>
            <td>
              {% if asset.release_usage_count > 0 %}
                <a href="/releases?project={{ project.id }}" class="release-usage-link">
                  Used by {{ asset.release_usage_count }} release{% if asset.release_usage_count != 1 %}s{% endif %}
                </a>
                {% if asset.release_usage.length > 0 %}
                  <ul class="release-detail-list">
                    {% for usage in asset.release_usage %}
                      <li>
                        <a href="/releases/{{ usage.release_id }}">{{ usage.title }}</a>
                        <span class="release-status">({{ usage.status }})</span>
                      </li>
                    {% endfor %}
                  </ul>
                {% endif %}
              {% else %}
                <span class="asset-unused">Not used by a release</span>
              {% endif %}
            </td>
          </tr>
        {% endfor %}
      </tbody>
    </table>
    {% endif %}

    {# Pagination #}
    {% if pageCount > 1 %}
      <nav class="pagination" aria-label="Asset list pages">
        {% if page > 1 %}
          <a href="{{ pageUrl({ page: page - 1 }) }}" class="pagination-prev">← Prev</a>
        {% endif %}

        <span class="pagination-info">Page {{ page }} of {{ pageCount }}</span>

        {% if page < pageCount %}
          <a href="{{ pageUrl({ page: page + 1 }) }}" class="pagination-next">Next →</a>
        {% endif %}
      </nav>

      <form class="page-size-form" method="get" action="/projects/{{ project.id }}/assets">
        <label for="pageSize">Assets per page:</label>
        <select id="pageSize" name="pageSize" onchange="this.form.submit()">
          <option value="10" {% if pageSize == 10 %}selected{% endif %}>10</option>
          <option value="25" {% if pageSize == 25 %}selected{% endif %}>25</option>
          <option value="50" {% if pageSize == 50 %}selected{% endif %}>50</option>
          <option value="100" {% if pageSize == 100 %}selected{% endif %}>100</option>
        </select>
        {# Preserve current filters in pageSize form #}
        {% if filters.view != 'list' %}
          <input type="hidden" name="view" value="{{ filters.view }}">
        {% endif %}
        {% if filters.search %}
          <input type="hidden" name="search" value="{{ filters.search }}">
        {% endif %}
        {% if filters.extension %}
          <input type="hidden" name="extension" value="{{ filters.extension }}">
        {% endif %}
        {% if filters.presence != 'all' %}
          <input type="hidden" name="presence" value="{{ filters.presence }}">
        {% endif %}
        {% if filters.usage != 'all' %}
          <input type="hidden" name="usage" value="{{ filters.usage }}">
        {% endif %}
      </form>
    {% endif %}

  {% elseif total == 0 and (filters.search or filters.extension or filters.presence != 'all' or filters.usage != 'all') %}
    <p class="placeholder">
      No assets match the current filters.
      <a href="{{ pageUrl({ search: '', extension: '', presence: 'all', usage: 'all', page: 1, pageSize: 25 }) }}">Reset Filters</a> to see all assets.
    </p>
  {% elseif total == 0 %}
    {% if project.archived_at %}
      <p class="placeholder">No assets found for this archived project.</p>
    {% else %}
      <p class="placeholder">No assets found. Click <strong>Scan Now</strong> to discover files in the project directory.</p>
    {% endif %}
  {% endif %}
{% endblock %}
