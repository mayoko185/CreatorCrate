{% extends "layout.njk" %}
{% import "partials/page-heading.njk" as pageHeading %}
{% import "partials/asset-browser-preference.njk" as assetBrowserPreferenceForm %}
{% import "partials/form-switch.njk" as formSwitch %}

{% set page_title = "Projects — " ~ project.title ~ " — Asset Categories" %}

{% block content %}
  {% if project.archived_at %}
    {% call pageHeading.render("These categories belong only to this project and do not affect the global Settings defaults.", "archived") %}
      <a class="button button-secondary" href="/projects/{{ project.id }}">Back to project</a>
    {% endcall %}
  {% else %}
    {% call pageHeading.render("These categories belong only to this project and do not affect the global Settings defaults.") %}
      <a class="button button-secondary" href="/projects/{{ project.id }}">Back to project</a>
    {% endcall %}
  {% endif %}

  {% if notice %}
    {% set noticeVariant = notice.variant %}
    {% set noticeText = notice.text %}
    {% include "partials/notice.njk" %}
  {% endif %}

  {% if project.archived_at %}
    {% set noticeVariant = "warning" %}
    {% set noticeText = "This project is archived, so its categories are shown read-only. No category here can be added, edited, reordered, or deleted." %}
    {% include "partials/notice.njk" %}
  {% endif %}

  <div class="panel panel--info">
    <p>
      These categories belong only to <strong>{{ project.title }}</strong>. Adding, renaming, enabling,
      disabling, reordering, or deleting a category here never changes the global Settings defaults used
      when new projects are created.
    </p>
    <p>
      Disabling a category does not delete its files — a disabled category's existing assets are still
      recognized the next time this project is scanned.
    </p>
    <p>
      <strong>Display name</strong> and <strong>directory slug</strong> are separate. Editing the display
      name only changes the label shown in CreatorCrate. The directory slug is set when a category is
      added and cannot currently be changed afterward — it is fixed to the folder that was created on disk.
    </p>
  </div>

  {{ assetBrowserPreferenceForm.project(
    assetBrowserPreference,
    project.id,
    "/projects/" ~ project.id ~ "/asset-categories/default",
    "project-asset-categories-default-category",
    _csrf,
    project.archived_at
  ) }}

  {% if not project.archived_at %}
    <div class="settings-section category-management-section category-management-add project-category-management-add">
      <h3>Add a category</h3>
      {% if addErrors.displayName or addErrors.directorySlug or addErrors.enabled %}
        <div class="error-summary" role="alert" id="add-category-errors">
          <p>Could not add the category. Fix the fields below and try again.</p>
        </div>
      {% endif %}
      {% set addEnabled = true %}
      {% if addValues.enabled is defined %}{% set addEnabled = addValues.enabled %}{% endif %}
      <form method="post" action="/projects/{{ project.id }}/asset-categories" class="project-form category-management-form project-category-management-form" novalidate>
        <input type="hidden" name="_csrf" value="{{ _csrf }}">
        <div class="field-row">
          <div class="field {% if addErrors.displayName %}field-error{% endif %}">
            <label for="add-displayName">Display name <span class="required" aria-label="required">*</span></label>
            <input type="text" id="add-displayName" name="displayName" value="{{ addValues.displayName or '' }}" maxlength="100" required{% if addErrors.displayName %} aria-describedby="add-displayName-error" aria-invalid="true"{% endif %}>
            {% if addErrors.displayName %}<span class="field-error-message" id="add-displayName-error">{{ addErrors.displayName }}</span>{% endif %}
          </div>

          <div class="field {% if addErrors.directorySlug %}field-error{% endif %}">
            <label for="add-directorySlug">Directory slug <span class="required" aria-label="required">*</span></label>
            <input type="text" id="add-directorySlug" name="directorySlug" value="{{ addValues.directorySlug or '' }}" maxlength="100" required{% if addErrors.directorySlug %} aria-describedby="add-directorySlug-error" aria-invalid="true"{% endif %}>
            <span class="help-text">Lowercase letters, numbers, and single hyphens only.</span>
            {% if addErrors.directorySlug %}<span class="field-error-message" id="add-directorySlug-error">{{ addErrors.directorySlug }}</span>{% endif %}
          </div>

          <div class="field field--switch">
            <span class="field-label">Enabled</span>
            {{ formSwitch.control(
              "add-enabled",
              "enabled",
              addEnabled,
              "New category enabled state",
              "add-enabled-error" if addErrors.enabled else null,
              true if addErrors.enabled else false
            ) }}
            {% if addErrors.enabled %}<span class="field-error-message" id="add-enabled-error">{{ addErrors.enabled }}</span>{% endif %}
          </div>
        </div>

        <div class="category-management-action-row">
          <button type="submit" class="button button-primary">Add Category</button>
        </div>
      </form>
    </div>
  {% endif %}

  <div class="settings-section category-management-section category-management-list-section project-category-management-section">
    <h3>Categories</h3>
    <p class="category-management-section-note">Changing a display name does not rename its directory.</p>
    {% if categories.length > 0 %}
      {% if not project.archived_at %}
        <form id="project-category-reorder-form" method="post" action="/projects/{{ project.id }}/asset-categories/reorder" class="category-reorder-form" data-category-reorder-form>
          <input type="hidden" name="_csrf" value="{{ _csrf }}">
          <input type="hidden" name="orderedCategoryIds" data-category-order-input value="">
        </form>
      {% endif %}

      <div
        class="category-reorder-list{% if project.archived_at %} category-reorder-list--readonly{% endif %}"
        role="list"
        aria-label="Project asset categories"
        {% if not project.archived_at %}
          data-category-reorder-list
          data-reorder-url="/projects/{{ project.id }}/asset-categories/reorder"
          data-reorder-form-target="project-category-reorder-form"
        {% endif %}>
        {% for category in categories %}
          {% set rowEnabled = category.enabled %}
          {% set rowEnabledError = null %}
          {% if enabledControl and enabledControl.categoryId == category.id %}
            {% if enabledControl.submitted is not none %}{% set rowEnabled = enabledControl.submitted %}{% endif %}
            {% set rowEnabledError = enabledControl.errorMessage %}
          {% endif %}
          {% set rowEnabledErrorId = "category-" ~ category.id ~ "-enabled-error" %}
          {% set rowNameErrors = nameEdit.errors if (nameEdit and nameEdit.categoryId == category.id) else {} %}
          {% set rowNameValue = nameEdit.values.displayName if (nameEdit and nameEdit.categoryId == category.id) else category.display_name %}
          <article
            class="category-management-card{% if project.archived_at %} category-management-card--readonly{% endif %}"
            role="listitem"
            data-category-id="{{ category.id }}"
            data-category-label="{{ category.display_name }}"
            {% if not project.archived_at %}
              data-category-reorder-item
              draggable="true"
              aria-posinset="{{ loop.index }}"
              aria-setsize="{{ categories.length }}"
            {% endif %}>
            {% if not project.archived_at %}
              <button
                type="button"
                class="category-reorder-handle"
                data-category-reorder-handle
                draggable="true"
                aria-label="Reorder {{ category.display_name }}"
                title="Drag to reorder">
                <span aria-hidden="true">⠿</span>
              </button>
            {% endif %}

            <div class="category-management-card-body">
              <div class="category-management-card-fields">
                <div class="category-management-card-field category-management-name">
                  <span class="category-management-card-label">Display name</span>
                  {% if not project.archived_at %}
                    <form method="post" action="/projects/{{ project.id }}/asset-categories/{{ category.id }}/name" class="inline-form category-name-form" novalidate>
                      <input type="hidden" name="_csrf" value="{{ _csrf }}">
                      <label class="sr-only" for="name-{{ category.id }}">Display name for category {{ loop.index }}</label>
                      <input type="text" id="name-{{ category.id }}" name="displayName" maxlength="100" value="{{ rowNameValue }}" required{% if rowNameErrors.displayName %} aria-describedby="name-{{ category.id }}-error" aria-invalid="true"{% endif %}>
                      <button type="submit" class="button button-small button-secondary">Save name</button>
                      {% if rowNameErrors.displayName %}
                        <span class="field-error-message" id="name-{{ category.id }}-error" role="alert">{{ rowNameErrors.displayName }}</span>
                      {% endif %}
                    </form>
                  {% else %}
                    <span class="category-management-name-value">{{ category.display_name }}</span>
                  {% endif %}
                </div>

                <div class="category-management-card-field category-management-slug">
                  <span class="category-management-card-label">Directory slug</span>
                  <code>{{ category.directory_slug }}</code>
                </div>
              </div>

              <div class="category-management-card-controls">
                <div class="category-management-enabled">
                  {% if project.archived_at %}
                    {{ formSwitch.control(
                      "project-category-enabled-" ~ category.id,
                      "enabled",
                      rowEnabled,
                      "Category " ~ category.display_name ~ " enabled state",
                      null,
                      false,
                      true
                    ) }}
                  {% else %}
                    <form method="post" action="/projects/{{ project.id }}/asset-categories/{{ category.id }}/enabled" class="category-enabled-form">
                      <input type="hidden" name="_csrf" value="{{ _csrf }}">
                      {{ formSwitch.control(
                        "project-category-enabled-" ~ category.id,
                        "enabled",
                        rowEnabled,
                        "Category " ~ category.display_name ~ " enabled state",
                        rowEnabledErrorId if rowEnabledError else null,
                        true if rowEnabledError else false,
                        false,
                        true,
                        true
                      ) }}
                    </form>
                    {% if rowEnabledError %}<span class="field-error-message" id="{{ rowEnabledErrorId }}" role="alert">{{ rowEnabledError }}</span>{% endif %}
                  {% endif %}
                </div>

                {% if not project.archived_at %}
                  <div class="category-management-actions">
                    <form method="post" action="/projects/{{ project.id }}/asset-categories/{{ category.id }}/create-release" class="inline-form">
                      <input type="hidden" name="_csrf" value="{{ _csrf }}">
                      <button type="submit" class="button button-small button-primary" aria-label="Create a new release from {{ category.display_name }}">Create release</button>
                    </form>
                    <form method="post" action="/projects/{{ project.id }}/asset-categories/{{ category.id }}/delete" class="inline-form">
                      <input type="hidden" name="_csrf" value="{{ _csrf }}">
                      <button type="submit" class="button button-small button-danger" data-confirm="Delete this category? Only possible when no asset references it and its folder is empty or missing.">Delete</button>
                    </form>
                  </div>
                {% endif %}
              </div>
            </div>
          </article>
        {% endfor %}
      </div>
      {% if not project.archived_at %}
        <div class="category-reorder-live-region sr-only" data-category-reorder-live aria-live="polite" aria-atomic="true"></div>
      {% endif %}
    {% else %}
      {% set emptyHeading = "No categories yet" %}
      {% set emptyDescription = "Add a category above to start organizing this project's assets." %}
      {% include "partials/empty-state.njk" %}
    {% endif %}
  </div>
{% endblock %}
