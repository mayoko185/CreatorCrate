{% extends "layout.njk" %}
{% import "partials/page-heading.njk" as pageHeading %}
{% import "partials/icons.njk" as icons %}

{% set page_title = "Projects — " ~ project.title %}

{% block content %}
  {% if not project.archived_at %}
    {% call pageHeading.render() %}
      <a class="button button-secondary" href="/projects/{{ project.id }}/tags">Manage tags</a>
    {% endcall %}
  {% else %}
    {{ pageHeading.render("", "archived") }}
  {% endif %}

  {% if notice %}
    {% set noticeVariant = notice.variant %}
    {% set noticeText = notice.text %}
    {% include "partials/notice.njk" %}
  {% endif %}

  {% if project.archived_at %}
    {% set noticeVariant = "warning" %}
    {% set noticeText = "This project is archived and read-only. Editing, releases, and asset scanning are restricted." %}
    {% include "partials/notice.njk" %}
  {% endif %}

  {# ─── Hero: primary image + at-a-glance summary ─────────────────── #}
  <section class="project-detail-hero">
    <div class="project-detail-media{% if project.primaryImage.state == 'available' and project.primaryImage.mediaModifier %} project-card-media--{{ project.primaryImage.mediaModifier }}{% endif %}"{% if project.primaryImage.state == 'available' %} data-preview-enhancement data-preview-state="loading"{% else %} data-primary-image-state="{{ project.primaryImage.state }}"{% endif %}>
      {% if project.primaryImage.state == 'available' %}
        <img class="project-detail-media-image{% if project.nsfwBlur %} project-image--nsfw-blurred{% endif %}{% if project.primaryImage.mediaModifier %} project-card-media-image--{{ project.primaryImage.mediaModifier }}{% endif %}" data-preview-image src="{{ project.primaryImage.previewUrl }}" alt="{{ project.primaryImage.alt }}" loading="lazy" decoding="async">
        <span class="project-detail-media-placeholder" data-preview-fallback hidden>Image unavailable</span>
      {% elif project.primaryImage.state == 'unavailable' %}
        <span class="project-detail-media-placeholder">Image unavailable</span>
      {% else %}
        <span class="project-detail-media-placeholder">
          No primary image set.
          {% if not project.archived_at %}
            <a href="/projects/{{ project.id }}/assets">Choose one in the asset viewer</a>
          {% endif %}
        </span>
      {% endif %}
    </div>

    <div class="project-detail-summary">
      <div class="project-detail-meta">
        {% set status = project.status %}{% include "partials/status-badge.njk" %}
        <nav class="project-detail-action-toolbar" aria-label="Project actions">
          {% if not project.archived_at %}
            <a class="button button-small button-secondary project-detail-action asset-tooltip asset-tooltip--right"
               href="/projects/{{ project.id }}/edit" aria-label="Edit project" data-tooltip="Edit project">
              {{ icons.icon('edit') }}
            </a>
          {% endif %}
          <a class="button button-small button-secondary project-detail-action asset-tooltip asset-tooltip--right"
             href="/projects/{{ project.id }}/assets" aria-label="View Assets" data-tooltip="View Assets">
            {{ icons.icon('assets') }}
          </a>
          {% if openLocallyUri %}
            <a class="button button-small button-secondary project-detail-action asset-tooltip asset-tooltip--right"
               href="{{ openLocallyUri }}" aria-label="Open locally" data-tooltip="Open locally">
              {{ icons.icon('open-locally') }}
            </a>
          {% endif %}
        </nav>
      </div>

      {% if project.notes %}
        <h2>Notes</h2>
        <p class="notes">{{ project.notes }}</p>
      {% endif %}

      <section class="project-detail-health">
        <div class="count-grid">
          <div class="count-card"><span class="count">{{ assetHealth.total }}</span> Total assets</div>
          <div class="count-card"><span class="count">{{ assetHealth.present }}</span> Present</div>
          <div class="count-card">
            <span class="count">{{ assetHealth.missing }}</span> Missing
            {% if assetHealth.missingByReleases > 0 %}
              <small>({{ assetHealth.missingByReleases }} referenced by releases)</small>
            {% endif %}
          </div>
        </div>
      </section>

      <div class="project-detail-tags">
        {% if projectTags.length > 0 %}
          <ul class="tag-chip-list">
            {% for tag in projectTags %}
              <li class="tag-chip">{{ tag.displayName }}</li>
            {% endfor %}
          </ul>
        {% else %}
          <p class="help-text">No tags assigned to this project.</p>
        {% endif %}
      </div>

      {# ─── Project details ────────────────────────────────────────── #}
      <section class="project-detail-info project-detail-section">
        <h2>Details</h2>
        <div class="project-detail-section-body">
          <dl class="detail-list">
            {% if project.project_dir %}
              <dt>Project directory</dt>
              <dd><code>{{ project.project_dir }}</code> <small>(relative to projects share)</small></dd>
            {% endif %}

            <dt>Slug</dt>
            <dd><code>{{ project.slug }}</code></dd>

            <dt>Created</dt>
            <dd>{{ project.created_at }}</dd>

            <dt>Updated</dt>
            <dd>{{ project.updated_at }}</dd>

            <dt>Planned date</dt>
            <dd>{{ project.planned_date or '—' }}{% if project.planned_date %} <small>(project target)</small>{% endif %}</dd>

            <dt>Description</dt>
            <dd class="description">{{ project.description or '—' }}</dd>

            {% if project.patreon_url %}
              <dt>Project link</dt>
              <dd><a class="project-detail-link" href="{{ project.patreon_url }}" target="_blank" rel="noopener">Project link</a></dd>
            {% endif %}

            {% if project.archived_at %}
              <dt>Archived</dt>
              <dd>{{ project.archived_at }}</dd>
            {% endif %}
          </dl>
        </div>
      </section>
    </div>
  </section>

  {# ─── Releases (full width) ─────────────────────────────────────── #}
  <section class="release-summary project-detail-releases project-detail-section">
    <h2>Releases</h2>

    <div class="project-detail-section-body">
      <div class="workflow-actions">
        <a class="button" href="/release-management?project={{ project.id }}">View release records</a>
        {% if not project.archived_at %}
          <a class="button button-secondary" href="/releases/new?projectId={{ project.id }}">Create release record</a>
        {% endif %}
      </div>

      {% if releaseSummary.recent.length > 0 %}
        <ul class="release-list">
          {% for r in releaseSummary.recent %}
            <li>
              <a href="/releases/{{ r.id }}">{{ r.title }}</a>
              <span class="meta">
                {% set status = r.project_status %}{% include "partials/status-badge.njk" %}{% if r.published_date %} · published {{ r.published_date }}{% elif r.planned_date %} · planned {{ r.planned_date }}{% endif %}
                · updated {{ r.updated_at }}
              </span>
              {% if r.thumbnails and r.thumbnails.length > 0 %}
                {% set thumbnailLimit = 12 %}
                <div class="release-thumbnail-strip">
                  {% for thumbnail in r.thumbnails %}
                    {% if loop.index <= thumbnailLimit %}
                      <a class="release-thumbnail-link" href="{{ thumbnail.viewerUrl }}" aria-label="View {{ thumbnail.filename }}">
                        <img class="release-thumbnail-image" src="{{ thumbnail.thumbnailUrl }}" alt="{{ thumbnail.filename }}" loading="lazy" decoding="async">
                      </a>
                    {% endif %}
                  {% endfor %}
                  {% if r.thumbnails.length > thumbnailLimit %}
                    <a class="release-thumbnail-more" href="/releases/{{ r.id }}">+{{ r.thumbnails.length - thumbnailLimit }} more</a>
                  {% endif %}
                </div>
              {% endif %}
            </li>
          {% endfor %}
        </ul>
      {% else %}
        {% set emptyHeading = "No release records for this project." %}
        {% set emptyDescription = "Create one only when you need asset packaging or a separate release history entry." %}
        {% set emptyHeadingLevel = "h3" %}
        {% include "partials/empty-state.njk" %}
      {% endif %}
    </div>
  </section>
{% endblock %}
