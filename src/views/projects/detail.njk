{% extends "layout.njk" %}

{% block content %}
  <div class="page-header">
    <h1>{{ project.title }}</h1>
    <div class="actions">
      <a class="button" href="/projects/{{ project.id }}/edit">Edit</a>
      <form method="post" action="/projects/{{ project.id }}/archive" class="inline-form">
        <button class="button button-danger" type="submit" onclick="return confirm('Archive this project?')">Archive</button>
      </form>
    </div>
  </div>

  <dl class="detail-list">
    {% if project.project_dir %}
      <dt>Project directory</dt>
      <dd><code>{{ project.project_dir }}</code> <small>(relative to projects share)</small></dd>
    {% endif %}

    <dt>Slug</dt>
    <dd><code>{{ project.slug }}</code></dd>

    <dt>Status</dt>
    <dd>{{ project.status | replace('-', ' ') | title }}</dd>

    <dt>Priority</dt>
    <dd>{{ project.priority | title }}</dd>

    {% if project.planned_date %}
      <dt>Planned date</dt>
      <dd>{{ project.planned_date }}</dd>
    {% endif %}

    {% if project.published_date %}
      <dt>Published date</dt>
      <dd>{{ project.published_date }}</dd>
    {% endif %}

    {% if project.patreon_url %}
      <dt>Patreon URL</dt>
      <dd><a href="{{ project.patreon_url }}" target="_blank" rel="noopener">{{ project.patreon_url }}</a></dd>
    {% endif %}

    <dt>Created</dt>
    <dd>{{ project.created_at }}</dd>

    <dt>Updated</dt>
    <dd>{{ project.updated_at }}</dd>

    {% if project.archived_at %}
      <dt>Archived</dt>
      <dd>{{ project.archived_at }}</dd>
    {% endif %}
  </dl>

  {% if project.description %}
    <section>
      <h2>Description</h2>
      <p class="description">{{ project.description }}</p>
    </section>
  {% endif %}

  {% if project.notes %}
    <section>
      <h2>Notes</h2>
      <p class="notes">{{ project.notes }}</p>
    </section>
  {% endif %}
{% endblock %}
