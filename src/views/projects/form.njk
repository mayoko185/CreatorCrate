{% extends "layout.njk" %}
{% import "partials/page-heading.njk" as pageHeading %}

{% set title = action ~ ' Project' %}
{% set page_title = "Projects — Edit " ~ project.title if action == 'Edit' else "Projects — " ~ title %}
{% set formDescription = "Create a tracked project record." if action == 'Create' else "Update project metadata and planning fields." %}

{% block content %}
  {{ pageHeading.render(formDescription) }}

  {% if errors.general %}
    <div class="error-summary" role="alert">
      <p>{{ errors.general }}</p>
    </div>
  {% endif %}

  <form method="post" action="{{ submitUrl }}" class="project-form" novalidate>
    <input type="hidden" name="_csrf" value="{{ _csrf }}">
    <div class="form-section">
      <h2>Basic information</h2>

      <div class="field {% if errors.title %}field-error{% endif %}">
        <label for="title">Title <span class="required" aria-label="required">*</span></label>
        <input type="text" id="title" name="title" value="{{ values.title or '' }}" maxlength="200" required{% if errors.title %} aria-describedby="title-error" aria-invalid="true"{% endif %}>
        {% if errors.title %}<span class="field-error-message" id="title-error">{{ errors.title }}</span>{% endif %}
      </div>

      <div class="field {% if errors.description %}field-error{% endif %}">
        <label for="description">Description</label>
        <textarea id="description" name="description" rows="4" maxlength="4000"{% if errors.description %} aria-describedby="description-error" aria-invalid="true"{% endif %}>{{ values.description or '' }}</textarea>
        {% if errors.description %}<span class="field-error-message" id="description-error">{{ errors.description }}</span>{% endif %}
      </div>

      <div class="field {% if errors.notes %}field-error{% endif %}">
        <label for="notes">Notes</label>
        <textarea id="notes" name="notes" rows="6" maxlength="10000"{% if errors.notes %} aria-describedby="notes-error" aria-invalid="true"{% endif %}>{{ values.notes or '' }}</textarea>
        {% if errors.notes %}<span class="field-error-message" id="notes-error">{{ errors.notes }}</span>{% endif %}
      </div>
    </div>

    <div class="form-section">
      <h2>Status and scheduling</h2>

      <div class="field-row">
        <div class="field {% if errors.status %}field-error{% endif %}">
          <label for="status">Status <span class="required" aria-label="required">*</span></label>
          <select id="status" name="status" required{% if errors.status %} aria-describedby="status-error" aria-invalid="true"{% endif %}>
            {% for s in statuses %}
              <option value="{{ s }}" {% if values.status == s %}selected{% endif %}>{{ s | replace('-', ' ') | title }}</option>
            {% endfor %}
          </select>
          {% if errors.status %}<span class="field-error-message" id="status-error">{{ errors.status }}</span>{% endif %}
        </div>

        <div class="field {% if errors.priority %}field-error{% endif %}">
          <label for="priority">Priority <span class="required" aria-label="required">*</span></label>
          <select id="priority" name="priority" required{% if errors.priority %} aria-describedby="priority-error" aria-invalid="true"{% endif %}>
            {% for p in priorities %}
              <option value="{{ p }}" {% if values.priority == p %}selected{% endif %}>{{ p | title }}</option>
            {% endfor %}
          </select>
          {% if errors.priority %}<span class="field-error-message" id="priority-error">{{ errors.priority }}</span>{% endif %}
        </div>
      </div>

      <div class="field-row">
        <div class="field {% if errors.plannedDate %}field-error{% endif %}">
          <label for="plannedDate">Planned date</label>
          <input type="date" id="plannedDate" name="plannedDate" value="{{ values.plannedDate or '' }}" aria-describedby="plannedDate-help{% if errors.plannedDate %} plannedDate-error{% endif %}"{% if errors.plannedDate %} aria-invalid="true"{% endif %}>
          <span class="help-text" id="plannedDate-help">Target date for the creative project</span>
          {% if errors.plannedDate %}<span class="field-error-message" id="plannedDate-error">{{ errors.plannedDate }}</span>{% endif %}
        </div>

        <div class="field {% if errors.publishedDate %}field-error{% endif %}">
          <label for="publishedDate">Published date</label>
          <input type="date" id="publishedDate" name="publishedDate" value="{{ values.publishedDate or '' }}" aria-describedby="publishedDate-help{% if errors.publishedDate %} publishedDate-error{% endif %}"{% if errors.publishedDate %} aria-invalid="true"{% endif %}>
          <span class="help-text" id="publishedDate-help">When the project was published</span>
          {% if errors.publishedDate %}<span class="field-error-message" id="publishedDate-error">{{ errors.publishedDate }}</span>{% endif %}
        </div>
      </div>
    </div>

    <div class="form-section">
      <h2>Links</h2>

      <div class="field {% if errors.patreonUrl %}field-error{% endif %}">
        <label for="patreonUrl">Project link</label>
        <input type="url" id="patreonUrl" name="patreonUrl" value="{{ values.patreonUrl or '' }}" aria-describedby="patreonUrl-help{% if errors.patreonUrl %} patreonUrl-error{% endif %}"{% if errors.patreonUrl %} aria-invalid="true"{% endif %}>
        <span class="help-text" id="patreonUrl-help">Optional absolute HTTP or HTTPS URL for this project.</span>
        {% if errors.patreonUrl %}<span class="field-error-message" id="patreonUrl-error">{{ errors.patreonUrl }}</span>{% endif %}
      </div>
    </div>

    <div class="form-actions">
      <button class="button button-primary" type="submit">{{ action }}</button>
      <a class="button button-secondary" href="{% if project %}/projects/{{ project.id }}{% else %}/projects{% endif %}">Cancel</a>
    </div>
  </form>
{% endblock %}
