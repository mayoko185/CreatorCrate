{% extends "layout.njk" %}
{% import "partials/page-heading.njk" as pageHeading %}

{% set title = action ~ ' Project' %}
{% set page_title = "Projects — Edit " ~ project.title if action == 'Edit' else "Projects — " ~ title %}
{% set formDescription = "Create a tracked project record." if action == 'Create' else "Update project metadata and planning fields." %}

{% block content %}
  {% call pageHeading.render(formDescription) %}
    <button class="button button-primary" type="submit" form="project-form">{{ action }}</button>
    {% if action == 'Edit' and project and not project.archived_at %}
      <a class="button button-secondary" href="/projects/{{ project.id }}/assets">View assets</a>
    {% endif %}
    <a class="button button-secondary" href="{% if project %}/projects/{{ project.id }}{% else %}/projects{% endif %}">Cancel</a>
  {% endcall %}

  {% if errors.general %}
    <div class="error-summary" role="alert">
      <p>{{ errors.general }}</p>
    </div>
  {% endif %}

  <form id="project-form" method="post" action="{{ submitUrl }}" class="project-form" novalidate>
    <input type="hidden" name="_csrf" value="{{ _csrf }}">
    {% include "partials/project-form-fields.njk" %}
  </form>

  {% if action == 'Edit' and project and not project.archived_at %}
    <section class="notes-workspace-secondary project-actions" aria-labelledby="project-actions-heading">
      <aside class="notes-workspace-actions">
        <p class="notes-workspace-kicker" id="project-actions-heading">Project actions</p>

        <details class="notes-workspace-disclosure notes-workspace-disclosure--archive">
          <summary>Archive project</summary>
          <div class="notes-workspace-disclosure-content">
            <p class="notes-workspace-warning">Archive keeps this project and its data, but makes it archived and read-only.</p>
            <form method="post" action="/projects/{{ project.id }}/archive">
              <input type="hidden" name="_csrf" value="{{ _csrf }}">
              <button class="button button-small button-secondary" type="submit" data-confirm="Archive this project? This cannot be undone.">Archive project</button>
            </form>
          </div>
        </details>

        <details class="notes-workspace-disclosure notes-workspace-disclosure--delete">
          <summary>Delete project</summary>
          <div class="notes-workspace-disclosure-content">
            <p class="notes-workspace-warning">Permanently delete this project and its owned data. This cannot be undone.</p>
            <form method="post" action="/projects/{{ project.id }}/delete">
              <input type="hidden" name="_csrf" value="{{ _csrf }}">
              <button class="button button-small button-danger" type="submit" data-confirm="Delete this project permanently? This cannot be undone.">Delete project</button>
            </form>
          </div>
        </details>
      </aside>
    </section>
  {% endif %}
{% endblock %}
