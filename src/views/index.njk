{% extends "layout.njk" %}

{% block content %}
  <h1>{{ appName }}</h1>
  <p>Organize your Patreon art projects in one self-hosted place.</p>

  <div class="actions">
    <a class="button button-primary" href="/projects/new">New Project</a>
    <a class="button" href="/projects">View All Projects</a>
    <a class="button" href="/releases">View All Releases</a>
  </div>

  <section class="dashboard-counts">
    <h2>Project counts</h2>
    <div class="count-grid">
      <div class="count-card"><span class="count">{{ counts.tbd }}</span> TBD</div>
      <div class="count-card"><span class="count">{{ counts.planned }}</span> Planned</div>
      <div class="count-card"><span class="count">{{ counts['in-progress'] }}</span> In Progress</div>
      <div class="count-card"><span class="count">{{ counts.ready }}</span> Ready</div>
      <div class="count-card"><span class="count">{{ counts.published }}</span> Published</div>
      <div class="count-card"><span class="count">{{ counts.archived }}</span> Archived</div>
    </div>
  </section>

  {% if releaseStatusCounts %}
    <section class="dashboard-counts">
      <h2>Release counts</h2>
      <div class="count-grid">
        <div class="count-card"><span class="count">{{ releaseStatusCounts.idea or 0 }}</span> Idea</div>
        <div class="count-card"><span class="count">{{ releaseStatusCounts.planned or 0 }}</span> Planned</div>
        <div class="count-card"><span class="count">{{ releaseStatusCounts.drafting or 0 }}</span> Drafting</div>
        <div class="count-card"><span class="count">{{ releaseStatusCounts.ready or 0 }}</span> Ready</div>
        <div class="count-card"><span class="count">{{ releaseStatusCounts.published or 0 }}</span> Published</div>
        <div class="count-card"><span class="count">{{ releaseStatusCounts.cancelled or 0 }}</span> Cancelled</div>
      </div>
    </section>
  {% endif %}

  {% if totalAssets is defined %}
    <section class="dashboard-counts">
      <h2>Assets</h2>
      <div class="count-grid">
        <div class="count-card"><span class="count">{{ totalAssets }}</span> Total assets</div>
      </div>
    </section>
  {% endif %}

  {% if overdueReleases.length > 0 %}
    <section class="recent-projects">
      <h2>Overdue releases</h2>
      <ul class="project-list">
        {% for release in overdueReleases %}
          <li>
            <a href="/releases/{{ release.id }}">{{ release.title }}</a>
            <span class="meta">{{ release.status }} · planned {{ release.planned_date }}</span>
          </li>
        {% endfor %}
      </ul>
    </section>
  {% endif %}

  {% if upcomingReleases.length > 0 %}
    <section class="recent-projects">
      <h2>Upcoming releases</h2>
      <ul class="project-list">
        {% for release in upcomingReleases %}
          <li>
            <a href="/releases/{{ release.id }}">{{ release.title }}</a>
            <span class="meta">{{ release.status }} · planned {{ release.planned_date }}</span>
          </li>
        {% endfor %}
      </ul>
    </section>
  {% endif %}

  <section class="recent-projects">
    <h2>Recently updated</h2>
    {% if recentlyUpdated.length > 0 %}
      <ul class="project-list">
        {% for project in recentlyUpdated %}
          <li>
            <a href="/projects/{{ project.id }}">{{ project.title }}</a>
            <span class="meta">{{ project.status }} · {{ project.priority }} · updated {{ project.updated_at }}</span>
          </li>
        {% endfor %}
      </ul>
    {% else %}
      <p class="placeholder">No projects yet. Create one to get started.</p>
    {% endif %}
  </section>
{% endblock %}
