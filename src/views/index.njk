{% extends "layout.njk" %}
{% import "partials/page-heading.njk" as pageHeading %}

{% block content %}
  {% call pageHeading.render(appName, "Organize your Patreon art projects in one self-hosted place.") %}
    <a class="button button-primary" href="/projects/new">New Project</a>
    <a class="button" href="/projects">View All Projects</a>
    <a class="button" href="/releases">View All Releases</a>
  {% endcall %}

  {# ─── Summary cards ─────────────────────────────────────────────── #}
  <section class="summary-cards" aria-label="Overview">
    <a class="summary-card" href="/projects">
      <span class="summary-card-value">{{ summary.totalProjects }}</span>
      <span class="summary-card-label">Projects</span>
      <span class="summary-card-context">Projects currently tracked</span>
    </a>
    <div class="summary-card">
      <span class="summary-card-value">{{ summary.totalAssets }}</span>
      <span class="summary-card-label">Assets</span>
      <span class="summary-card-context">Across all projects</span>
    </div>
    {% if attention.totalCount > 0 %}
      <a class="summary-card summary-card--attention" href="#needs-attention">
        <span class="summary-card-value">{{ attention.totalCount }}</span>
        <span class="summary-card-label">Need attention</span>
        <span class="summary-card-context">Releases requiring review</span>
      </a>
    {% else %}
      <div class="summary-card">
        <span class="summary-card-value">0</span>
        <span class="summary-card-label">Need attention</span>
        <span class="summary-card-context">Releases requiring review</span>
      </div>
    {% endif %}
    {% if summary.missingAssetSummary.total > 0 %}
      <div class="summary-card summary-card--warning">
        <span class="summary-card-value">{{ summary.missingAssetSummary.total }}</span>
        <span class="summary-card-label">Missing assets</span>
        <span class="summary-card-context">Files missing at the last scan{% if summary.missingAssetSummary.referencedByReleases > 0 %}; {{ summary.missingAssetSummary.referencedByReleases }} referenced{% endif %}</span>
      </div>
    {% else %}
      <div class="summary-card">
        <span class="summary-card-value">{{ summary.missingAssetSummary.total }}</span>
        <span class="summary-card-label">Missing assets</span>
        <span class="summary-card-context">Files missing at the last scan</span>
      </div>
    {% endif %}
  </section>

  {# ─── Releases needing attention ──────────────────────────────────── #}
  <section class="needs-attention" id="needs-attention">
    <h2>Releases needing attention</h2>

    {% if attention.totalCount == 0 %}
      {% set emptyHeading = "All releases are in good shape" %}
      {% set emptyDescription = "Nothing needs attention right now." %}
      {% set emptyHeadingLevel = "h3" %}
      {% include "partials/empty-state.njk" %}
    {% else %}
      {% if attention.overdue.length > 0 %}
        <div class="attention-group attention-overdue">
          <h3>Overdue ({{ attention.overdue.length }})</h3>
          <ul class="release-list">
            {% for r in attention.overdue %}
              <li>
                <a href="/releases/{{ r.id }}">{{ r.title }}</a>
                <span class="meta">{{ r.status }} · planned {{ r.planned_date }}</span>
              </li>
            {% endfor %}
          </ul>
        </div>
      {% endif %}

      {% if attention.readyToPublish.length > 0 %}
        <div class="attention-group attention-ready">
          <h3>Ready to publish ({{ attention.readyToPublish.length }})</h3>
          <ul class="release-list">
            {% for r in attention.readyToPublish %}
              <li>
                <a href="/releases/{{ r.id }}">{{ r.title }}</a>
                <span class="meta">{{ r.status }}{% if r.planned_date %} · planned {{ r.planned_date }}{% endif %}</span>
              </li>
            {% endfor %}
          </ul>
        </div>
      {% endif %}

      {% if attention.readyButBlocked.length > 0 %}
        <div class="attention-group attention-blocked">
          <h3>Ready but blocked ({{ attention.readyButBlocked.length }})</h3>
          <ul class="release-list">
            {% for r in attention.readyButBlocked %}
              <li>
                <a href="/releases/{{ r.id }}">{{ r.title }}</a>
                <span class="meta">
                  {{ r.status }}{% if r.planned_date %} · planned {{ r.planned_date }}{% endif %}
                  {% if r.blockers.length > 0 %}
                    · blocked:
                    {% for b in r.blockers %}
                      {%- if b.key == 'assets_selected' %}no assets selected{%- endif %}
                      {%- if b.key == 'selected_assets_present' %}{{ b.details.missingSelectedAssetCount }} selected asset{{ 's' if b.details.missingSelectedAssetCount != 1 }} missing{%- endif %}
                      {%- if b.key == 'scope_mutable' %}
                        {%- if b.details.releaseArchived %}archived release{%- endif %}
                        {%- if b.details.projectArchived %}archived project{%- endif %}
                      {%- endif %}
                      {%- if not loop.last %}, {% endif %}
                    {%- endfor %}
                  {% endif %}
                </span>
              </li>
            {% endfor %}
          </ul>
        </div>
      {% endif %}

      {% if attention.missingPlannedDate.length > 0 %}
        <div class="attention-group attention-scheduling">
          <h3>Active without planned date ({{ attention.missingPlannedDate.length }})</h3>
          <ul class="release-list">
            {% for r in attention.missingPlannedDate %}
              <li>
                <a href="/releases/{{ r.id }}">{{ r.title }}</a>
                <span class="meta">{{ r.status }}</span>
              </li>
            {% endfor %}
          </ul>
        </div>
      {% endif %}

      {% if attention.releasesWithoutAssets.length > 0 %}
        <div class="attention-group attention-selection">
          <h3>Missing selection ({{ attention.releasesWithoutAssets.length }})</h3>
          <ul class="release-list">
            {% for r in attention.releasesWithoutAssets %}
              <li>
                <a href="/releases/{{ r.id }}">{{ r.title }}</a>
                <span class="meta">
                  {{ r.status }}{% if r.planned_date %} · planned {{ r.planned_date }}{% endif %}
                  · no assets selected
                </span>
              </li>
            {% endfor %}
          </ul>
        </div>
      {% endif %}

      {% if attention.missingSelectedAssets.length > 0 %}
        <div class="attention-group attention-warning">
          <h3>Missing selected assets ({{ attention.missingSelectedAssets.length }})</h3>
          <ul class="release-list">
            {% for r in attention.missingSelectedAssets %}
              <li>
                <a href="/releases/{{ r.id }}">{{ r.title }}</a>
                <span class="meta">
                  {{ r.status }}{% if r.planned_date %} · planned {{ r.planned_date }}{% endif %}
                  · {{ r.missing_asset_count }} missing
                </span>
              </li>
            {% endfor %}
          </ul>
        </div>
      {% endif %}
    {% endif %}
  </section>

  {# ─── Upcoming releases ──────────────────────────────────────────── #}
  <section class="upcoming-releases">
    <h2>Upcoming releases</h2>
    {% if upcomingReleases.length > 0 %}
      <div class="upcoming-grouped">
        {% for group in upcomingReleases %}
          <h3 class="upcoming-date">{{ group.plannedDate }}</h3>
          <ul class="release-list">
            {% for r in group.releases %}
              <li>
                <a href="/releases/{{ r.id }}">{{ r.title }}</a>
                <span class="meta">{{ r.status }}</span>
              </li>
            {% endfor %}
          </ul>
        {% endfor %}
      </div>
    {% else %}
      {% set emptyHeading = "No upcoming releases scheduled" %}
      {% set emptyDescription = "Add planned dates to active releases to see them here." %}
      {% set emptyHeadingLevel = "h3" %}
      {% include "partials/empty-state.njk" %}
    {% endif %}
  </section>

  {# ─── Workflow summary ──────────────────────────────────────────── #}
  <section class="workflow-summary">
    <h2>Release status</h2>
    <div class="count-grid">
      <div class="count-card"><span class="count">{{ summary.releaseStatusCounts.idea or 0 }}</span> Idea</div>
      <div class="count-card"><span class="count">{{ summary.releaseStatusCounts.planned or 0 }}</span> Planned</div>
      <div class="count-card"><span class="count">{{ summary.releaseStatusCounts.drafting or 0 }}</span> Drafting</div>
      <div class="count-card"><span class="count">{{ summary.releaseStatusCounts.ready or 0 }}</span> Ready</div>
      <div class="count-card"><span class="count">{{ summary.releaseStatusCounts.published or 0 }}</span> Published</div>
      <div class="count-card"><span class="count">{{ summary.releaseStatusCounts.cancelled or 0 }}</span> Cancelled</div>
    </div>

    <details class="project-counts-details">
      <summary>Project counts</summary>
      <div class="count-grid">
        <div class="count-card"><span class="count">{{ projectCounts.tbd }}</span> TBD</div>
        <div class="count-card"><span class="count">{{ projectCounts.planned }}</span> Planned</div>
        <div class="count-card"><span class="count">{{ projectCounts['in-progress'] }}</span> In Progress</div>
        <div class="count-card"><span class="count">{{ projectCounts.ready }}</span> Ready</div>
        <div class="count-card"><span class="count">{{ projectCounts.published }}</span> Published</div>
        <div class="count-card"><span class="count">{{ projectCounts.archived }}</span> Archived</div>
      </div>
    </details>
  </section>

  {# ─── Recently updated ──────────────────────────────────────────── #}
  <section class="recent-projects">
    <h2>Recently updated projects</h2>
    {% if recentlyUpdated.length > 0 %}
      <ul class="project-list">
        {% for project in recentlyUpdated %}
          <li>
            <a href="/projects/{{ project.id }}">{{ project.title }}</a>
            {% set status = project.status %}
            <span class="meta">
              {% include "partials/status-badge.njk" %}
              · {{ project.priority | title }} · updated {{ project.updated_at }}
            </span>
          </li>
        {% endfor %}
      </ul>
    {% else %}
      {% set emptyHeading = "No projects are currently tracked" %}
      {% set emptyDescription = "Create a project to start organizing releases and assets." %}
      {% set emptyActionUrl = "/projects/new" %}
      {% set emptyActionLabel = "New Project" %}
      {% set emptyHeadingLevel = "h3" %}
      {% include "partials/empty-state.njk" %}
    {% endif %}
  </section>
{% endblock %}
