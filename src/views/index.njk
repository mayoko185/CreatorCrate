{% extends "layout.njk" %}
{% import "partials/page-heading.njk" as pageHeading %}
{% import "partials/project-card.njk" as projectCard %}
{% import "partials/icons.njk" as icons %}
{% import "partials/dashboard-defaults-dialog.njk" as dashboardDefaultsDialog %}
{% import "partials/project-create-dialog.njk" as projectCreateDialog %}

{% set page_title = "Dashboard" %}

{% block content %}
  {% call pageHeading.render("Organize your art projects in one self-hosted place.") %}
    <a class="button button-primary" href="/projects/new" data-dialog-open="project-create-dialog">New Project</a>
  {% endcall %}

  <div class="asset-viewer-display-controls" data-project-grid-size-controls>
    {% set gridSizeLabelsInteractive = true %}
    {% include "partials/asset-grid-size-control.njk" %}

    <div class="project-filter-actions project-filter-actions--projects">
    <a class="asset-viewer-defaults-link button button-small button-secondary project-filter-control asset-tooltip asset-tooltip--left"
       href="/?defaults=1" aria-label="Dashboard defaults"
       data-dialog-open="dashboard-defaults-dialog" data-tooltip="Dashboard defaults" data-dashboard-defaults-link>
      {{ icons.icon('settings') }}
    </a>
      {% set nsfwToggleLabel = "Disable NSFW filter" if nsfwFilterEnabled else "Enable NSFW filter" %}
      <form method="post" action="/projects/nsfw-filter" class="inline-form" data-projects-nsfw-filter>
        <input type="hidden" name="_csrf" value="{{ _csrf }}">
        <input type="hidden" name="enabled" value="{{ '0' if nsfwFilterEnabled else '1' }}" data-projects-nsfw-value>
        <input type="hidden" name="returnTo" value="/">
        <button class="button button-small button-secondary project-filter-control asset-tooltip asset-tooltip--left"
                id="projects-nsfw-toggle" type="submit" data-projects-nsfw-toggle
                aria-pressed="{{ 'true' if nsfwFilterEnabled else 'false' }}"
                aria-label="{{ nsfwToggleLabel }}" data-tooltip="{{ nsfwToggleLabel }}">
          {{ icons.icon('nsfw-filter') }}
        </button>
      </form>
    </div>
  </div>

  {# ─── Summary cards ─────────────────────────────────────────────── #}
  <section class="summary-cards" aria-label="Overview">
    <a class="summary-card" href="/projects">
      <span class="summary-card-value">{{ summary.totalProjects }}</span>
      <span class="summary-card-label">Projects</span>
      <span class="summary-card-context">Projects currently tracked</span>
    </a>
    <a class="summary-card" href="{{ assetsUrl }}">
      <span class="summary-card-value">{{ summary.totalAssets }}</span>
      <span class="summary-card-label">Assets</span>
      <span class="summary-card-context">Across all projects</span>
    </a>
    {% if summary.missingAssetSummary.total > 0 %}
      <a class="summary-card summary-card--warning" href="{{ missingAssetsUrl }}">
        <span class="summary-card-value">{{ summary.missingAssetSummary.total }}</span>
        <span class="summary-card-label">Missing assets</span>
        <span class="summary-card-context">Files missing at the last scan</span>
      </a>
    {% else %}
      <a class="summary-card" href="{{ missingAssetsUrl }}">
        <span class="summary-card-value">{{ summary.missingAssetSummary.total }}</span>
        <span class="summary-card-label">Missing assets</span>
        <span class="summary-card-context">Files missing at the last scan</span>
      </a>
    {% endif %}
    <a class="summary-card" href="/releases">
      <span class="summary-card-value">{{ summary.totalReleases }}</span>
      <span class="summary-card-label">Releases</span>
      <span class="summary-card-context">Including archived releases</span>
    </a>
  </section>

  {% for section in dashboardSections %}
    <section class="dashboard-project-section" data-dashboard-section="{{ section.id }}">
      <h2>{{ section.label }}</h2>
      {% if section.projects.length > 0 %}
        <ul class="project-grid">
          {% for project in section.projects %}
            {{ projectCard.render(project, 'grid', 'h3') }}
          {% endfor %}
        </ul>
      {% else %}
        {% set emptyActionUrl = "" %}
        {% set emptyActionLabel = "" %}
        {% set emptyActionDialogId = "" %}
        {% if section.id == 'overdue' %}
          {% set emptyHeading = "No overdue projects" %}
          {% set emptyDescription = "Projects with no releases and a planned date today or earlier will show up here." %}
        {% elif section.id == 'upcoming' %}
          {% set emptyHeading = "No upcoming projects scheduled" %}
          {% set emptyDescription = "Add planned dates to active projects to see them here." %}
        {% elif section.id == 'recently-updated' %}
          {% set emptyHeading = "No projects are currently tracked" %}
          {% set emptyDescription = "Create a project to start organizing releases and assets." %}
          {% set emptyActionUrl = "/projects/new" %}
          {% set emptyActionLabel = "New Project" %}
          {% set emptyActionDialogId = "project-create-dialog" %}
        {% else %}
          {% set emptyHeading = "No " + (section.label | lower) + " projects" %}
          {% set emptyDescription = "No projects currently have the " + (section.label | lower) + " status." %}
        {% endif %}
        {% set emptyHeadingLevel = "h3" %}
        {% include "partials/empty-state.njk" %}
      {% endif %}
    </section>
  {% endfor %}
{% endblock %}

{% block overlay %}
  {{ dashboardDefaultsDialog.render(dashboardDefaults, dashboardSectionRegistry, dashboardDefaultsDialogOpen, _csrf, dashboardDefaultsFormState or {}) }}
  {{ projectCreateDialog.render(projectCreateForm, '/', _csrf, projectCreateDialogOpen) }}
{% endblock %}
