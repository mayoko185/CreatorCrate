{% extends "layout.njk" %}
{% import "partials/page-heading.njk" as pageHeading %}
{% import "partials/view-switcher.njk" as viewSwitcher %}
{% import "partials/icons.njk" as icons %}
{% import "partials/dialog.njk" as dialog %}
{% import "partials/dropdown.njk" as dropdown %}
{% import "partials/asset-information.njk" as assetInformation %}
{% import "partials/asset-presentation.njk" as assetPresentation %}
{% import "partials/dashboard-title-info.njk" as titleInfo %}
{% import "partials/calendar-info-card.njk" as infoCard %}

{% set page_title = "Asset Viewer" %}
{% set assetVideoPreview = true %}
{% set currentView = presentation.view or filters.view %}
{% set projectFilterHasSelection = false %}
{% set projectFilterSummary = 'All projects' %}
{% for project in projectOptions %}
  {% if project.id == filters.projectId %}
    {% set projectFilterHasSelection = true %}
    {% set projectFilterSummary = project.title %}
  {% endif %}
{% endfor %}
{% set presenceFilterSummary = 'All assets' %}
{% if presenceOptions is defined %}
  {% for option in presenceOptions %}
    {% if option.selected %}{% set presenceFilterSummary = option.label %}{% endif %}
  {% endfor %}
{% endif %}
{% set usageFilterSummary = 'All assets' %}
{% if usageOptions is defined %}
  {% for option in usageOptions %}
    {% if option.selected %}{% set usageFilterSummary = option.label %}{% endif %}
  {% endfor %}
{% endif %}
{% set sortFilterSummary = 'Filename' %}
{% if sortOptions is defined %}
  {% for option in sortOptions %}
    {% if option.selected %}{% set sortFilterSummary = option.label %}{% endif %}
  {% endfor %}
{% endif %}
{% set orderFilterSummary = filters.order %}
{% if orderOptions is defined %}
  {% for option in orderOptions %}
    {% if option.selected or option.value == filters.order %}{% set orderFilterSummary = option.label %}{% endif %}
  {% endfor %}
{% endif %}
{% set pageSizeFilterSummary = pageSize %}
{% if pageSizeOptions is defined %}
  {% for option in pageSizeOptions %}
    {% if option.selected or option.value == pageSize %}{% set pageSizeFilterSummary = option.label %}{% endif %}
  {% endfor %}
{% endif %}

{% macro renderListLocation(asset) %}
  {% if asset.category_directory_slug %}
    {{ asset.category_directory_slug }}{% if asset.nested_path %}/{{ asset.nested_path }}{% endif %}
  {% elif asset.nested_path %}
    {{ asset.nested_path }}
  {% elif asset.relative_path and asset.filename and asset.relative_path != asset.filename %}
    {{ asset.relative_path | replace('/' ~ asset.filename, '') }}
  {% else %}
    Project root
  {% endif %}
{% endmacro %}

{% macro renderGridPreview(asset, detailUrl, displayName) %}
  {% set previewUrl = asset.preview_url or asset.thumbnail_url %}
  {% set previewAvailable = asset.is_present and previewUrl and asset.preview_state != 'unsupported' and asset.preview_state != 'missing' %}
  <div class="asset-card-media asset-viewer-grid-card-preview{% if asset.preview and asset.preview.kind == 'krita' %} asset-media--krita{% endif %}" data-asset-viewer-preview{% if previewAvailable %} data-preview-enhancement data-preview-state="loading"{% endif %}>
    {% if previewAvailable %}
      <a class="asset-card-media-link asset-viewer-grid-card-preview-link" href="{{ detailUrl }}" aria-label="View preview of {{ displayName }}" data-project-assets-preview-id="{{ asset.id }}">
        <img class="asset-card-thumb asset-viewer-grid-card-preview-image{% if asset.nsfwBlur %} asset-image--nsfw-blurred{% endif %}"
             src="{{ previewUrl }}"
             alt=""
             loading="lazy"
             decoding="async"
             data-preview-image>
      </a>
      <span class="asset-card-placeholder asset-card-fallback" data-preview-fallback hidden>{{ asset.extension or 'Preview unavailable' }}</span>
    {% elif not asset.is_present %}
      <span class="asset-card-placeholder asset-card-placeholder-missing">Missing at last scan</span>
    {% elif asset.preview_state == 'video' %}
      {{ assetPresentation.videoPlaceholder(asset, 'grid', detailUrl, 'Play video ' ~ displayName, { nsfwBlur: asset.nsfwBlur, title: displayName }) }}
    {% elif asset.preview_state == 'unsupported' %}
      <span class="asset-card-placeholder">{{ asset.extension or 'Asset' }} — preview not supported</span>
    {% else %}
      <span class="asset-card-placeholder">Preview unavailable</span>
    {% endif %}
    {{ assetInformation.render(asset) }}
  </div>
{% endmacro %}

{# List thumbnail in the Dashboard thumbnail box. Placeholders are icons or
   the short type label with the full state in their title and sr-only text,
   since the 48px box cannot hold a sentence. #}
{% macro renderListPreview(asset, detailUrl, displayName) %}
  {% set previewUrl = asset.preview_url or asset.thumbnail_url %}
  {% set previewAvailable = asset.is_present and previewUrl and asset.preview_state != 'unsupported' and asset.preview_state != 'missing' %}
  {% set typeLabel = (asset.extension | upper) or 'File' %}
  <div class="asset-list-card-media dashboard-thumb{% if asset.preview and asset.preview.kind == 'krita' %} asset-media--krita{% endif %}"{% if previewAvailable %} data-preview-enhancement data-preview-state="loading"{% endif %}>
    {% if previewAvailable %}
      <a class="asset-list-card-media-link" href="{{ detailUrl }}" aria-label="View preview of {{ displayName }} from {{ asset.project_title }}" data-project-assets-preview-id="{{ asset.id }}">
        <img class="asset-list-card-media-image{% if asset.nsfwBlur %} asset-image--nsfw-blurred{% endif %}"
             src="{{ previewUrl }}"
             alt=""
             loading="lazy"
             decoding="async"
             data-preview-image>
      </a>
      <span class="asset-list-card-media-fallback" data-preview-fallback hidden>{{ typeLabel }}</span>
    {% elif not asset.is_present %}
      <span class="asset-list-card-media-placeholder asset-list-card-media-placeholder--missing" title="Missing at last scan">{{ icons.icon('warning') }}<span class="sr-only">Missing at last scan</span></span>
    {% elif asset.preview_state == 'video' %}
      {{ assetPresentation.videoPlaceholder(asset, 'list', detailUrl, 'Play video ' ~ displayName ~ ' from ' ~ asset.project_title, { nsfwBlur: asset.nsfwBlur, title: displayName }) }}
    {% elif asset.preview_state == 'unsupported' %}
      <span class="asset-list-card-media-placeholder" title="{{ typeLabel }} — preview not supported">{{ typeLabel }}<span class="sr-only"> — preview not supported</span></span>
    {% else %}
      <span class="asset-list-card-media-placeholder" title="Preview unavailable">{{ icons.icon('assets') }}<span class="sr-only">Preview unavailable</span></span>
    {% endif %}
  </div>
{% endmacro %}

{#
  List title information card on the Calendar card shell, bound by
  enhanceDashboardTitleInfoCards through the title trigger. Only an image
  preview is shown: videos and other files state their preview instead, so
  hovering never loads or plays media.
#}
{% macro renderListInfoCard(asset, detailId, detailUrl, projectUrl, displayName) %}
  {% set previewUrl = asset.preview_url or asset.thumbnail_url %}
  {% set previewAvailable = asset.is_present and previewUrl and asset.preview_state != 'unsupported' and asset.preview_state != 'missing' and asset.preview_state != 'video' %}
  {% set cardImage = { state: 'available', previewUrl: previewUrl, alt: asset.previewAltText or ('Preview of ' ~ displayName) } if previewAvailable else null %}
  {% set typeLabel = (asset.extension | upper) or 'File' %}
  {% call infoCard.shell(detailId, displayName, cardImage, asset.nsfwBlur) %}
    <div class="calendar-release-info-actions">
      <a class="button button-small button-secondary" href="{{ detailUrl }}">Open asset</a>
      <a class="button button-small button-secondary" href="{{ projectUrl }}">Open project</a>
    </div>
    <h3 class="asset-viewer-grid-card-info-heading asset-list-info-filename">{{ displayName }}</h3>
    <dl class="asset-viewer-grid-card-info-list">
      <div class="asset-viewer-grid-card-info-row"><dt>Path</dt><dd class="asset-list-info-path">{{ asset.relative_path or '—' }}</dd></div>
      {% if not previewAvailable %}
        <div class="asset-viewer-grid-card-info-row"><dt>Preview</dt><dd>
          {%- if not asset.is_present %}File missing at last scan
          {%- elif asset.preview_state == 'video' %}{{ typeLabel }} video — play it from the row thumbnail
          {%- elif asset.preview_state == 'unsupported' %}{{ typeLabel }} — preview not supported
          {%- else %}Preview unavailable{% endif -%}
        </dd></div>
      {% endif %}
      <div class="asset-viewer-grid-card-info-row"><dt>Project</dt><dd>{{ asset.project_title or '—' }}</dd></div>
      <div class="asset-viewer-grid-card-info-row"><dt>Project status</dt><dd>{% set status = asset.project_status %}{% set projectStatusOption = asset.projectStatusOption %}{% include "partials/status-badge.njk" %}</dd></div>
      <div class="asset-viewer-grid-card-info-row"><dt>Project type</dt><dd>{% if asset.project_type %}{% set projectType = asset.project_type %}{% set projectTypeOption = asset.projectTypeOption %}{% include "partials/project-type-badge.njk" %}{% else %}—{% endif %}</dd></div>
      <div class="asset-viewer-grid-card-info-row"><dt>Category</dt><dd>{{ assetInformation.renderCategory(asset) }}</dd></div>
      <div class="asset-viewer-grid-card-info-row"><dt>Type</dt><dd>{{ typeLabel }}{% if asset.extension %} (.{{ asset.extension }}){% endif %}</dd></div>
      <div class="asset-viewer-grid-card-info-row"><dt>Presence</dt><dd>{{ 'Present' if asset.is_present else 'Missing at last scan' }}</dd></div>
      <div class="asset-viewer-grid-card-info-row"><dt>Size</dt><dd>{{ asset.formattedSize or '—' }}{% if asset.size_bytes == 0 or asset.size_bytes %} ({{ asset.size_bytes }} bytes){% endif %}</dd></div>
      <div class="asset-viewer-grid-card-info-row"><dt>Modified</dt><dd>{{ asset.formattedModified or '—' }}</dd></div>
    </dl>
    <div class="asset-viewer-grid-card-info-section">
      <span class="asset-viewer-grid-card-info-section-label">Effective tags</span>
      {{ assetInformation.renderEffectiveTags(asset, 'asset-viewer-grid-card-info-tags', 'asset-viewer-grid-card-info-empty') }}
    </div>
    <div class="asset-viewer-grid-card-info-section">
      <span class="asset-viewer-grid-card-info-section-label">Releases</span>
      {% if asset.release_titles and asset.release_titles.length > 0 %}
        <ul class="asset-list-info-releases" aria-label="Associated releases">
          {% for release in asset.release_titles %}<li><a href="/releases/{{ release.id }}">{{ release.title }}</a></li>{% endfor %}
        </ul>
      {% else %}
        <span class="asset-viewer-grid-card-info-empty">Not used by a release</span>
      {% endif %}
    </div>
  {% endcall %}
{% endmacro %}

{% block content %}
  {{ pageHeading.render("Browse assets across active projects.") }}

  {% if assetViewerDefaultsNotice %}
    <p class="page-notice" role="status">{{ assetViewerDefaultsNotice }}</p>
  {% endif %}
  {% if assetViewerNsfwError %}
    <p class="page-notice page-notice--error" role="alert">{{ assetViewerNsfwError }}</p>
  {% endif %}

  <div data-asset-library-live-region>
    <span class="sr-only" data-asset-library-live-status aria-live="polite" aria-atomic="true"></span>

  <div class="asset-viewer-display-controls">
    {% if currentView == 'grid' %}
      {% set gridSizeLabelsInteractive = true %}
    {% endif %}
    {{ viewSwitcher.render(currentView, pageUrl, "Asset display", true) }}

    {% if currentView == 'grid' %}
      {% include "partials/asset-grid-size-control.njk" %}
    {% endif %}

    <div class="project-filter-actions project-filter-actions--projects">
       <a class="button button-small button-secondary project-filter-control asset-tooltip asset-tooltip--left"
          href="#asset-viewer-filter-dialog" aria-label="Filter assets"
          data-dialog-open="asset-viewer-filter-dialog" data-tooltip="Filter assets">
         {{ icons.icon('content-filter') }}
       </a>
       <a class="asset-viewer-defaults-link button button-small button-secondary project-filter-control asset-tooltip asset-tooltip--left"
          href="/asset-viewer?defaults=1" aria-label="Asset Viewer defaults"
          data-dialog-open="asset-viewer-defaults-dialog" data-tooltip="Asset Viewer defaults" data-asset-viewer-defaults-link>
        {{ icons.icon('settings') }}
      </a>
      {% set nsfwToggleLabel = "Disable NSFW filter" if nsfwFilterEnabled else "Enable NSFW filter" %}
      <form method="post" action="/asset-viewer/nsfw-filter" class="inline-form" data-asset-library-nsfw-filter>
        <input type="hidden" name="_csrf" value="{{ _csrf }}">
        <input type="hidden" name="enabled" value="{{ '0' if nsfwFilterEnabled else '1' }}" data-asset-library-nsfw-value>
        <input type="hidden" name="returnTo" value="{{ assetViewerNsfwReturnUrl }}">
        <button class="button button-small button-secondary project-filter-control asset-tooltip asset-tooltip--left"
                id="asset-library-nsfw-toggle" type="submit" data-asset-library-nsfw-toggle
                aria-pressed="{{ 'true' if nsfwFilterEnabled else 'false' }}"
                aria-label="{{ nsfwToggleLabel }}" data-tooltip="{{ nsfwToggleLabel }}">
          {{ icons.icon('nsfw-filter') }}
        </button>
      </form>
       <button class="slideshow-trigger button button-small button-secondary project-filter-control asset-tooltip asset-tooltip--left"
               type="button"
               aria-label="Start slideshow"
              data-tooltip="Start slideshow"
              data-slideshow-trigger>{{ icons.icon('slideshow') }}</button>
    </div>
  </div>

  <p class="results-meta">{{ total }} asset{% if total != 1 %}s{% endif %} found</p>

  {% if assets.length > 0 %}
    {% if currentView == 'grid' %}
      <ul class="asset-grid" role="list" aria-label="Assets across active projects">
        {% for asset in assets %}
          {% set detailUrl = asset.detailUrl or ("/projects/" ~ asset.project_id ~ "/assets/" ~ asset.id) %}
          {% set displayName = asset.filename or asset.relative_path or 'Unnamed asset' %}
          <li class="asset-grid-item{% if not asset.is_present %} is-missing{% endif %}">
            <article class="asset-card asset-viewer-grid-card" data-asset-id="{{ asset.id }}">
              <div class="asset-card-top asset-viewer-grid-card-top">
                <a class="asset-details-link asset-details-link--{{ 'present' if asset.is_present else 'missing' }} asset-tooltip asset-tooltip--right" href="{{ detailUrl }}"
                   aria-label="Asset details | File {{ 'present' if asset.is_present else 'missing!' }}"
                   data-tooltip="Asset details | File {{ 'present' if asset.is_present else 'missing!' }}">
                  {{ icons.icon('details') }}<span class="sr-only">View details</span>
                </a>
              </div>

              {{ renderGridPreview(asset, detailUrl, displayName) }}
            </article>
          </li>
        {% endfor %}
      </ul>
    {% else %}
      {#
        Column List in the Dashboard panel and table-scroll surfaces, on the
        column-aligned asset List rules (see "Column-aligned asset List" in
        creatorcrate.css) with an Asset Library grid that adds the Project
        column. The title opens its information card, whose Open asset and
        Open project actions navigate; the thumbnail opens its preview.
      #}
      {% set listColumns = [
        ['asset', 'Asset'], ['project', 'Project'], ['category', 'Category'], ['type', 'Type'], ['presence', 'Presence'],
        ['releases', 'Releases'], ['size', 'Size'], ['modified', 'Modified']
      ] %}
      <div class="dashboard dashboard-panel asset-list-panel">
        <div class="dashboard-table-scroll asset-list-scroll" role="region" aria-label="Asset table" tabindex="0">
          <div class="asset-list-table asset-list-table--library" data-asset-list-columns="{% for column in listColumns %}{{ column[0] }}{% if not loop.last %} {% endif %}{% endfor %}">
            <div class="asset-list-header" aria-hidden="true">
              {% for column in listColumns %}<span class="asset-list-cell asset-list-cell--{{ column[0] }}">{{ column[1] }}</span>{% endfor %}
            </div>
            <ul class="asset-list asset-list--library" role="list" aria-label="Assets across active projects">
              {% for asset in assets %}
                {% set detailUrl = asset.detailUrl or ("/projects/" ~ asset.project_id ~ "/assets/" ~ asset.id) %}
                {% set projectUrl = "/projects/" ~ asset.project_id %}
                {% set displayName = asset.filename or asset.relative_path or 'Unnamed asset' %}
                {% set detailId = 'asset-library-list-info-' ~ asset.id %}
                {% set releaseCount = asset.release_titles.length if asset.release_titles else 0 %}
                <li class="asset-list-item{% if not asset.is_present %} is-missing{% endif %}">
                  <article class="asset-list-card" data-asset-id="{{ asset.id }}">
                    <div class="asset-list-cell asset-list-cell--asset">
                      {{ renderListPreview(asset, detailUrl, displayName) }}
                      <div class="asset-list-card-heading">
                        <div class="dashboard-title-info asset-list-card-title-info" data-dashboard-title-info>
                          <h2 class="asset-list-card-title">{{ titleInfo.trigger(displayName, detailId) }}</h2>
                          {{ renderListInfoCard(asset, detailId, detailUrl, projectUrl, displayName) }}
                        </div>
                        <div class="asset-list-card-details">
                          <span class="asset-list-card-location" data-asset-containing-location>{{ renderListLocation(asset) }}</span>
                        </div>
                      </div>
                    </div>
                    <dl class="asset-list-cell asset-list-cell--project asset-list-card-meta asset-list-card-meta--project">
                      <dt>Project</dt>
                      <dd>{% if asset.project_title %}<a class="asset-project-link" href="{{ projectUrl }}" aria-label="View project {{ asset.project_title }}">{{ asset.project_title }}</a>{% else %}<span class="dashboard-muted">—</span>{% endif %}</dd>
                    </dl>
                    <dl class="asset-list-cell asset-list-cell--category asset-list-card-meta asset-list-card-meta--category">
                      <dt>Category</dt>
                      <dd>{{ assetInformation.renderCategory(asset) }}</dd>
                    </dl>
                    <dl class="asset-list-cell asset-list-cell--type asset-list-card-meta asset-list-card-meta--type">
                      <dt>Type</dt>
                      <dd>{% if asset.extension %}<span class="asset-type-label">{{ asset.extension | upper }}</span>{% else %}<span class="dashboard-muted">—</span>{% endif %}</dd>
                    </dl>
                    <dl class="asset-list-cell asset-list-cell--presence asset-list-card-meta asset-list-card-meta--presence">
                      <dt>Presence</dt>
                      <dd class="asset-list-card-presence">{{ assetPresentation.presenceIndicator(asset, 'left') }}</dd>
                    </dl>
                    <dl class="asset-list-cell asset-list-cell--releases asset-list-card-meta asset-list-card-meta--releases">
                      <dt>Releases</dt>
                      <dd>
                        {#- Release titles are in the title information card. -#}
                        {% if releaseCount > 0 %}
                          {% set releaseUsageLabel = 'Used in ' ~ releaseCount ~ (' release' if releaseCount == 1 else ' releases') %}
                          <span class="asset-indicator asset-icon-control asset-tooltip asset-indicator--used" role="img" tabindex="0"
                                aria-label="{{ releaseUsageLabel }}" data-tooltip="{{ releaseUsageLabel }}">R</span>
                          <span class="asset-list-card-release-count" aria-hidden="true">{{ releaseCount }}</span>
                        {% else %}
                          <span class="asset-indicator asset-icon-control asset-tooltip asset-indicator--unused" role="img" tabindex="0"
                                aria-label="Not used by a release" data-tooltip="Not used by a release">U</span>
                        {% endif %}
                      </dd>
                    </dl>
                    <dl class="asset-list-cell asset-list-cell--size asset-list-card-meta asset-list-card-meta--size">
                      <dt>Size</dt>
                      <dd>{% if asset.formattedSize %}{{ asset.formattedSize }}{% else %}<span class="dashboard-muted">—</span>{% endif %}</dd>
                    </dl>
                    <dl class="asset-list-cell asset-list-cell--modified asset-list-card-meta asset-list-card-meta--modified">
                      <dt>Modified</dt>
                      <dd>{% if asset.modified_at and asset.formattedModified %}{{ asset.formattedModified }}{% else %}<span class="dashboard-muted">—</span>{% endif %}</dd>
                    </dl>
                  </article>
                </li>
              {% endfor %}
            </ul>
          </div>
        </div>
      </div>
    {% endif %}

    {% if pageCount > 1 %}
      <nav class="pagination" aria-label="Asset Viewer pages">
        {% if hasPreviousPage %}
          <a class="button" href="{{ pageUrl({ page: page - 1 }) }}" rel="prev" aria-label="Previous Asset Viewer page">Previous</a>
        {% endif %}
        <span class="pagination-info">Page {{ page }} of {{ pageCount }}</span>
        {% if hasNextPage %}
          <a class="button" href="{{ pageUrl({ page: page + 1 }) }}" rel="next" aria-label="Next Asset Viewer page">Next</a>
        {% endif %}
      </nav>
    {% endif %}
  {% else %}
    {% set filtersActive = filters.projectId or filters.categories.length > 0 or filters.tags.length > 0 or filters.search or filters.extensions.length > 0 or filters.presence != 'all' or filters.usage != 'all' %}
    {% set emptyActionAttributes = [] %}
    {% set noAssetsAcrossProjects = false %}
    {% if hasAnyAssets is defined %}
      {% set noAssetsAcrossProjects = not hasAnyAssets %}
    {% elif unfilteredTotal is defined %}
      {% set noAssetsAcrossProjects = unfilteredTotal == 0 %}
    {% else %}
      {% set noAssetsAcrossProjects = not filtersActive %}
    {% endif %}

    {% if noAssetsAcrossProjects %}
      {% set emptyHeading = "No assets across active projects" %}
      {% set emptyDescription = "No assets are currently indexed in active projects." %}
    {% else %}
      {% set emptyHeading = "No assets match the current filters" %}
      {% set emptyDescription = "No assets in active projects match the selected filters." %}
      {% set emptyActionUrl = clearFiltersUrl %}
      {% set emptyActionLabel = "Reset" %}
      {% set emptyActionAttributes = [["data-asset-library-reset", true]] %}
    {% endif %}
    {% set emptyHeadingLevel = "h2" %}
    {% include "partials/empty-state.njk" %}
  {% endif %}

  </div>

{% endblock %}
{% block overlay %}
  {% call dialog.render('asset-viewer-filter-dialog', 'Filter') %}
    <form id="asset-filters" class="app-dialog-form project-form" method="get" action="/asset-viewer">
      <div class="app-dialog-body">
        <div class="page-defaults-grid">
          {% if currentView == 'list' or preserveViewQuery %}
            <input type="hidden" name="view" value="{{ currentView }}">
          {% endif %}

          {{ dropdown.searchableSingleSelect({
            id: "asset-project-filter",
            name: "project",
            label: "Project",
            options: projectOptions,
            valueKey: "id",
            labelKey: "title",
            selected: filters.projectId if projectFilterHasSelection else null,
            placeholder: "All projects",
            panelLabel: "Project options",
            searchLabel: "Search projects",
            searchInputId: "asset-project-filter-search",
            noResultsText: "No matching projects",
            optionListLabel: "Project choices",
            optionIdPrefix: "asset-project",
            fieldClasses: "app-dialog-field asset-viewer-filter-field asset-viewer-project-filter asset-viewer-filter-field--project",
            classes: "asset-project-filter-disclosure"
          }) }}

          {{ dropdown.multiSelect({
            id: "asset-category-filter",
            name: "category",
            label: "Category",
            fieldClasses: "app-dialog-field asset-viewer-filter-field",
            options: categoryFilterOptions,
            optionIdPrefix: "asset-category",
            selectedValues: categoryFilterSelectedValues,
            emptySummary: "Any category",
            countLabel: "categories",
            panelLabel: "Category options"
          }) }}

          {{ dropdown.multiSelect({
            id: "asset-tag-filter",
            name: "tag",
            label: "Tag",
            fieldClasses: "app-dialog-field asset-viewer-filter-field",
            options: tagOptions,
            optionIdPrefix: "asset-tag",
            selectedValues: tagFilterSelectedValues,
            emptySummary: "Any tag",
            countLabel: "tags",
            panelLabel: "Tag options",
            emptyOptionText: "No tags available"
          }) }}

          {{ dropdown.multiSelect({
            id: "asset-extension-filter",
            name: "extension",
            label: "Extension",
            fieldClasses: "app-dialog-field asset-viewer-filter-field",
            options: extensionOptions,
            optionIdPrefix: "asset-extension",
            selectedValues: extensionFilterSelectedValues,
            emptySummary: "Any extension",
            countLabel: "extensions",
            optionPrefix: ".",
            panelLabel: "Extension options"
          }) }}

          {% if presenceOptions is defined and presenceOptions.length > 0 %}
            {{ dropdown.singleSelect({
              id: "asset-presence-filter",
              name: "presence",
              label: "Presence",
              fieldClasses: "app-dialog-field asset-viewer-filter-field",
              options: presenceOptions,
              selected: filters.presence,
              summary: presenceFilterSummary,
              optionIdPrefix: "asset-presence",
              panelLabel: "Presence options"
            }) }}
          {% else %}
            {{ dropdown.singleSelect({
              id: "asset-presence-filter",
              name: "presence",
              label: "Presence",
              fieldClasses: "app-dialog-field asset-viewer-filter-field",
              options: presenceOptions or [],
              selected: filters.presence,
              nativeSelect: { id: "asset-presence" },
              panelLabel: "Presence options"
            }) }}
          {% endif %}

          {% if usageOptions is defined and usageOptions.length > 0 %}
            {{ dropdown.singleSelect({
              id: "asset-usage-filter",
              name: "usage",
              label: "Release usage",
              fieldClasses: "app-dialog-field asset-viewer-filter-field",
              options: usageOptions,
              selected: filters.usage,
              summary: usageFilterSummary,
              optionIdPrefix: "asset-usage",
              panelLabel: "Release usage options"
            }) }}
          {% else %}
            {{ dropdown.singleSelect({
              id: "asset-usage-filter",
              name: "usage",
              label: "Release usage",
              fieldClasses: "app-dialog-field asset-viewer-filter-field",
              options: usageOptions or [],
              selected: filters.usage,
              nativeSelect: { id: "asset-usage" },
              panelLabel: "Release usage options"
            }) }}
          {% endif %}

          {% if sortOptions is defined and sortOptions.length > 0 %}
            {{ dropdown.singleSelect({
              id: "asset-sort-filter",
              name: "sort",
              label: "Sort by",
              fieldClasses: "app-dialog-field asset-viewer-filter-field",
              options: sortOptions,
              selected: filters.sort,
              summary: sortFilterSummary,
              optionIdPrefix: "asset-sort",
              panelLabel: "Sort by options"
            }) }}
          {% else %}
            {{ dropdown.singleSelect({
              id: "asset-sort-filter",
              name: "sort",
              label: "Sort by",
              fieldClasses: "app-dialog-field asset-viewer-filter-field",
              options: sortOptions or [],
              selected: filters.sort,
              nativeSelect: { id: "asset-sort" },
              panelLabel: "Sort by options"
            }) }}
          {% endif %}

          {% if orderOptions is defined and orderOptions.length > 0 %}
            {{ dropdown.singleSelect({
              id: "asset-order-filter",
              name: "order",
              label: "Sort order",
              fieldClasses: "app-dialog-field asset-viewer-filter-field",
              options: orderOptions,
              selected: filters.order,
              summary: orderFilterSummary,
              optionIdPrefix: "asset-order",
              panelLabel: "Sort order options"
            }) }}
          {% else %}
            <div class="field app-dialog-field">
              <label for="asset-order">Sort order</label>
              <input id="asset-order" name="order" type="text" value="{{ filters.order }}">
            </div>
          {% endif %}

          {% if pageSizeOptions is defined and pageSizeOptions.length > 0 %}
            {{ dropdown.singleSelect({
              id: "asset-page-size-filter",
              name: "pageSize",
              label: "Page size",
              fieldClasses: "app-dialog-field asset-viewer-filter-field",
              options: pageSizeOptions,
              selected: pageSize ~ '',
              summary: pageSizeFilterSummary,
              optionIdPrefix: "asset-page-size",
              panelLabel: "Page size options"
            }) }}
          {% else %}
            <div class="field app-dialog-field">
              <label for="asset-page-size">Page size</label>
              <input id="asset-page-size" name="pageSize" type="number" value="{{ pageSize }}">
            </div>
          {% endif %}

        </div>
      </div>
    </form>
    <form class="asset-viewer-filter-reset" method="get" action="{{ clearFiltersUrl }}">
      <button class="button" type="submit" data-asset-library-reset>Reset filters</button>
    </form>
  {% endcall %}

  {% call dialog.render('asset-viewer-defaults-dialog', 'Asset Viewer defaults', assetViewerDefaultsDialogOpen, 'asset-viewer-defaults-description', 'asset-viewer-defaults-form') %}
    <form id="asset-viewer-defaults-form" method="post" action="/asset-viewer/defaults" class="app-dialog-form project-form"
          data-dialog-form data-dialog-async="false" data-asset-viewer-defaults-autosave novalidate>
      <p id="asset-viewer-defaults-description" class="app-dialog-description">
        Choose the presentation used when the Asset Viewer opens without explicit options.
      </p>

      <div class="app-dialog-error" data-dialog-error role="alert" hidden>
        <p data-dialog-error-text></p>
        <ul data-dialog-error-list></ul>
      </div>

       <input type="hidden" name="_csrf" value="{{ _csrf }}">
       <input type="hidden" name="returnTo" value="{{ assetViewerDefaultsReturnUrl }}">

      <div class="app-dialog-body">
        <div class="page-defaults-grid">
          {% for field in assetViewerDefaults.fields %}
          {% set submittedOption = none %}
          {% set nativeAttributes = [["data-autosubmit", "fetch"]] if field.multi else [["required", true], ["data-autosubmit", "fetch"]] %}
          {% set summaryAttributes = [] %}
          {% if field.showSubmittedValue %}
            {% set submittedOption = {
              id: field.id ~ '-submitted',
              value: field.submittedOptionValue,
              label: 'Submitted value: ' ~ field.submittedDisplayValue,
              attributes: [["data-dialog-submitted-value", true]],
              selected: true
            } %}
          {% endif %}
          {% if field.error %}
            {% set nativeAttributes = [["data-autosubmit", "fetch"], ["aria-describedby", field.id ~ '-error'], ["aria-invalid", true]] if field.multi else [["required", true], ["data-autosubmit", "fetch"], ["aria-describedby", field.id ~ '-error'], ["aria-invalid", true]] %}
            {% set summaryAttributes = [["aria-describedby", field.id ~ '-error'], ["aria-invalid", true]] %}
          {% endif %}
          <div class="field app-dialog-field{% if field.error %} field-error{% endif %}" data-dialog-field="{{ field.name }}">
            {% if field.multi %}
              {{ dropdown.multiSelect({
                id: field.id ~ '-dropdown',
                name: field.name,
                label: field.label,
                options: field.options,
                selectedValues: field.selectedValues,
                emptySummary: 'All extensions' if field.name == 'extension' else 'All tags',
                countLabel: 'values',
                optionIdPrefix: field.id,
                dispatchNativeChange: true,
                summaryAttributes: summaryAttributes,
                nativeSelect: {
                  id: field.id,
                  attributes: nativeAttributes
                }
              }) }}
            {% else %}
              {{ dropdown.singleSelect({
              id: field.id ~ '-dropdown',
              name: field.name,
              label: field.label,
              options: field.options,
              selected: field.selectedValue,
              optionIdPrefix: field.id,
              leadingOption: submittedOption,
              dispatchNativeChange: true,
              summaryAttributes: summaryAttributes,
              nativeSelect: {
                id: field.id,
                attributes: nativeAttributes
              }
              }) }}
            {% endif %}
            {% if field.error %}<span class="field-error-message" id="{{ field.id }}-error">{{ field.error }}</span>{% endif %}
          </div>
          {% endfor %}
        </div>
      </div>

      <div class="app-dialog-status" data-settings-fetch-save-status role="status" aria-live="polite" aria-atomic="true"></div>
    </form>
  {% endcall %}
  <div data-slideshow-scaffold class="slideshow-scaffold" hidden inert role="dialog" aria-modal="true" aria-label="Slideshow">
      <script type="application/json" data-slideshow-sequence>{{ slideshowSequenceJson | default('[]') | safe }}</script>
      <div class="slideshow-scaffold-inner">
        <div class="slideshow-header">
          <span class="slideshow-status" data-slideshow-status aria-live="polite" aria-atomic="true"></span>
          <span class="slideshow-media-status" data-slideshow-media-status role="status" aria-live="polite" hidden></span>
          <div class="slideshow-header-actions">
            <button type="button" class="slideshow-fullscreen asset-tooltip" data-slideshow-fullscreen aria-label="Enter fullscreen" data-tooltip="Enter fullscreen" aria-pressed="false">
              <span class="slideshow-fullscreen-enter-icon" aria-hidden="true">{{ icons.icon('fullscreen') }}</span>
              <span class="slideshow-fullscreen-exit-icon" aria-hidden="true">{{ icons.icon('fullscreen-exit') }}</span>
            </button>
            <button type="button" class="slideshow-original-size asset-tooltip" data-slideshow-original-size aria-label="View original size" data-tooltip="View original size" aria-pressed="false">
              {{ icons.icon('original-size') }}
            </button>
            <button type="button" class="slideshow-close asset-tooltip asset-tooltip--right" data-slideshow-close aria-label="Close slideshow" data-tooltip="Close slideshow">{{ icons.icon('close') }}</button>
          </div>
        </div>
      <div class="slideshow-preview" data-slideshow-preview></div>
      <div class="slideshow-controls">
        <button type="button" class="slideshow-nav-btn asset-tooltip asset-tooltip--left" data-slideshow-prev aria-label="Previous" data-tooltip="Previous">{{ icons.icon('chevron-left') }}</button>
        <button type="button" class="slideshow-play-pause asset-tooltip asset-tooltip--top" data-slideshow-play-pause aria-label="Play" data-tooltip="Play" disabled>
          <span class="slideshow-play-icon" aria-hidden="true">{{ icons.icon('slideshow') }}</span>
          <span class="slideshow-pause-icon" aria-hidden="true">{{ icons.icon('pause') }}</span>
        </button>
        {{ dropdown.singleSelect({
          id: "slideshow-speed-dropdown",
          label: "Slideshow speed",
          visuallyHiddenLabel: true,
          compact: true,
          selected: "4000",
          dispatchNativeChange: true,
          options: [
            { value: "2000", label: "2 s" },
            { value: "4000", label: "4 s" },
            { value: "6000", label: "6 s" }
          ],
          panelLabel: "Slideshow speed options",
          nativeSelect: {
            id: "slideshow-speed",
            classes: "slideshow-speed",
            attributes: [["data-slideshow-speed", true], ["disabled", true]]
          }
        }) }}
        <button type="button" class="slideshow-nav-btn asset-tooltip asset-tooltip--right" data-slideshow-next aria-label="Next" data-tooltip="Next">{{ icons.icon('chevron-right') }}</button>
      </div>
    </div>
  </div>
{% endblock %}
