{% extends "layout.njk" %}
{% import "partials/page-heading.njk" as pageHeading %}
{% import "partials/view-switcher.njk" as viewSwitcher %}
{% import "partials/icons.njk" as icons %}
{% import "partials/dialog.njk" as dialog %}
{% import "partials/dropdown.njk" as dropdown %}

{% set page_title = "Asset Viewer" %}
{% set currentView = presentation.view or filters.view %}
{% set clearFiltersUrl = pageUrl({ projectId: null, categories: null, tags: null, search: null, extensions: null, presence: 'all', usage: 'all', page: 1 }) %}
{% set projectFilterHasSelection = false %}
{% set projectFilterSummary = 'All projects' %}
{% for project in projectOptions %}
  {% if project.id == filters.projectId %}
    {% set projectFilterHasSelection = true %}
    {% set projectFilterSummary = project.title %}
  {% endif %}
{% endfor %}
{% set presenceFilterSummary = 'All assets' %}
{% if presenceOptions is defined %}
  {% for option in presenceOptions %}
    {% if option.selected %}{% set presenceFilterSummary = option.label %}{% endif %}
  {% endfor %}
{% endif %}
{% set usageFilterSummary = 'All assets' %}
{% if usageOptions is defined %}
  {% for option in usageOptions %}
    {% if option.selected %}{% set usageFilterSummary = option.label %}{% endif %}
  {% endfor %}
{% endif %}
{% set sortFilterSummary = 'Filename' %}
{% if sortOptions is defined %}
  {% for option in sortOptions %}
    {% if option.selected %}{% set sortFilterSummary = option.label %}{% endif %}
  {% endfor %}
{% endif %}
{% set orderFilterSummary = filters.order %}
{% if orderOptions is defined %}
  {% for option in orderOptions %}
    {% if option.selected or option.value == filters.order %}{% set orderFilterSummary = option.label %}{% endif %}
  {% endfor %}
{% endif %}
{% set pageSizeFilterSummary = pageSize %}
{% if pageSizeOptions is defined %}
  {% for option in pageSizeOptions %}
    {% if option.selected or option.value == pageSize %}{% set pageSizeFilterSummary = option.label %}{% endif %}
  {% endfor %}
{% endif %}

{% macro renderPresence(asset) %}
  {% if asset.is_present %}
    {% set status = 'present-at-last-scan' %}
  {% else %}
    {% set status = 'missing-at-last-scan' %}
  {% endif %}
  {% include "partials/status-badge.njk" %}
{% endmacro %}

{% macro renderGridPresenceIcon(asset) %}
  {% if asset.is_present %}
    <span class="asset-indicator asset-icon-control asset-tooltip asset-tooltip--left asset-indicator--present"
          role="img" tabindex="0" aria-label="Present" data-tooltip="Present">P</span>
  {% else %}
    <span class="asset-indicator asset-icon-control asset-tooltip asset-tooltip--left asset-indicator--missing"
          role="img" tabindex="0" aria-label="Missing at last scan" data-tooltip="Missing at last scan">!</span>
  {% endif %}
{% endmacro %}

{% macro renderGridReleaseUsageIcon(asset) %}
  {% if asset.release_titles and asset.release_titles.length > 0 %}
    {% if asset.release_titles.length == 1 %}
      {% set release = asset.release_titles[0] %}
      <a class="asset-indicator asset-icon-control asset-tooltip asset-indicator--used"
         href="/releases/{{ release.id }}" aria-label="Used in release {{ release.title }}"
         data-tooltip="Used in release">R</a>
    {% else %}
      <span class="asset-indicator asset-icon-control asset-tooltip asset-indicator--used"
            role="img" tabindex="0" aria-label="Used in {{ asset.release_titles.length }} releases"
            data-tooltip="Used in multiple releases">R</span>
    {% endif %}
  {% else %}
    <span class="asset-indicator asset-icon-control asset-tooltip asset-indicator--unused"
          role="img" tabindex="0" aria-label="Not used by a release"
          data-tooltip="Not used by a release">U</span>
  {% endif %}
{% endmacro %}

{% macro renderCategory(asset) %}
  {% if asset.category_display_name %}
    {{ asset.category_display_name }}{% if asset.category_enabled == 0 %} <em class="asset-category-disabled-marker">(disabled)</em>{% endif %}
  {% else %}
    Uncategorized
  {% endif %}
{% endmacro %}

{% macro renderListLocation(asset) %}
  {% if asset.category_directory_slug %}
    {{ asset.category_directory_slug }}{% if asset.nested_path %}/{{ asset.nested_path }}{% endif %}
  {% elif asset.nested_path %}
    {{ asset.nested_path }}
  {% elif asset.relative_path and asset.filename and asset.relative_path != asset.filename %}
    {{ asset.relative_path | replace('/' ~ asset.filename, '') }}
  {% else %}
    Project root
  {% endif %}
{% endmacro %}

{% macro renderEffectiveTags(asset, listClass, emptyClass) %}
  {% if asset.tags and asset.tags.length > 0 %}
    <ul class="{{ listClass }}" aria-label="Effective tags">
      {% for tag in asset.tags %}
        <li>{{ tag.displayName }}{% if tag.origin == 'inherited' %} <span class="asset-tag-origin"><span class="sr-only">Inherited from </span>Project</span>{% endif %}</li>
      {% endfor %}
    </ul>
  {% else %}
    <span class="{{ emptyClass }}">No effective tags</span>
  {% endif %}
{% endmacro %}

{% macro renderReleaseTitles(asset, listClass, emptyClass, linkClass) %}
  {% if asset.release_titles and asset.release_titles.length > 0 %}
    <ul class="{{ listClass }}" aria-label="Associated releases">
      {% for release in asset.release_titles %}
        <li><a class="{{ linkClass or 'asset-viewer-grid-card-release-link' }}" href="/releases/{{ release.id }}">{{ release.title }}</a></li>
      {% endfor %}
    </ul>
  {% else %}
    <span class="{{ emptyClass }}">Not in any release</span>
  {% endif %}
{% endmacro %}

{% macro renderGridAssetInfo(asset) %}
  <div class="asset-viewer-grid-card-info" data-asset-info-card role="group" aria-label="Asset information">
    <h3 class="asset-viewer-grid-card-info-heading">Asset information</h3>
    <dl class="asset-viewer-grid-card-info-list">
      <div class="asset-viewer-grid-card-info-row">
        <dt>Location</dt>
        <dd>{{ asset.relative_path or '—' }}</dd>
      </div>
      <div class="asset-viewer-grid-card-info-row">
        <dt>Category</dt>
        <dd>{{ renderCategory(asset) }}</dd>
      </div>
      <div class="asset-viewer-grid-card-info-row">
        <dt>Extension</dt>
        <dd>{{ asset.extension or '—' }}</dd>
      </div>
      <div class="asset-viewer-grid-card-info-row">
        <dt>Size</dt>
        <dd>{% if asset.size_bytes == 0 or asset.size_bytes %}{{ asset.size_bytes }} bytes{% else %}—{% endif %}</dd>
      </div>
      <div class="asset-viewer-grid-card-info-row">
        <dt>Modified</dt>
        <dd>{{ asset.modified_at or '—' }}</dd>
      </div>
      <div class="asset-viewer-grid-card-info-row">
        <dt>Presence</dt>
        <dd>{% if asset.is_present %}Present at last scan{% else %}Missing at last scan{% endif %}</dd>
      </div>
      <div class="asset-viewer-grid-card-info-row">
        <dt>Release usage</dt>
        <dd>
          {% if asset.release_titles and asset.release_titles.length > 0 %}
            Used in {{ asset.release_titles.length }} release{% if asset.release_titles.length != 1 %}s{% endif %}
          {% else %}
            Not used by a release
          {% endif %}
        </dd>
      </div>
    </dl>

    <div class="asset-viewer-grid-card-info-section">
      <span class="asset-viewer-grid-card-info-section-label">Effective tags</span>
      {{ renderEffectiveTags(asset, 'asset-viewer-grid-card-info-tags', 'asset-viewer-grid-card-info-empty') }}
    </div>
  </div>
{% endmacro %}

{% macro renderGridPreview(asset, detailUrl, displayName) %}
  {% set previewUrl = asset.preview_url or asset.thumbnail_url %}
  {% set previewAvailable = asset.is_present and previewUrl and asset.preview_state != 'unsupported' and asset.preview_state != 'missing' %}
  <div class="asset-card-media asset-viewer-grid-card-preview{% if asset.preview and asset.preview.kind == 'krita' %} asset-media--krita{% endif %}" data-asset-viewer-preview{% if previewAvailable %} data-preview-enhancement data-preview-state="loading"{% endif %}>
    {% if previewAvailable %}
      <a class="asset-card-media-link asset-viewer-grid-card-preview-link" href="{{ detailUrl }}" aria-label="View preview of {{ displayName }}">
        <img class="asset-card-thumb asset-viewer-grid-card-preview-image{% if asset.nsfwBlur %} asset-image--nsfw-blurred{% endif %}"
             src="{{ previewUrl }}"
             alt=""
             loading="lazy"
             decoding="async"
             data-preview-image>
      </a>
      <span class="asset-card-placeholder asset-card-fallback" data-preview-fallback hidden>{{ asset.extension or 'Preview unavailable' }}</span>
    {% elif not asset.is_present %}
      <span class="asset-card-placeholder asset-card-placeholder-missing">Missing at last scan</span>
    {% elif asset.preview_state == 'unsupported' %}
      <span class="asset-card-placeholder">{{ asset.extension or 'Asset' }} — preview not supported</span>
    {% else %}
      <span class="asset-card-placeholder">Preview unavailable</span>
    {% endif %}
    {{ renderGridAssetInfo(asset) }}
  </div>
{% endmacro %}

{% macro renderListPreview(asset, detailUrl, displayName) %}
  {% set previewUrl = asset.preview_url or asset.thumbnail_url %}
  {% set previewAvailable = asset.is_present and previewUrl and asset.preview_state != 'unsupported' and asset.preview_state != 'missing' %}
  <div class="asset-list-card-media"{% if previewAvailable %} data-preview-enhancement data-preview-state="loading"{% endif %}>
    {% if previewAvailable %}
      <a class="asset-list-card-media-link" href="{{ detailUrl }}" aria-label="View preview of {{ displayName }} from {{ asset.project_title }}">
        <img class="asset-list-card-media-image{% if asset.nsfwBlur %} asset-image--nsfw-blurred{% endif %}"
             src="{{ previewUrl }}"
             alt=""
             loading="lazy"
             decoding="async"
             data-preview-image>
      </a>
      <span class="asset-list-card-media-fallback" data-preview-fallback hidden>{{ asset.extension or 'Preview unavailable' }}</span>
    {% elif not asset.is_present %}
      <span class="asset-list-card-media-placeholder asset-list-card-media-placeholder--missing">Missing at last scan</span>
    {% elif asset.preview_state == 'unsupported' %}
      <span class="asset-list-card-media-placeholder">{{ asset.extension or 'Asset' }} — preview not supported</span>
    {% else %}
      <span class="asset-list-card-media-placeholder">Preview unavailable</span>
    {% endif %}
  </div>
{% endmacro %}

{% block content %}
  {{ pageHeading.render("Browse assets across active projects.") }}

  {% if assetViewerDefaultsNotice %}
    <p class="page-notice" role="status">{{ assetViewerDefaultsNotice }}</p>
  {% endif %}
  {% if assetViewerNsfwError %}
    <p class="page-notice page-notice--error" role="alert">{{ assetViewerNsfwError }}</p>
  {% endif %}

  <div data-asset-library-live-region>
    <span class="sr-only" data-asset-library-live-status aria-live="polite" aria-atomic="true"></span>

  <div class="asset-viewer-display-controls">
    {% if currentView == 'grid' %}
      {% set gridSizeLabelsInteractive = true %}
    {% endif %}
    {{ viewSwitcher.render(currentView, pageUrl, "Asset display", true) }}

    {% if currentView == 'grid' %}
      {% include "partials/asset-grid-size-control.njk" %}
    {% endif %}

    <div class="project-filter-actions project-filter-actions--projects">
       <a class="asset-viewer-defaults-link button button-small button-secondary project-filter-control asset-tooltip asset-tooltip--left"
          href="/assets?defaults=1" aria-label="Asset Viewer defaults"
          data-dialog-open="asset-viewer-defaults-dialog" data-tooltip="Asset Viewer defaults" data-asset-viewer-defaults-link>
        {{ icons.icon('settings') }}
      </a>
      {% set nsfwToggleLabel = "Disable NSFW filter" if nsfwFilterEnabled else "Enable NSFW filter" %}
      <form method="post" action="/assets/nsfw-filter" class="inline-form" data-asset-library-nsfw-filter>
        <input type="hidden" name="_csrf" value="{{ _csrf }}">
        <input type="hidden" name="enabled" value="{{ '0' if nsfwFilterEnabled else '1' }}" data-asset-library-nsfw-value>
        <input type="hidden" name="returnTo" value="{{ assetViewerNsfwReturnUrl }}">
        <button class="button button-small button-secondary project-filter-control asset-tooltip asset-tooltip--left"
                id="asset-library-nsfw-toggle" type="submit" data-asset-library-nsfw-toggle
                aria-pressed="{{ 'true' if nsfwFilterEnabled else 'false' }}"
                aria-label="{{ nsfwToggleLabel }}" data-tooltip="{{ nsfwToggleLabel }}">
          {{ icons.icon('nsfw-filter') }}
        </button>
      </form>
       <button class="slideshow-trigger button button-small button-secondary project-filter-control asset-tooltip asset-tooltip--left"
               type="button"
               aria-label="Start slideshow"
              data-tooltip="Start slideshow"
              data-slideshow-trigger>{{ icons.icon('slideshow') }}</button>
        <a class="button button-small button-secondary project-filter-control asset-tooltip asset-tooltip--left"
           href="{{ clearFiltersUrl }}"
           aria-label="Reset filters" data-tooltip="Reset filters" data-asset-library-reset>{{ icons.icon('reset') }}<span class="sr-only">Reset</span></a>
    </div>
  </div>

  <form id="asset-filters" class="filters asset-viewer-filters asset-viewer-filters--asset-viewer" method="get" action="/assets">
    <noscript><button class="button" type="submit">Filter</button></noscript>
    {% if currentView == 'list' or preserveViewQuery %}
      <input type="hidden" name="view" value="{{ currentView }}">
    {% endif %}

    {{ dropdown.searchableSingleSelect({
      id: "asset-project-filter",
      name: "project",
      label: "Project",
      options: projectOptions,
      valueKey: "id",
      labelKey: "title",
      selected: filters.projectId if projectFilterHasSelection else null,
      placeholder: "All projects",
      panelLabel: "Project options",
      searchLabel: "Search projects",
      searchInputId: "asset-project-filter-search",
      noResultsText: "No matching projects",
      optionListLabel: "Project choices",
      optionIdPrefix: "asset-project",
      fieldClasses: "asset-viewer-filter-field asset-viewer-project-filter",
      classes: "asset-project-filter-disclosure"
    }) }}

    {{ dropdown.multiSelect({
      id: "asset-category-filter",
      name: "category",
      label: "Category",
      fieldClasses: "asset-viewer-filter-field",
      options: categoryFilterOptions,
      optionIdPrefix: "asset-category",
      selectedValues: categoryFilterSelectedValues,
      emptySummary: "Any category",
      countLabel: "categories",
      panelLabel: "Category options"
    }) }}

    {{ dropdown.multiSelect({
      id: "asset-tag-filter",
      name: "tag",
      label: "Tag",
      fieldClasses: "asset-viewer-filter-field",
      options: tagOptions,
      optionIdPrefix: "asset-tag",
      selectedValues: tagFilterSelectedValues,
      emptySummary: "Any tag",
      countLabel: "tags",
      panelLabel: "Tag options",
      emptyOptionText: "No tags available"
    }) }}

    {{ dropdown.multiSelect({
      id: "asset-extension-filter",
      name: "extension",
      label: "Extension",
      fieldClasses: "asset-viewer-filter-field",
      options: extensionOptions,
      optionIdPrefix: "asset-extension",
      selectedValues: extensionFilterSelectedValues,
      emptySummary: "Any extension",
      countLabel: "extensions",
      optionPrefix: ".",
      panelLabel: "Extension options"
    }) }}

    {% if presenceOptions is defined and presenceOptions.length > 0 %}
      {{ dropdown.singleSelect({
        id: "asset-presence-filter",
        name: "presence",
        label: "Presence",
        fieldClasses: "asset-viewer-filter-field",
        options: presenceOptions,
        selected: filters.presence,
        summary: presenceFilterSummary,
        optionIdPrefix: "asset-presence",
        panelLabel: "Presence options"
      }) }}
    {% else %}
      {{ dropdown.singleSelect({
        id: "asset-presence-filter",
        name: "presence",
        label: "Presence",
        fieldClasses: "asset-viewer-filter-field",
        options: presenceOptions or [],
        selected: filters.presence,
        nativeSelect: { id: "asset-presence" },
        panelLabel: "Presence options"
      }) }}
    {% endif %}

    {% if usageOptions is defined and usageOptions.length > 0 %}
      {{ dropdown.singleSelect({
        id: "asset-usage-filter",
        name: "usage",
        label: "Release usage",
        fieldClasses: "asset-viewer-filter-field",
        options: usageOptions,
        selected: filters.usage,
        summary: usageFilterSummary,
        optionIdPrefix: "asset-usage",
        panelLabel: "Release usage options"
      }) }}
    {% else %}
      {{ dropdown.singleSelect({
        id: "asset-usage-filter",
        name: "usage",
        label: "Release usage",
        fieldClasses: "asset-viewer-filter-field",
        options: usageOptions or [],
        selected: filters.usage,
        nativeSelect: { id: "asset-usage" },
        panelLabel: "Release usage options"
      }) }}
    {% endif %}

    {% if sortOptions is defined and sortOptions.length > 0 %}
      {{ dropdown.singleSelect({
        id: "asset-sort-filter",
        name: "sort",
        label: "Sort by",
        fieldClasses: "asset-viewer-filter-field",
        options: sortOptions,
        selected: filters.sort,
        summary: sortFilterSummary,
        optionIdPrefix: "asset-sort",
        panelLabel: "Sort by options"
      }) }}
    {% else %}
      {{ dropdown.singleSelect({
        id: "asset-sort-filter",
        name: "sort",
        label: "Sort by",
        fieldClasses: "asset-viewer-filter-field",
        options: sortOptions or [],
        selected: filters.sort,
        nativeSelect: { id: "asset-sort" },
        panelLabel: "Sort by options"
      }) }}
    {% endif %}

    {% if orderOptions is defined and orderOptions.length > 0 %}
      {{ dropdown.singleSelect({
        id: "asset-order-filter",
        name: "order",
        label: "Sort order",
        fieldClasses: "asset-viewer-filter-field",
        options: orderOptions,
        selected: filters.order,
        summary: orderFilterSummary,
        optionIdPrefix: "asset-order",
        panelLabel: "Sort order options"
      }) }}
    {% else %}
      <div class="field">
        <label for="asset-order">Sort order</label>
        <input id="asset-order" name="order" type="text" value="{{ filters.order }}">
      </div>
    {% endif %}

    {% if pageSizeOptions is defined and pageSizeOptions.length > 0 %}
      {{ dropdown.singleSelect({
        id: "asset-page-size-filter",
        name: "pageSize",
        label: "Page size",
        fieldClasses: "asset-viewer-filter-field",
        options: pageSizeOptions,
        selected: pageSize ~ '',
        summary: pageSizeFilterSummary,
        optionIdPrefix: "asset-page-size",
        panelLabel: "Page size options"
      }) }}
    {% else %}
      <div class="field">
        <label for="asset-page-size">Page size</label>
        <input id="asset-page-size" name="pageSize" type="number" value="{{ pageSize }}">
      </div>
    {% endif %}

  </form>

  <p class="results-meta">{{ total }} asset{% if total != 1 %}s{% endif %} found</p>

  {% if assets.length > 0 %}
    {% if currentView == 'grid' %}
      <ul class="asset-grid" role="list" aria-label="Assets across active projects">
        {% for asset in assets %}
          {% set detailUrl = "/projects/" ~ asset.project_id ~ "/assets/" ~ asset.id %}
          {% set projectUrl = "/projects/" ~ asset.project_id %}
          {% set displayName = asset.filename or asset.relative_path or 'Unnamed asset' %}
          <li class="asset-grid-item{% if not asset.is_present %} is-missing{% endif %}">
            <article class="asset-card asset-viewer-grid-card" data-asset-id="{{ asset.id }}">
              <div class="asset-card-top asset-viewer-grid-card-top">
                {{ renderGridPresenceIcon(asset) }}
                <span class="asset-card-usage">{{ renderGridReleaseUsageIcon(asset) }}</span>
              </div>

              {{ renderGridPreview(asset, detailUrl, displayName) }}

              <div class="asset-card-body asset-viewer-grid-card-title-area">
                <h2 class="asset-viewer-grid-card-title">
                  <a class="asset-file-link" href="{{ detailUrl }}"
                     aria-label="View details for {{ displayName }}">{{ displayName }}</a>
                </h2>
                <a class="asset-project-link asset-viewer-grid-card-project-link" href="{{ projectUrl }}"
                   aria-label="View project {{ asset.project_title }}">{{ asset.project_title }}</a>
                {{ renderReleaseTitles(asset, 'asset-viewer-grid-card-title-releases', 'asset-viewer-grid-card-title-empty') }}
              </div>
            </article>
          </li>
        {% endfor %}
      </ul>
    {% else %}
      <ul class="asset-list" role="list" aria-label="Assets across active projects">
        {% for asset in assets %}
          {% set detailUrl = "/projects/" ~ asset.project_id ~ "/assets/" ~ asset.id %}
          {% set projectUrl = "/projects/" ~ asset.project_id %}
          {% set displayName = asset.filename or asset.relative_path or 'Unnamed asset' %}
          <li class="asset-list-item{% if not asset.is_present %} is-missing{% endif %}">
            <article class="asset-list-card" data-asset-id="{{ asset.id }}">
              {{ renderListPreview(asset, detailUrl, displayName) }}

              <div class="asset-list-card-body">
                <div class="asset-list-card-header">
                  <div class="asset-list-card-heading">
                    <h2 class="asset-list-card-title">
                      <a class="asset-file-link" href="{{ detailUrl }}"
                         aria-label="View details for {{ displayName }} from {{ asset.project_title }}">{{ displayName }}</a>
                    </h2>
                    <span class="asset-list-card-location" data-asset-containing-location>{{ renderListLocation(asset) }}</span>
                  </div>
                  <span class="asset-list-card-presence">{{ renderPresence(asset) }}</span>
                </div>

                <dl class="asset-list-card-metadata">
                  <div class="asset-list-card-meta asset-list-card-meta--project">
                    <dt>Project</dt>
                    <dd><a class="asset-project-link" href="{{ projectUrl }}" aria-label="View project {{ asset.project_title }}">{{ asset.project_title }}</a></dd>
                  </div>
                  <div class="asset-list-card-meta asset-list-card-meta--category">
                    <dt>Category</dt>
                    <dd>{{ renderCategory(asset) }}</dd>
                  </div>
                  <div class="asset-list-card-meta asset-list-card-meta--extension">
                    <dt>Extension</dt>
                    <dd><span class="asset-type-label">{{ asset.extension or '—' }}</span></dd>
                  </div>
                  <div class="asset-list-card-meta asset-list-card-meta--size">
                    <dt>Size</dt>
                    <dd>{% if asset.size_bytes == 0 or asset.size_bytes %}{{ asset.size_bytes }} bytes{% else %}—{% endif %}</dd>
                  </div>
                  <div class="asset-list-card-meta asset-list-card-meta--modified">
                    <dt>Modified</dt>
                    <dd>{{ asset.modified_at or '—' }}</dd>
                  </div>
                </dl>

                <div class="asset-list-card-associations">
                  <section class="asset-list-card-association asset-list-card-association--tags">
                    <h3 class="asset-list-card-association-label">Effective tags</h3>
                    <div class="asset-list-card-association-content">
                      {{ renderEffectiveTags(asset, 'asset-list-card-tags', 'asset-list-card-empty') }}
                    </div>
                  </section>
                  <section class="asset-list-card-association asset-list-card-association--releases">
                    <h3 class="asset-list-card-association-label">Releases</h3>
                    <div class="asset-list-card-association-content">
                      {{ renderReleaseTitles(asset, 'asset-list-card-releases', 'asset-list-card-empty', 'asset-list-card-release-link') }}
                    </div>
                  </section>
                </div>
              </div>
            </article>
          </li>
        {% endfor %}
      </ul>
    {% endif %}

    {% if pageCount > 1 %}
      <nav class="pagination" aria-label="Asset Viewer pages">
        {% if hasPreviousPage %}
          <a class="button" href="{{ pageUrl({ page: page - 1 }) }}" rel="prev" aria-label="Previous Asset Viewer page">Previous</a>
        {% endif %}
        <span class="pagination-info">Page {{ page }} of {{ pageCount }}</span>
        {% if hasNextPage %}
          <a class="button" href="{{ pageUrl({ page: page + 1 }) }}" rel="next" aria-label="Next Asset Viewer page">Next</a>
        {% endif %}
      </nav>
    {% endif %}
  {% else %}
    {% set filtersActive = filters.projectId or filters.categories.length > 0 or filters.tags.length > 0 or filters.search or filters.extensions.length > 0 or filters.presence != 'all' or filters.usage != 'all' %}
    {% set noAssetsAcrossProjects = false %}
    {% if hasAnyAssets is defined %}
      {% set noAssetsAcrossProjects = not hasAnyAssets %}
    {% elif unfilteredTotal is defined %}
      {% set noAssetsAcrossProjects = unfilteredTotal == 0 %}
    {% else %}
      {% set noAssetsAcrossProjects = not filtersActive %}
    {% endif %}

    {% if noAssetsAcrossProjects %}
      {% set emptyHeading = "No assets across active projects" %}
      {% set emptyDescription = "No assets are currently indexed in active projects." %}
    {% else %}
      {% set emptyHeading = "No assets match the current filters" %}
      {% set emptyDescription = "No assets in active projects match the selected filters." %}
      {% set emptyActionUrl = clearFiltersUrl %}
      {% set emptyActionLabel = "Reset" %}
    {% endif %}
    {% set emptyHeadingLevel = "h2" %}
    {% include "partials/empty-state.njk" %}
  {% endif %}

  </div>

{% endblock %}
{% block overlay %}
  {% call dialog.render('asset-viewer-defaults-dialog', 'Asset Viewer defaults', assetViewerDefaultsDialogOpen, 'asset-viewer-defaults-description', 'asset-viewer-defaults-form') %}
    <form id="asset-viewer-defaults-form" method="post" action="/assets/defaults" class="app-dialog-form project-form"
          data-dialog-form data-dialog-async novalidate>
      <p id="asset-viewer-defaults-description" class="app-dialog-description">
        Choose the presentation used when the Asset Viewer opens without explicit options.
      </p>

      <div class="app-dialog-error" data-dialog-error role="alert" hidden>
        <p data-dialog-error-text></p>
        <ul data-dialog-error-list></ul>
      </div>

       <input type="hidden" name="_csrf" value="{{ _csrf }}">
       <input type="hidden" name="returnTo" value="{{ assetViewerDefaultsReturnUrl }}">

      <div class="app-dialog-body">
        {% for field in assetViewerDefaults.fields %}
          {% set submittedOption = none %}
          {% set nativeAttributes = [["required", true]] %}
          {% set summaryAttributes = [] %}
          {% if field.showSubmittedValue %}
            {% set submittedOption = {
              id: field.id ~ '-submitted',
              value: field.submittedOptionValue,
              label: 'Submitted value: ' ~ field.submittedDisplayValue,
              attributes: [["data-dialog-submitted-value", true]],
              selected: true
            } %}
          {% endif %}
          {% if field.error %}
            {% set nativeAttributes = [["required", true], ["aria-describedby", field.id ~ '-error'], ["aria-invalid", true]] %}
            {% set summaryAttributes = [["aria-describedby", field.id ~ '-error'], ["aria-invalid", true]] %}
          {% endif %}
          <div class="field app-dialog-field{% if field.error %} field-error{% endif %}" data-dialog-field="{{ field.name }}">
            {{ dropdown.singleSelect({
              id: field.id ~ '-dropdown',
              name: field.name,
              label: field.label,
              options: field.options,
              selected: field.selectedValue,
              optionIdPrefix: field.id,
              leadingOption: submittedOption,
              summaryAttributes: summaryAttributes,
              nativeSelect: {
                id: field.id,
                attributes: nativeAttributes
              }
            }) }}
            {% if field.error %}<span class="field-error-message" id="{{ field.id }}-error">{{ field.error }}</span>{% endif %}
          </div>
        {% endfor %}
      </div>

      <div class="app-dialog-status" data-dialog-status role="status" aria-live="polite"></div>

      <footer class="app-dialog-footer">
        <button class="button button-secondary" type="submit" formmethod="dialog" data-dialog-close>Cancel</button>
        <button class="button button-primary" type="submit" data-dialog-submit>Save defaults</button>
      </footer>
    </form>
  {% endcall %}
  <div data-slideshow-scaffold class="slideshow-scaffold" hidden inert role="dialog" aria-modal="true" aria-label="Slideshow">
      <script type="application/json" data-slideshow-sequence>{{ slideshowSequenceJson | default('[]') | safe }}</script>
      <div class="slideshow-scaffold-inner">
        <div class="slideshow-header">
          <span class="slideshow-status" data-slideshow-status aria-live="polite" aria-atomic="true"></span>
          <span class="slideshow-media-status" data-slideshow-media-status role="status" aria-live="polite" hidden></span>
          <div class="slideshow-header-actions">
            <button type="button" class="slideshow-fullscreen" data-slideshow-fullscreen aria-label="Enter fullscreen" aria-pressed="false" title="Enter fullscreen">
              <span class="slideshow-fullscreen-enter-icon" aria-hidden="true">{{ icons.icon('fullscreen') }}</span>
              <span class="slideshow-fullscreen-exit-icon" aria-hidden="true">{{ icons.icon('fullscreen-exit') }}</span>
            </button>
            <button type="button" class="slideshow-close" data-slideshow-close aria-label="Close slideshow">{{ icons.icon('close') }}</button>
            <button type="button" class="slideshow-original-size" data-slideshow-original-size aria-label="View original size" aria-pressed="false" title="View original size">
              {{ icons.icon('original-size') }}
            </button>
          </div>
        </div>
      <div class="slideshow-preview" data-slideshow-preview></div>
      <div class="slideshow-controls">
        <button type="button" class="slideshow-nav-btn" data-slideshow-prev aria-label="Previous">{{ icons.icon('chevron-left') }}</button>
        <button type="button" class="slideshow-play-pause" data-slideshow-play-pause aria-label="Play" disabled>
          <span class="slideshow-play-icon" aria-hidden="true">{{ icons.icon('slideshow') }}</span>
          <span class="slideshow-pause-icon" aria-hidden="true">{{ icons.icon('pause') }}</span>
        </button>
        {{ dropdown.singleSelect({
          id: "slideshow-speed-dropdown",
          label: "Slideshow speed",
          visuallyHiddenLabel: true,
          compact: true,
          selected: "4000",
          dispatchNativeChange: true,
          options: [
            { value: "2000", label: "2 s" },
            { value: "4000", label: "4 s" },
            { value: "6000", label: "6 s" }
          ],
          panelLabel: "Slideshow speed options",
          nativeSelect: {
            id: "slideshow-speed",
            classes: "slideshow-speed",
            attributes: [["data-slideshow-speed", true], ["disabled", true]]
          }
        }) }}
        <button type="button" class="slideshow-nav-btn" data-slideshow-next aria-label="Next">{{ icons.icon('chevron-right') }}</button>
      </div>
    </div>
  </div>
{% endblock %}
