NODE_ENV=development
PORT=3000
APP_NAME=CreatorCrate
APP_DATA_ROOT=./data/app
PROJECTS_ROOT=./data/projects
DATABASE_PATH=./data/app/creatorcrate.db

# Authentication is optional and disabled by default. Enable it from the
# browser at Settings > Security — no password hash or session secret needs
# to be generated or pasted here. The chosen username/password hash and a
# generated session secret are stored under APP_DATA_ROOT
# (operator-credential.json, auth-enablement.json). Recovery if you get
# locked out: `pnpm auth:reset` (run on the host, requires interactive
# confirmation).
#
# IMPORTANT: those two managed files are not included in SQLite database
# backups — back up APP_DATA_ROOT at the host/filesystem level if you want
# authentication settings to survive a redeploy.

# Optional auth/session deployment controls.
# SESSION_TTL_HOURS=24
# COOKIE_SECURE=false
# TRUST_PROXY=false
# HSTS_ENABLED=false

# Number of managed database backups to keep after each new backup is
# created (newest first). Optional; defaults to 10 if unset. Set to 0 to
# disable automatic pruning and keep every backup indefinitely.
# BACKUP_RETENTION_COUNT=10

# Optional recurring scans of eligible projects. Leave unset or empty to
# disable automatic scanning; valid values are whole minutes from 1 through
# 35791.
# AUTO_SCAN_INTERVAL_MINUTES=60

# Optional release notifications (Settings > Release Notifications). Every
# value below is optional and deployment-controlled; unset channels simply show
# as "not ready". Secrets (SMTP password, tokens, full Webhook URL) are read only
# from the environment and never stored in the database or shown in the UI.
# Enable channels, timing, and the email recipient in Settings. Values are
# read at startup: after changing them, recreate the container with
# `docker compose up -d` (a plain restart keeps the old environment), or
# restart `pnpm start` when running directly. See "Release
# Notifications" in README.md for each channel and the Webhook JSON contract.
#
# External base URL used to build release links in notifications. Leave unset
# to send notifications without links.
# RELEASE_NOTIFICATIONS_BASE_URL=https://creatorcrate.example.com
#
# Email (SMTP). SECURITY is tls, starttls (default), or plain (trusted relay
# only; requires PORT). PORT defaults to 465 for tls and 587 for starttls.
# The recipient address is chosen in Settings.
# RELEASE_NOTIFICATIONS_SMTP_HOST=smtp.example.com
# RELEASE_NOTIFICATIONS_SMTP_PORT=587
# RELEASE_NOTIFICATIONS_SMTP_SECURITY=starttls
# RELEASE_NOTIFICATIONS_SMTP_USERNAME=
# RELEASE_NOTIFICATIONS_SMTP_PASSWORD=
# RELEASE_NOTIFICATIONS_SMTP_FROM=creatorcrate@example.com
#
# ntfy: server URL, topic, and optional access token.
# RELEASE_NOTIFICATIONS_NTFY_URL=https://ntfy.sh
# RELEASE_NOTIFICATIONS_NTFY_TOPIC=
# RELEASE_NOTIFICATIONS_NTFY_TOKEN=
#
# Gotify: server URL and application token.
# RELEASE_NOTIFICATIONS_GOTIFY_URL=https://gotify.example.com
# RELEASE_NOTIFICATIONS_GOTIFY_TOKEN=
#
# Webhook: endpoint URL (treated as secret) and optional bearer token.
# RELEASE_NOTIFICATIONS_WEBHOOK_URL=
# RELEASE_NOTIFICATIONS_WEBHOOK_TOKEN=

# Host bind-mount paths used only by Docker Compose
CREATORCRATE_APP_DATA_PATH=./data/app
CREATORCRATE_PROJECTS_PATH=./data/projects
