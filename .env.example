NODE_ENV=development
PORT=3000
APP_NAME=CreatorCrate
APP_DATA_ROOT=./data/app
PROJECTS_ROOT=./data/projects
DATABASE_PATH=./data/app/creatorcrate.db

# Authentication is optional and disabled by default. Enable it from the
# browser at Settings > Security — no password hash or session secret needs
# to be generated or pasted here. The chosen username/password hash and a
# generated session secret are stored under APP_DATA_ROOT
# (operator-credential.json, auth-enablement.json). Recovery if you get
# locked out: `pnpm auth:reset` (run on the host, requires interactive
# confirmation).
#
# IMPORTANT: those two managed files are not included in SQLite database
# backups — back up APP_DATA_ROOT at the host/filesystem level if you want
# authentication settings to survive a redeploy.

# Optional auth/session deployment controls.
# SESSION_TTL_HOURS=24
# COOKIE_SECURE=false
# TRUST_PROXY=false
# HSTS_ENABLED=false

# Number of managed database backups to keep after each new backup is
# created (newest first). Optional; defaults to 10 if unset. Set to 0 to
# disable automatic pruning and keep every backup indefinitely.
# BACKUP_RETENTION_COUNT=10

# Optional recurring scans of eligible projects. Leave unset or empty to
# disable automatic scanning; valid values are whole minutes from 1 through
# 35791.
# AUTO_SCAN_INTERVAL_MINUTES=60

# Host bind-mount paths used only by Docker Compose
CREATORCRATE_APP_DATA_PATH=./data/app
CREATORCRATE_PROJECTS_PATH=./data/projects
