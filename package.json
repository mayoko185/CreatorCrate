{
  "name": "creatorcrate",
  "version": "0.1.0",
  "description": "Self-hosted web application for organizing Patreon art projects and files",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "pnpm test",
    "auth:hash": "node scripts/hash-password.js",
    "auth:reset": "node scripts/auth-reset.js"
  },
  "dependencies": {
    "@sindresorhus/slugify": "^2.2.1",
    "better-sqlite3": "^11.5.0",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "nunjucks": "^3.2.4",
    "sharp": "0.35.3"
  },
  "devDependencies": {
    "supertest": "^7.0.0",
    "vitest": "^2.1.3"
  }
}
