{
  "name": "creatorcrate",
  "version": "0.1.0",
  "description": "Self-hosted web application for organizing art projects and files",
  "type": "module",
  "engines": {
    "node": ">=24.19.0 <25"
  },
  "packageManager": "pnpm@11.21.0",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "pnpm test",
    "auth:hash": "node scripts/hash-password.js",
    "auth:reset": "node scripts/auth-reset.js"
  },
  "dependencies": {
    "@sindresorhus/slugify": "^2.2.1",
    "@toast-ui/editor": "3.2.2",
    "better-sqlite3": "13.0.3",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "markdown-it": "^15.0.0",
    "nunjucks": "^3.2.4",
    "sanitize-html": "2.16.0",
    "sharp": "0.35.3",
    "yauzl": "^3.4.0"
  },
  "devDependencies": {
    "supertest": "^7.0.0",
    "vitest": "^4.1.10"
  }
}
