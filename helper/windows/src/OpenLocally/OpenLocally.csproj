<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Windows GUI subsystem: protocol activation does not flash a console
         window. Command-line arguments and exit codes still work normally. -->
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="OpenLocally.Tests" />
  </ItemGroup>

</Project>
